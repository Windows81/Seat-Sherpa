    var exactN=rides.filter(function(r){return !r.adjacent;}).length;
    var nearN=rides.length-exactN;
    countEl.textContent=exactN+' upcoming ride'+(exactN===1?'':'s')+(nearN?' · '+nearN+' nearby':'');
    if(webMode){
      countEl.innerHTML=esc(countEl.textContent)
        +' &nbsp;·&nbsp; <a href="/post" style="color:#00D4C8;text-decoration:none;">Driving one of these routes? Post your ride →</a>'
        +' &nbsp;·&nbsp; <a href="/requests" style="color:#7dd3fc;text-decoration:none;">Need a ride nobody posted? Request it →</a>';
    }
    // Adjacent-region rides render under a divider so nobody mistakes a
    // Santa Barbara ride for the Orange County ride they searched.
    var exact=rides.filter(function(r){return !r.adjacent;});
    var near=rides.filter(function(r){return r.adjacent;});
    var html=exact.map(card).join('');
    if(near.length){
      html+='<div style="grid-column:1/-1;color:#8a8a92;font-size:13px;letter-spacing:1px;text-transform:uppercase;margin:14px 0 2px;">Nearby routes &mdash; close to what you searched</div>';
      html+=near.map(card).join('');
    }
    list.innerHTML=html;
  }
  ['dateF','availF','flexF'].forEach(function(id){
    document.getElementById(id).addEventListener('change',renderRides);
  });
  // ── Address autocomplete (Mapbox forward geocode, CA/NV bbox) ──────────
  (function(){
    var MB='pk.eyJ1IjoiamR0MjYyIiwiYSI6ImNtcDhnb3pvNzBkbGYyenBpN2psY3g2bGsifQ.sqsxq8sjfLaq978oqGExHg';
    var inp=document.getElementById('addrF'),sg=document.getElementById('addrSugg'),clr=document.getElementById('addrClear');
    var t=null;
    function hide(){sg.classList.add('hidden');sg.innerHTML='';}
    inp.addEventListener('input',function(){
      addrCoords=null;clr.classList.toggle('hidden',!inp.value);
      clearTimeout(t);
      var q=inp.value.trim();
      if(q.length<3){hide();renderRides();return;}
      t=setTimeout(function(){
        fetch('https://api.mapbox.com/geocoding/v5/mapbox.places/'+encodeURIComponent(q)+'.json?limit=5&bbox=-124.5,32,-114,42&access_token='+MB)
          .then(function(r){return r.json();})
          .then(function(j){
            if(inp.value.trim()!==q)return; // stale response — input changed or was cleared
            sg.innerHTML='';
            var fs=(j&&j.features)||[];
            if(!fs.length){hide();return;}
            fs.forEach(function(f){
              var b=document.createElement('button');
              b.type='button';
              b.textContent=f.place_name;
              b.style.cssText='display:block;width:100%;text-align:left;background:none;border:0;color:#e8e8ee;font-family:inherit;font-size:14px;padding:10px 14px;cursor:pointer;border-bottom:1px solid rgba(255,255,255,.06)';
              b.addEventListener('click',function(){
                inp.value=f.place_name;
                addrCoords={lat:f.center[1],lng:f.center[0]};
                clr.classList.remove('hidden');
                hide();renderRides();
              });
              sg.appendChild(b);
            });
            sg.classList.remove('hidden');
          }).catch(hide);
      },300);
    });
    clr.addEventListener('click',function(){inp.value='';addrCoords=null;clr.classList.add('hidden');hide();renderRides();});
    document.addEventListener('click',function(e){if(!sg.contains(e.target)&&e.target!==inp)hide();});
  })();
  // Signed-in searches log client-side (search_log RLS is authenticated-only
  // — anon inserts were silently dropped for weeks; public-rides now logs
  // anonymous searches server-side with source=web, 0227). Route alerts
  // email these searchers when a driver posts; drivers see the demand tiles.
  var SRC_WEB_OK=true; // 0228 ran 9/1: search_log source CHECK admits 'web'
  function logSearch(resultsCount){
    try{
      var tok=null;
      try{var raw=localStorage.getItem('sb-vmfmbntacifqoqxqxgsk-auth-token');if(raw)tok=(JSON.parse(raw)||{}).access_token||null;}catch(_){}
      var uid=null;
      if(tok){try{uid=JSON.parse(atob(tok.split('.')[1])).sub||null;}catch(_){}}
      if(!tok||!uid)return; // anon searches are logged server-side by public-rides
      // 0220 stamp: /rides never loaded ss-session.js — signed-in searchers
      // here looked "Unknown surface" in admin. Once per page load.
      if(!window.__wseen){window.__wseen=1;fetch(SUPA+'/rest/v1/profiles?id=eq.'+uid,{method:'PATCH',headers:{apikey:ANON,Authorization:'Bearer '+tok,'Content-Type':'application/json',Prefer:'return=minimal'},body:JSON.stringify({web_seen_at:new Date().toISOString()})}).catch(function(){});}
      // (ToS acceptance is logged only on pages that show the notice — audit 2026-09-02.)
      fetch(SUPA+'/rest/v1/search_log',{method:'POST',headers:{apikey:ANON,Authorization:'Bearer '+(tok||ANON),'Content-Type':'application/json',Prefer:'return=minimal'},body:JSON.stringify({user_id:uid,from_dest:fromS.value,to_dest:toS.value,search_date:document.getElementById('dateF').value||null,results_count:resultsCount,source:SRC_WEB_OK?'web':undefined})}).catch(function(){});
    }catch(_){}
  }
  function load(){
    list.innerHTML='<div class="loading">Loading rides…</div>'; countEl.textContent='';
    var u=SUPA+'/functions/v1/public-rides?from='+encodeURIComponent(fromS.value)+'&to='+encodeURIComponent(toS.value);
    // 0227 attribution: date filter + landing referrer + campaign tag ride
    // along so the server can log what anonymous visitors wanted and how
    // they found us.
    try{
      var dF=document.getElementById('dateF');
      if(dF&&dF.value)u+='&date='+encodeURIComponent(dF.value);
      var qp=new URLSearchParams(location.search);
      var camp=qp.get('c')||qp.get('utm_source')||'';
      if(camp)u+='&c='+encodeURIComponent(camp.slice(0,80));
      if(document.referrer)u+='&ref='+encodeURIComponent(document.referrer.slice(0,300));
    }catch(_){}
    var utok=null;try{var raw0=localStorage.getItem('sb-vmfmbntacifqoqxqxgsk-auth-token');if(raw0)utok=(JSON.parse(raw0)||{}).access_token||null;}catch(_){}
    fetch(u,{headers:{apikey:ANON,Authorization:'Bearer '+(utok||ANON)}}).then(function(r){return r.json();}).then(function(d){
      var rides=(d&&d.rides)||[];
      allRides=rides;
      logSearch(rides.filter(function(r){return !r.adjacent;}).length); // exact matches only - nearby top-ups are not met demand
      renderRides();
    }).catch(function(){ list.innerHTML='<div class="empty">Could not load rides right now — refresh to try again.</div>'; });
  }
  // Booking-intent signal: fires when someone taps a ride to open it. Filter
  // this event by Desktop in Vercel Analytics to size web-checkout demand.
  list.addEventListener('click',function(e){ if(e.target.closest('.ride')) window.va('event',{name:'ride_click'}); });
  fromS.onchange=load; toS.onchange=load;
  document.getElementById('swap').onclick=function(){var a=fromS.value;fromS.value=toS.value;toS.value=a;load();};
  load();
})();
</script>
<script src="/js/ss-menu.js"></script>
<script src="/js/ss-appbar.js"></script>
<script>
// /rides is BOTH a public marketing page and the signed-in marketplace, so
// the header depends on who's looking:
//   signed out — keep the marketing nav (wordmark + "Sign in")
//   signed in  — swap in the shared console app bar, so browsing rides sits
//                in the same chrome as Trips/Driving/Messages instead of
//                dropping you out of the console (Justin, 2026-08-28).
try {
  if (window.SS_APPBAR && SS_APPBAR.signedIn()) {
    SS_APPBAR.mount({
      active: 'rides',
      // Replaces the marketing <nav> outright.
      mountTo: document.querySelector('nav'),
      // Align to the CONTENT column, not the nav's own .wrap — that one is
      // being replaced and would measure wrong.
      alignTo: document.querySelector('body > .wrap'),
    });
  }
} catch (_) { /* the marketing nav is a fine fallback */ }
</script>
