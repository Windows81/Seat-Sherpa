function rideWhen(dateStr, timeStr) {
  var p = String(dateStr || '').split('-').map(Number);
  if (!p[0] || !p[1] || !p[2]) return '';
  var day = new Date(p[0], p[1] - 1, p[2]).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  var t = '';
  if (timeStr) {
    var h = parseInt(String(timeStr).slice(0, 2), 10), m = String(timeStr).slice(3, 5);
    if (!isNaN(h)) t = ((h % 12) || 12) + ':' + m + ' ' + (h >= 12 ? 'PM' : 'AM') + ' PT';
  }
  return day + (t ? ' · ' + t : '');
}

