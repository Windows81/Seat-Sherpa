      // (fp front passenger; ml/mr middle row; rl/rc/rr rear). Unknown ids
      // (future layouts) fall back to the plain grid so nothing breaks.
      const KNOWN = { fp: 1, ml: 1, mr: 1, rl: 1, rc: 1, rr: 1 };
      const byId = {};
      for (const s of seats) byId[s.id] = s;
      const carLayout = seats.length > 0 && seats.every((s) => KNOWN[s.id]);

