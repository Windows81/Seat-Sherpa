          const div2 = document.createElement('div');
          div2.className = 'windshield';
          shell.appendChild(div2);
          const rear = document.createElement('div');
          rear.className = 'carrow three';
          rear.appendChild(tile('rl'));
          rear.appendChild(tile('rc'));
          rear.appendChild(tile('rr'));
          shell.appendChild(rear);
        }

        // Car chrome (v2): wheels at the corners + side mirrors, centered.
        const wrap = document.createElement('div');
        wrap.className = 'carwrap';
        ['wfl', 'wfr', 'wrl', 'wrr'].forEach((w) => {
          const el = document.createElement('div');
          el.className = 'carwheel ' + w;
          wrap.appendChild(el);
        });
        ['mml', 'mmr'].forEach((m) => {
          const el = document.createElement('div');
          el.className = 'carmirror ' + m;
          wrap.appendChild(el);
        });
        wrap.appendChild(shell);
        grid.appendChild(wrap);
      }

      if (rideData.driverFirst) {
        $('drvMsgLabel').textContent = 'Message to ' + rideData.driverFirst + ' (optional)';
        var _smb = $('successMsgBtn'); if (_smb) _smb.textContent = '💬 Message ' + rideData.driverFirst;
      }
      for (const pid of priorSeats) {
        const btn = grid.querySelector('[data-seat="' + (window.CSS && CSS.escape ? CSS.escape(pid) : pid) + '"]');
        if (btn && !btn.classList.contains('taken')) btn.click();
      }
      updateSummary();
    }

    function seatById(id) { return (rideData.seats || []).find((s) => s.id === id); }

    // The ONE place the charge is computed (display only — the server recomputes
    // everything from the ride row). Used by the seat summary AND the
    // "Your pick" line on the gate steps, so both always show the same number.
    function computeTotals() {
      const n = selectedSeats.length;
      if (n === 0 || !rideData) return null;
      const totalDollars = selectedSeats.reduce((sum, id) => sum + segPrice(seatById(id)?.price || 0), 0);
      // Same integer math as the server: fee on the summed seat cents.
      const bps = typeof rideData.serviceFeeBps === 'number' ? rideData.serviceFeeBps : 500;
      const seatCents = Math.round(totalDollars * 100);
      const feeCents = serviceFeeCentsFor(seatCents);
      const minLifted = feeCents > Math.floor((seatCents * bps) / 10000);
      // Flat 99¢ booking fee, when it applies: waived-driver rides (server
      // says so) OR this rider holds credit (credit parity with the app,
      // 2026-08-25). The server adds it as its own Checkout line item.
      const bookingFeeCents =
        rideData.bookingFeeApplies === true || myCreditCents > 0 ||
        (rideData.bookingFeeApplies === undefined && rideData.bookingFeeCents > 0)
          ? 99 : 0;
      const grandTotal = seatCents + feeCents + bookingFeeCents;
      // Credit preview — mirrors the server exactly: redeem up to the total
      // minus Stripe's 50¢ card minimum. charge = what the card is charged.
      const creditPreview = myCreditCents > 0 && grandTotal > 50 ? Math.min(myCreditCents, grandTotal - 50) : 0;
      return { n, bps, minLifted, seatCents, feeCents, bookingFeeCents, grandTotal, creditPreview, charge: grandTotal - creditPreview };
