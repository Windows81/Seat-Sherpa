    <p class="legal">
      Seat Sherpa is a cost-sharing carpool marketplace, not a ride-hail service.<br />
      <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> · <a href="mailto:support@seatsherpa.app">support@seatsherpa.app</a>
    </p>
  </div>

  <script src="/js/ss-oauth.js"></script>
  <script type="module">
    // book.html — v1 web booking (2026-08-20).
    //
    // "Book one ride from a link": /book?id=N renders the ride via the extended
    // public-ride endpoint, walks a brand-new visitor through email OTP →
    // name+bio → phone verify → photo → seat pick, then calls the
    // web-create-booking edge fn which inserts a Pending booking and returns a
    // Stripe Checkout url. Web bookings are ALWAYS request-to-book (manual
    // capture) — the card is only authorized until the driver accepts in the
    // app — so every piece of copy on this page says "charged only if the
    // driver accepts".
    //
    // The step order mirrors the app's gates (server enforces them all again in
    // web-create-booking): the server is the gate; this page just routes the
    // visitor to whichever step the server would bounce them to anyway.
    import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

    const SUPA = 'https://vmfmbntacifqoqxqxgsk.supabase.co';
    // Publishable (anon) key — safe to expose in client-side code by design.
    const ANON = 'sb_publishable_TGebz9q_z0kkH0Tuivlr4w_3MPLMxF3';

    // persistSession (localStorage) is REQUIRED here — the session must survive
    // the round-trip to Stripe Checkout so the success page can poll the
    // booking row under the rider's own RLS. (reset-password.html's
    // persistSession:false is deliberately NOT copied.)
    //
    // 2026-08-20 — this stored session is now a HANDOFF, not just a scratchpad
    // for the length of one checkout. The hidden rider surface (/trips, via
    // /js/ss-session.js) reads the exact same localStorage entry, so a rider who
    // books here is still signed in days later when they need their pickup code
    // at the curb — and that code is the only thing that releases the driver's
    // reimbursement (0043 + stripe-release-to-driver). Two rules keep the
    // handoff working:
    //   1. NEVER pass `storageKey` — here or in ss-session.js. Both clients are
    //      built from the same project URL, so both inherit the library default
    //      `sb-vmfmbntacifqoqxqxgsk-auth-token`. Setting a "tidier" namespaced
    //      key on either side silently orphans the other, and the rider gets
    //      bounced to a sign-in screen at pickup time.
    //   2. autoRefreshToken is spelled out rather than left implicit. A rider
    //      can sit on Stripe Checkout longer than the ~1h access token lives,
    //      and the refresh-on-return is what keeps the stored session alive to
    //      be handed off at all.
    const supabase = createClient(SUPA, ANON, {
      auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: false },
    });

    // ── URL params ────────────────────────────────────────────────────────
    const qp = new URLSearchParams(location.search);
    const rideId = Number(qp.get('id'));
    const bookingParam = Number(qp.get('booking'));
    const returnState = qp.get('state'); // 'success' | 'cancelled' | null

    // ── State helpers ─────────────────────────────────────────────────────
    const STATES = ['stLoading','stGone','stAppOnly','stEmail','stCode','stProfile','stPhone','stSeats','stRedirect','stFinalizing','stSuccess','stCancelled'];
    const $ = (id) => document.getElementById(id);

    // ── Back affordance (2026-08-28, Justin: "a back button on any booking
    // page"). Interactive steps keep a trail; ← pops it. On the first step
    // there's nothing to pop, so ← returns to the ride's landing page. Non-
    // interactive states (loading, Stripe redirect, success…) hide the row.
    const BACKABLE = { stEmail: 1, stCode: 1, stProfile: 1, stPhone: 1, stSeats: 1 };
    let stepTrail = [];
    let currentStep = null;
    let backNav = false;
    // Once the rider is signed in, the auth steps must never come back via
    // browser Back (audit 2026-09-02: Back from the seat picker showed the
    // email form to a signed-in rider). popstate unwinds past them instead.
    let ssAuthDone = false;
    function show(id) {
      currentStep = id;
      STATES.forEach((s) => $(s).classList.toggle('hidden', s !== id));
      // The sign-in card carries the "By continuing you agree" notice. Mark
      // that it was actually SEEN (sessionStorage survives the Google/Apple
      // redirect back to this tab), so ssLogTos only records an acceptance
      // for someone who saw it (bug check 10/14: a signed-in page load used to
      // log one with no notice shown).
      if (id === 'stEmail') { try { sessionStorage.setItem('ss-tos-notice-seen', '1'); } catch (_) {} }
      // Reveal the nav banner only on terminal screens (booking done/cancelled)
      // so the active funnel stays distraction-free (Justin, 2026-08-28).
      var _bn = $('bookNav');
      if (_bn) _bn.style.display = (id === 'stSuccess' || id === 'stCancelled' || id === 'stGone') && _bn.childElementCount > 0 ? 'flex' : 'none';
      if (BACKABLE[id]) {
        if (backNav) backNav = false;
        else {
          // Returning to a step already on the trail truncates the loop —
          // "Use a different email" cycles must not stack stale entries.
          const seen = stepTrail.indexOf(id);
          if (seen >= 0 && seen < stepTrail.length - 1) {
            // In-page return to an EARLIER step ("Use a different email"):
            // unwind real history to that entry instead of stacking a new
            // one on top, so browser Back keeps matching the trail
            // (audit 2026-09-02). popstate re-renders the step.
            const delta = seen - (stepTrail.length - 1);
            stepTrail.length = seen + 1;
            try { history.go(delta); return; } catch (_) {}
          }
          if (seen >= 0) stepTrail.length = seen;
          stepTrail.push(id);
          // Browser back == the in-page Back button (Justin, 2026-09-01):
          // each wizard step gets a history entry, and popstate below
          // replays the same step-back logic. First step replaces so
          // back from there still leaves the page normally.
          try {
            if (stepTrail.length === 1) history.replaceState({ ss: id }, '');
            else history.pushState({ ss: id }, '');
          } catch (_) {}
        }
        $('backRow').classList.remove('hidden');
      } else {
        $('backRow').classList.add('hidden');
      }
    }
    function goBack() {
      if (stepTrail.length > 1) { try { history.back(); return; } catch (_) {} }
      location.href = '/ride?id=' + encodeURIComponent(String(rideId || ''));
    }
    window.addEventListener('pageshow', (ev) => {
      // Safari restores this document from bfcache when the rider backs out
      // of Stripe Checkout — frozen on the redirect spinner forever (audit
      // P2). Put them back on their seats.
      if (ev.persisted && currentStep === 'stRedirect') {
        backNav = true;
        show('stSeats');
        try { renderSeats(); } catch (_) {}
      }
    });
    window.addEventListener('popstate', (ev) => {
      const ss = ev.state && ev.state.ss;
      if (!ss || !BACKABLE[ss]) return;
      // Terminal screens never step back into the funnel - a booked ride
      // must not reopen its own seat picker; re-assert the current entry.
      if (currentStep === 'stSuccess' || currentStep === 'stFinalizing' || currentStep === 'stRedirect' || currentStep === 'stCancelled' || currentStep === 'stGone') {
        try { history.back(); } catch (_) {} // unwind the wizard entries so Back LEAVES from a terminal screen instead of trapping (audit P2)
        return;
      }
      if (ssAuthDone && (ss === 'stEmail' || ss === 'stCode')) {
        try { history.back(); } catch (_) {} // signed in: keep unwinding past the auth steps
        return;
      }
      const i = stepTrail.indexOf(ss);
      if (i >= 0) stepTrail.length = i + 1; else stepTrail.push(ss);
      backNav = true;
      show(ss);
    });
    $('backBtn').addEventListener('click', goBack);
    function setMsg(id, text, kind) {
      const el = $(id);
      if (!text) { el.classList.add('hidden'); return; }
      el.textContent = text;
      el.className = 'msg ' + (kind || 'err');
    }

    let rideData = null;      // extended public-ride payload
    let selectedSeats = [];   // seat ids picked on the seat step
    let pendingEmail = '';    // email awaiting OTP
    let pendingPhone = null;  // { cc, num, e164 } awaiting SMS OTP
    let myUid = null;
    // Rider's referral/ride credit — fetched post-sign-in (the 0082 guard
    // permits reading your OWN balance under your own session). Drives the
    // fee trigger + the credit preview in updateSummary, mirroring the app.
    let myCreditCents = 0;
    // 0286: does this rider hold a live booking-fee waiver? Display only;
    // web-create-booking re-reads the same columns and is authoritative.
    // 0318: it is a PERCENTAGE. 100 = the whole fee off (myFeeWaived, shown
    // as "Waived"), 50 = half off (the checkout-lapse offer, shown as the
    // halved amount), 0 = none.
    let myFeeWaiverPct = 0;
    let myFeeWaived = false;
    function setWaiverPct(p) {
      var n = Math.round(Number(p));
      myFeeWaiverPct = Number.isFinite(n) ? Math.min(100, Math.max(0, n)) : 0;
      myFeeWaived = myFeeWaiverPct >= 100;
    }
    // THE waived-fee formula, identical to the server's feeAfterWaiver: pct
    // percent off, rounded to the cent (half a cent rounds up).
    function feeAfterWaiverWeb(feeCents, pct) {
      if (!(pct > 0)) return feeCents;
      if (pct >= 100) return 0;
      return Math.round((feeCents * (100 - pct)) / 100);
    }
    // Typed code at checkout (2026-09-03). Lazy import keeps this page's own
    // client untouched; both clients share the same stored session.
    (async () => {
      try {
        const S = await import('/js/ss-session.js');
        S.wireCodeEntry({
          input: 'webCode', button: 'webCodeBtn', msg: 'webCodeMsg',
          onApplied: async () => {
            if (!myUid) return;
            const { data: bal } = await supabase.rpc('credit_balance_cents', { p_user: myUid });
            myCreditCents = Number(bal) || 0;
            try { updateSummary(); } catch (_) {}
          },
        });
      } catch (_) { /* code entry is a convenience, never a blocker */ }
    })();
    async function fetchMyCredit() {
      if (!myUid) return;
      try {
        const { data: bal } = await supabase.rpc('credit_balance_cents', { p_user: myUid });
        const v = typeof bal === 'number' ? bal : 0;
        if (v !== myCreditCents) { myCreditCents = v; try { updateSummary(); } catch (_) {} }
      } catch (_) { /* preview only — checkout is authoritative */ }
      // 0286 booking-fee waiver. web-create-booking applies the same rule from
      // the same column, so this only decides what the rider SEES before they
      // pay. Without it a waived rider would be shown a fee, then charged
      // less, which reads as a bait-and-switch in reverse and is exactly the
      // kind of number mismatch we have been stamping out all month.
      try {
        const { data: w, error: wErr } = await supabase.rpc('passenger_fee_waiver_pct', { p_user: myUid });
        window.__ssWaiverChecked = true;
        // A failed read is 0: never invent a discount the server will not honor.
        const nw = wErr ? 0 : Math.min(100, Math.max(0, Math.round(Number(w)) || 0));
        if (nw !== myFeeWaiverPct) {
          setWaiverPct(nw);
          // The seat TILES carry the fee too and are painted before sign-in
          // resolves, so they must repaint here or a $10 seat reads "$12" over
          // a "$10.00" total (review, 2026-09-11). renderSeats keeps picks.
          try { renderSeats(); } catch (_) {}
          try { updateSummary(); } catch (_) {}
        }
      } catch (_) { /* no waiver on a failed read — never invent a discount */ }
    }

    // ── Shared validation (cloned from the app so web + app enforce the same
    //     bars — services/profiles.ts hasSufficientBio, services/phone-verify) ──
    const BIO_MIN_WORDS = 3, BIO_MIN_CHARS = 15;
    const bioWords = (b) => (b || '').trim().split(/\s+/).filter(Boolean).length;
    const bioOk = (b) => bioWords(b) >= BIO_MIN_WORDS && (b || '').trim().length >= BIO_MIN_CHARS;

    // No phone numbers in a public bio — lib/off-platform-guard.ts
    // containsPhoneNumber, and migration 0209 enforces the same rule in the
    // database (which is what actually stops a direct PostgREST write). This
    // copy just turns a raw trigger exception into a readable message.
    // Collapses separators between digits first, so "4 0 8 7 3 9 9 3 6 8"
    // and "408.739.9368" are caught alongside the plain form.
    const PHONE_RE = /(^|\D)(\+?1[\s.\-·]?)?\(?\d{3}\)?[\s.\-·]?\d{3}[\s.\-·]?\d{4}(?!\d)/;
    const collapseDigits = (t) => {
      let out = t || '';
      for (let i = 0; i < 24; i++) {
        const n = out.replace(/(\d)[\s.\-·()]+(\d)/g, '$1$2');
        if (n === out) break;
        out = n;
      }
      return out;
    };
    const EMAIL_RE = /[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}/i;
    // Bare " at "/" dot " decode only when BOTH appear — "at" alone is too
    // common a word ("I work at 23andMe.com" is not an email). Bracketed
    // forms are pure evasion and always decode. Mirrors off-platform-guard.
    const deobEmail = (t) => {
      const b = (t || '')
        .replace(/\s*[([{]\s*at\s*[)\]}]\s*/gi, '@')
        .replace(/\s*[([{]\s*dot\s*[)\]}]\s*/gi, '.');
      if (!/\s+at\s+/i.test(t || '') || !/\s+dot\s+/i.test(t || '')) return b;
      return b.replace(/\s+at\s+/gi, '@').replace(/\s+dot\s+/gi, '.');
    };
    // Returns 'phone' | 'email' | null — mirrors lib/off-platform-guard.ts
    // detectBioContact. A bare @handle is intentionally fine.
    const bioContact = (t) => {
      if (!t) return null;
      // ISO dates stripped before collapsing (a date+time collapses to a
      // 10-digit run); the raw test still catches real phones either way.
      if (PHONE_RE.test(t) || PHONE_RE.test(collapseDigits(t.replace(/\d{4}-\d{2}-\d{2}/g, ' ')))) return 'phone';
      // Density check (0216 mirror): 10 digits packed into a ≤20-char window
      // is a phone however dressed ("661-57jdjd5-52gshsj64"), bar year runs.
      {
        const digs = [];
        for (let i = 0; i < t.length; i++) if (t[i] >= '0' && t[i] <= '9') digs.push(i);
        for (let i = 0; i + 9 < digs.length; i++) {
          const win = t.slice(digs[i], digs[i + 9] + 1);
          if (win.length <= 20 && !/^((19|20)\d\d\D{0,3})+$/.test(win)) return 'phone';
        }
      }
      if (EMAIL_RE.test(t) || EMAIL_RE.test(deobEmail(t))) return 'email';
      return null;
    };
    // Booking note ("Message to the driver"): it becomes the first chat
    // message and goes out BEFORE the driver accepts, so it gets the chat
    // rule (warn, never block) with the app's BOOKING_NOTE_WARNING copy.
    // Phone (incl. spaced/interleaved forms) via bioContact; emails, @handles
    // and off-platform apps via the app's HANDLE_RE (lib/off-platform-guard.ts).
    const NOTE_HANDLE_RE = /\b(whats\s?app|telegram|signal|snapchat|venmo|zelle|cash\s?app)\b|@[a-z0-9_.]{3,}/i;
    // Spelled-out digits ("five one zero, nine zero one, eight three zero
    // two", 2026-10-11): a run of three or more number words, seven or more
    // digits in all, is read as the number it spells. Mirrors
    // lib/off-platform-guard.ts normalizeNumberWords and migration 0386; the
    // same snippet lives in trips.html and driving.html. Notes only: the bio
    // check stays mirrored to migration 0209.
    const numberWords = (t) => (t || '').replace(/\b(?:zero|one|two|three|four|five|six|seven|eight|nine|oh|o|\d+)(?:[\s,.\-()/·*]{0,3}\b(?:zero|one|two|three|four|five|six|seven|eight|nine|oh|o|\d+)\b){2,}/gi, (run) => {
      const words = (run.match(/\b(zero|one|two|three|four|five|six|seven|eight|nine)\b/gi) || []).length;
      const digits = run.toLowerCase().replace(/\b(zero|oh|o)\b/g, '0').replace(/\bone\b/g, '1').replace(/\btwo\b/g, '2').replace(/\bthree\b/g, '3').replace(/\bfour\b/g, '4').replace(/\bfive\b/g, '5').replace(/\bsix\b/g, '6').replace(/\bseven\b/g, '7').replace(/\beight\b/g, '8').replace(/\bnine\b/g, '9').replace(/[^0-9]/g, '');
      return words >= 3 && digits.length >= 10 ? digits : run;
    });
    const noteContact = (t) => {
      if (!t) return null;
      const c = bioContact(numberWords(t));
      if (c === 'phone') return 'phone';
      if (c === 'email' || NOTE_HANDLE_RE.test(t)) return 'handle';
      return null;
    };
    const NOTE_WARN_MSG = {
      // 0306: a booking note is always sent before acceptance, so the server
      // hides the contact detail. Say so, and say when numbers are handed
      // over (Justin, 2026-10-11): 24 hours before the ride, once confirmed.
      phone: "Phone numbers and emails stay hidden until your driver accepts your request, so this one will be removed from your message. Your driver can reply to you in Seat Sherpa. Once the booking is confirmed, Seat Sherpa gives you each other's phone numbers 24 hours before the ride, so there's no need to exchange them now.",
      handle: "Handles and emails stay hidden until your driver accepts your request, so this one will be removed from your message. Your driver can reply to you in Seat Sherpa. Once the booking is confirmed, Seat Sherpa gives you each other's phone numbers 24 hours before the ride, so there's no need to exchange them now.",
    };
    const BIO_CONTACT_MSG = {
      phone: "Please take the phone number out of your bio. Your profile is public to everyone browsing rides, and you can call your driver from the app once the booking is confirmed.",
      email: "Please take the email address out of your bio. Your profile is public to everyone browsing rides, and you can message your driver on Seat Sherpa once the booking is confirmed.",
    };

    // lib/phone.ts stripLeadingCountryCode — drop a doubled country code so we
    // never send Twilio "+1 1505..." (unroutable).
    function stripCC(cc, phone) {
      cc = (cc || '').replace(/\D/g, ''); const num = (phone || '').replace(/\D/g, '');
      if (!cc || !num) return num;
      if (cc === '1') return num.length === 11 && num.charAt(0) === '1' ? num.slice(1) : num;
      if (num.indexOf(cc) === 0 && num.length > cc.length + 10) return num.slice(cc.length);
      return num;
    }
    const toE164 = (cc, phone) => '+' + (cc || '').replace(/\D/g, '') + stripCC(cc, phone);
    // +1 (US/Canada) ONLY on web — the service area is CA/NV and the app has
    // the full country picker for edge cases. An open country field on a
    // public page is an SMS-pumping surface: bots request OTP codes to
    // premium international numbers on our Twilio bill (audit M3).
    const plausibleE164 = (e) => /^\+1\d{10}$/.test(e);

    // services/phone-verify.ts error mapping, verbatim — same friendly copy as
    // the app so support only ever sees one set of phone-error strings.
    function mapPhoneSendError(error) {
      const msg = (error.message || '').toLowerCase();
      if (msg.includes('rate limit')) return 'Too many requests. Try again in an hour.';
      if (msg.includes('already') || msg.includes('exists'))
        return 'This number already has a Seat Sherpa account. Sign out, then sign back in with the email or Apple/Google you used before. Your history is there.';
      if (msg.includes('invalid') && (msg.includes('phone') || msg.includes('number') || msg.includes("'to'") || msg.includes('21211')))
        return "That doesn't look like a valid phone number. Please double-check it and try again.";
      return "We couldn't send your code. Please check your number and try again.";
    }

    const noState = (s) => String(s || '').replace(/,\s*[A-Z]{2}$/, '');
    // Whole dollars read "$45", not "$45.00" (2026-10-12).
    const fmt$ = (n) => '$' + Number(n).toFixed(2).replace(/\.00$/, '');
    // What the rider actually pays for one seat: seat price + the service fee,
    // same integer math as the summary (Justin, 2026-08-28 — the seat tile
    // should show $10.50, not the $10 base). The flat booking fee is per-
    // booking, not per-seat, so it stays out of the tile and on its own line.
    // Minimum service fee (0256): the server says whether the $2 floor applies to
    // THIS ride (serviceFeeMinCents > 0 only for rides posted after the cutoff);
    // the fee is max(bps fee, floor). Same rule web-create-booking charges.
    // The fee BEFORE any waiver: what the info toggle quotes as "would have been".
    function serviceFeeBeforeWaiverCentsFor(seatCents) {
      var bps = typeof rideData !== 'undefined' && typeof rideData.serviceFeeBps === 'number' ? rideData.serviceFeeBps : 500;
      var minC = typeof rideData !== 'undefined' && typeof rideData.serviceFeeMinCents === 'number' ? rideData.serviceFeeMinCents : 0;
      var pct = Math.floor((seatCents * bps) / 10000);
      return minC > 0 ? Math.max(pct, minC) : pct;
    }
    function serviceFeeCentsFor(seatCents) {
      // 0286: a live waiver cuts the fee for this rider (0318: by its
      // percentage), on every seat tile as well as the receipt, so the tile
      // price and the total agree.
      return feeAfterWaiverWeb(serviceFeeBeforeWaiverCentsFor(seatCents), myFeeWaiverPct);
    }
    function seatAllIn(dollars) {
      var c = Math.round(Number(dollars) * 100);
      return (c + serviceFeeCentsFor(c)) / 100;
    }

    // MARGINAL tile pricing — ported from the app's booking-sheet, which fixed
    // this on 2026-09-09. The $2 minimum booking fee (0256) and the 99c
    // processing fee are per BOOKING, not per seat, so charging them on every
    // tile made two $11 seats read $13.00 each against a $24.00 receipt: two
    // numbers on one screen that could not both be true. What a tile must show
    // is what ADDING that seat costs, given what is already selected, so the
    // tiles always sum to the receipt (13 + 11 = the 24 charged).
    function allInCentsForWeb(cents) {
      if (cents <= 0) return 0;
      var base = cents + serviceFeeCentsFor(cents);
      var bookingFee = (rideData && (rideData.bookingFeeApplies === true ||
        (typeof myCreditCents === 'number' && myCreditCents > 0) ||
        (rideData.bookingFeeApplies === undefined && rideData.bookingFeeCents > 0))) ? 99 : 0;
      return base + bookingFee;
    }
    /** Dollars this tile adds to the total right now. Measured from the total
     *  WITHOUT this seat, so the number reads the same whether or not it is
     *  already selected. alone=true ignores the selection: what booking this
     *  one seat by itself costs, which is the "per seat" price line. */
    function tilePriceDollars(seat, alone) {
      var p = Math.round(segPrice(seat.price) * 100);
      var sel = 0;
      if (!alone) {
        for (var i = 0; i < selectedSeats.length; i++) {
          var s = seatById(selectedSeats[i]);
          if (s) sel += Math.round(segPrice(s.price) * 100);
        }
      }
      var without = !alone && selectedSeats.indexOf(seat.id) >= 0 ? sel - p : sel;
      return (allInCentsForWeb(without + p) - allInCentsForWeb(without)) / 100;
    }

    // ── Ride card render ──────────────────────────────────────────────────
    function renderRideCard(d) {
      // Visible labels drop the state ("Los Angeles → Hayward", 2026-10-12);
      // the tab title keeps it.
      $('rideRoute').textContent = (noState(d.fromArea) || 'A city') + ' → ' + (noState(d.toArea) || 'destination');
      // Pacific wall-clock, shown as posted (time audit 2026-09-03): the old
      // Date(depDate + 'T' + depTime) re-read the time in the VIEWER's zone.
      // Flexible departure (0326) rides along on the same line, same words
      // as the ride page chip.
      var bkFlex = Number(d.departFlexMinutes) || 0;
      var bkFlexLbl = bkFlex === 60 ? 'Flexible, about 1 h'
        : bkFlex === 120 ? 'Flexible, about 2 h'
        : bkFlex === 720 ? 'Flexible, half a day'
        : bkFlex === 1440 ? 'Flexible, about a day' : '';
      // Compact summary (2026-10-12): one grey line "when · Name, verified";
      // rating, trips and preferences move to a small caption under it.
      var bkWho = '';
      var bkExtras = [];
      if (d.driverFirst) {
        // Trust (benchmark 8/26): we enforce phone OTP + license on file
        // before any ride goes live, and say so where the booking decision
        // happens. Both checks read "verified"; if only one is on file the
        // line names that one. Grey, never teal (teal is for taps).
        var bkPhoneOk = !!d.driverPhoneVerified, bkLicOk = !!d.driverLicenseOnFile;
        bkWho = d.driverFirst + (bkPhoneOk && bkLicOk ? ', verified'
          : bkPhoneOk ? ', phone verified'
          : bkLicOk ? ", driver's license on file" : '');
        // "New driver" parked 2026-09-07 (Justin) until more drivers carry reviews — unrated shows nothing.
        // Ratings round DOWN to one decimal (2026-10-05): 4.95 shows 4.9.
        if (d.driverRating) bkExtras.push('★ ' + (Math.floor(Math.round(Number(d.driverRating) * 1000) / 100) / 10).toFixed(1));
        if (typeof d.driverTrips === 'number' && d.driverTrips > 0) bkExtras.push(d.driverTrips + ' trip' + (d.driverTrips === 1 ? '' : 's'));
        // Preference chips (2026-08-28), where the booking decision happens.
        if (d.driverPrefs) {
          var pp = d.driverPrefs;
          if (pp.conversation === 'chatty') bkExtras.push('Chatty');
          else if (pp.conversation === 'depends') bkExtras.push('Happy either way');
          else if (pp.conversation === 'quiet') bkExtras.push('Quiet ride');
          if (pp.musicOk === true) bkExtras.push('Music');
          if (pp.smokingOk === false) bkExtras.push('No smoking');
          if (pp.petsOk === true) bkExtras.push('Pets ok');
        }
        // Driver photo when public-ride has one (https only); a dead link
        // just drops the image, never a broken icon.
        var bkAv = $('rideAvatar');
        var bkPhoto = typeof d.driverPhotoUrl === 'string' && /^https:\/\//i.test(d.driverPhotoUrl) ? d.driverPhotoUrl : '';
        if (bkAv && bkPhoto) {
          bkAv.onerror = function () { bkAv.classList.add('hidden'); };
          bkAv.src = bkPhoto;
          bkAv.classList.remove('hidden');
        }
      }
      $('rideMeta').textContent = rideWhen(d.depDate, d.depTime) + (bkFlexLbl ? ' · ' + bkFlexLbl : '') + (bkWho ? ' · ' + bkWho : '');
      $('rideDriver').textContent = bkExtras.join(' · ');
      $('rideDriver').classList.toggle('hidden', bkExtras.length === 0);
      $('rideCard').classList.remove('hidden');
      // Cancellation terms, verbatim from the same table trips.html shows
      // after booking (POLICY_DETAILS) — terms belong before money.
      var POLICY_DETAILS = {
        standard: [
          'Cancel 24 hours or more before departure: full refund of the seat price',
          'Cancel 2 to 24 hours before departure: half the seat price back',
          'Cancel within 2 hours of departure: no refund',
          'The booking fee is not refunded when you cancel',
          'If the driver cancels: full refund, booking fee included',
          'If the driver changes the departure time after you book: full refund, booking fee included, up to 2 hours before the new departure',
        ],
        free: [
          'Cancel 2 hours or more before departure: full refund',
          'Cancel within 2 hours of departure: no refund',
        ],
        moderate: [
          'Cancel 48 hours or more before departure: full refund',
          'Cancel 2 to 48 hours before departure: half back',
          'Cancel within 2 hours of departure: no refund',
        ],
        strict: [
          'Cancel 7 days or more before departure: half back',
          'Cancel within 7 days of departure: no refund',
        ],
      };
      var polLines = POLICY_DETAILS[d.cancellationPolicy];
      if (polLines) {
        var pList = $('policyList');
        pList.innerHTML = '';
        for (var pi = 0; pi < polLines.length; pi++) {
          var li = document.createElement('li');
          li.textContent = polLines[pi];
          pList.appendChild(li);
        }
      } else {
        $('policyBox').style.display = 'none';
      }
      document.title = (d.fromArea || 'Ride') + ' → ' + (d.toArea || '') + ' · Book a seat · Seat Sherpa';
    }

    // ── Funnel routing: jump to the first incomplete step ─────────────────
    // Mirrors web-create-booking's server-side gates (GATE_NAME/BIO/PHONE/
    // PHOTO) so a visitor almost never gets bounced by the server; if they do
    // anyway (e.g. stale tab), handleBookingError routes them back here.
    async function route() {
      const { data: sessionData } = await supabase.auth.getSession();
      if (!sessionData.session) { show('stEmail'); return; }

      // getUser() = fresh /auth/v1/user fetch → authoritative
      // phone_confirmed_at (auth.users is the source of truth for the phone
      // gate, per services/phone-verify.ts).
      const { data: userData, error: userErr } = await supabase.auth.getUser();
      if (userErr || !userData.user) { show('stEmail'); return; }
      const user = userData.user;
      myUid = user.id; try { localStorage.setItem('ss_last_role','rider'); } catch (_) {}
      ssAuthDone = true;
      void fetchMyCredit();

      const { data: profile } = await supabase
        .from('profiles')
        .select('name, bio, photo_url')
        .eq('id', user.id)
        .maybeSingle();

      // The signup trigger seeds profiles.name from the email prefix — a
      // non-blank name that still isn't a real name. Treat it as unset so the
      // driver never sees "justin.des.tang" on a request.
      ssLogTos(user.id);
      const emailLocal = (user.email || '').split('@')[0].toLowerCase();
      const name = (profile?.name || '').trim();
      const nameNeeded = !name || name.toLowerCase() === emailLocal || name.includes('@') || nameLooksLikeHandle(name); // '@' mirrors the server's GATE_NAME — without it a handle-name loops silently (audit P0)

      // Prune COMPLETED gates from the back trail (scan #4): Back must never
      // resurrect a consumed code screen or an already-verified phone step.
      stepTrail = stepTrail.filter((s) => {
        if (s === 'stEmail' || s === 'stCode') return false;            // signed in now
        if (s === 'stPhone' && user.phone_confirmed_at) return false;
        if (s === 'stProfile' && !nameNeeded && bioOk(profile?.bio) && profile?.photo_url) return false;
        return true;
      });

      // ONE profile gate (2026-09-02): name + bio + face photo together, then
      // phone, then seats. Google sign-ins arrive with a display name and a
      // picture in user_metadata — prefill the name, offer the photo.
      const meta = user.user_metadata || {};
      const profileNeeded = nameNeeded || !bioOk(profile?.bio) || !profile?.photo_url;
      const phoneNeeded = !user.phone_confirmed_at;
      currentPhotoUrl = profile?.photo_url || null;
      renderGatePick(profileNeeded, phoneNeeded);

      if (profileNeeded) {
        const metaName = String(meta.full_name || meta.name || '').trim();
        const metaLooksReal = metaName && metaName.includes(' ') && !metaName.includes('@');
        $('pfName').value = nameNeeded ? (metaLooksReal ? metaName : '') : name;
        $('pfBio').value = profile?.bio || '';
        updateBioCount();
        // Existing photo → show it; none → offer the Google one if there is one.
        const prev = $('photoPrev');
        if (currentPhotoUrl && !photoBlob) { prev.src = currentPhotoUrl; prev.classList.remove('hidden'); }
        const gUrl = !currentPhotoUrl && !photoBlob ? String(meta.avatar_url || meta.picture || '') : '';
        if (gUrl) {
          googlePhotoUrl = gUrl.replace(/=s\d+(-c)?$/, '=s512-c');
          $('googlePhotoImg').src = googlePhotoUrl;
          $('googlePhotoOffer').classList.remove('hidden');
        } else {
          $('googlePhotoOffer').classList.add('hidden');
        }
        show('stProfile');
        void renderEmailSection();
      } else if (phoneNeeded) {
        show('stPhone');
      } else {
        // Phone-only accounts have no email — never render "Signed in as ·".
        $('signedInEmail').textContent = user.email || user.phone || 'your account';
        $('signedIn').classList.remove('hidden');
        show('stSeats');
      }
    }

    // "Your pick · step N of M" on the gate screens: keep what they're buying
    // in view while they finish the profile (2026-09-02).
    let currentPhotoUrl = null, googlePhotoUrl = '';
    const escGate = (t) => String(t).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;" }[c]));
    function renderGatePick(profileNeeded, phoneNeeded) {
      const total = (profileNeeded ? 1 : 0) + (phoneNeeded ? 1 : 0);
      let pick = '';
      try {
        if (selectedSeats.length > 0) {
          const labels = selectedSeats.map((id) => { const st = seatById(id); return seatName(st ? (st.label || st.id) : id); });
          // Full price including fees (and any credit) — the same number the
          // seat summary and the Request button show (Justin, 2026-09-02).
          const t = computeTotals();
          pick = 'Your pick: <b>' + labels.map(escGate).join(', ') + '</b> · ' + (t ? fmt$(t.charge / 100) + ' total' : '');
        }
      } catch (_) { pick = ''; }
      const put = (id, stepNo) => {
        const el = $(id); if (!el) return;
        if (!pick && total < 2) { el.classList.add('hidden'); return; }
        el.innerHTML = (pick || 'Almost there') + (total > 1 ? '<span class="step">Step ' + stepNo + ' of ' + total + '</span>' : '');
        el.classList.remove('hidden');
      };
      put('gatePickProfile', 1);
      put('gatePickPhone', profileNeeded ? 2 : 1);
    }

    // ── Load ride ─────────────────────────────────────────────────────────
    // fresh:true bypasses the browser's HTTP cache (public-ride is cached
    // ~120s) — used after SEATS_TAKEN, where re-reading the cached response
    // would keep showing the just-taken seat as open.
    async function fetchRide(bearer, fresh) {
      // v=book: public-ride logs this as a booking-page view (0295), keyed to
      // the signed-in user when a JWT is sent, else to the salted IP hash.
      const r = await fetch(SUPA + '/functions/v1/public-ride?id=' + encodeURIComponent(rideId)
          + '&v=book' + (fresh ? '&fresh=' + Date.now() : ''),
        { headers: { apikey: ANON, Authorization: 'Bearer ' + (bearer || ANON) },
          cache: fresh ? 'reload' : 'default' });
      return r.json();
    }

    // Send the SIGNED-IN user's token when we have one, not the anon key:
    // public-ride answers `isOwnRide` only for an identified caller, which is
    // how this page learns the viewer is the driver BEFORE the seat picker
    // (Justin, 2026-09-08 — web let him walk to payment on his own ride).
    // Anonymous visitors keep the anon key and the old behaviour exactly.
    async function loadRide(fresh) {
      let bearer = ANON;
      try {
        const { data: sd } = await supabase.auth.getSession();
        if (sd && sd.session && sd.session.access_token) bearer = sd.session.access_token;
      } catch (_) { /* not signed in — anon key */ }
      return fetchRide(bearer, fresh);
    }

    // Waitlist (2026-08-28, app parity): ?waitlist=1 turns the full-ride dead
    // end into demand capture. Mirrors services/waitlist.ts joinWaitlist —
    // dupe insert = already on the list = success. notify-waitlist already
    // emails web users when a seat frees; only this join was missing.
    let waitlistMode = false;
    async function waitlistFlow() {
      $('rideCard').classList.add('hidden');
      const { data: sd } = await supabase.auth.getSession();
      const uid = sd && sd.session && sd.session.user ? sd.session.user.id : null;
      if (!uid) {
        $('goneTitle').textContent = 'This ride is full';
        $('goneSub').innerHTML = 'We’ll email you the moment a seat opens. ' +
          '<a href="#" id="wlSignIn" style="font-weight:700;">Sign in with your email to join the waitlist →</a>';
        show('stGone');
        const a = document.getElementById('wlSignIn');
        // waitlistMode: after sign-in the continuations must come BACK here
        // (scan #1 — route() knows nothing about waitlists and dumped the
        // signed-in visitor on an empty seat grid; the join never happened).
        if (a) a.addEventListener('click', (e) => { e.preventDefault(); waitlistMode = true; show('stEmail'); });
        return;
      }
      // A waitlist sign-in saw the same notice as a booking sign-in (bug
      // check 10/15: this path skipped route(), so it was never logged).
      ssLogTos(uid);
      const { error } = await supabase.from('ride_waitlist').insert({ ride_id: rideId, user_id: uid });
      if (error && !/duplicate|unique/i.test(error.message || '')) {
        $('goneTitle').textContent = 'This ride is full';
        $('goneSub').textContent = 'Every seat has been taken, and the waitlist did not respond. Refresh to try again.';
        show('stGone');
        return;
      }
      $('goneTitle').textContent = "You're on the list 🔔";
      $('goneSub').textContent = "We'll email you the moment a seat opens on this ride. No need to keep checking.";
      show('stGone');
      void offerAlternative();
    }

    // Full is not a dead end (Justin, 2026-09-17): a live ride within a day
    // whose route passes within 50 miles of this ride's start and then its end
    // (RPC alt_rides_for_full_ride, migration 0302) is offered under the
    // waitlist confirmation so the person can lock a seat in instead of
    // waiting. The join above stands either way; any error means no offer.
    const ALT_METRO = {
      sfba: 'San Francisco Bay Area', sanjose: 'San Jose', napasonoma: 'Napa / Sonoma', sacramento: 'Sacramento',
      tahoereno: 'Tahoe / Reno', la: 'Los Angeles', oc: 'Orange County', sd: 'San Diego', palm: 'Palm Springs',
      inlandempire: 'Riverside / Inland Empire', vegas: 'Las Vegas', manteca: 'Manteca', fresno: 'Fresno',
      santacruz: 'Santa Cruz', monterey: 'Monterey', bakersfield: 'Bakersfield', slo: 'San Luis Obispo',
      santabarbara: 'Santa Barbara', burningman: 'Burning Man', redding: 'Redding',
    };
    // Mapbox sometimes puts a REGION where the city belongs ("Westwood, The
    // Westside, California": Vladimir's rides 518 and 519, 2026-10-02), and the
    // last non-state part is then a district, not a city. Known Los Angeles
    // districts resolve to Los Angeles; other regional labels (South Bay, East
    // Bay, ...) step back to the part before them, or to nothing so the caller
    // falls back to the metro name. We go by city name (Justin).
    function ssPickCity(cleaned) {
      if (!cleaned || !cleaned.length) return '';
      var last = String(cleaned[cleaned.length - 1]);
      var key = last.toLowerCase().replace(/^the\s+/, '');
      var CITY = { 'westside': 'Los Angeles', 'san fernando valley': 'Los Angeles', 'valley': 'Los Angeles', 'south los angeles': 'Los Angeles', 'east los angeles': 'Los Angeles' };
      var SKIP = ['south bay', 'east bay', 'peninsula', 'silicon valley', 'north bay', 'inland empire', 'central valley', 'orange county', 'bay area', 'san francisco bay area', 'los angeles county', 'san diego county', 'wine country'];
      if (CITY[key]) return CITY[key];
      if (SKIP.indexOf(key) >= 0) return cleaned.length >= 2 ? String(cleaned[cleaned.length - 2]) : '';
      return last;
    }
    function altCity(area, fallback) {
      var parts = String(area || '').split(',').map(function (s) { return s.trim(); }).filter(function (s) {
        return s && !/^(california|nevada|ca|nv|usa|united states)(\s+\d{5})?$/i.test(s) && !/^\d{5}$/.test(s);
      });
      var city = ssPickCity(parts);
      return city && city.length <= 28 && !/\d/.test(city) ? city : fallback;
    }
    function altEsc(s) {
      return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function altWhen(depDate, depTime) {
      var day = String(depDate || '');
      var p = day.split('-').map(Number);
      var dt = new Date(Date.UTC(p[0], (p[1] || 1) - 1, p[2] || 1));
      if (isFinite(dt.getTime()) && p[0] > 2000) {
        day = dt.toLocaleDateString('en-US', { timeZone: 'UTC', weekday: 'short', month: 'numeric', day: 'numeric' });
      }
      var t = String(depTime || '').split(':').map(Number);
      if (!isFinite(t[0])) return day;
      var h12 = t[0] % 12 === 0 ? 12 : t[0] % 12;
      var mm = isFinite(t[1]) ? t[1] : 0;
      return day + ' at ' + h12 + ':' + (mm < 10 ? '0' : '') + mm + ' ' + (t[0] >= 12 ? 'PM' : 'AM');
    }
    async function offerAlternative() {
      try {
        // This card promises nothing about withdrawing a request, so it asks
        // for the plain one-day window (p_same_need false, migration 0334).
        // Before that migration the argument is unknown: retry the default.
        let { data, error } = await supabase.rpc('alt_rides_for_full_ride', { p_ride_id: rideId, p_same_need: false });
        if (error) ({ data, error } = await supabase.rpc('alt_rides_for_full_ride', { p_ride_id: rideId }));
        if (error || !Array.isArray(data) || !data.length) return;
        const a = data[0];
        const from = altCity(a.departure_area, ALT_METRO[a.from_dest] || a.from_dest);
        const to = altCity(a.arrival_area, ALT_METRO[a.to_dest] || a.to_dest);
        const seats = a.open_seats + ' seat' + (a.open_seats === 1 ? '' : 's') + ' open';
        // All-in like the marketplace: seat + service fee (5%, $2 minimum), whole
        // dollars, never the bare seat price (Justin, 2026-09-17).
        const seatCents = Math.round(Number(a.price_from) * 100);
        const feeCents = Math.max(Math.floor(seatCents * 0.05), 200);
        const price = a.price_from != null ? ', from $' + Math.ceil((seatCents + feeCents) / 100) : '';
        const more = data.length > 1 ? ' ' + (data.length - 1) + ' more like it on the marketplace.' : '';
        $('goneSub').innerHTML =
          "We'll email you if a seat opens. " +
          '<strong>' + altEsc(a.driver_name) + '</strong> is driving ' + altEsc(from) + ' to ' + altEsc(to) + ' ' +
          altEsc(altWhen(a.dep_date, a.dep_time)) + altEsc(price) + ', ' + altEsc(seats) + '. ' +
          '<a href="/book?id=' + encodeURIComponent(a.ride_id) + '" style="font-weight:700;">Lock that one in instead</a>.' +
          altEsc(more);
      } catch (_) { /* no offer */ }
    }

    // Backup request (Justin, 2026-10-02): a request is only a request. Right
    // after one goes in, the same matcher looks for another live ride within a
    // day and 50 miles of this one's route; a second ride from the SAME driver
    // is not a backup, so those rows are dropped. The server withdraws the
    // other pending request when one driver accepts, so the copy can promise
    // it. No match or any error = no block at all.
    async function offerBackup(rid) {
      try {
        if (!Number.isFinite(rid)) return;
        const { data, error } = await supabase.rpc('alt_rides_for_full_ride', { p_ride_id: rid });
        if (error || !Array.isArray(data)) return;
        const rows = data.filter(function (r) { return r && !r.same_driver; });
        if (!rows.length) return;
        const a = rows[0];
        const altId = Number(a.ride_id);
        if (!Number.isFinite(altId)) return;
        const from = altCity(a.departure_area, ALT_METRO[a.from_dest] || a.from_dest);
        const to = altCity(a.arrival_area, ALT_METRO[a.to_dest] || a.to_dest);
        const seats = a.open_seats + ' seat' + (a.open_seats === 1 ? '' : 's') + ' open';
        // All-in like the marketplace: seat + service fee (5%, $2 minimum), whole
        // dollars, never the bare seat price (Justin, 2026-09-17).
        const seatCents = Math.round(Number(a.price_from) * 100);
        const feeCents = Math.max(Math.floor(seatCents * 0.05), 200);
        const price = a.price_from != null ? ', from $' + Math.ceil((seatCents + feeCents) / 100) : '';
        const more = rows.length > 1 ? ' ' + (rows.length - 1) + ' more like it on the marketplace.' : '';
        const anchor = $('successSub');
        if (!anchor) return;
        const old = $('backupOffer');
        if (old) old.remove();
        const box = document.createElement('div');
        box.id = 'backupOffer';
        box.style.cssText = 'margin:-4px 0 18px;padding:14px 16px;border-radius:12px;background:var(--offer-bg);border:1px solid var(--teal-line-4);';
        const h = document.createElement('p');
        h.style.cssText = 'font-size:16px;font-weight:700;margin:0 0 6px;';
        h.textContent = 'Another ride goes your way';
        const body = document.createElement('p');
        body.className = 'sub';
        body.style.marginBottom = '10px';
        body.innerHTML =
          '<strong>' + altEsc(a.driver_name) + '</strong> is also driving ' + altEsc(from) + ' to ' + altEsc(to) + ' ' +
          altEsc(altWhen(a.dep_date, a.dep_time)) + altEsc(price) + ', with ' + altEsc(seats) + '. ' +
          'Request that one too and the first driver to accept is yours. We withdraw your other request automatically, so you are never charged twice.' +
          altEsc(more);
        const link = document.createElement('a');
        link.href = '/book?id=' + encodeURIComponent(String(altId));
        link.textContent = 'See that ride';
        link.style.cssText = 'font-weight:700;font-size:15px;color:var(--teal);text-decoration:none;';
        box.appendChild(h);
        box.appendChild(body);
        box.appendChild(link);
        anchor.insertAdjacentElement('afterend', box);
      } catch (_) { /* no block */ }
    }

    function showGone(kind) {
      $('rideCard').classList.add('hidden');
      if (kind === 'full') {
        if (qp.get('waitlist') === '1' && rideId) { void waitlistFlow(); return; }
        $('goneTitle').textContent = 'This ride is full';
        $('goneSub').innerHTML = 'Every seat has been taken. <a href="?id=' + encodeURIComponent(rideId) + '&waitlist=1" style="font-weight:700;">Join the waitlist</a> and we’ll email you if one opens.';
      } else if (kind === 'own_ride') {
        $('goneTitle').textContent = 'This is your ride';
        $('goneSub').innerHTML = 'You can’t book a seat on a ride you’re driving. <a href="/driving" style="font-weight:700;">Open your driving console</a> to manage seats and riders, or share the link to fill it.';
      } else if (kind === 'too_soon') {
        // Requests close 15 minutes before departure — the driver needs time
        // to answer. Distinct from an actual departure (sweep 2026-09-03).
        $('goneTitle').textContent = 'Too close to departure to request';
        $('goneSub').innerHTML = 'Requests close 15 minutes before a ride leaves so the driver has time to answer. <a href="/rides?web=1" style="font-weight:700;">See other rides on this route</a>.';
      } else if (kind === 'soon') {
        // Reachable only if the ride departs mid-session now that booking runs
        // right up to departure (2026-08-28) — so say what actually happened.
        $('goneTitle').textContent = 'This ride has just departed';
        $('goneSub').innerHTML = 'It left while you were booking. Drivers post new rides every day. <a href="/rides?web=1" style="font-weight:700;">See what’s live now</a>.';
      } else if (kind === 'offline') {
        // A failed fetch is NOT a cancelled ride (audit 8/28): telling a rider
        // on a flaky phone connection that the ride is gone kills a live sale.
        $('goneTitle').textContent = "Couldn't load this ride";
        $('goneSub').innerHTML = 'Check your connection and <a href="#" id="goneRetry" style="font-weight:700;">try again</a>.';
        show('stGone');
        var _gr = $('goneRetry');
        if (_gr) _gr.addEventListener('click', function (e) { e.preventDefault(); location.reload(); });
        return;
      } else {
        $('goneTitle').textContent = 'That ride is no longer available';
        $('goneSub').textContent = 'It was cancelled or has already left. Drivers post new rides every day.';
      }
      show('stGone');
    }

    // ── Seat picker ───────────────────────────────────────────────────────
    // ── Segment state (2026-08-28) — mirrors _shared/web-posting.ts
    //    segmentFactor/segmentSeatPriceUsd EXACTLY; the server recomputes the
    //    charge, this is display. ─────────────────────────────────────────
    let segBoardingId = null, segAlightingId = null, segLegUsd = null;
    function segHav(a, c) {
      if (!a || !c || !isFinite(a.lat)) return 0;
      const R = 3958.8, toRad = (d2) => (d2 * Math.PI) / 180;
      const dLat = toRad(c.lat - a.lat), dLng = toRad(c.lng - a.lng);
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a.lat)) * Math.cos(toRad(c.lat)) * Math.sin(dLng / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(h));
    }
    function segT(start, end, p) {
      const dx = end.lng - start.lng, dy = end.lat - start.lat;
      const len2 = dx * dx + dy * dy || 1;
      return ((p.lng - start.lng) * dx + (p.lat - start.lat) * dy) / len2;
    }
    function segStopById(id) { return (rideData.routeStops || []).find((s) => s.id === id) || null; }
    // ── Leg-aware seats (0356, 2026-10-05) ───────────────────────────────
    // On a leg-aware ride a seat is sold only between its rider's pickup and
    // drop-off. public-ride sends seatHolds [{seat, from, to}] in stop
    // positions (origin 0, a stop at route position pos is pos + 1, the
    // destination routeStopCount + 1) and each seat's closed flag. Elsewhere
    // the whole-ride avail flag decides, exactly as before.
    function legPos(id, fallback) {
      if (!id) return fallback;
      const st = segStopById(id);
      if (st && typeof st.pos === 'number') return st.pos + 1;
      const m = /^cust-(\d+)$/.exec(id);
      return m ? Number(m[1]) + 1 : fallback;
    }
    function seatOpenForLeg(s) {
      if (!rideData || !rideData.legAware) return s.avail !== false;
      if (s.closed === true) return false;
      const n = typeof rideData.routeStopCount === 'number' ? rideData.routeStopCount : (rideData.routeStops || []).length;
      const b = legPos(segBoardingId, 0), a = legPos(segAlightingId, n + 1);
      return !(rideData.seatHolds || []).some((h) => h.seat === s.id && h.from < a && b < h.to);
    }
    /** Anything bookable on this ride at all: a whole-ride seat, or (leg-aware)
     *  the open stretch public-ride found (openFrom). */
    function rideHasOpenSeat(d) {
      if (!d || !Array.isArray(d.seats)) return false;
      if (d.seats.some((s) => s.avail !== false) && d.seatsLeft !== 0) return true;
      return !!(d.legAware && d.openFrom);
    }
    function segPrice(fullUsd) {
      if (segLegUsd == null || !(fullUsd > 0)) return fullUsd;
      return Math.min(fullUsd, segLegUsd);
    }
    // Board / Get off draw their value in a wrapping span (.segval) under a
    // transparent <select>, so the span must follow the select. Setting
    // .value, rebuilding options or disabling one in code fires no "change",
    // so every such path ends here: initSegment (build, preselect, openFrom,
    // passed-stop move) and recomputeSegment (user changes via onchange, the
    // drop-off reset below, SEATS_TAKEN and INVALID_STOP recovery).
    function syncSegFields() {
      [['segBoard', 'segBoardVal'], ['segAlight', 'segAlightVal']].forEach(function (pair) {
        var sel = $(pair[0]), out = $(pair[1]);
        if (!sel || !out) return;
        var o = sel.selectedIndex >= 0 ? sel.options[sel.selectedIndex] : null;
        var t = o ? o.textContent : '';
        // Keep the time in one piece ("~12:20 AM (next day)") so a long
        // value breaks after the "·", never inside the time.
        var cut = t.lastIndexOf(' · ');
        out.textContent = cut >= 0 ? t.slice(0, cut + 3) + t.slice(cut + 3).split(' ').join(' ') : t;
      });
    }
    function recomputeSegment() {
      const start = rideData.approxStart, end = rideData.approxEnd;
      const b = segStopById(segBoardingId), a = segStopById(segAlightingId);
      segLegUsd = null;
      const note = $('segNote');
      if ((b || a) && start && end) {
        // Coordless stops (name-only / catalog drift) must not join the
        // projection: null coerces to 0 in segT and projects to the point
        // (0,0), which made ANY coordless boarding trip the "drop-off before
        // pickup" error (review finding #5). Mirror the server: no coords →
        // endpoint defaults, price never discounts.
        const hasC = (p) => p && typeof p.lat === 'number' && isFinite(p.lat)
          && typeof p.lng === 'number' && isFinite(p.lng);
        const tb = b && hasC(b) ? segT(start, end, b) : 0;
        const ta = a && hasC(a) ? segT(start, end, a) : 1;
        if (ta <= tb) {
          // Impossible order — reset the alighting side and say why.
          segAlightingId = null;
          $('segAlight').value = '';
          // Re-price for the RESET pair (audit P1): the server will bill the
          // driver-set board->end leg; showing full price here over-quotes.
          var spR = rideData.segmentPrices || null;
          var vR = spR ? spR[(segBoardingId || 'origin') + '|end'] : undefined;
          segLegUsd = typeof vR === 'number' && isFinite(vR) && vR > 0 ? Math.round(vR) : null;
          note.textContent = 'That drop-off comes before your pickup on the route, so it was reset to the final stop.';
          note.classList.remove('hidden');
        } else {
          // Driver-set leg price (0226): the driver priced this exact pair
          // at posting, or the leg costs the full seat price. Same lookup
          // the server bills with - display cannot drift from the charge.
          const sp = rideData.segmentPrices || null;
          const v = sp ? sp[(segBoardingId || 'origin') + '|' + (segAlightingId || 'end')] : undefined;
          segLegUsd = typeof v === 'number' && isFinite(v) && v > 0 ? Math.round(v) : null;
          // No bare leg price here (2026-10-12): it left out the booking fee
          // and sat under the all-in price line. The line above already
          // carries this leg's price, fees included.
          note.textContent = segLegUsd != null
            ? 'Partial trip. The driver set the price for this stretch, shown above.'
            : '';
          note.classList.toggle('hidden', segLegUsd == null);
        }
      } else {
        note.classList.add('hidden');
      }
      syncSegFields();
      renderSeats();
    }
    function initSegment() {
      const stops = rideData.routeStops || [];
      if (!stops.length || !rideData.approxStart || !rideData.approxEnd) return;
      const wrap = $('segWrap');
      const bSel = $('segBoard'), aSel = $('segAlight');
      bSel.innerHTML = ''; aSel.innerHTML = '';
      const opt = (sel, value, label) => {
        const o = document.createElement('option');
        o.value = value; o.textContent = label;
        sel.appendChild(o);
      };
      // Times: departure on the origin, the server's per-stop estimate on each
      // stop (public-ride `eta`, same math as the app chips and the pickup
      // reminders; timing sweep 2026-09-10). Estimates, confirmed in chat.
      const to12h = (t) => { const m = /^(\d{1,2}):(\d{2})/.exec(t || ''); if (!m) return ''; const h = Number(m[1]); return (h % 12 || 12) + ':' + m[2] + ' ' + (h >= 12 ? 'PM' : 'AM'); };
      const depLabel = to12h(rideData.depTime);
      // Option text is "Name · time" (2026-10-12): the "Board" / "Get off"
      // words now sit on each field's own label above the value.
      const withEta = (label, st) => label + (st.eta ? ' · ' + st.eta : '');
      // A pickup the car has already reached cannot be chosen (2026-10-06,
      // reversing 10/5: the ride stays bookable from later stops after it
      // leaves the origin). public-ride says which points are still ahead.
      const originOk = rideData.originBoardable !== false;
      const stopOk = (st) => st.boardable !== false;
      opt(bSel, '', (noState(rideData.fromArea) || 'Start') + (originOk ? (depLabel ? ' · ' + depLabel : '') : ' (departed)'));
      if (!originOk) bSel.options[bSel.options.length - 1].disabled = true;
      stops.forEach((st) => {
        if (!st.id) return;
        opt(bSel, st.id, stopOk(st) ? withEta(st.name, st) : st.name + ' (passed)');
        if (!stopOk(st)) bSel.options[bSel.options.length - 1].disabled = true;
      });
      stops.forEach((st) => { if (st.id) opt(aSel, st.id, withEta(st.name, st)); });
      opt(aSel, '', noState(rideData.toArea) || 'End');
      aSel.value = '';
      // Leg preselect from the search card (2026-09-08): ?board=<stopId>
      // &alight=<stopId>, forwarded by ride.html. Only ids that exist on THIS
      // ride are honoured; recomputeSegment re-validates order and prices the
      // pair exactly as the seat tiles and the server will.
      try {
        // A re-run (after SEATS_TAKEN) keeps the pair already chosen; the
        // rebuilt selects used to show the origin while the state, the tiles
        // and the request still carried the stop (bug check 2026-10-06).
        if (segBoardingId && segStopById(segBoardingId)) bSel.value = segBoardingId; else segBoardingId = null;
        if (segAlightingId && segStopById(segAlightingId)) aSel.value = segAlightingId; else segAlightingId = null;
        const pb = qp.get('board'), pa = qp.get('alight');
        if (!segBoardingId && pb && segStopById(pb)) { bSel.value = pb; segBoardingId = pb; }
        if (!segAlightingId && pa && segStopById(pa)) { aSel.value = pa; segAlightingId = pa; }
        // Leg-aware ride sold out from the start but open from a later stop
        // (0356): open on that stop, e.g. "Board: Los Angeles", instead of a
        // grid of Taken seats.
        if (!segBoardingId && rideData.legAware && rideData.openFrom && rideData.openFrom.stopId
            && segStopById(rideData.openFrom.stopId)
            && !(rideData.seats || []).some((s) => s.avail !== false)) {
          bSel.value = rideData.openFrom.stopId;
          segBoardingId = rideData.openFrom.stopId;
        }
        // Pickup behind the car (origin departed, or a passed stop chosen):
        // move to the first point still ahead, as public-ride worked it out.
        const chosen = segBoardingId ? segStopById(segBoardingId) : null;
        if ((segBoardingId ? !(chosen && stopOk(chosen)) : !originOk) && typeof rideData.boardableFromIndex === 'number') {
          const ahead = stops.find((st) => st.pos === rideData.boardableFromIndex - 1 && st.id);
          if (ahead) { bSel.value = ahead.id; segBoardingId = ahead.id; }
        }
        if (segBoardingId || segAlightingId) recomputeSegment();
      } catch (_) {}
      // Property handlers, not addEventListener: initSegment can run again
      // after SEATS_TAKEN, and stacked listeners recomputed twice per change.
      bSel.onchange = () => { segBoardingId = bSel.value || null; recomputeSegment(); };
      aSel.onchange = () => { segAlightingId = aSel.value || null; recomputeSegment(); };
      syncSegFields();
      wrap.classList.remove('hidden');
    }

    /** Rewrite every open tile's price from the current selection. Open tiles
     *  carry data-seat and a .sp price; taken and closed tiles show a word,
     *  never a price. Taken seats ALSO carry data-seat, so .taken is skipped
     *  explicitly: picking a seat used to repaint a closed tile's "Closed" as
     *  a price (seen on ride 559, 2026-10-12). */
    function refreshTilePrices() {
      var tiles = document.querySelectorAll('[data-seat]');
      for (var i = 0; i < tiles.length; i++) {
        var el = tiles[i];
        if (el.disabled || el.classList.contains('taken')) continue;
        var seat = seatById(el.dataset.seat);
        var sp = el.querySelector('.sp');
        if (seat && sp) sp.textContent = fmt$(tilePriceDollars(seat));
      }
    }

    // Seat names in sentence case on screen ("Rear Left" -> "Rear left").
    // Only plain capitalized words are lowered, so a driver's "VIP seat" or
    // "Seat 2" reads as written.
    function seatName(t) {
      return String(t == null ? '' : t).split(' ').map(function (w, i) {
        return i > 0 && /^[A-Z][a-z]+$/.test(w) ? w.toLowerCase() : w;
      }).join(' ');
    }
    // The status line on an open tile. Same words as the app's seat layout
    // (booking-sheet CLOSED_LABEL sub), except the front seat says "Open".
    // public-ride does not send `sub` today; a seat that carries one uses it.
    const SEAT_STATUS = { fp: 'Open', ml: 'Window', mr: 'Window', rl: 'Window', rc: 'Middle', rr: 'Window' };
    function seatStatus(s) {
      if (s.id !== 'fp' && typeof s.sub === 'string' && s.sub.trim()) return s.sub.trim().slice(0, 24);
      return SEAT_STATUS[s.id] || 'Open';
    }

    /** The price line under "Pick your seat", stated once instead of on every
     *  tile. Every number comes from tilePriceDollars(seat, true), the same
     *  function the tiles use, so it is what checkout charges for one seat
     *  for the current Board / Get off. If the open seats differ in price the
     *  tiles keep their own prices and the line reads "From $X". The flat
     *  processing fee (99c, per booking, inside a lone seat's tile price) is
     *  split out by name rather than folded into "per seat", because a
     *  second seat in the same booking does not pay it again. */
    function seatPriceLine() {
      var el = $('seatPriceLine'), grid = $('seatGrid');
      if (!el || !grid || !rideData) return;
      var seats = Array.isArray(rideData.seats) ? rideData.seats : [];
      var lo = null, hi = null, flat = 0, openCount = 0, firstP = null;
      for (var i = 0; i < seats.length; i++) {
        var s = seats[i];
        // Same "open" test as seatBtn.
        if (!(typeof s.price === 'number' && s.price > 0) || !seatOpenForLeg(s)) continue;
        var c = Math.round(tilePriceDollars(s, true) * 100);
        var p = Math.round(segPrice(s.price) * 100);
        flat = c - (p + serviceFeeCentsFor(p));
        openCount += 1;
        if (firstP === null) firstP = p;
        if (lo === null || c < lo) lo = c;
        if (hi === null || c > hi) hi = c;
      }
      if (lo === null) {
        // Nothing open for this stretch: no price to state; tiles say why.
        el.classList.add('hidden');
        grid.classList.remove('oneprice');
        return;
      }
      var one = lo === hi;
      grid.classList.toggle('oneprice', one);
      el.textContent = '';
      if (!one) el.appendChild(document.createTextNode('From '));
      // ONE seat, all in: the 99c processing fee included, so this matches
      // the ride page's "$20.99 per seat, all in" (bug check 2026-10-12; it
      // read "$20 per seat + $0.99 processing fee").
      var amt = document.createElement('b');
      amt.textContent = fmt$(lo / 100);
      el.appendChild(amt);
      el.appendChild(document.createTextNode(' per seat, all in'));
      // A second seat can cost less than the first: the $2 minimum fee and the
      // 99c processing fee are per BOOKING. With tile prices hidden, "$22 per
      // seat" next to a "$42" button for 2 seats read as a mistake, so say the
      // exact 2-seat total whenever it is less than double (bug check 10/12).
      if (one && openCount >= 2 && firstP !== null) {
        var twoC = 2 * firstP + serviceFeeCentsFor(2 * firstP) + (flat > 0 ? flat : 0);
        if (twoC < 2 * lo) el.appendChild(document.createTextNode(' (2 seats: ' + fmt$(twoC / 100) + ')'));
      }
      el.classList.remove('hidden');
    }

    function seatBtn(s) {
      const btn = document.createElement('button');
      btn.type = 'button';
      const priced = typeof s.price === 'number' && s.price > 0;
      const open = seatOpenForLeg(s) && priced;
      btn.className = 'seat' + (open ? '' : ' taken');
      btn.dataset.seat = s.id;
      // textContent, never innerHTML: seat label/id come from the DRIVER's
      // rides.seats JSON (any app user controls their own), so a markup
      // label here would be stored XSS running with the rider's session.
      // (2026-08-20)
      var labelSpan = document.createElement('span');
      labelSpan.className = 'sn';
      labelSpan.textContent = seatName(s.label || s.id);
      // Status line: "Open" / "Window" / "Middle" on an open seat.
      // Booked-by-a-rider says "Taken"; a seat the driver closed (comfort
      // seat) says "Closed" — different facts (Justin, 2026-08-28). booked is
      // new in the payload: only an explicit false means closed, so a cached
      // pre-field payload still reads "Taken".
      var stateSpan = document.createElement('span');
      stateSpan.className = 'seatst';
      stateSpan.textContent = open
        ? seatStatus(s)
        : (rideData && rideData.legAware
          ? (s.closed === true ? 'Closed' : 'Taken')
          : (s.booked === false ? 'Closed' : 'Taken'));
      btn.appendChild(labelSpan);
      // Price span on open seats only. CSS shows it instead of the status
      // when the open seats differ in price (#seatGrid without .oneprice).
      if (open) {
        var priceSpan = document.createElement('span');
        priceSpan.className = 'sp';
        priceSpan.textContent = fmt$(tilePriceDollars(s));
        btn.appendChild(priceSpan);
      }
      btn.appendChild(stateSpan);
      if (open) {
        btn.addEventListener('click', () => {
          const i = selectedSeats.indexOf(s.id);
          if (i >= 0) selectedSeats.splice(i, 1); else selectedSeats.push(s.id);
          btn.classList.toggle('sel', i < 0);
          // Marginal prices depend on what else is selected, so every OTHER
          // tile's number changes when this one is picked: the first seat
          // carries the per-booking minimum, the second does not. Repaint the
          // labels in place (never the whole grid, which would drop the DOM
          // nodes and the selection styling we just set).
          refreshTilePrices();
          updateSummary();
