  .card.tripcard { padding: 14px 16px; margin-bottom: 16px; }
  .tripsum { display: flex; align-items: center; gap: 12px; }
  .tripav { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: 50% 25%; flex: none; background: var(--bg); }
  .tripsum-text { flex: 1; min-width: 0; }
  .tripcard .route { font-size: 17px; font-weight: 700; letter-spacing: -0.2px; line-height: 1.3; color: var(--text); }
  .tripcard .meta { font-size: 14px; color: var(--sub); margin-top: 2px; line-height: 1.4; }
  .tripcard .tripx { font-size: 12.5px; color: var(--cap); margin-top: 3px; line-height: 1.4; }

  /* One price line under "Pick your seat". The amount is white, never teal. */
  .priceline { font-size: 16px; color: var(--sub); line-height: 1.4; margin: 0 0 12px; }
  .priceline b { color: var(--text); font-weight: 800; }

  /* Board / Get off: a labeled field whose value WRAPS (a long stop such as
     "Santa Nella / Los Banos · ~11:25 PM" must never be cut off). The real
     <select> is a transparent overlay covering the whole field: a tap or
     click anywhere opens it, it keeps keyboard focus and its label for screen
     readers, and the wrapper shows the focus ring. The visible text is
     .segval, kept equal to the selected option by syncSegFields(). */
  .segq { font-size: 14px; color: var(--cap); margin: 4px 0 8px; }
  .segfield { position: relative; margin: 0 0 10px; padding: 28px 44px 11px 16px; background: var(--field); border: 1px solid var(--line-2); border-radius: 14px; transition: border-color 0.15s, box-shadow 0.15s; }
  .segfield:focus-within { border-color: var(--teal); box-shadow: 0 0 0 1px var(--teal); }
  label.segk { position: absolute; left: 16px; top: 10px; margin: 0; font-size: 12.5px; line-height: 1; color: var(--field-label); pointer-events: none; }
  .segval { display: block; min-height: 1.3em; font-size: 16.5px; font-weight: 700; line-height: 1.3; color: var(--text); overflow-wrap: anywhere; }
  .segfield select {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; margin: 0; padding: 0 16px;
    -webkit-appearance: none; appearance: none; opacity: 0; z-index: 1; cursor: pointer;
    border: 0; border-radius: 13px; background: var(--field); color: var(--text);
    font-size: 16px; /* 16px keeps iOS from zooming the page on focus */
  }
  .segfield select option { background: var(--surface); color: var(--text); font-weight: 500; }
  .segfield select option:disabled { color: var(--cap); }
  .segchev { position: absolute; right: 16px; top: 50%; width: 18px; height: 18px; margin-top: -9px; color: var(--cap); pointer-events: none; }
  #segNote { color: var(--sub); line-height: 1.45; }

  /* Seat tiles: seat name + a status line (Open / Window / Middle / Closed).
     The price shows on a tile only when this ride's open seats differ in
     price (#seatGrid without .oneprice). */
  .seat .sn { display: block; font-weight: 700; line-height: 1.2; }
  .seat .seatst { display: block; font-size: 12px; font-weight: 600; color: var(--cap); margin-top: 3px; line-height: 1.2; }
  .seat.sel .seatst { color: var(--sel-cap); }
  #seatGrid.oneprice .seat .sp { display: none; }
  #seatGrid:not(.oneprice) .seat:not(.taken) .seatst { display: none; }
  .carshell .seat { min-height: 74px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 10px 4px; }
  .carshell .seat .sn { font-size: 15px; }

  /* Laptop layout (2026-10-12, founder: the page was "still geared more
     towards mobile vertical" on a laptop). Nothing here applies under
     960px. From 960px .wrap widens to 1080px (the shared app bar aligns its
     inner column to .wrap's max-width, so the wordmark lines up with the
     content) and lays its children on a grid:
     - single-task steps (sign-in, codes, profile, phone, unavailable,
       waitlist, redirect, finalizing, success, cancelled) sit in ONE
       centered 560px column;
     - while the seat picker shows, the grid becomes a checkout: trip,
       Back and the picker on the left, a sticky summary card (total, promo,
       cancellation policy, Request) on the right, same columns as /ride.
     The switch reads the picker's own visibility with :has(), so no script
     decides the layout; a browser without :has() keeps the centered
     column. Same nodes, ids and handlers either way. */
  @media (min-width: 960px) {
    .wrap { max-width: 1080px; display: grid; grid-template-columns: minmax(0, 560px); justify-content: center; align-content: start; }
    .wrap:not(:has(> #stSeats:not(.hidden))) { padding-top: 24px; }
    .wrap:has(> #stSeats:not(.hidden)) { grid-template-columns: minmax(0, 1fr) 360px; column-gap: 36px; justify-content: stretch; align-items: start; }
    .wrap:has(> #stSeats:not(.hidden)) > #rideCard { grid-column: 1; grid-row: 1; }
    .wrap:has(> #stSeats:not(.hidden)) > #backRow { grid-column: 1; grid-row: 2; }
    .wrap:has(> #stSeats:not(.hidden)) > #stSeats { display: contents; }
    .wrap:has(> #stSeats:not(.hidden)) .bookmain,
    .wrap:has(> #stSeats:not(.hidden)) .bookside {
      min-width: 0; margin-bottom: 20px; padding: 28px;
      background: var(--surface); border: 1px solid var(--line); border-radius: 18px;
    }
    .wrap:has(> #stSeats:not(.hidden)) .bookmain { grid-column: 1; grid-row: 3; }
    .wrap:has(> #stSeats:not(.hidden)) .bookside { grid-column: 2; grid-row: 1 / span 3; position: sticky; top: 86px; padding: 24px; }
    .wrap:has(> #stSeats:not(.hidden)) .bookside > .hint { margin-bottom: 0; }
    .wrap:has(> #stSeats:not(.hidden)) > .legal { grid-column: 1 / -1; grid-row: 4; }
    .wrap:has(> #stSeats:not(.hidden)) .bookmain h1 { font-size: 26px; }
    .wrap:has(> #stSeats:not(.hidden)) .tripcard .route { font-size: 19px; }
    .wrap:has(> #stSeats:not(.hidden)) .carwrap { width: 270px; margin-top: 16px; }
  }
  /* Board and Get off side by side once each field has room for a long
     stop name on two lines. */
  @media (min-width: 1100px) {
    .wrap:has(> #stSeats:not(.hidden)) #segWrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 12px; }
    .wrap:has(> #stSeats:not(.hidden)) #segWrap > .segq,
    .wrap:has(> #stSeats:not(.hidden)) #segWrap > #segNote { grid-column: 1 / -1; }
  }

  /* Shared widgets that bring their own dark colors and are drawn on this
     page: the Google / Apple sign-in block (js/ss-oauth.js), the promo-code
     message ss-session.js paints inline, and the rate-your-trip sheet
     (js/ss-rating-gate.js). Light-only overrides from this page; dark keeps
     the modules' own styles untouched. Drop these once those modules read
     the theme tokens themselves. The Google button is already white and the
     Apple button stays black (Apple's guideline allows black on light). */
  @media (prefers-color-scheme: light) {
    #oauthMount .ss-oauth-msg { color: var(--cap); }
    #oauthMount .ss-oauth-msg.err { color: var(--err); }
    #oauthMount .ss-oauth-or { color: var(--cap); }
    #oauthMount .ss-oauth-or::before, #oauthMount .ss-oauth-or::after { background: var(--line-2); }
    #webCodeMsg.msg.ok { color: var(--ok) !important; }
    #webCodeMsg.msg.err { color: var(--err) !important; }
    body .ssrg-card { background: var(--surface); color: var(--text); border-color: var(--line); }
    body .ssrg-eyebrow { color: var(--teal); }
    body .ssrg-route { color: var(--sub); }
    body .ssrg-star { color: var(--car-line); }
    body .ssrg-star.on { color: var(--teal); }
    body .ssrg-star:focus-visible { outline-color: var(--teal); }
    body .ssrg-note { background: var(--field); color: var(--text); border-color: var(--line-2); }
    body .ssrg-note:focus { border-color: var(--teal); }
    body .ssrg-msg { color: var(--err); }
    body .ssrg-later { color: var(--sub); }
    body .ssrg-later:hover { color: var(--text); }
    body .ssrg-count { color: var(--cap); }
  }
</style>
</head>
<body>
  <!-- Shared console app bar for signed-in riders (2026-09-03): Trips /
       Messages / Find a ride are one tap away from checkout. No-op signed out. -->
  <script src="/js/ss-appbar.js"></script>
  <script>
    // Mounted once .wrap exists: mount() measures that column to size the
    // bar, and this script sits above it (audit 2026-09-04).
    document.addEventListener('DOMContentLoaded', function () {
      if (!window.SS_APPBAR) return;
      var bar = SS_APPBAR.mount({ active: 'rides' });
      // The bar now mounts for signed-out visitors too; keep this page's own
      // "← Back to rides" row for them (the console tabs replace it only
      // when signed in).
      if (bar && SS_APPBAR.signedIn()) {
        var b = document.querySelector('.wrap > .brand');
        if (b) b.style.display = 'none';
      }
    });
  </script>
  <div class="wrap">
    <!-- The shared app bar carries the logo and tabs; the page's own second
         logo and "Back to rides" pill came out 2026-09-16 (three navigation
         elements before the content). The one back link is #backRow. -->
    <span id="bookNav" style="display:none;align-items:center;"></span>

    <!-- Persistent ride summary — stays visible above every booking step so
         the visitor never loses sight of what they're booking. -->
    <!-- Compact row (2026-10-12): driver photo, route, then one grey line
         (when · driver, verified); rating, trips and preferences sit in a
         small caption under it (#rideDriver) when the ride has any. -->
    <div class="card tripcard hidden" id="rideCard">
      <div class="tripsum">
        <img id="rideAvatar" class="tripav hidden" alt="" width="44" height="44" decoding="async" />
        <div class="tripsum-text">
          <div class="route" id="rideRoute"></div>
          <div class="meta" id="rideMeta"></div>
          <div class="tripx hidden" id="rideDriver"></div>
        </div>
      </div>
    </div>

    <!-- ── STATES ─────────────────────────────────────────────────────── -->

    <!-- Loading -->
    <div id="backRow" class="hidden" style="margin:0 0 10px;">
      <button type="button" class="linkbtn" id="backBtn">&larr; Back</button>
    </div>

    <div class="card center" id="stLoading">
      <div class="spinner"></div>
      <h1>Loading ride…</h1>
      <p class="sub" style="margin-bottom:0;">One moment while we fetch the details.</p>
    </div>

    <!-- Ride gone / full / departs too soon -->
    <div class="card center hidden" id="stGone">
      <h1 id="goneTitle">That ride is no longer available</h1>
      <p class="sub" id="goneSub">It was cancelled or has already left. Drivers post new rides every day.</p>
      <a class="store-badge" href="/rides?web=1" style="justify-content:center;" aria-label="Browse current rides">
        <div class="label"><span class="big">See current rides</span></div>
      </a>
      <p class="sub" style="margin:14px 0 0;">or <a href="https://seatsherpa.onelink.me/cGHs?pid=web&c=book">get the app</a></p>
    </div>

    <!-- Online booking not available for this ride (public-ride predates the
         seats payload — should clear itself on the next deploy). -->
    <!-- Web first (2026-10-03): this used to say "Book this ride in the app",
         a dead end for a rider with no app. The cause is on our side and
         clears itself, so the way forward is a retry, with support behind it;
         the app is a quiet extra, never the instruction. -->
    <div class="card center hidden" id="stAppOnly">
      <h1>This ride can't be booked here right now</h1>
      <p class="sub">Something on our side is out of date. Try again in a minute. If it keeps happening, email <a href="mailto:support@seatsherpa.app">support@seatsherpa.app</a> and we will sort it out.</p>
      <button class="primary" type="button" onclick="location.reload()">Try again</button>
      <p class="hint" style="margin-top:14px;">Seat Sherpa is also on the <a href="https://seatsherpa.onelink.me/cGHs?pid=web&c=book">App Store and Google Play</a>.</p>
    </div>

    <!-- STEP: email (+ Google/Apple via js/ss-oauth.js) -->
    <div class="card hidden" id="stEmail">
      <h1>Sign in to book your seat</h1>
      <div id="oauthMount" style="margin-top:14px;"></div>
      <p class="sub">We'll email you a sign-in code. No password needed.</p>
      <label for="email">Email</label>
      <input id="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" />
      <button class="primary" id="emailBtn">Email me a code</button>
      <div class="msg err hidden" id="emailMsg"></div>
      <p data-tos-notice class="hint" style="margin-top:12px;">By continuing you agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
    </div>

    <!-- STEP: email code -->
    <div class="card hidden" id="stCode">
      <h1>Enter the code we emailed you</h1>
      <p class="sub">Sent to <strong id="codeEmailEcho"></strong>. It can take a minute, and it may land in spam.</p>
      <input id="emailCode" class="codeinput" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder="••••••" />
      <button class="primary" id="codeBtn">Verify</button>
      <div class="rowlinks">
        <button class="linkbtn" id="codeResend">Resend code</button>
        <button class="linkbtn" id="codeChangeEmail">Use a different email</button>
      </div>
      <div class="msg err hidden" id="codeMsg"></div>
    </div>

    <!-- STEP: profile — name + bio + face photo on ONE screen (2026-09-02).
         Google sign-ins get their name prefilled and a one-tap "Use my Google
         photo" (face-checked like any upload); phones get a direct selfie
         button next to the file picker. -->
    <div class="card hidden" id="stProfile">
      <div class="gate-pick hidden" id="gatePickProfile"></div>
      <h1>Tell the driver who you are</h1>
      <p class="sub">Your name, a few words, and a photo of your face are what the driver sees.</p>

      <div class="photo-row">
        <img id="photoPrev" class="avatar-prev hidden" alt="Your photo" />
        <div id="googlePhotoOffer" class="google-offer hidden">
          <img id="googlePhotoImg" alt="Your Google photo" />
          <div>
            <div class="google-offer-title">Use your Google photo?</div>
            <div class="google-offer-sub">Your driver just needs to recognize you.</div>
            <button type="button" class="primary small" id="googlePhotoUse">Use this photo</button>
          </div>
        </div>
        <div class="photo-btns">
          <label class="filebtn" for="photoSelfie" id="photoSelfieLabel">Take a selfie</label>
          <input id="photoSelfie" type="file" accept="image/*" capture="user" class="hidden" />
          <label class="filebtn" for="photoFile" id="photoFileLabel">Choose a photo</label>
          <input id="photoFile" type="file" accept="image/*" class="hidden" />
        </div>
        <div class="msg err hidden" id="photoMsg"></div>
      </div>

      <label for="pfName">Your name</label>
      <input id="pfName" type="text" autocomplete="name" placeholder="First Last" />
      <label for="pfBio">A few words about you</label>
      <p class="sub" style="margin:0 0 8px;font-size:14px;">No phone numbers or emails. You'll chat in Seat Sherpa once booked.</p>
      <textarea id="pfBio" maxlength="500" placeholder="e.g. Grad student heading home for the weekend. Quiet rider, one small bag."></textarea>
      <p class="hint"><span id="bioCount">0</span> / 3 words minimum</p>
      <div class="profsec hidden" id="secEmail">
        <div class="profhead"><span class="profst" id="stEmailOk">○</span><strong>Email for confirmations</strong></div>
        <p class="hint">Confirmations and pickup details go here. We'll send a link to confirm it.</p>
        <input id="acctEmail" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" />
        <button class="primary" id="acctEmailBtn">Save email</button>
        <div class="msg err hidden" id="acctEmailMsg"></div>
      </div>
      <button class="primary" id="profileBtn">Continue</button>
      <div class="msg err hidden" id="profileMsg"></div>
    </div>

    <!-- STEP: phone -->
    <div class="card hidden" id="stPhone">
      <div class="gate-pick hidden" id="gatePickPhone"></div>
      <h1>Verify your phone</h1>
      <p class="sub">So your driver can reach you on ride day. Your number stays private until 24 hours before departure. We'll text you a 6-digit code.</p>
      <div id="phoneEntry">
        <div style="display:flex; gap:10px;">
          <div style="width:88px;">
            <label for="phoneCc">Country</label>
            <input id="phoneCc" type="tel" inputmode="numeric" value="1" maxlength="4" style="text-align:center;" />
          </div>
          <div style="flex:1;">
            <label for="phoneNum">Phone number</label>
            <input id="phoneNum" type="tel" autocomplete="tel-national" inputmode="tel" placeholder="555 123 4567" />
          </div>
        </div>
        <button class="primary" id="phoneSendBtn">Text me a code</button>
      </div>
      <div id="phoneCodeEntry" class="hidden" style="margin-top:14px;">
        <label for="phoneCode">6-digit code</label>
        <input id="phoneCode" class="codeinput" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="••••••" />
        <button class="primary" id="phoneVerifyBtn">Verify phone</button>
        <div class="rowlinks">
          <button class="linkbtn" id="phoneResend">Resend code</button>
          <button class="linkbtn" id="phoneChange">Change number</button>
        </div>
      </div>
      <div class="msg err hidden" id="phoneMsg"></div>
    </div>


    <!-- STEP: seat pick -->
    <!-- Two plain wrappers (2026-10-12): on phones they are ordinary blocks
         and the card reads as one column, exactly as before. From 960px the
         card dissolves (display: contents) and .bookmain / .bookside become
         the left column and the sticky right summary card of the checkout. -->
    <div class="card hidden" id="stSeats">
      <div class="bookmain">
      <h1>Pick your seat</h1>
      <!-- The price, stated once (2026-10-12): written by seatPriceLine()
           from tilePriceDollars, the same number the tiles used to carry. -->
      <p class="priceline hidden" id="seatPriceLine"></p>
      <!-- Segment booking (2026-08-28): board/alight at a route-fill stop —
           the price prorates to the share of the trip you ride. Hidden unless
           the ride has stops. -->
      <div id="segWrap" class="hidden" style="margin-bottom:14px;" role="group" aria-labelledby="segQ">
        <p class="segq" id="segQ">Where are you riding?</p>
        <!-- .segval shows the selected option and wraps; the select on top is
             transparent but real (focus, keyboard, screen readers). -->
        <div class="segfield">
          <label class="segk" for="segBoard">Board</label>
          <span class="segval" id="segBoardVal" aria-hidden="true"></span>
          <select id="segBoard"></select>
          <svg class="segchev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </div>
        <div class="segfield">
          <label class="segk" for="segAlight">Get off</label>
          <span class="segval" id="segAlightVal" aria-hidden="true"></span>
          <select id="segAlight"></select>
          <svg class="segchev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </div>
        <div class="sub hidden" id="segNote" style="margin:8px 0 0;font-size:14px;"></div>
      </div>
      <div class="seatgrid" id="seatGrid"></div>
      <label for="drvMsg" id="drvMsgLabel">Message to the driver (optional)</label>
      <textarea id="drvMsg" maxlength="300" style="min-height:64px;" placeholder="e.g. Hi! I can meet anywhere near downtown."></textarea>
      </div>
      <div class="bookside">
      <div id="priceSummary" class="hidden">
        <div class="sumline"><span id="sumSeatsLabel">Seats</span><span id="sumSeats"></span></div>
        <!-- "Booking fee" with an info toggle, never a derived rate in the label
             (Justin, 2026-09-10: "(18%)" on an $11 seat, "($2.00 min)"). The
             flat 99¢ line below is "Processing fee" so the two never share a name. -->
        <div class="sumline"><span id="sumFeeLabel">Booking fee <button type="button" class="infobtn" id="feeInfoBtn" aria-label="About the booking fee" aria-controls="feeInfo" aria-expanded="false">i</button></span><span id="sumFee"></span></div>
        <p class="hint hidden" id="feeInfo" style="margin:2px 0 10px;"></p>
        <div class="sumline hidden" id="sumBookingFeeRow"><span>Processing fee</span><span id="sumBookingFee"></span></div>
        <div class="sumline hidden" id="sumCreditRow" style="color:var(--ok);"><span>Ride credit</span><span id="sumCredit"></span></div>
        <div class="sumline total"><span>Estimated total</span><span id="sumTotal"></span></div>
        <p class="hint" style="margin:8px 0 14px;">Exact total shown at secure checkout.</p>
        <p class="hint hidden" id="instantNote" style="margin:-6px 0 14px;">This ride is instant-book in the app. In the browser the driver confirms your request, usually within the hour; your card is only charged when they do.</p>
        <!-- Typed code at checkout (2026-09-03): applying one refreshes the
             credit line above. Same applier as sign-in and the account page. -->
        <details id="codeBox" style="margin:0 0 14px;">
          <summary style="cursor:pointer;font-size:14px;color:var(--teal);">Have an invite or promo code?</summary>
          <div style="display:flex;gap:8px;margin-top:10px;">
            <input id="webCode" placeholder="e.g. TAYLOR5" autocapitalize="characters" autocomplete="off" maxlength="12" style="flex:1;min-width:0;" />
            <button class="outline muted" id="webCodeBtn" type="button" style="width:auto;padding:0 18px;margin:0;">Apply</button>
          </div>
          <div class="msg hidden" id="webCodeMsg" style="font-size:14px;margin-top:8px;"></div>
        </details>
        <!-- Cancellation terms BEFORE money (benchmark 8/26) — copy matches
             trips.html's POLICY_DETAILS so pre- and post-booking never
             disagree. Populated from public-ride's cancellationPolicy. -->
        <details id="policyBox" style="margin:0 0 14px;">
          <summary style="cursor:pointer;font-size:14px;color:var(--teal);">Cancellation policy</summary>
          <ul id="policyList" style="margin:8px 0 0 18px;font-size:14px;color:var(--policy);line-height:1.6;"></ul>
        </details>
      </div>
      <button class="primary" id="bookBtn" disabled>Pick a seat to continue</button>
      <!-- Terms 3.2 disclosure (2026-10-14), shown where the card is
           authorized, in ONE line with the "only charged if accepted"
           reassurance so that promise is never absolute (bug check 10/14).
           "Booking fee" is the receipt's own label. Mirrors the app dock. -->
      <p class="hint" style="margin-top:10px; text-align:center;">You're only charged if the driver accepts. If you and the driver agree to pay outside Seat Sherpa instead, the booking fee is still charged (<a href="/terms#off-service-payment">Terms 3.2</a>). Payment is handled by Stripe.</p>
      <div class="msg err hidden" id="bookMsg"></div>
      <div class="signedin hidden" id="signedIn">Signed in as <span id="signedInEmail"></span> · <button class="linkbtn" id="signOutBtn">Not you?</button></div>
      </div>
    </div>

    <!-- Redirecting to Stripe -->
    <div class="card center hidden" id="stRedirect">
      <div class="spinner"></div>
      <h1>Taking you to secure checkout…</h1>
      <p class="sub" style="margin-bottom:0;">Payment is handled by Stripe. The seat is only charged if the driver accepts.</p>
    </div>

    <!-- Returned from Stripe: finalizing → request sent -->
    <div class="card center hidden" id="stFinalizing">
      <div class="spinner"></div>
      <h1>Finalizing your payment…</h1>
      <p class="sub" style="margin-bottom:0;">This usually takes a few seconds.</p>
    </div>

    <div class="card center hidden" id="stSuccess">
      <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color:var(--teal);" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></div>
      <h1 id="successTitle">Your request is in</h1>
      <div class="refcode hidden" id="successRef"></div>
      <p class="sub" id="successSub">The driver has been notified. Your card is only charged when they accept, and we'll email you as soon as they respond.</p>
      <!-- Web-first (2026-08-28): a web booker's home is the browser console,
           not the app stores. Soft app line only. -->
      <!-- One filled button (primary-action audit, Justin 2026-09-05):
           messaging the driver is what improves the trip, so it's the fill;
           My trips is a link. Emoji dropped per the design rules. -->
      <a class="primary" id="successMsgBtn" href="/messages" style="display:block;text-align:center;text-decoration:none;padding:15px;border-radius:12px;background:var(--teal-fill);color:var(--on-teal);font-weight:700;font-size:16px;">Message the driver</a>
