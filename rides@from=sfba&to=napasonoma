<script>
// /rides is BOTH a public marketing page and the signed-in marketplace, so
// the header depends on who's looking:
//   signed out — keep the marketing nav (wordmark + "Sign in")
//   signed in  — swap in the shared console app bar, so browsing rides sits
//                in the same chrome as Trips/Driving/Messages instead of
//                dropping you out of the console (Justin, 2026-08-28).
try {
  if (window.SS_APPBAR && SS_APPBAR.signedIn()) {
    SS_APPBAR.mount({
      active: 'rides',
      // Replaces the marketing <nav> outright.
      mountTo: document.querySelector('nav'),
      // Align to the CONTENT column, not the nav's own .wrap — that one is
      // being replaced and would measure wrong.
      alignTo: document.querySelector('body > .wrap'),
    });
  }
} catch (_) { /* the marketing nav is a fine fallback */ }
</script>
