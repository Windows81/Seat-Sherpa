      try{var raw=localStorage.getItem('sb-vmfmbntacifqoqxqxgsk-auth-token');if(raw)tok=(JSON.parse(raw)||{}).access_token||null;}catch(_){}
      if(!tok||!rides.length)return;
      var ids=rides.map(function(r){return Number(r.id);}).filter(function(n){return isFinite(n)&&n>0;}).slice(0,200);
      fetch(SUPA+'/functions/v1/web-preferred-rides',{method:'POST',headers:{apikey:ANON,Authorization:'Bearer '+tok,'Content-Type':'application/json'},body:JSON.stringify({rideIds:ids})})
        .then(function(r){return r.ok?r.json():null;})
        .then(function(d){
          var got=(d&&d.rideIds)||[];
          if(!got.length)return;
          got.forEach(function(id){preferredRideIds[String(id)]=true;});
          if(allRides===rides)renderRides(); // a newer search already replaced this list
        }).catch(function(){});
    }catch(_){}
  }
  // Booking-intent signal: fires when someone taps a ride to open it. Filter
  // this event by Desktop in Vercel Analytics to size web-checkout demand.
  list.addEventListener('click',function(e){ if(e.target.closest('.ride')) window.va('event',{name:'ride_click'}); });
  fromS.onchange=load; toS.onchange=load;
  document.getElementById('swap').onclick=function(){var a=fromS.value;fromS.value=toS.value;toS.value=a;load();};
  load();
})();
</script>
