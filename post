      $('priceCapLine').classList.toggle('hidden', !atCap);
      // Split line updates BEFORE the atCap early-return — it used to freeze
      // at the cap−$1 numbers when stepping onto the cap (Fable audit #6).
      {
        const seatCents = cur.priceUsd * 100;
        const driverUsd = (seatCents - Math.floor(seatCents * 500 / 10000)) / 100;
        $('priceSplit').textContent = 'You keep $' + driverUsd.toFixed(2);
      }
      // Color-coded price + feedback (2026-08-28, BlaBlaCar-style): green in
      // the suggested band = "you'll fill fast"; red above it = honest
      // warning that riders will find cheaper seats.
      if (resp && resp.low_cents && resp.high_cents) {
        // Band width capped at $10 (Justin, 2026-08-28): "Suggested $16–$55"
        // reads as no guidance at all — a tight band anchors. Slide the $10
        // window to bracket the suggested price so the default opens green.
        // The server's band is the distance band (Justin, 2026-09-04: <50mi
        // $10–12, 50–100 $12–20, 100–200 $15–30, 200+ $25–40) — show it as
        // is, clipped to this trip's cap. (The 9/1 sliding-width logic went
        // with the old cost-basis suggestion.)
        const lo = Math.max(FLOOR, Math.min(Math.round(resp.low_cents / 100), priceCap));
        const hi = Math.max(lo, Math.min(Math.round(resp.high_cents / 100), priceCap));
        const hint = $('priceHint');
        if (cur.priceUsd <= hi) {
          $('priceVal').style.color = '#4ade80';
          hint.textContent = "You'll get riders in no time.";
          hint.style.color = '#4ade80';
        } else {
          $('priceVal').style.color = '#ff8a8a';
