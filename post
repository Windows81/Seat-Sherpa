        return;
      }
      btn.disabled = false; btn.textContent = 'Continue';
      await publishAll();
    });

    // ── Publish ───────────────────────────────────────────────────────────
    function legPayload(leg) {
      return {
        fromAddress: leg.fromAddress,
        toAddress: leg.toAddress,
        startLat: leg.start.lat, startLng: leg.start.lng,
        endLat: leg.end.lat, endLng: leg.end.lng,
        // Measured just before publish (drivingRoute); null = server fallback.
        roadMiles: leg.roadMiles != null ? leg.roadMiles : null,
        roadMinutes: leg.roadMinutes != null ? leg.roadMinutes : null,
        // The road the driver actually chose, as an encoded polyline, so the
        // ride page can draw the real shape instead of an A→B straight line
        // (Justin, 2026-08-28). Downsampled to keep the column small; null
        // when Mapbox was unavailable and renderers fall back to a line.
        routeGeom: Array.isArray(leg.routeGeom) && leg.routeGeom.length > 1
          ? encPoly(slimPts(leg.routeGeom, 120))
          : null,
        // Catalog stops go as id strings; driver-added cities as
        // {name, lat, lng} objects (validateStops accepts both, 2026-08-28).
        stops: Array.from(leg.stops).map((sid) => {
          const s = (leg.stopSuggestions || []).find((x) => x && x.id === sid);
          return s && s.custom ? { name: s.name, lat: s.lat, lng: s.lng } : sid;
        }),
        departures: leg.dates.map((d) => ({ date: d, time: leg.perDateTimes[d] || leg.time })),
        seatCount: leg.seatCount,
        comfort: leg.comfort,
        // Exact seat map when the driver confirmed one (2026-09-04); the
        // server falls back to the count-only fill without it.
        seatLayout: leg.seatLayout || null,
        openSeatIds: Array.isArray(leg.openSeats) && leg.openSeats.length ? leg.openSeats : null,
        priceCents: leg.priceUsd * 100,
        instant: leg.instant,
        // Driver-set leg prices keyed by wire stop ids (catalog id as-is,
        // custom stops as cust-<index into the stops array above>).
        segmentPrices: (() => {
          if (!leg.segPrices || typeof leg.segPrices !== 'object') return null;
          const stopArr = Array.from(leg.stops || []);
          const wire = (tok) => {
            if (tok === 'origin' || tok === 'end') return tok;
            const i = stopArr.indexOf(tok);
            if (i < 0) return null;
            const s = (leg.stopSuggestions || []).find((x2) => x2 && x2.id === tok);
            return s && s.custom ? 'cust-' + i : tok;
          };
          const out = {};
          let any = false;
          for (const k in leg.segPrices) {
            const parts = k.split('|');
            if (parts.length !== 2) continue;
            const a = wire(parts[0]), b = wire(parts[1]);
            const v = leg.segPrices[k];
            if (!a || !b || typeof v !== 'number' || !isFinite(v)) continue;
            out[a + '|' + b] = v;
            any = true;
          }
          return any ? out : null;
        })(),
      };
    }
    // Server machine code → the screen that fixes it.
    const ERR_SCREEN = { BAD_ROUTE: 'stFrom', OUT_OF_AREA: 'stFrom', MIN_TRIP: 'stFrom', BAD_DATES: 'stDates', BAD_SEATS: 'stSeats', BAD_PRICE: 'stPrice', BAD_STOPS: 'stStops' };
    // BAD_SEATS pointed at timeMsg (a hidden card's element) and stSeats had
    // no message element at all — a server bounce landed the driver on the
    // seats screen with zero explanation (audit M6).
    const ERR_MSG = { BAD_ROUTE: 'fromMsg', OUT_OF_AREA: 'fromMsg', MIN_TRIP: 'fromMsg', BAD_DATES: 'datesMsg', BAD_SEATS: 'seatsMsg', BAD_PRICE: 'priceMsg', BAD_STOPS: 'stopsMsg' };

    async function publishAll() {
      // Snapshot for the network-retry path, which must NOT lose queued legs.
      const legsAtStart = savedLegs.slice();
      $('publishRetry').classList.add('hidden');
      $('publishBusy').classList.remove('hidden');
      show('stPublishing');
      const { data: sessionData } = await supabase.auth.getSession();
      const token = sessionData.session && sessionData.session.access_token;
      if (!token) { show('stEmail'); return; }

      const failures = [];
      for (const leg of savedLegs) {
        // Skip a leg that already published (retry after a partial failure).
        if (leg._published) continue;
        // Measure the drivable route once per leg (cached on the leg so a
        // retry doesn't re-fetch). Best-effort: null just means the server
        // uses its haversine fallback.
        if (leg.roadMiles == null) {
          const rr = await drivingRoute(leg.start, leg.end);
          if (rr) { leg.roadMiles = rr.miles; leg.roadMinutes = rr.minutes; }
        }
        try {
          const res = await fetch(SUPA + '/functions/v1/web-create-ride-draft', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: ANON, Authorization: 'Bearer ' + token },
            body: JSON.stringify(legPayload(leg)),
          });
          const body = await res.json().catch(() => ({}));
          if (res.ok && body && typeof body.draftId === 'number') {
            leg._published = true;
            // A published draft = a driver lead (audit L8). Once per session.
            try {
              if (!window.__ssPostLead && window.ssTrack) { window.__ssPostLead = true; window.ssTrack('Lead'); }
            } catch (_) {}
            publishedDrafts.push({
              id: body.draftId,
              from: leg.fromAddress, to: leg.toAddress, nDates: leg.dates.length,
              dates: leg.dates.slice(), time: leg.time, perDateTimes: leg.perDateTimes || {}, isReturn: !!leg.isReturn,
              status: body.status === 'live' ? 'live' : 'pending',
              rideIds: Array.isArray(body.rideIds) ? body.rideIds : [],
              gates: body.gates || null,
            });
            continue;
          }
          if (body && body.error === 'MIGRATION_PENDING') { show('stUnavailable'); return; }
          if (body && body.error === 'ACCOUNT_SUSPENDED') {
            show('stReady');
            $('readyTitle').textContent = 'We hit a problem';
            $('rideCards').innerHTML = ''; $('gateList').innerHTML = '';
            $('statusLine').textContent = body.message || 'Your account is suspended. Email support@seatsherpa.app.';
            return;
          }
          failures.push({ leg, code: body && body.error, message: (body && (body.message || body.error)) || 'Something went wrong.' });
        } catch (e) {
          failures.push({ leg, code: null, message: (e && e.message) || 'Network problem — try again.' });
        }
      }

      if (publishedDrafts.length === 0 && failures.length > 0) {
        // Nothing published — bounce to the screen that can fix the first error.
        const f = failures[0];
        const scr = ERR_SCREEN[f.code];
        cur = f.leg; // re-enter that leg for editing
        // Drop EVERY queued leg, not just the one being edited (Fable audit
        // #4): a stale failed return left in savedLegs would publish behind
        // the driver's back on the next walk-through — or duplicate when
        // they answer the return question again.
        savedLegs = [];
        if (scr) {
          if (scr === 'stDates') enterDates(); else if (scr === 'stPrice') enterPrice(); else show(scr);
          setMsg(ERR_MSG[f.code] || 'fromMsg', f.message);
        } else {
          // No mapped screen = network/unknown, NOT a problem with their dates.
          // Keep every leg queued and offer a direct retry (audit 8/28).
          savedLegs = legsAtStart;
          cur = savedLegs[savedLegs.length - 1] || cur;
          $('publishRetrySub').textContent = (f.message || 'Something went wrong.')
            + ' Your ride is safe — nothing was lost.';
          $('publishBusy').classList.add('hidden');
          $('publishRetry').classList.remove('hidden');
          show('stPublishing');
        }
        return;
      }

      saveLocal();
      const partialMsg = failures.length > 0
        ? 'Your outbound published, but the other direction hit a snag: ' + failures[0].message + ' You can post it again any time.'
        : '';
      await enterReady(partialMsg);
    }

    // ── Ready screen + gates ──────────────────────────────────────────────
    // Photo + bio + license are ONE step (2026-09-02) and all three block
    // go-live, matching the app (photo + bio required since 1.0.8) and the
    // server's gatesClear. Car and deposits stay optional.
    const GATE_DEFS = [
      { key: 'phone', title: 'Confirm your phone', doneTitle: 'Phone confirmed',
        unlock: 'Riders need a real number at pickup. Required to go live.', screen: 'gPhone', blocking: true },
      { key: 'profile', title: 'Photo, bio & driver\u2019s license', doneTitle: 'Photo, bio & license on file',
        unlock: 'Riders see your photo and bio; the license stays private. Required to go live.', screen: 'gProfile', blocking: true },
      { key: 'car', title: 'Add your car', doneTitle: 'Car added',
        unlock: 'Shows riders what to look for at pickup.', screen: 'gCar', blocking: false },
      { key: 'payouts', title: 'Set up deposits', doneTitle: 'Deposits connected',
        unlock: 'Unlocks accepting bookings and Instant Book — Stripe sends riders’ cost share to your bank.', screen: null, blocking: false },
    ];
    const gateDone = (key) => key === 'profile'
      ? !!(gateState.photo && gateState.bio && gateState.license)
      : !!gateState[key];
    let gateState = { phone: false, photo: false, license: false, bio: false, car: false, payouts: false };
    let reviewHold = false;

    async function enterReady(extraMsg) {
      show('stReady');
