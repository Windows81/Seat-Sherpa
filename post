    }
    // Whether the last enterRoute actually rendered a chooser (≥2 routes) —
    // the stops screen's Back button targets stRoute only when there is a
    // live chooser to return to; otherwise stRoute is a blank card (audit #2).
    let routeChooserShown = false;
    // Flow epoch (audit HIGH-1): every (re)entry into the route flow bumps
    // this; awaited work from an older entry checks it and aborts instead of
