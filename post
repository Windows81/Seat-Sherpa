    }
    function clearLocal() { try { localStorage.removeItem(LS_KEY); } catch (_) {} }

    // ── Address autocomplete (port of lib/geocoding.ts searchbox flow) ────
    const uuid = () => (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2));
    function stripCountry(s) { return (s || '').replace(/,?\s*(United States|USA|US)\s*$/i, ''); }

    function wireAutocomplete(inputId, listId, pickedId, pickedAddrId, changeId, btnId, assign) {
      let session = uuid();
      let debounceTimer = null;
      let pickSeq = 0;
      const input = $(inputId), list = $(listId);

      async function suggest(q) {
        const bbox = '-124.5,32.0,-114.0,42.0';
        const url = 'https://api.mapbox.com/search/searchbox/v1/suggest?q=' + encodeURIComponent(q) +
          '&access_token=' + MAPBOX_TOKEN + '&session_token=' + session +
          '&country=us&bbox=' + bbox + '&limit=6&types=poi,address,place,locality,neighborhood';
        const res = await fetch(url);
        if (!res.ok) return [];
        const json = await res.json();
        return (json.suggestions || []).map((s) => ({
          id: s.mapbox_id,
          primary: s.name,
          secondary: stripCountry(s.place_formatted || ''),
          full: stripCountry(s.full_address || (s.name + (s.place_formatted ? ', ' + s.place_formatted : ''))),
        }));
      }
      async function retrieve(id) {
        const url = 'https://api.mapbox.com/search/searchbox/v1/retrieve/' + encodeURIComponent(id) +
          '?access_token=' + MAPBOX_TOKEN + '&session_token=' + session;
        const res = await fetch(url);
        if (!res.ok) return null;
        const json = await res.json();
        const f = json.features && json.features[0];
        if (!f) return null;
        session = uuid(); // one billable session per suggest→retrieve pairing
        return { lat: f.geometry.coordinates[1], lng: f.geometry.coordinates[0] };
      }
      function render(items) {
        list.innerHTML = '';
        if (items.length === 0) { list.classList.add('hidden'); return; }
        for (const it of items) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'ac-item';
          // textContent only — geocoder strings are third-party data.
          const p = document.createElement('span'); p.className = 'p'; p.textContent = it.primary;
          const s = document.createElement('span'); s.className = 's'; s.textContent = it.secondary;
          b.appendChild(p); b.appendChild(s);
          b.addEventListener('click', async () => {
            const seq = ++pickSeq;
            list.classList.add('hidden');
            input.value = it.full;
            const coords = await retrieve(it.id);
            if (seq !== pickSeq) return; // a newer pick superseded this one (audit L5)
            // Both fields live on ONE card now — all errors surface in fromMsg.
            if (!coords) { setMsg('fromMsg', "Couldn't load that address — try another."); return; }
            assign(it.full, coords);
            input.classList.add('hidden');
            $(pickedAddrId).textContent = it.full;
            $(pickedId).classList.remove('hidden');
            $(btnId).disabled = false;
          });
          list.appendChild(b);
        }
        list.classList.remove('hidden');
      }
      input.addEventListener('input', () => {
        const q = input.value.trim();
        assign(null, null); // typing invalidates any prior pick
        $(btnId).disabled = true;
        clearTimeout(debounceTimer);
        if (q.length < 3) { list.classList.add('hidden'); return; }
        debounceTimer = setTimeout(async () => {
          try {
            const items = await suggest(q);
            // Compare against THIS request's query (audit M2) — a shared
            // lastQuery lets any late out-of-order response render.
            if (input.value.trim() === q) render(items);
          } catch (_) { /* transient */ }
        }, 250);
      });
      $(changeId).addEventListener('click', () => {
        assign(null, null);
        $(pickedId).classList.add('hidden');
        input.classList.remove('hidden');
        input.value = '';
        $(btnId).disabled = true;
        input.focus();
      });
    }

    // Dynamic savings hook (Justin, 2026-08-28): once both spots are picked
    // the line shows THIS trip's number — 3 open seats × the per-seat cost-
    // share cap (drivable-ish miles × $0.76/3, $10 floor, $55 ceiling) minus
    // the 5% driver fee. SF→San Jose reads ~$30, SF→LA ~$156.
    function updateSaveLine() {
      const amt = $('saveAmt'), word = $('saveTripWord');
      if (cur.start && cur.end) {
        const miles = haversineMiles(cur.start, cur.end) * 1.25;
        if (isFinite(miles) && miles > 0) {
          // The $60 tier only on MEASURED road miles (bug check 10/13: the
          // x1.25 estimate put SF -> LA at 434 mi and promised $228 while the
          // price step, on 382 road miles, capped at $55).
          const measured = typeof cur.roadMiles === 'number' && cur.roadMiles > 0 ? cur.roadMiles : null;
          const perSeat = Math.min(hardCapFor(measured), Math.max(10, (miles * 0.76) / Math.max(MIN_SHARE_SEATS, saveSeats)));
          // Cap at the trip's real shareable cost — floor × seats otherwise
          // overstates short trips (Fable E2).
          const net = Math.round(Math.min(saveSeats * perSeat, miles * 0.76) * 0.95);
          amt.textContent = '$' + net;
          word.textContent = 'this trip';
          return;
        }
      }
      amt.textContent = '$228';
      word.textContent = 'a trip';
    }
    wireAutocomplete('fromInput', 'fromList', 'fromPicked', 'fromPickedAddr', 'fromChange', 'fromBtn',
      (addr, coords) => { cur.fromAddress = addr || ''; cur.start = coords; updateSaveLine(); });
    // Shares fromBtn: either field's typing disables it, either pick
    // re-enables; the click handler validates BOTH before proceeding.
    wireAutocomplete('toInput', 'toList', 'toPicked', 'toPickedAddr', 'toChange', 'fromBtn',
      (addr, coords) => { cur.toAddress = addr || ''; cur.end = coords; updateSaveLine(); });

    // Combined From+To continue (2026-08-28, BlaBlaCar-style single card):
    // one button validates both picks and runs the full eligibility checks.
    $('fromBtn').addEventListener('click', () => {
      setMsg('fromMsg', '');
      if (!cur.start) { setMsg('fromMsg', 'Pick your starting point from the suggestions.'); return; }
      if (!cur.end) { setMsg('fromMsg', 'Pick your destination from the suggestions.'); return; }
      // Same two rules the app enforces at this moment — so a driver isn't
      // told at the very end that the whole trip is ineligible.
      if (!inServiceArea(cur.start) || !inServiceArea(cur.end)) {
        setMsg('fromMsg', "Seat Sherpa has only launched in California and Nevada so far — please pick addresses inside CA/NV.");
        return;
      }
      // A measurement belongs to ONE pair of endpoints. If the driver went
      // back and changed an address, the old figure must not price the new
      // route (the server clamp would catch it, but the page would briefly
      // advertise a wrong cap).
      const routeKey = cur.start.lat + ',' + cur.start.lng + '|' + cur.end.lat + ',' + cur.end.lng;
      if (cur.roadFor !== routeKey) {
        cur.roadMiles = null; cur.roadMinutes = null;
