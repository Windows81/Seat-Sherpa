    let routeEpoch = 0;
    $('routeMap').onerror = () => $('routeMap').classList.add('hidden');
    async function enterRoute() {
      const epoch = ++routeEpoch;
      show('stRoute');
      setMsg('routeMsg', '');
      routeChooserShown = false;
      $('routeList').innerHTML = '';
