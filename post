    // City out of a geocoder address, with the region-as-city guard
    // ("Westwood, The Westside, California" is Los Angeles, review
    // 2026-10-02). Same rule as lib/format-address.ts: never a street, a
    // state or a ZIP; the last cleaned part is the city. '' when nothing fits.
    function ssCityOf(addr) {
      const parts = String(addr || '').split(',').map((s) => s.trim()).filter(Boolean);
      const STATE = /^(california|ca|nevada|nv|arizona|az|oregon|or|usa|united states|us)( +\d{5}(-\d{4})?)?$/i;
      const cleaned = parts.filter((p) => !/^\d/.test(p) && !STATE.test(p) && !/^\d{5}(-\d{4})?$/.test(p));
      if (!cleaned.length) return '';
      const last = cleaned[cleaned.length - 1];
      const key = last.toLowerCase().replace(/^the\s+/, '');
      const CITY = { 'westside': 'Los Angeles', 'san fernando valley': 'Los Angeles', 'valley': 'Los Angeles', 'south los angeles': 'Los Angeles', 'east los angeles': 'Los Angeles' };
      const SKIP = ['south bay', 'east bay', 'peninsula', 'silicon valley', 'north bay', 'inland empire', 'central valley', 'orange county', 'bay area', 'san francisco bay area', 'los angeles county', 'san diego county', 'wine country'];
      if (CITY[key]) return CITY[key];
      if (SKIP.indexOf(key) >= 0) return cleaned.length >= 2 ? cleaned[cleaned.length - 2] : last;
      return last;
    }

    // post.html — v1 web posting (2026-08-21).
