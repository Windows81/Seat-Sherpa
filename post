    function renderRideCards() {
      const wrap = $('rideCards');
      wrap.innerHTML = '';
      for (const d of publishedDrafts) {
        const card = document.createElement('div');
        card.className = 'ridecard';
        const route = document.createElement('div'); route.className = 'route';
        route.textContent = (d.isReturn ? '↩ Return: ' : '🚗 ') + shortPlace(d.from) + ' → ' + shortPlace(d.to);
        const meta = document.createElement('div'); meta.className = 'meta';
        meta.textContent = draftWhen(d);
        if (d.status === 'live') meta.textContent += ' · LIVE to riders';
        card.appendChild(route); card.appendChild(meta);
        wrap.appendChild(card);
