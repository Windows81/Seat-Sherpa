    }
    function restoreWip() {
      try {
        const raw = localStorage.getItem(WIP_KEY);
        if (!raw) return false;
        const v = JSON.parse(raw);
        if (!v || !v.cur || !v.cur.start || !v.cur.end || (Date.now() - (v.ts || 0)) > WIP_TTL_MS) return false;
        cur = legFromJson(v.cur);
        savedLegs = Array.isArray(v.savedLegs) ? v.savedLegs.map(legFromJson) : [];
