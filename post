        const { error } = await supabase.from('profiles').update({ bio }).eq('id', myUid);
        if (error) throw error;
      } catch (e) {
        setMsg('bioMsg', (e && e.message) || 'Could not save. Try again.');
        btn.disabled = false; btn.textContent = 'Save bio';
        return;
      }
      btn.disabled = false; btn.textContent = 'Save bio';
      // Merged screen: mark this section done, stay put, and only offer the
      // way back once all three are on file.
      await refreshGates();
      renderProfileSections();
    });

    // ── Merged profile screen state ─────────────────────────────────────
    function renderProfileSections() {
      const set = (sec, st, ok) => { $(sec).classList.toggle('done', ok); $(st).textContent = ok ? '✓' : '○'; };
      set('secPhoto', 'stPhotoOk', !!gateState.photo);
      set('secBio', 'stBioOk', !!gateState.bio);
      set('secLicense', 'stLicenseOk', !!gateState.license);
      const all = !!(gateState.photo && gateState.license); /* bio optional since 2026-09-06 */
      $('profileDoneBtn').classList.toggle('hidden', !all);
      void renderEmailSection();
      // Google sign-ins: one-tap "Use my Google photo" (face-checked like any
      // upload) while no photo is on file yet.
      void (async () => {
        try {
          if (gateState.photo || photoBlob) { $('googlePhotoOffer').classList.add('hidden'); return; }
          const { data } = await supabase.auth.getUser();
          const meta = (data && data.user && data.user.user_metadata) || {};
          const gUrl = String(meta.avatar_url || meta.picture || '');
          if (!gUrl) return;
          googlePhotoUrl = gUrl.replace(/=s\d+(-c)?$/, '=s512-c');
          $('googlePhotoImg').src = googlePhotoUrl;
          $('googlePhotoOffer').classList.remove('hidden');
        } catch (_) {}
      })();
    }
    // Add-email (parity with the app's on-open prompt, 2026-09-02): only
    // shown when auth has no email (Apple re-auth / phone-only sign-ins).
    async function renderEmailSection() {
      const sec = $('secEmail'); if (!sec) return;
      try {
        const { data } = await supabase.auth.getUser();
        const u = data && data.user;
        const missing = !!u && !(u.email || '').trim();
        sec.classList.toggle('hidden', !missing);
        if (u && (u.new_email || '').trim()) {
          $('stEmailOk').textContent = '✓';
          setMsg('acctEmailMsg', 'Confirmation sent to ' + u.new_email + ' — tap the link in that email to finish.', 'ok');
        }
      } catch (_) { sec.classList.add('hidden'); }
    }
    $('acctEmailBtn').addEventListener('click', async () => {
      setMsg('acctEmailMsg', '');
      const email = $('acctEmail').value.trim().toLowerCase();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setMsg('acctEmailMsg', 'Enter a valid email address.'); return; }
      const btn = $('acctEmailBtn'); btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const { error } = await supabase.auth.updateUser({ email }, { emailRedirectTo: 'https://seatsherpa.app/email-changed' });
        if (error) throw error;
        $('stEmailOk').textContent = '✓';
        setMsg('acctEmailMsg', 'Confirmation sent to ' + email + ' — tap the link in that email to finish. You can keep going here meanwhile.', 'ok');
      } catch (e) {
        setMsg('acctEmailMsg', (e && e.message) || 'Could not save that email. Try again.');
      }
      btn.disabled = false; btn.textContent = 'Save email';
    });
    $('profileDoneBtn').addEventListener('click', () => { show('stReady'); void refreshGates(); });

    // ── Gate: car (vehicles insert — same client-side write the app makes) ─
    $('carBtn').addEventListener('click', async () => {
      setMsg('carMsg', '');
      const year = $('carYear').value.trim();
      const make = $('carMake').value.trim();
      const model = $('carModel').value.trim();
      if (!/^(19|20)\d{2}$/.test(year)) { setMsg('carMsg', 'Enter a 4-digit year.'); return; }
      if (!make || !model) { setMsg('carMsg', 'Enter the make and model.'); return; }
      const btn = $('carBtn');
      btn.disabled = true; btn.textContent = 'Saving…';
      try {
        const { error } = await supabase.from('vehicles').insert({
          owner_id: myUid,
          year, make, model,
          car_type: $('carType').value,
          color: $('carColor').value,
          // The web seat model is the standard 5-seat car (4 passenger
          // positions) — matches the posting flow's seat layout.
          max_passenger_seats: 4,
          plate: $('carPlate').value.trim() || null,
          amenities: [],
          is_default: true,
        });
        if (error) throw error;
      } catch (e) {
        setMsg('carMsg', (e && e.message) || 'Could not save. Try again.');
        btn.disabled = false; btn.textContent = 'Save car';
        return;
      }
      btn.disabled = false; btn.textContent = 'Save car';
      show('stReady');
      await refreshGates();
    });

    // Rental fast path: reuse an existing rental row or insert a details-
    // less placeholder (make='Rental' renders as 'Rental car' everywhere;
    // is_rental relaxes the insurance ask and tags the ride for riders).
    $('carRentalBtn').addEventListener('click', async () => {
      setMsg('carMsg', '');
      const btn = $('carRentalBtn');
      btn.disabled = true; btn.textContent = 'Setting up your rental…';
      try {
        const { data: mine } = await supabase.from('vehicles')
          .select('id').eq('owner_id', myUid).eq('is_rental', true).limit(1);
        if (!mine || !mine.length) {
          const { error } = await supabase.from('vehicles').insert({
            owner_id: myUid, year: '', make: 'Rental', model: '',
            car_type: 'Sedan', color: 'Other', max_passenger_seats: 4,
            // is_default FALSE (Fable A4): true made the placeholder the sticky
            // default forever once a real car arrived. With zero other cars,
            // defaultVehicle picks the only row anyway.
            plate: null, amenities: [], is_default: false, is_rental: true,
          });
          if (error) throw error;
        }
      } catch (e) {
        setMsg('carMsg', (e && e.message) || 'Could not save. Try again.');
        btn.disabled = false; btn.textContent = '🔑 Driving a rental? Skip this — we’ll ask for details the day before';
        return;
      }
      btn.disabled = false; btn.textContent = '🔑 Driving a rental? Skip this — we’ll ask for details the day before';
      show('stReady');
      await refreshGates();
    });

    // ── Gate: payouts (Stripe) ────────────────────────────────────────────
    async function startStripeOnboarding() {
      show('stStripeRedirect');
      try {
        const { data: sessionData } = await supabase.auth.getSession();
        const token = sessionData.session && sessionData.session.access_token;
        if (!token) { show('stReady'); return; }
        const res = await fetch(SUPA + '/functions/v1/web-stripe-onboarding-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: ANON, Authorization: 'Bearer ' + token },
          body: JSON.stringify({}),
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body && body.url) { location.href = body.url; return; }
        throw new Error((body && (body.message || body.error)) || 'Could not open Stripe.');
      } catch (e) {
        show('stReady');
        setMsg('readyMsg', (e && e.message) || 'Could not open Stripe — try again.');
      }
    }

    // ── Boot ──────────────────────────────────────────────────────────────
    (async function init() {
      const qp = new URLSearchParams(location.search);
      const stripeReturn = qp.get('stripe'); // 'return' | 'refresh' | null

      // "+ Post a ride" (app bar, console) = a brand-new ride, always (Justin,
      // 2026-09-04). Forget the last published ride's checklist, any
      // half-finished draft and any hero hand-off, then start at From.
      if (qp.get('new') === '1') {
        try { localStorage.removeItem(WIP_KEY); localStorage.removeItem(LS_KEY); localStorage.removeItem('ss-post-prefill-v1'); } catch (_) {}
        try { history.replaceState(null, '', '/post'); } catch (_) {}
        show('stFrom');
        return;
      }
      const refillWanted = /^\d+$/.test(qp.get('refill') || '');

      const stored = loadLocal();
      const { data: sessionData } = await supabase.auth.getSession();

      // Stripe-onboarding return: pull Connect status NOW instead of waiting
      // on the webhook (the status-drift lesson). Hoisted OUT of the
      // stored-drafts branch (audit L2): a driver whose LS was cleared — or
      // whose drafts already finalized — still deserves the reconcile, or
      // the payouts gate shows stale until the webhook lands.
      if (sessionData.session && (stripeReturn === 'return' || stripeReturn === 'refresh')) {
        try {
          await fetch(SUPA + '/functions/v1/stripe-refresh-account-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: ANON, Authorization: 'Bearer ' + sessionData.session.access_token },
            body: JSON.stringify({}),
          });
        } catch (_) {}
        history.replaceState(null, '', '/post');
      }

      // /drive hero hand-off (2026-08-28, BlaBlaCar-style): the driver page's
      // From+To widget stores a pick pair; a fresh valid one skips straight
      // to the route chooser. One-shot, and it beats drafts/WIP — the driver
      // typed this route seconds ago.
      try {
        const rawPre = localStorage.getItem('ss-post-prefill-v1');
        if (rawPre) {
          localStorage.removeItem('ss-post-prefill-v1');
          const pre = JSON.parse(rawPre);
          const okPt = (p) => p && isFinite(p.lat) && isFinite(p.lng);
          if (pre && (Date.now() - (pre.ts || 0)) < 5 * 60 * 1000 && okPt(pre.start) && okPt(pre.end)) {
            cur = newLeg();
            cur.start = { lat: Number(pre.start.lat), lng: Number(pre.start.lng) };
            cur.end = { lat: Number(pre.end.lat), lng: Number(pre.end.lng) };
            cur.fromAddress = String(pre.fromAddress || '').slice(0, 120);
            cur.toAddress = String(pre.toAddress || '').slice(0, 120);
            // Mirror a manual pick so Back from the chooser shows real chips.
            $('fromInput').classList.add('hidden'); $('fromPickedAddr').textContent = cur.fromAddress; $('fromPicked').classList.remove('hidden');
            $('toInput').classList.add('hidden'); $('toPickedAddr').textContent = cur.toAddress; $('toPicked').classList.remove('hidden');
            $('fromBtn').disabled = false;
            updateSaveLine();
            if (!inServiceArea(cur.start) || !inServiceArea(cur.end)) {
              show('stFrom');
              setMsg('fromMsg', 'Seat Sherpa has only launched in California and Nevada so far — please pick addresses inside CA/NV.');
              return;
            }
            cur.roadFor = cur.start.lat + ',' + cur.start.lng + '|' + cur.end.lat + ',' + cur.end.lng;
            const preMiles = tripMilesOf(cur);
            if (preMiles < MIN_TRIP_MILES) {
              show('stFrom');
              setMsg('fromMsg', 'Pickup and dropoff are only ~' + preMiles.toFixed(1) + ' mi apart — Seat Sherpa is for longer trips (' + MIN_TRIP_MILES + ' mi or more).');
              return;
            }
            void enterRoute();
            return;
          }
        }
      } catch (_) { /* bad payload — fall through to the normal flow */ }

      // The last published ride's checklist resumes ONLY while something on it
      // is still pending (a gate to clear, a draft not yet live). Once every
      // draft is live the memory is spent — the old code showed "Your ride is
      // live" on every later visit, including after that ride was cancelled,
      // and swallowed Post-again (Justin, 2026-09-04). Post-again always wins.
      if (stored && sessionData.session && !refillWanted) {
        publishedDrafts = stored.drafts.map((d) => ({ ...d, status: 'pending', rideIds: [] }));
        await enterReady('');
        const stillPending = publishedDrafts.some((d) => d.status !== 'live');
        if (stillPending || stripeReturn) return;
        publishedDrafts = [];
        try { localStorage.removeItem(LS_KEY); } catch (_) {}
        renderRideCards();
      }

      // No local memory, but the driver may still have a pending draft from
      // another day/browser tab: the SELECT-own grant on web_ride_drafts (0205)
      // lets us resume it. Only PUBLISHED drafts resume — finalized history
      // shouldn't hijack a fresh visit.
      if (sessionData.session && !refillWanted) {
        try {
          const { data: rows } = await supabase
            .from('web_ride_drafts')
            .select('id, status, departure_area, arrival_area, departures')
            .eq('status', 'published')
            .order('created_at', { ascending: false })
            .limit(3);
          if (rows && rows.length > 0) {
            publishedDrafts = rows.map((r) => ({
              id: r.id,
              from: r.departure_area, to: r.arrival_area,
              nDates: Array.isArray(r.departures) ? r.departures.length : 1,
              status: 'pending', rideIds: [],
            }));
            saveLocal();
            await enterReady('');
            return;
          }
        } catch (_) { /* table may not exist yet — fall through to the flow */ }
      }

      // Post-again (2026-08-28, app `refill=` parity): ?refill=<rideId>
      // prefills the whole leg from one of the driver's own rides — route,
      // seats, price, instant — and drops them on the stops screen; only
      // dates and time need answering. Signed-in only (rides are readable by
      // anyone, but posting requires the session anyway).
      // "Post again" used to prefill only the endpoints: the source ride's
      // route stops and driver-set leg prices were dropped without a word
      // (sweep 2026-09-03). Re-select the same catalog stops, re-create the
      // custom ones, and carry the leg prices across (marked edited so the
      // suggestion pass leaves them alone).
      function applyRefillStops(routeStops, segPrices) {
        if (!cur.start || !cur.end) return;
        // A ride the driver posted WITHOUT stops (explicit empty list) must
        // come back without them — enterStops() has just auto-selected the
        // corridor's defaults, and returning here left those in place, so
        // "Post again" quietly re-added stops the driver had removed (audit
        // 2026-09-04). Legacy rides (null, pre-stops) keep the defaults.
        if (Array.isArray(routeStops) && routeStops.length === 0) {
          cur.stops = new Set();
          renderStops();
          return;
        }
        if (!Array.isArray(routeStops)) return;
        if (!Array.isArray(cur.stopSuggestions)) cur.stopSuggestions = [];
        const cap = maxStopsFor(cur);
        const localIdByIndex = [];
        cur.stops = new Set();
        routeStops.forEach((st, i) => {
          let id = null;
          if (typeof st === 'string') {
            if (cur.stopSuggestions.some((x) => x && x.id === st)) id = st;
          } else if (st && isFinite(Number(st.lat)) && isFinite(Number(st.lng))) {
            const lat = Number(st.lat), lng = Number(st.lng);
            const near = cur.stopSuggestions.find((x) => x && typeof x.lat === 'number' && Math.abs(x.lat - lat) < 0.04 && Math.abs(x.lng - lng) < 0.04);
            if (near) id = near.id;
            else {
              id = 'custom-r' + i + '-' + Math.abs(Math.round(lat * 1e4)) + '' + Math.abs(Math.round(lng * 1e4));
              const toS = haversineMiles(cur.start, { lat, lng }), toE = haversineMiles(cur.end, { lat, lng });
              const t = (toS + toE) > 0 ? toS / (toS + toE) : 0.5;
              cur.stopSuggestions.push({ id, name: String(st.name || 'Stop'), lat, lng, t, custom: true });
            }
          }
          localIdByIndex[i] = id;
          if (id && cur.stops.size < cap) cur.stops.add(id);
        });
        cur.stopSuggestions.sort((a, b) => (a.t || 0) - (b.t || 0));
        if (segPrices && typeof segPrices === 'object') {
          cur.segPrices = {}; cur.segEdited = {};
          const local = (tok) => {
            if (tok === 'origin' || tok === 'end') return tok;
            const m = /^cust-(\d+)$/.exec(tok);
            if (m) return localIdByIndex[Number(m[1])] || null;
            return cur.stops.has(tok) ? tok : null;
          };
          for (const k in segPrices) {
            const parts = String(k).split('|');
            if (parts.length !== 2) continue;
            const a = local(parts[0]), b = local(parts[1]);
            const v = Number(segPrices[k]);
            if (!a || !b || !isFinite(v) || v <= 0) continue;
            cur.segPrices[a + '|' + b] = v;
            cur.segEdited[a + '|' + b] = true;
          }
        }
        renderStops();
      }
      const refillId = parseInt(new URLSearchParams(location.search).get('refill') || '', 10);
      if (Number.isFinite(refillId) && refillId > 0) {
        try {
          const { data: sd } = await supabase.auth.getSession();
          if (sd && sd.session) {
            const { data: r } = await supabase
              .from('rides')
              .select('id, driver_id, departure_area, arrival_area, start_lat, start_lng, end_lat, end_lng, seats, instant, dep_time, route_stops, segment_prices')
              .eq('id', refillId)
              .maybeSingle();
            if (r && r.driver_id === sd.session.user.id) {
              cur = newLeg();
              cur.fromAddress = r.departure_area || '';
              cur.toAddress = r.arrival_area || '';
              if (r.start_lat != null) cur.start = { lat: Number(r.start_lat), lng: Number(r.start_lng) };
              if (r.end_lat != null) cur.end = { lat: Number(r.end_lat), lng: Number(r.end_lng) };
              const seats = Array.isArray(r.seats) ? r.seats : [];
              const pax = seats.filter((s) => s && !s.isDriver);
              const open = pax.filter((s) => s.avail !== false);
              if (open.length) cur.seatCount = open.length;
              cur.comfort = !open.some((s) => s.id === 'rc');
              // Carry the exact seat map across (2026-09-04): layout from the
              // stored positions, open set from avail.
              if (pax.length) {
                cur.seatLayout = pax.some((s) => s.id === 'ml' || s.id === 'mr') ? 'van' : 'sedan';
                cur.openSeats = open.map((s) => s.id).filter((id) => SEAT_LAYOUTS[cur.seatLayout].indexOf(id) !== -1);
                if (!cur.openSeats.length) cur.openSeats = null;
                cur.seatMapKey = cur.seatCount + '|' + (cur.comfort ? 1 : 0);
              }
              cur.instant = false; // retired 0271: re-posting an old instant ride is request-to-book
              const prices = open.map((s) => Number(s.price)).filter((n) => n > 0);
              if (prices.length) cur.priceUsd = Math.round(Math.min.apply(null, prices));
              if (r.dep_time) cur.time = String(r.dep_time).slice(0, 5);
              if (cur.start && cur.end) { await enterStops(); applyRefillStops(r.route_stops, r.segment_prices); return; }
            }
          }
        } catch (_) { /* fall through to the normal flow */ }
      }

      // Evicted-tab resume (audit H2): a work-in-progress draft beats a blank
      // first screen. Falls through to stFrom when there's nothing to restore.
      if (restoreWip()) return;

      // Filling a rider's request (/requests → "Driving this?"): carry the
      // route and date across so the driver doesn't retype what they just
      // read (audit 8/28). Addresses stay the driver's to pick — we seed the
      // city so autocomplete is one tap away, never a silent centroid.
      try {
        const rFrom = qp.get('from'), rTo = qp.get('to'), rDate = qp.get('date');
        // Any area or stop this page knows, plus the Inland Empire (an area the
        // server accepts but this page has no entry for). Bug check 2026-10-07:
        // post_ride_link to Monterey or Riverside opened a blank form.
        const areaOf = (id) => DESTS.find((d) => d.id === id) || WAYPOINTS.find((d) => d.id === id)
          || (id === 'inlandempire' ? { id, name: 'Riverside' } : null);
        const fromD = rFrom && areaOf(rFrom);
        const toD = rTo && areaOf(rTo);
        if (fromD && toD) {
          const banner = $('reqBanner');
          if (banner) {
            // via=agent (2026-10-07): an AI assistant's post_ride_link prefill
            // (MCP), not a rider request, so the banner just names the trip.
            // via=email: the lapsed-driver note's link to the driver's own route.
            const viaAgent = qp.get('via') === 'agent' || qp.get('via') === 'email';
            banner.textContent = (viaAgent ? 'Posting ' : '🙋 Filling a rider request: ') + fromD.name + ' → ' + toD.name
              + (rDate ? ' · ' + fmtDateShort(rDate) : '') + '. Add your exact pickup and dropoff below.';
            banner.classList.remove('hidden');
          }
          if (rDate && /^\d{4}-\d{2}-\d{2}$/.test(rDate) && rDate >= pacificTodayIso()) {
            cur.dates = [rDate];
          }
          // Seed the inputs and fire the autocomplete so one tap picks a real
          // address (never auto-committing a metro centroid as the pickup).
          const seed = (inputId, text) => {
            const el = $(inputId);
            if (!el) return;
            el.value = text;
            el.dispatchEvent(new Event('input', { bubbles: true }));
          };
          seed('fromInput', fromD.name);
          seed('toInput', toD.name);
        }
      } catch (_) { /* prefill is best-effort */ }

      show('stFrom');
    })();

    // Enter-key submits on single-field steps.
    const enterMap = [['email','emailBtn'], ['emailCode','codeBtn'], ['nameInput','nameBtn'], ['phoneNum','phoneSendBtn'], ['phoneCode','phoneVerifyBtn']];
    for (const [inp, btn] of enterMap) {
      $(inp).addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); $(btn).click(); } });
    }
  </script>
  <script type="module" src="/js/ss-rating-gate.js"></script>
</body>
