          ? 'That code is incorrect or has expired. Tap Resend for a new one.'
          : error.message);
        return;
      }
      // Keep an existing account's role; stamp 'driver' only on fresh ones.
      try { await supabase.auth.updateUser({ data: { role: (data && data.user && data.user.user_metadata && data.user.user_metadata.role) || 'driver' } }); } catch (_) {}
      // Fresh-account registration event — same 10-minute freshness rule as
      // book.html (audit L8: this funnel had zero conversion tracking).
      try {
        const created = data && data.user && data.user.created_at ? new Date(data.user.created_at).getTime() : 0;
        if (created && Date.now() - created < 10 * 60 * 1000 && window.ssTrack) {
          window.ssTrack('CompleteRegistration', { em: data.user.email });
        }
      } catch (_) {}
      myUid = data && data.user ? data.user.id : null; if (myUid) try { localStorage.setItem('ss_last_role','driver'); } catch (_) {} void loadSaveSeats();
      await nameCheckThenPublish(data.user);
    });

    // ── Name check → publish ──────────────────────────────────────────────
    async function nameCheckThenPublish(user) {
      let profileName = '';
      try {
        const { data: p } = await supabase.from('profiles').select('name').eq('id', user.id).maybeSingle();
        profileName = ((p && p.name) || '').trim();
      } catch (_) {}
      const emailLocal = (user.email || '').split('@')[0].toLowerCase();
      if (!profileName || profileName.toLowerCase() === emailLocal || nameLooksLikeHandle(profileName)) { show('stName'); return; }
      await publishAll();
    }
    function nameLooksLikeHandle(n) {
      const t = String(n || '').trim();
      if (!t || /\s/.test(t)) return false;
      return (/\d/.test(t) && /^[a-z0-9._-]+$/i.test(t)) || /^[a-z0-9]{10}$/.test(t);
    }
    $('nameBtn').addEventListener('click', async () => {
      setMsg('nameMsg', '');
      const name = $('nameInput').value.trim();
      if (!name || name.split(/\s+/).length < 1) { setMsg('nameMsg', 'Please enter your name.'); return; }
      if (name.includes('@') || nameLooksLikeHandle(name)) { setMsg('nameMsg', 'That looks like a username — riders and drivers need your real first and last name.'); return; }
      const btn = $('nameBtn');
      btn.disabled = true; btn.textContent = 'Saving…';
      try {
        // The signup trigger creates the profiles row; update-with-one-retry
        // covers the just-signed-up race (book.html pattern).
        let { data, error } = await supabase.from('profiles').update({ name }).eq('id', myUid).select('id');
        if (!error && (!data || data.length === 0)) {
          await new Promise((r) => setTimeout(r, 900));
          ({ data, error } = await supabase.from('profiles').update({ name }).eq('id', myUid).select('id'));
        }
        if (error || !data || data.length === 0) throw error || new Error('Profile not ready — please try again.');
        try { await supabase.auth.updateUser({ data: { name } }); } catch (_) {}
      } catch (e) {
        setMsg('nameMsg', (e && e.message) || 'Could not save. Try again.');
