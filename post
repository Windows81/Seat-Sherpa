    // ── Auth (email OTP — book.html pattern) ──────────────────────────────
    let emailCooldown = 0, emailCooldownTimer = null;
    function startEmailCooldown() {
      emailCooldown = 60;
      const btn = $('codeResend');
      clearInterval(emailCooldownTimer);
      emailCooldownTimer = setInterval(() => {
        emailCooldown -= 1;
        if (emailCooldown <= 0) { clearInterval(emailCooldownTimer); btn.disabled = false; btn.textContent = 'Resend code'; }
        else { btn.disabled = true; btn.textContent = 'Resend in ' + emailCooldown + 's'; }
      }, 1000);
      btn.disabled = true; btn.textContent = 'Resend in 60s';
    }
    async function sendEmailOtp(email) {
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { shouldCreateUser: true, data: { role: 'driver', surface: 'web' } },
      });
      if (error) {
        const m = (error.message || '').toLowerCase();
        if (m.includes('rate limit')) return 'Too many codes requested. Try again in an hour.';
        return error.message || "Couldn't send the code. Try again.";
      }
      return null;
    }
    // Compact "here's what you're publishing" recap. Everything is already in
    // memory on savedLegs; this just makes a wrong date/price visible BEFORE
    // the ride goes live rather than when a rider books it (audit 8/28).
    function renderPublishSummary() {
      const box = $('publishSummary');
      if (!box) return;
      const legs = savedLegs && savedLegs.length ? savedLegs : (cur && cur.start ? [cur] : []);
      if (!legs.length) { box.classList.add('hidden'); return; }
      const shortPlace = (a) => {
        const parts = String(a || '').split(',').map((s) => s.trim()).filter(Boolean);
        return parts.length >= 2 ? parts[parts.length - 2] : (parts[0] || '');
      };
      const fmt12 = (t) => {
        const [H, M] = String(t || '').split(':').map(Number);
        if (!isFinite(H)) return '';
        const ap = H >= 12 ? 'PM' : 'AM';
        const h = H % 12 === 0 ? 12 : H % 12;
        return h + ':' + String(M || 0).padStart(2, '0') + ' ' + ap;
      };
      box.innerHTML = '';
      const title = document.createElement('div');
      title.style.cssText = 'font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#888;margin-bottom:8px;';
      title.textContent = legs.length > 1 ? "You're publishing 2 trips" : "You're publishing";
      box.appendChild(title);
      legs.forEach((leg, i) => {
        const row = document.createElement('div');
        row.style.cssText = 'font-size:14px;line-height:1.55;' + (i ? 'margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,0.08);' : '');
        const r1 = document.createElement('div');
        r1.style.cssText = 'font-weight:700;';
        r1.textContent = shortPlace(leg.fromAddress) + ' → ' + shortPlace(leg.toAddress);
        const r2 = document.createElement('div');
        r2.style.cssText = 'color:#9a9aa4;';
        const dates = (leg.dates || []).slice().sort();
        const when = dates.length === 1
          ? fmtDateShort(dates[0]) + ' · ' + fmt12(leg.perDateTimes[dates[0]] || leg.time)
          : dates.length + ' dates · ' + fmt12(leg.time);
        r2.textContent = when + ' · ' + leg.seatCount + ' seat' + (leg.seatCount === 1 ? '' : 's') + ' · $' + leg.priceUsd + '/seat';
        row.appendChild(r1); row.appendChild(r2);
        box.appendChild(row);
      });
      box.classList.remove('hidden');
    }
    $('publishRetryBtn').addEventListener('click', () => { void publishAll(); });
    // Pop the last queued leg back into the wizard so its price/date/seats can
    // be corrected, then re-publish through the normal path.
    $('emailBackBtn').addEventListener('click', () => {
      if (savedLegs.length) cur = savedLegs.pop();
      void enterPrice();
    });
    async function startAuthThenPublish() {
      // If the return leg's dates conflict with the outbound (<4h), catch it
      // here rather than letting the server bounce one leg.
      if (savedLegs.length === 2) {
        const all = [];
        for (const leg of savedLegs) for (const d of leg.dates) all.push(new Date(d + 'T' + (leg.perDateTimes[d] || leg.time) + ':00').getTime());
        all.sort((a, b) => a - b);
        for (let i = 1; i < all.length; i++) {
          if (all[i] - all[i - 1] < 4 * 3600 * 1000) {
            cur = savedLegs.pop();
            enterDates();
            setMsg('datesMsg', 'Your return departs within 4 hours of an outbound date — leave yourself time to drive there.');
            return;
          }
        }
      }
      const { data: sessionData } = await supabase.auth.getSession();
      if (!sessionData.session) { renderPublishSummary(); show('stEmail'); return; }
      const { data: userData } = await supabase.auth.getUser();
      if (!userData || !userData.user) { renderPublishSummary(); show('stEmail'); return; }
      myUid = userData.user.id; try { localStorage.setItem('ss_last_role','driver'); } catch (_) {} void loadSaveSeats();
      await nameCheckThenPublish(userData.user);
    }
    $('emailBtn').addEventListener('click', async () => {
      setMsg('emailMsg', '');
      const email = $('email').value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setMsg('emailMsg', 'Enter a valid email address.'); return; }
      const btn = $('emailBtn');
      btn.disabled = true; btn.textContent = 'Sending…';
      const err = await sendEmailOtp(email);
      btn.disabled = false; btn.textContent = 'Email me a code';
      if (err) { setMsg('emailMsg', err); return; }
      pendingEmail = email;
      $('codeEmailEcho').textContent = email;
      $('emailCode').value = '';
      startEmailCooldown();
      show('stCode');
      $('emailCode').focus();
    });
    $('codeResend').addEventListener('click', async () => {
      setMsg('codeMsg', '');
      const err = await sendEmailOtp(pendingEmail);
      if (err) { setMsg('codeMsg', err); return; }
      startEmailCooldown();
      setMsg('codeMsg', 'New code sent.', 'ok');
    });
    $('codeChangeEmail').addEventListener('click', () => { setMsg('codeMsg', ''); show('stEmail'); });

    // ── Social sign-in (Google / Apple popup — js/ss-oauth.js) ────────────
    // The popup writes the shared session and the page never navigates, so
    // the staged legs (savedLegs/cur) survive sign-in intact. Continuation
    // mirrors the OTP verify path: role stamp (keep existing, default
    // driver), fresh-account signup event, then back into
    // startAuthThenPublish() — which now finds a session and publishes.
    if (window.SS_OAUTH) {
      window.SS_OAUTH.mount($('oauthMount'), {
        onSignedIn: async () => {
          try {
            const { data: u } = await supabase.auth.getUser();
            if (u && u.user) {
              try { await supabase.auth.updateUser({ data: { role: (u.user.user_metadata && u.user.user_metadata.role) || 'driver' } }); } catch (_) {}
              try {
                const created = u.user.created_at ? new Date(u.user.created_at).getTime() : 0;
                if (created && Date.now() - created < 10 * 60 * 1000 && window.ssTrack) {
                  window.ssTrack('CompleteRegistration', { em: u.user.email });
