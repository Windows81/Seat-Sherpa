      ret.toAddress = cur.fromAddress; ret.end = cur.start;
      // Same stops are valid in reverse; carry seats/comfort/price/instant.
      ret.stopSuggestions = cur.stopSuggestions;
      ret.stops = new Set(cur.stops);
      // Same road in reverse: geometry flipped, measurement identical.
      ret.routeGeom = cur.routeGeom ? [...cur.routeGeom].reverse() : null;
      ret.roadMiles = cur.roadMiles; ret.roadMinutes = cur.roadMinutes;
      ret.seatCount = cur.seatCount; ret.comfort = cur.comfort;
      ret.seatLayout = cur.seatLayout; ret.openSeats = Array.isArray(cur.openSeats) ? cur.openSeats.slice() : null; ret.seatMapKey = cur.seatMapKey;
      ret.instant = cur.instant; ret.priceUsd = cur.priceUsd;
