    // actually take. The choice feeds (a) roadMiles/minutes for the price cap
    // and (b) suggestStops, which then scores candidates against the CHOSEN
    // polyline instead of the straight-line corridor (the 99-vs-I5 fix).
    function encPoly(points) {
      let out = '', pl = 0, pg = 0;
      const ec = (v, prev) => {
        let i = Math.round(v * 1e5) - prev;
        let c = i << 1; if (i < 0) c = ~c;
        let str = '';
