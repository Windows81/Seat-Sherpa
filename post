    const NOTE_CASH_ANY_RE = /\b(cash|efectivo)\b/i;
    const NOTE_EXTRA_PAY_RE = /\b(extra|additional|remaining|rest\s+of\s+the|difference|more)\b[^.!?]{0,40}(\b(pay|payment|money|amount|dollars|bucks)\b|\$\s?\d)|\b(gas\s+money|split(ting)?\s+(the\s+)?gas|chip\s+in|pitch\s+in|tip\s+me|pay\s+(me|you|him|her|the\s+driver)\b(?!\s+a\s+visit)|pay(ing)?\s+directly|dinero\s+extra|pagar\s+(m[aá]s|directo|aparte))\b/i;
    const NOTE_CANCEL_DIRECT_RE = /\b(cancel|refund)\b[^.!?]{0,80}\b(i('| a)?ll\s+(still\s+)?(drive|take|pick)|drive\s+you|take\s+you|pick\s+you\s+up)\b|\b(just\s+)?cancel\s+(it|the\s+\w+)\s+and\s+(i|we)\b/i;
    const NOTE_OFFAPP_CONTACT_RE = /\b(text|call|dm|hit)\s+me\b(\s+(at|on))?(\s+(instead|directly|there|here))?(?![^.!?]{0,20}\bin\s+the\s+app\b)|\b(whats\s?app|telegram|signal\s+app|snapchat|instagram|ig|imessage|wechat|kakao|line\s+id)\b|\boff\s+(the\s+)?app\b|\boutside\s+(the\s+)?app\b/i;
    const NOTE_COPY = {
      NOTE_CONTACT: 'Keep contact details out of the note. Your note is public to everyone browsing rides, so phone numbers, emails, and links stay out. Riders can message you on Seat Sherpa once they book.',
      NOTE_OFFPLATFORM: 'Keep payment and contact on Seat Sherpa. Your note is public to everyone browsing rides, so anything about paying outside Seat Sherpa, cash, or moving the conversation elsewhere stays out. Riders book and pay through Seat Sherpa, and you can chat there once they do.',
      NOTE_EXTRA: 'The seat price is the whole price. Riders pay the price you posted and nothing more at pickup, so a note cannot ask for gas money, tips, or extra. Set the seat price to what the ride is worth and leave it there.',
      NOTE_TOO_LONG: 'Keep the note to ' + NOTE_MAX + ' characters.',
    };
    /** Machine code each hit refuses under; 'cash' is allowed (logged only). */
    const NOTE_HIT_CODE = {
      phone: 'NOTE_CONTACT', email: 'NOTE_CONTACT', link: 'NOTE_CONTACT',
      offapp_payment: 'NOTE_OFFPLATFORM', offapp_contact: 'NOTE_OFFPLATFORM', cancel_and_direct: 'NOTE_OFFPLATFORM',
      extra_payment: 'NOTE_EXTRA',
    };
    /** Default hit when the SERVER refused a note this page let through. */
    const NOTE_CODE_HIT = { NOTE_CONTACT: 'phone', NOTE_OFFPLATFORM: 'offapp_payment', NOTE_EXTRA: 'extra_payment' };
