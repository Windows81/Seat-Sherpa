        if (v.screen === 'stEmail' || v.screen === 'stCode' || v.screen === 'stName') { void startAuthThenPublish(); return true; }
        if (v.screen === 'stReturn') { show('stReturn'); return true; }
        if (v.screen === 'stPrice' && cur.time && cur.dates.length) { void enterPrice(); return true; }
        if (v.screen === 'stInstant' && cur.time && cur.dates.length) { renderInstant(); show('stInstant'); return true; }
        if (v.screen === 'stSeatMap' && cur.time && cur.dates.length) { renderSeatMap(); show('stSeatMap'); return true; }
        if (v.screen === 'stSeats' && cur.time && cur.dates.length) { renderSeats(); show('stSeats'); return true; }
        if (v.screen === 'stTime' && cur.dates.length) { enterTime(); return true; }
        if (v.screen === 'stDates' || cur.dates.length) { enterDates(); return true; }
