    const WIP_TTL_MS = 24 * 60 * 60 * 1000;
    // Screens worth resuming to. Gate/checklist states derive from the server
    // at boot and must not be restored blindly.
    const WIP_SCREENS = ['stTo', 'stStops', 'stDates', 'stTime', 'stSeats', 'stSeatMap', 'stInstant', 'stPrice', 'stReturn', 'stEmail', 'stCode', 'stName'];
    const legToJson = (l) => ({ ...l, stops: [...(l.stops || [])] });
    const legFromJson = (l) => ({ ...l, stops: new Set(Array.isArray(l.stops) ? l.stops : []) });
    function saveWip(screen) {
      if (WIP_SCREENS.indexOf(screen) === -1 || !cur || !cur.start) {
        // Not a resumable point (fresh stFrom, publishing, checklist) — a
        // stale snapshot must not resurrect after the flow moved past it.
        if (screen === 'stReady' || screen === 'stFrom') try { localStorage.removeItem(WIP_KEY); } catch (_) {}
        return;
      }
      localStorage.setItem(WIP_KEY, JSON.stringify({
        screen, cur: legToJson(cur), savedLegs: savedLegs.map(legToJson), ts: Date.now(),
