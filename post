      // NorCal ↔ SoCal corridors also get US-101 and Highway 1 as real
      // options (Justin, 2026-08-28) — Mapbox never volunteers them because
      // they're slower, so we force them with a mid-route via point and show
      // honest drive times. Only where they're sane (Bay ↔ LA/OC/SD).
      try {
        const NORCAL = new Set(['sfba', 'sanjose', 'santacruz', 'napasonoma']);
        const SOCAL = new Set(['la', 'oc', 'sd', 'santabarbara']);
        const fromD = nearestDestId(cur.start), toD = nearestDestId(cur.end);
        const isCorridor = (NORCAL.has(fromD) && SOCAL.has(toD)) || (SOCAL.has(fromD) && NORCAL.has(toD));
        // Shorter corridors where the road is a real driver preference and
        // Mapbox only volunteers one shape (Justin, 2026-08-28). Keyed on the
        // unordered metro pair, so it fires in both directions.
        // skipIf: don't force a road Mapbox already offered.
        const PAIR_ROUTES = {
          'sanjose|sfba': [
            { tag: 'US-101 (Peninsula)', skipIf: /\b101\b/, pts: [{ lat: 37.4520, lng: -122.1200 }] },   // Palo Alto on 101
            { tag: 'I-280', skipIf: /\b280\b/, pts: [{ lat: 37.3830, lng: -122.1900 }] },                 // Page Mill / 280
          ],
          'santacruz|sfba': [
            { tag: 'Highway 1 (coastal)', skipIf: /\bCA[ -]?1\b|Highway 1|Cabrillo/i, pts: [{ lat: 37.0110, lng: -122.1920 }, { lat: 37.4636, lng: -122.4286 }, { lat: 37.6138, lng: -122.4869 }] }, // Davenport + HMB + Pacifica (boundary regex — bare /CA 1/ matched CA-17, Fable C1)
          ],
          'sfba|tahoereno': [
            { tag: 'US-50 (South Lake Tahoe)', skipIf: /\bUS[ -]?50\b/, pts: [{ lat: 38.7296, lng: -120.7985 }] }, // Placerville on 50
          ],
          'sacramento|tahoereno': [
            { tag: 'US-50 (South Lake Tahoe)', skipIf: /\bUS[ -]?50\b/, pts: [{ lat: 38.7296, lng: -120.7985 }] },
          ],
          'la|sd': [
            { tag: 'I-15 (inland)', skipIf: /\b15\b/, pts: [{ lat: 33.4936, lng: -117.1484 }] },          // Temecula on 15
          ],
          'oc|sd': [
            { tag: 'I-15 (inland)', skipIf: /\b15\b/, pts: [{ lat: 33.4936, lng: -117.1484 }] },
          ],
          'la|santabarbara': [
            { tag: 'Highway 1 (coastal)', skipIf: /\bCA[ -]?1\b|Highway 1/i, pts: [{ lat: 34.0259, lng: -118.7798 }] }, // Malibu on PCH
          ],
          'fresno|la': [
            { tag: 'CA-99 (Valley towns)', skipIf: /\b99\b/, pts: [{ lat: 35.3733, lng: -119.0187 }] },   // Bakersfield on 99
          ],
        };
        const hasClass = (re) => routes.some((r) => re.test((r.legs && r.legs[0] && r.legs[0].summary) || ''));
        if (!isCorridor && routes.length) {
          const extras = PAIR_ROUTES[[fromD, toD].sort().join('|')] || [];
          const fastestShort = Math.min(...routes.map((r) => r.duration));
          for (const v of extras) {
            if (v.skipIf && hasClass(v.skipIf)) continue;
            const pts = [...v.pts].sort((a, b2) => haversineMiles(cur.start, a) - haversineMiles(cur.start, b2));
            const extra = await fetchRoutes([cur.start, ...pts, cur.end].map((p) => p.lng + ',' + p.lat).join(';'), false);
            if (epoch !== routeEpoch) return;
            const r = extra[0];
            if (r && r.duration < fastestShort * 2.2) { r._forcedTag = v.tag; routes.push(r); }
          }
        }
        if (isCorridor && routes.length) {
          const vias = [];
          // Peninsula pattern (Justin, 2026-08-28): US-101 down the dense
          // Peninsula, then CA-152 over Pacheco Pass to I-5. Forced via
          // Gilroy for SF-side starts; the near-duplicate guard below drops
          // it when Mapbox's fastest already takes this shape (common for
          // San Jose starts).
          const norSide = NORCAL.has(fromD) ? fromD : (NORCAL.has(toD) ? toD : null);
          if (norSide === 'sfba' || norSide === 'sanjose') vias.push({ tag: 'US-101 → I-5 (via Gilroy)', pts: [{ lat: 37.0033, lng: -121.5663 }] });
          // TWO pins each for 101/Hwy-1 (2026-08-28 pm): with one via Mapbox
          // "finishes" the trip on 46→I-5 through Bakersfield — the forced
          // route must stay on its road the whole way or the label lies and
          // the stop suggester offers Central Valley cities on a coastal ride.
          if (!hasClass(/101/)) vias.push({ tag: 'US-101', pts: [{ lat: 36.6777, lng: -121.6555 }, { lat: 34.4208, lng: -119.6982 }] });          // Salinas + Santa Barbara
          if (!hasClass(/\bCA[ -]?1\b|Highway 1|Cabrillo/i)) vias.push({ tag: 'Highway 1 (coastal)', pts: [{ lat: 36.2704, lng: -121.8081 }, { lat: 35.3658, lng: -120.8499 }] }); // Big Sur + Morro Bay
          // Central Valley (Justin, 2026-08-30: 'at least 1 hw 1, hw 101,
          // highway 5, and one that goes thru central valley'). CA-99 hits
          // the towns I-5 skips — Fresno first, Bakersfield pins the spine.
          if (!hasClass(/\b99\b/)) vias.push({ tag: 'CA-99 (Central Valley — Fresno)', pts: [{ lat: 36.7378, lng: -119.7871 }, { lat: 35.3733, lng: -119.0187 }] }); // Fresno + Bakersfield
          const fastest = Math.min(...routes.map((r) => r.duration));
          for (const v of vias) {
            // Vias are listed north→south; order them from the driver's start
            // so the reverse direction (LA→SF) doesn't zigzag.
            const pts = [...v.pts].sort((a, b2) => haversineMiles(cur.start, a) - haversineMiles(cur.start, b2));
            const extra = await fetchRoutes(
              [cur.start, ...pts, cur.end].map((p) => p.lng + ',' + p.lat).join(';'), false);
            if (epoch !== routeEpoch) return;
            const r = extra[0];
            // Sanity: a forced route more than 2.2x the fastest is a detour
            // nobody would drive; one whose PATH already exists is a
            // duplicate. Duration/distance twins are NOT proof (SF→LA via
            // 280/101/152 scores within 1% of 580/5/210 — different roads),
            // so sample three points along the forced geometry and require
            // all of them to sit on an existing polyline.
            const ptOf = (geo, f) => { const cs = geo.geometry.coordinates; const c2 = cs[Math.floor((cs.length - 1) * f)]; return { lng: c2[0], lat: c2[1] }; };
            const distToRoute = (p, rt) => {
              const cs = rt.geometry.coordinates;
              const kx = Math.cos((p.lat * Math.PI) / 180);
              let best = Infinity;
              for (let i = 0; i < cs.length - 1; i++) {
                const ax = (cs[i][0] - p.lng) * kx, ay = cs[i][1] - p.lat;
                const bx = (cs[i + 1][0] - p.lng) * kx, by = cs[i + 1][1] - p.lat;
                const dx = bx - ax, dy = by - ay;
                const len2 = dx * dx + dy * dy;
                let tt = len2 > 0 ? -(ax * dx + ay * dy) / len2 : 0;
                tt = Math.max(0, Math.min(1, tt));
                const px = ax + dx * tt, py = ay + dy * tt;
                const dd = Math.sqrt(px * px + py * py) * 69;
                if (dd < best) best = dd;
              }
              return best;
            };
            const dup = r && routes.some((x) => [0.25, 0.5, 0.75].every((f) => distToRoute(ptOf(r, f), x) < 8));
            if (r && !dup && r.duration < fastest * 2.2) {
              r._forcedTag = v.tag;
              routes.push(r);
            }
          }
        }
      } catch (_) { /* corridor extras are best-effort */ }

      $('routeLoading').classList.add('hidden');
      if (routes.length === 0) { chooseRoute(null); return; }   // API down → old flow
      if (routes.length === 1) { chooseRoute(routes[0]); return; } // nothing to choose

      routes.sort((a, b) => a.duration - b.duration);            // fastest first
      let selIdx = 0;
      const labelOf = (r) => {
