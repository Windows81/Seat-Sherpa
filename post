  <script src="/js/ss-appbar.js"></script>
  <script>
    // Mounted once .wrap exists: mount() measures that column to size the
    // bar, and this script sits above it (bug scan 2026-09-06 — mounting at
    // parse time left the bar at the 1180px fallback over a 600px wizard).
    document.addEventListener('DOMContentLoaded', function () {
      if (!window.SS_APPBAR) return;
      var bar = SS_APPBAR.mount({ active: 'post' });
      if (bar && SS_APPBAR.signedIn()) {
        var b = document.querySelector('.wrap > .brand');
        if (b) b.style.display = 'none';
