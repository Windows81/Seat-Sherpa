<body>
  <!-- Shared console app bar (ss-appbar.js): a signed-in driver always has
       Trips / Driving / Messages one tap away, even mid-wizard. mount() is a
       no-op when signed out, so first-time visitors keep the plain logo. -->
  <script src="/js/ss-appbar.js"></script>
  <script>
    (function () {
      if (!window.SS_APPBAR) return;
      var bar = SS_APPBAR.mount({ active: 'post' });
      if (bar) document.addEventListener('DOMContentLoaded', function () {
        var b = document.querySelector('.wrap > .brand');
        if (b) b.style.display = 'none';
      });
    })();
  </script>
  <div class="wrap">
    <div class="brand">
      <svg style="height:36px;width:auto;display:block" viewBox="0 -22 600 144" role="img" aria-label="Seat Sherpa" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="wmg" x1="0" y1="1" x2="0.35" y2="0"><stop offset="0" stop-color="#0F9C93"/><stop offset="1" stop-color="#24E4D8"/></linearGradient></defs><g transform="translate(-36.4 -50) scale(0.427)"><path d="M150 342 C 162 312, 236 286, 240 250 C 245 210, 90 196, 94 160 C 97 115, 158 99, 186 86 Q 200 76 214 86 C 192 99, 141 115, 146 160 C 150 196, 313 210, 316 250 C 320 286, 254 312, 250 342 Z" fill="url(#wmg)" stroke="#0B5650" stroke-width="4"/><path d="M200 342 C 208 312, 278 286, 278 250 C 279 210, 120 196, 120 160 C 119 115, 175 99, 200 86" fill="none" stroke="#FFFFFF" stroke-width="5" stroke-linecap="butt" stroke-dasharray="9 16"/></g><text x="101" y="96" font-family="Outfit, sans-serif" font-weight="600" font-size="86" fill="#00D4C8">eat</text><text x="263" y="96" font-family="Outfit, sans-serif" font-weight="600" font-size="86" fill="#ffffff">Sherpa</text></svg>
    </div>

    <!-- Escape hatches (2026-09-03): a wizard with no way out strands people.
         "Start over" wipes the saved draft and reloads; "Back to dashboard"
         is for signed-in drivers (the app bar covers it too), home otherwise. -->
    <!-- Two pills, opposite ends, different weights (Justin, 2026-09-04: the
         dot-separated pair read as one link). -->
    <div id="postEscape" style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin:-8px 0 14px;font-size:13px;">
      <a href="/driving" id="postBackDash" style="color:#00D4C8;font-weight:700;text-decoration:none;border:1px solid rgba(0,212,200,.35);border-radius:999px;padding:6px 12px;">← Back to dashboard</a>
      <a href="#" id="postStartOver" style="color:#E8E8EC;font-weight:600;text-decoration:none;border:1px solid rgba(255,255,255,.28);border-radius:999px;padding:6px 12px;">↺ Start over</a>
    </div>

    <!-- ── FLOW SCREENS ─────────────────────────────────────────────────── -->

    <!-- Where from? -->
    <!-- ONE combined From+To card (Justin, 2026-08-28, BlaBlaCar-style: "just
         a simple from where to where, as opposed to two separate pages" +
         the savings hook up front). stTo below stays in the DOM for the
         restore path but never shows. -->
    <div class="card hidden" id="stFrom">
      <div class="eyebrow">Post a ride</div>
      <div id="reqBanner" class="hidden" style="background:rgba(0,212,200,0.08);border:1px solid rgba(0,212,200,0.25);border-radius:12px;padding:10px 14px;font-size:13.5px;color:#b9e8e4;line-height:1.5;margin-bottom:12px;"></div>
      <h1>Where are you driving?</h1>
      <p class="sub">Exact spots — riders only see the neighborhood. CA & NV trips, 15+ miles.</p>
      <div class="ac-wrap">
        <label for="fromInput">Leaving from</label>
        <input id="fromInput" type="text" autocomplete="off" placeholder="e.g. Caltrain Station, San Jose" />
        <div class="ac-list hidden" id="fromList"></div>
      </div>
      <div class="picked hidden" id="fromPicked"><span>📍</span><span class="addr" id="fromPickedAddr"></span><button class="linkbtn" id="fromChange">Change</button></div>
      <div class="ac-wrap">
        <label for="toInput">Going to</label>
        <input id="toInput" type="text" autocomplete="off" placeholder="e.g. Union Station, Los Angeles" />
        <div class="ac-list hidden" id="toList"></div>
      </div>
      <div class="picked hidden" id="toPicked"><span>🏁</span><span class="addr" id="toPickedAddr"></span><button class="linkbtn" id="toChange">Change</button></div>
      <p class="sub" id="saveLine" style="margin:2px 0 14px;font-size:16px;color:#fff;">Save up to <strong id="saveAmt" style="color:#00D4C8;">$209</strong> on <span id="saveTripWord">a trip</span> — riders chip in for the seats you're driving anyway.</p>
      <button class="primary" id="fromBtn" disabled>Continue</button>
      <div class="msg err hidden" id="fromMsg"></div>
    </div>

    <!-- Legacy separate dropoff step — kept for the WIP-restore path only;
         the combined card above owns the live flow. -->
    <div class="card hidden" id="stTo">
      <div class="backrow"><button class="linkbtn" data-back="stFrom">← Back</button></div>
      <div class="eyebrow">Post a ride</div>
      <h1>Where are you headed?</h1>
      <p class="sub">Your dropoff. Seat Sherpa serves trips of 15 miles or more inside California and Nevada.</p>
      <button class="primary hidden" id="toBtn" disabled>Continue</button>
      <div class="msg err hidden" id="toMsg"></div>
    </div>

    <!-- Route choice (2026-08-28, Justin: choose the actual road on Mapbox;
         stop suggestions then come from the CHOSEN route, not a corridor
         guess). Skipped automatically when Mapbox returns one route. -->
    <div class="card hidden" id="stRoute">
      <div class="backrow"><button class="linkbtn" data-back="stFrom">← Back</button></div>
      <div class="eyebrow">Post a ride</div>
      <h1>Which way are you driving?</h1>
      <p class="sub">Pick your route — pickup stops get suggested along it.</p>
      <div id="routeLoading" class="center" style="padding: 10px 0 18px;"><div class="spinner"></div><p class="sub" style="margin:0;">Finding routes…</p></div>
      <img id="routeMap" class="hidden" alt="Route options" style="width:100%;border-radius:12px;border:1px solid rgba(255,255,255,0.08);margin-bottom:12px;background:#101014;" />
      <div id="routeList"></div>
      <button class="primary hidden" id="routeBtn">Continue</button>
      <div class="msg err hidden" id="routeMsg"></div>
    </div>

    <!-- Stopovers -->
    <div class="card hidden" id="stStops">
      <div class="backrow"><button class="linkbtn" id="stopsBackBtn">← Back</button></div>
      <div class="eyebrow">Post a ride</div>
      <h1>Add stopovers to get more riders</h1>
      <p class="sub">Better odds of filling every seat &mdash; each stop adds a whole city of riders who can hop in along the way, for just a quick pull-off. You&rsquo;ll set prices for the shorter legs at the price step.</p>
      <div id="stopsLoading" class="center" style="padding: 10px 0 18px;"><div class="spinner"></div><p class="sub" style="margin:0;">Checking your route…</p></div>
      <div id="stopsList"></div>
      <div class="ac-wrap hidden" id="stopAddWrap" style="margin-top:2px;">
        <label for="stopAddInput">Add a city on your route</label>
        <input id="stopAddInput" type="text" autocomplete="off" placeholder="e.g. Kettleman City" />
        <div class="ac-list hidden" id="stopAddList"></div>
      </div>
      <button class="linkbtn" type="button" id="stopAddBtn" style="display:block;margin:2px 0 14px;">+ Add a city</button>
      <button class="primary" id="stopsBtn">Continue</button>
      <div class="msg err hidden" id="stopsMsg"></div>
    </div>

    <!-- Dates -->
    <div class="card hidden" id="stDates">
      <div class="backrow"><button class="linkbtn" id="datesBackBtn">← Back</button></div>
      <div class="eyebrow" id="datesEyebrow">Post a ride</div>
      <h1 id="datesTitle">When are you going?</h1>
      <p class="sub" id="datesSub">Pick the date of your drive.</p>
      <!-- Always-multi (2026-08-28, BlaBlaCar-style): no toggle to find —
           tap as many dates as you drive, up to 20. -->
      <div class="multirow" id="multiRow">
        <span class="multilabel">Multiple dates</span>
        <button type="button" class="msw" id="multiSw" role="switch" aria-checked="true" aria-label="Multiple dates"><span class="mswknob"></span></button>
      </div>
      <div class="cal" id="calendar"></div>
      <button class="primary" id="datesBtn" disabled>Continue</button>
      <div class="msg err hidden" id="datesMsg"></div>
    </div>

    <!-- Time -->
    <div class="card hidden" id="stTime">
      <div class="backrow"><button class="linkbtn" data-back="stDates">← Back</button></div>
      <div class="eyebrow">Post a ride</div>
      <h1>What time do you leave?</h1>
      <p class="sub" id="timeSub">Departure time for your ride.</p>
      <!-- Soft lead-time nudge (Justin, 2026-09-03: "no soft prompt that
           posting a few days in advance will get me more riders"). Shown when
           the earliest date is today or tomorrow; never blocks. -->
      <div class="msg hidden" id="leadHint" style="color:#F5F5F7;border:1px solid rgba(0,212,200,0.45);background:rgba(0,212,200,0.10);border-radius:10px;padding:10px 12px;margin:0 0 14px;font-size:14px;line-height:1.5;"></div>
      <label for="timeHour">Departure time</label>
      <!-- Dropdowns, not free entry (Justin, 2026-09-01): minutes locked to
           00/15/30/45 like the app; browsers don't enforce step on typed
           values, so the native picker let any minute through. -->
      <div class="timegrp">
        <select id="timeHour" aria-label="Hour"><option value="">Hour</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option><option>8</option><option>9</option><option>10</option><option>11</option><option>12</option></select>
        <select id="timeMin" aria-label="Minutes"><option>00</option><option>15</option><option>30</option><option>45</option></select>
        <select id="timeAmPm" aria-label="AM or PM"><option>AM</option><option>PM</option></select>
      </div>
      <div id="perDateWrap" class="hidden">
        <button class="linkbtn" id="perDateToggle" style="margin: 0 0 12px;">Set a different time for a specific date</button>
        <div id="perDateList" class="hidden"></div>
      </div>
      <button class="primary" id="timeBtn" disabled>Continue</button>
      <div class="msg err hidden" id="timeMsg"></div>
    </div>

    <!-- Seats + comfort -->
    <div class="card hidden" id="stSeats">
      <div class="backrow"><button class="linkbtn" data-back="stTime">← Back</button></div>
      <div class="eyebrow">Post a ride</div>
      <h1>How many riders?</h1>
      <p class="sub">Seats you're offering on this trip.</p>
      <div class="stepper">
        <button id="seatMinus" aria-label="Fewer seats">−</button>
        <div class="val" id="seatVal">3</div>
        <button id="seatPlus" aria-label="More seats">+</button>
      </div>
      <p class="hint hidden" id="seatFitNote"></p>
      <div class="msg err hidden" id="seatsMsg"></div>
      <button class="choice sel" id="comfortRow" type="button">
        <span class="tick" id="comfortTick">✓</span>
        <span><span class="t">Max 2 in the back</span>
        <span class="d">Think comfort — no one in a middle seat. A sedan offers 3 this way, a 3-row car up to 5. Turn it off to fill every seat (up to 6); the trip's cost-sharing cap is split across more seats, so the max price per seat drops.</span></span>
      </button>
      <button class="primary" id="seatsBtn">Continue</button>
    </div>

    <!-- Seat map (2026-09-04): confirm exactly which seats are for sale -->
    <div class="card hidden" id="stSeatMap">
      <div class="backrow"><button class="linkbtn" data-back="stSeats">← Back</button></div>
      <div class="eyebrow">Post a ride</div>
      <h1>Which seats?</h1>
      <p class="sub">Tap a seat to close or open it. Closed seats stay in the car but aren't for sale.</p>
      <div class="seatmapcar" id="seatMapCar"></div>
      <p class="hint" id="seatMapSum" style="text-align:center;margin-top:0"></p>
      <button class="primary" id="seatMapBtn">Confirm seats</button>
    </div>

    <!-- Instant book -->
    <div class="card hidden" id="stInstant">
      <div class="backrow"><button class="linkbtn" data-back="stSeatMap">← Back</button></div>
      <div class="eyebrow">Post a ride</div>
      <h1>How do you want to take bookings?</h1>
      <p class="sub">You can change this later in the app.</p>
      <button class="choice sel" id="reviewRow" type="button">
        <span class="tick radio" id="reviewTick">✓</span>
        <span><span class="t">Review every request</span>
        <span class="d">Riders request a seat; you approve each one. Works right away — no deposit setup needed to receive requests.</span></span>
      </button>
      <button class="choice" id="instantRow" type="button">
        <span class="tick radio" id="instantTick"></span>
        <span><span class="t">Instant Book</span>
        <span class="d" id="instantDesc">Riders book without waiting for approval. Needs deposits (Stripe) connected — until then, riders send requests you approve.</span></span>
      </button>
      <button class="primary" id="instantBtn">Continue</button>
    </div>

    <!-- Price -->
    <div class="card hidden" id="stPrice">
      <div class="backrow"><button class="linkbtn" data-back="stInstant">← Back</button></div>
      <div class="eyebrow">Post a ride</div>
      <h1>Set your price per seat</h1>
      <p class="sub">Riders split your costs for the trip — gas, tolls, wear. You keep the seat price minus a small service fee.</p>
      <div class="stepper">
        <button id="priceMinus" aria-label="Lower price">−</button>
        <div class="val" id="priceVal">$—</div>
        <button id="pricePlus" aria-label="Raise price">+</button>
      </div>
      <p class="sub" id="priceSplit" style="text-align:center; margin: 2px 0 10px;"></p>
      <span class="pill hidden" id="priceBand"></span>
      <p class="sub hidden" id="priceHint" style="text-align:center;margin:8px 0 4px;"></p>
      <span class="pill cap hidden" id="priceCapLine">Prices are capped at the trip's shared cost.</span>
      <!-- Per-segment suggested prices (Justin, 2026-09-01, BlaBlaCar-style):
           when the route has stops, show the driver what each shorter leg
           sells for — same formula the server bills riders with at booking
           (segmentFactor: distance share, 0.3 floor, $10 min, capped at full). -->
      <div id="segWrap" class="hidden" style="margin:16px 0 6px;">
        <div style="font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#888;margin-bottom:2px;">Prices for shorter legs</div>
        <div style="font-size:12.5px;color:#9a9aa2;margin-bottom:8px;">Riders who board or hop off at your stops pay what you set here. We suggest prices for your five biggest legs &mdash; edit any box, or clear it to charge the full seat price. Legs you don&rsquo;t price simply charge the full seat.</div>
        <div id="segList"></div>
      </div>
      <!-- Prices of similar rides (2026-08-28, BlaBlaCar parity) — real
           upcoming rides on this corridor from the public marketplace. -->
      <div id="similarWrap" class="hidden" style="margin:16px 0 6px;">
        <div style="font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#888;margin-bottom:8px;">Prices of similar rides</div>
        <div id="similarList"></div>
      </div>
      <button class="primary" id="priceBtn" disabled>Continue</button>
      <div class="msg err hidden" id="priceMsg"></div>
    </div>

    <!-- Return trip -->
    <!-- Regular drive? (Justin, 2026-08-28) — a late-flow catch for drivers
         who picked one date but actually make this drive often. Shown only
         when a single date is selected on the outbound leg. -->
    <div class="card hidden" id="stRegular">
      <div class="backrow"><button class="linkbtn" data-back="stPrice">← Back</button></div>
      <div class="eyebrow">Post a ride</div>
      <h1>Is this a regular drive?</h1>
      <p class="sub">Add every date you make this drive — each one posts as its own ride, same time, seats and price.</p>
      <button class="choice" id="regularYes" type="button">
        <span class="tick radio"></span>
        <span><span class="t">Yes — add more dates</span>
        <span class="d">Pick them on the calendar next.</span></span>
      </button>
      <button class="choice" id="regularNo" type="button">
        <span class="tick radio"></span>
        <span><span class="t">No, just this once</span>
        <span class="d">Keep the single date.</span></span>
      </button>
    </div>

    <div class="card hidden" id="stReturn">
      <div class="backrow"><button class="linkbtn" data-back="stPrice">← Back</button></div>
      <div class="eyebrow">Post a ride</div>
      <h1>Coming back? Publish the return now</h1>
      <p class="sub">Same route in reverse, same seats and price — you just pick the dates and time.</p>
      <button class="choice" id="returnYes" type="button">
        <span class="tick radio"></span>
        <span><span class="t">Yes, sure!</span>
        <span class="d">Pick your return dates next.</span></span>
      </button>
      <button class="choice" id="returnNo" type="button">
        <span class="tick radio"></span>
        <span><span class="t">I'll do it later</span>
        <span class="d">Post just this direction for now.</span></span>
      </button>
      <div class="msg err hidden" id="returnMsg"></div>
    </div>

    <!-- Email OTP (+ Google/Apple via js/ss-oauth.js) -->
    <div class="card hidden" id="stEmail">
      <!-- Without this the driver is stuck: browser-back leaves the page and
           reload lands right back here, so a wrong price/date spotted at
           sign-in was unfixable (audit 8/28). -->
      <div class="backrow"><button class="linkbtn" id="emailBackBtn">← Back to edit the ride</button></div>
      <div class="eyebrow">Post a ride · Sign in</div>
      <h1>Sign in to post your ride</h1>
      <!-- Last chance to catch a wrong date/time/price before it's live and
           bookable (audit 8/28: nothing summarized the ride before publish). -->
      <div id="publishSummary" class="hidden" style="background:#0E0E10;border:1px solid rgba(255,255,255,0.12);border-radius:12px;padding:13px 15px;margin:2px 0 16px;"></div>
      <div id="oauthMount" style="margin-top:14px;"></div>
      <p class="sub">We'll email you a sign-in code — no password needed. Then your ride posts.</p>
      <label for="email">Email</label>
      <input id="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" />
      <button class="primary" id="emailBtn">Email me a code</button>
      <p data-tos-notice style="color:#8a8a92;font-size:12px;margin:10px 0 0;">By continuing you agree to the <a href="/terms" style="color:#00D4C8;text-decoration:none;">Terms of Service</a> and <a href="/privacy" style="color:#00D4C8;text-decoration:none;">Privacy Policy</a>.</p>
      <div class="msg err hidden" id="emailMsg"></div>
      <p data-tos-notice class="hint" style="margin-top:12px;">By continuing you agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
    </div>

    <!-- Email code -->
    <div class="card hidden" id="stCode">
      <div class="eyebrow">Post a ride · Verify email</div>
      <h1>Enter the code we emailed you</h1>
      <p class="sub">We sent it to <strong id="codeEmailEcho"></strong>. It can take a minute — check spam too.</p>
      <input id="emailCode" class="codeinput" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder="••••••" />
      <button class="primary" id="codeBtn">Verify</button>
      <div class="rowlinks">
        <button class="linkbtn" id="codeResend">Resend code</button>
        <button class="linkbtn" id="codeChangeEmail">Use a different email</button>
      </div>
      <div class="msg err hidden" id="codeMsg"></div>
    </div>

    <!-- Name (only when the profile doesn't have a real one) -->
    <div class="card hidden" id="stName">
      <div class="eyebrow">Post a ride · Your name</div>
      <h1>What's your name?</h1>
      <p class="sub">Riders see your first name and last initial on the ride.</p>
      <label for="nameInput">Your name</label>
      <input id="nameInput" type="text" autocomplete="name" placeholder="First Last" />
      <button class="primary" id="nameBtn">Continue</button>
      <div class="msg err hidden" id="nameMsg"></div>
    </div>

    <!-- Publishing -->
    <div class="card center hidden" id="stPublishing">
      <div id="publishBusy">
        <div class="spinner"></div>
        <h1>Posting your ride…</h1>
        <p class="sub" style="margin-bottom:0;">One moment.</p>
      </div>
      <!-- Network failure keeps the ride in memory and offers a real retry —
           it used to dump the driver on the dates screen with a network
           message and no way back except re-walking the wizard (audit 8/28). -->
      <div id="publishRetry" class="hidden">
        <div class="icon">📡</div>
        <h1>Couldn't reach Seat Sherpa</h1>
        <p class="sub" id="publishRetrySub">Your ride is safe — nothing was lost. Check your connection and try again.</p>
        <button class="primary" id="publishRetryBtn">Try publishing again</button>
      </div>
    </div>

    <!-- Ready + gates -->
    <div class="card hidden" id="stReady">
      <div class="eyebrow">Post a ride</div>
      <h1 id="readyTitle">Your ride is ready</h1>
      <p class="sub" id="readySub">Here's what you're offering.</p>
      <div id="rideCards"></div>
      <div class="statusline" id="statusLine">Checking status…</div>
      <div class="gates" id="gateList"></div>
      <div class="msg err hidden" id="readyMsg"></div>
      <div id="liveLinks" class="hidden" style="margin-top: 14px;"></div>
      <div class="signedin" id="readyFooter" style="margin-top:16px;">
        <button class="linkbtn" id="postAnotherBtn">Post another ride</button>
        <span id="signedInWrap" class="hidden"> · Signed in as <span id="signedInEmail"></span> · <button class="linkbtn" id="signOutBtn">Not you?</button></span>
      </div>
    </div>

    <!-- ── GATE SCREENS ─────────────────────────────────────────────────── -->

    <!-- Phone -->
    <div class="card hidden" id="gPhone">
      <div class="backrow"><button class="linkbtn" data-back="stReady">← Back to your ride</button></div>
      <div class="eyebrow">Almost there · Confirm phone</div>
      <h1>Confirm your phone</h1>
      <p class="sub">Riders need to reach you at pickup. Your number stays private until ride day &mdash; it's only shared starting 24 hours before departure, and never used for marketing. We'll text you a 6-digit code.</p>
      <div id="phoneEntry">
        <div style="display:flex; gap:10px;">
          <div style="width:88px;">
            <label for="phoneCc">Country</label>
            <input id="phoneCc" type="tel" inputmode="numeric" value="1" maxlength="4" style="text-align:center;" />
          </div>
          <div style="flex:1;">
            <label for="phoneNum">Phone number</label>
            <input id="phoneNum" type="tel" autocomplete="tel-national" inputmode="tel" placeholder="555 123 4567" />
          </div>
        </div>
        <button class="primary" id="phoneSendBtn">Text me a code</button>
      </div>
      <div id="phoneCodeEntry" class="hidden" style="margin-top:14px;">
        <label for="phoneCode">6-digit code</label>
        <input id="phoneCode" class="codeinput" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="••••••" />
        <button class="primary" id="phoneVerifyBtn">Confirm phone</button>
        <div class="rowlinks">
          <button class="linkbtn" id="phoneResend">Resend code</button>
          <button class="linkbtn" id="phoneChange">Change number</button>
        </div>
      </div>
      <div class="msg err hidden" id="phoneMsg"></div>
    </div>

    <!-- Photo + bio + license — ONE screen (Justin, 2026-09-02: "didn't we
         make it so that it's one screen to add bio, pic, and DL?"). The three
         forms keep their ids and handlers; each saves on its own and the
         screen stays put until all three are on file. -->
    <div class="card hidden" id="gProfile">
      <div class="backrow"><button class="linkbtn" data-back="stReady">← Back to your ride</button></div>
      <div class="eyebrow">Almost there · Photo, bio &amp; license</div>
      <h1>Riders need to know who's driving</h1>
      <p class="sub">Three quick things, all on this page. Your photo and bio are public; the license is private and never shown to riders.</p>

      <div class="profsec" id="secPhoto">
