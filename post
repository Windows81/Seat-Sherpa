        return;
      }
      // Route is confirmed — measure the real drivable distance NOW (not at
      // publish) so the price cap and seat-fit downstream use it. Best-effort:
      // stale results for an abandoned route are guarded by the coord check.
      // Route chooser (2026-08-28) owns the road measurement now — the chosen
      // alternative IS the driver's actual miles/minutes. The old prefetch
      // survives inside chooseRoute's no-routes fallback.
      void enterRoute();
    });

    // ── Route chooser (2026-08-28) ────────────────────────────────────────
    // Mapbox Directions alternatives → the driver picks the road they'll
    // actually take. The choice feeds (a) roadMiles/minutes for the price cap
    // and (b) suggestStops, which then scores candidates against the CHOSEN
    // polyline instead of the straight-line corridor (the 99-vs-I5 fix).
    function encPoly(points) {
      let out = '', pl = 0, pg = 0;
      const ec = (v, prev) => {
        let i = Math.round(v * 1e5) - prev;
        let c = i << 1; if (i < 0) c = ~c;
        let str = '';
        while (c >= 0x20) { str += String.fromCharCode((0x20 | (c & 0x1f)) + 63); c >>= 5; }
        return str + String.fromCharCode(c + 63);
      };
      for (const p of points) {
        out += ec(p.lat, pl) + ec(p.lng, pg);
        pl = Math.round(p.lat * 1e5); pg = Math.round(p.lng * 1e5);
      }
      return out;
    }
    function downsample(points, max) {
      if (points.length <= max) return points;
      const step = (points.length - 1) / (max - 1);
      const out = [];
      for (let i = 0; i < max; i++) out.push(points[Math.round(i * step)]);
      return out;
    }
    function fmtDur(sec) {
      const m = Math.round(sec / 60);
      return m >= 60 ? Math.floor(m / 60) + 'h ' + (m % 60) + 'm' : m + ' min';
    }
    function geomOf(r) { return r.geometry.coordinates.map((c2) => ({ lng: c2[0], lat: c2[1] })); }
    function slimPts(geom, n) {
      return downsample(geom, n).map((p) => ({ lat: Math.round(p.lat * 1e4) / 1e4, lng: Math.round(p.lng * 1e4) / 1e4 }));
    }
    // ONE combined map (Justin, 2026-08-28): every option drawn together —
    // the SELECTED route bold dark teal, the rest light teal underneath.
    function routesMapUrl(routes, selIdx) {
      // Light map for a light system theme (2026-10-12); dark otherwise. The
      // pale alternates vanish on the light basemap, so they go a shade deeper.
      const lightMap = !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches);
      const altLine = lightMap ? '5CC2BA-0.7' : '8AE8E1-0.55';
      const overlays = [];
      routes.forEach((r, i) => {
        if (i === selIdx) return;
        overlays.push('path-3+' + altLine + '(' + encodeURIComponent(encPoly(slimPts(geomOf(r), 35))) + ')');
      });
      // Selected LAST so it draws on top.
      overlays.push('path-5+00B8AD-0.95(' + encodeURIComponent(encPoly(slimPts(geomOf(routes[selIdx]), 45))) + ')');
      const mapStyle = lightMap ? 'light-v11' : 'dark-v11';
      return 'https://api.mapbox.com/styles/v1/mapbox/' + mapStyle + '/static/'
        + overlays.join(',') + '/auto/640x300@2x?padding=32&access_token=' + MAPBOX_TOKEN;
    }
    async function fetchRoutes(coordsStr, alternatives) {
      const res = await fetch('https://api.mapbox.com/directions/v5/mapbox/driving/' + coordsStr
