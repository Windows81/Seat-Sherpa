    }
    // "1 date" → "Fri, Sep 5 · 7:00 AM"; several → "3 dates · Sep 5, 6, 7 · 7:00 AM"
    // ("times vary" when per-date times differ). Justin, 2026-09-02.
    function draftWhen(d) {
      const dates = Array.isArray(d.dates) ? d.dates : [];
      if (dates.length === 0) return d.nDates === 1 ? '1 date' : d.nDates + ' dates';
      const fmtDate = (iso, withWeekday) => {
        const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso); if (!m) return iso;
        const dt = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
        return dt.toLocaleDateString('en-US', withWeekday ? { weekday: 'short', month: 'short', day: 'numeric' } : { month: 'short', day: 'numeric' });
      };
      const fmtTime = (t) => {
        const m = /^(\d{1,2}):(\d{2})$/.exec(t || ''); if (!m) return '';
        let h = Number(m[1]); const ap = h >= 12 ? 'PM' : 'AM'; h = h % 12 || 12;
        return h + ':' + m[2] + ' ' + ap;
      };
      const times = new Set(dates.map((iso) => (d.perDateTimes && d.perDateTimes[iso]) || d.time || ''));
      const timeStr = times.size === 1 ? fmtTime([...times][0]) : 'times vary';
      if (dates.length === 1) return fmtDate(dates[0], true) + (timeStr ? ' · ' + timeStr : '');
      const sorted = dates.slice().sort();
      const list = sorted.length <= 4 ? sorted.map((iso) => fmtDate(iso, false)).join(', ') : fmtDate(sorted[0], false) + ' → ' + fmtDate(sorted[sorted.length - 1], false);
      return sorted.length + ' dates · ' + list + (timeStr ? ' · ' + timeStr : '');
    }
    function shortPlace(addr) {
      const parts = (addr || '').split(',').map((s) => s.trim()).filter(Boolean);
      if (parts.length === 0) return addr || '';
      // City first (region-as-city guard, review 2026-10-02); then the old
      // rule: first non-numeric-ish chunk reads as the place name.
      return ssCityOf(addr) || (parts.length >= 2 && /\d/.test(parts[0]) ? parts[1] : parts[0]);
    }

    async function refreshGates() {
      // 1. Client-side reads for instant checkmarks (all under the driver's
      //    own RLS — the same reads the app makes).
      try {
        const { data: userData } = await supabase.auth.getUser();
        if (userData && userData.user) {
          myUid = userData.user.id; try { localStorage.setItem('ss_last_role','driver'); } catch (_) {} void loadSaveSeats();
          gateState.phone = !!userData.user.phone_confirmed_at;
        }
        const { data: p } = await supabase.from('profiles')
          .select('name, bio, photo_url, driver_license_photo_url, driver_license_expiry_date, stripe_account_id, stripe_charges_enabled')
          .eq('id', myUid).maybeSingle();
        if (p) {
          gateState.photo = !!(p.photo_url || '').trim();
          const bio = (p.bio || '').trim();
          gateState.bio = bio.split(/\s+/).filter(Boolean).length >= 3 && bio.length >= 15;
          const today = pacificTodayIso();
          gateState.license = !!p.driver_license_photo_url && (!p.driver_license_expiry_date || p.driver_license_expiry_date >= today);
          gateState.payouts = !!p.stripe_account_id && p.stripe_charges_enabled === true;
        }
        const { count } = await supabase.from('vehicles').select('id', { count: 'exact', head: true }).eq('owner_id', myUid);
        gateState.car = (count || 0) > 0;
      } catch (_) {}

      // 2. Ask the server per draft: live yet? (Server truth wins on gates.)
      const { data: sessionData } = await supabase.auth.getSession();
