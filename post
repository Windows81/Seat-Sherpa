    }
    $('priceMinus').addEventListener('click', () => { cur.priceUsd = Math.max(FLOOR, cur.priceUsd - 1); renderPrice(); });
    $('pricePlus').addEventListener('click', () => { cur.priceUsd = Math.min(priceCap, cur.priceUsd + 1); renderPrice(); });
    $('priceBtn').addEventListener('click', () => {
      setMsg('priceMsg', '');
