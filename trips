      #chatBody > .card:has(> .thread) > h1 { grid-column: 2; grid-row: 2; font-size: 24px; }
      #chatBody > .card:has(> .thread) > .sub { grid-column: 2; grid-row: 3; }
      #chatBody > .card:has(> .thread) > .callrow { grid-column: 2; grid-row: 4; }
      #chatBody > .card:has(> .thread) > .linkbtn { justify-self: start; }
      #chatBody > .card:has(> .thread) > .thread {
        grid-row: 1 / 6; height: clamp(380px, calc(100vh - 330px), 820px); max-height: none;
        padding: 16px 18px; border: 1px solid var(--line-soft); border-radius: 14px;
