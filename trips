<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your trips · Seat Sherpa</title>

  <!-- Transactional, signed-in-only, and DELIBERATELY UNLINKED (2026-08-20).
       Nothing on index/rides/ride/book, the sitemap, robots.txt, or any app
       screen points here — Justin reaches it by typing the URL. noindex is the
       belt to that suspenders: a page that renders a rider's pickup code and
       their chat with a driver must never land in a search index even if
       someone pastes the link somewhere public. -->
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="#0E0E10" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#F5F6F5" media="(prefers-color-scheme: light)" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- NO marketing pixels here, unlike book.html. Meta/Reddit/Google tags exist
       to measure a conversion funnel; /trips is post-purchase account plumbing.
       Firing a third-party PageView on the screen that displays a pickup code
       and a private chat thread buys us nothing and leaks the visit. -->

  <style>
    /* Styling is lifted wholesale from book.html so the post-booking surface
       feels like the same product as the funnel that created the booking. */
    /* Color tokens + light theme (2026-10-12). Dark values are this page's
       own colors, unchanged; the light set follows the phone's or computer's
       setting. --teal is a FILL (buttons, my chat bubbles); --link is teal
       TEXT, only for things you can tap. --ssbar-* / --ssmenu-* theme the
       shared header and menu. */
    :root {
      --bg: #0E0E10; --text: #fff; --strong: #fff; --link: #00D4C8; --teal: #00D4C8; --on-teal: #04201e;
      --grad-a: #1a1a1d; --grad-b: #141416; --line: rgba(255,255,255,0.10); --line-soft: rgba(255,255,255,0.08);
      --line-input: rgba(255,255,255,0.14); --line-av: rgba(255,255,255,0.12); --line-outline: rgba(255,255,255,0.22);
      --tile: #141417; --tile-line: #232329; --input-bg: #0E0E10; --focus: #00D4C8;
      --sub: #b9b9c6; --sub2: #adadb8; --sub3: #a3a3ae; --cap: #8f8f98; --cap2: #8b8b95; --hover-text: #cfcfd6;
      --star-off: #55555f; --star-hover: #8a8a95; --danger: #ff8a8a; --ok: #4ade80;
      --amber-line: rgba(255,184,77,0.45); --amber-bg: #191509; --amber: #FFB84D; --amber-k: #e8c88c;
      --count-bg: rgba(255,255,255,0.08); --spin-track: rgba(255,255,255,0.15);
      --ref-bg: #0d1f1e; --ref-line: rgba(0,212,200,0.35); --ref-text: #00D4C8;
      --pend-bg: #24200d; --pend-line: rgba(255,193,7,0.35); --pend: #ffc94a;
      --conf-bg: #0d1f1e; --conf-line: rgba(0,212,200,0.35); --conf: #00D4C8;
      --canc-bg: #241416; --canc-line: rgba(255,138,138,0.3); --canc: #ff8a8a;
      --done-bg: #16181c; --done-line: rgba(255,255,255,0.15); --done: #b9b9c6;
      --teal-hover: rgba(0,212,200,0.4); --pickup-line: rgba(0,212,200,0.35); --code: #00D4C8; --avatar-ini: #00D4C8;
      --warn-bg: #241416; --warn-line: rgba(255,138,138,0.3); --warn-text: #ffb3b3;
      --info-bg: #141d1c; --info-line: rgba(0,212,200,0.3); --info-text: #cfe9e7;
      --neutral-bg: #16181c; --neutral-line: rgba(255,255,255,0.12); --neutral-text: #b9b9c6;
      --bub-them: #1f1f23; --bub-them-text: #fff; --bub-fail: #3a1c1f; --bub-fail-text: #ffb3b3;
      --nav-text: #b9b9c6; --nav-bg: #17171d; --nav-line: #2a2a33;
      --seat-line: rgba(0,212,200,0.45); --cancel-line: rgba(255,138,138,0.3); --done-panel-line: rgba(0,212,200,0.35);
      --call: #00a8a0; --callmsg: #6b7280;
      color-scheme: dark;
    }
    @media (prefers-color-scheme: light) {
      :root {
        --bg: #F5F6F5; --text: #121416; --strong: #121416; --link: #007C76;
        --grad-a: #FFFFFF; --grad-b: #FFFFFF; --line: rgba(18,22,22,0.10); --line-soft: rgba(18,22,22,0.10);
        --line-input: rgba(18,22,22,0.18); --line-av: rgba(18,22,22,0.12); --line-outline: rgba(18,22,22,0.18);
        --tile: #FFFFFF; --tile-line: rgba(18,22,22,0.10); --input-bg: #EFF1F0; --focus: #007C76;
        --sub: #4B5357; --sub2: #4B5357; --sub3: #4B5357; --cap: #687176; --cap2: #687176; --hover-text: #23272A;
        --star-off: #8C9498; --star-hover: #687176; --danger: #C62828; --ok: #1E7B3A;
        --amber-line: rgba(138,90,0,0.35); --amber-bg: #FFF4DB; --amber: #8A5A00; --amber-k: #8A5A00;
        --count-bg: rgba(18,22,22,0.07); --spin-track: rgba(18,22,22,0.12);
        --ref-bg: #EFF1F0; --ref-line: rgba(18,22,22,0.18); --ref-text: #23272A;
        --pend-bg: #FFF4DB; --pend-line: rgba(138,90,0,0.30); --pend: #8A5A00;
        --conf-bg: #E3F4F2; --conf-line: rgba(0,124,118,0.35); --conf: #00665F;
        --canc-bg: #FDECEC; --canc-line: rgba(198,40,40,0.28); --canc: #C62828;
        --done-bg: #EFF1F0; --done-line: rgba(18,22,22,0.14); --done: #4B5357;
        --teal-hover: rgba(0,124,118,0.45); --pickup-line: rgba(0,124,118,0.35); --code: #121416; --avatar-ini: #007C76;
        --warn-bg: #FEF2F2; --warn-line: rgba(198,40,40,0.25); --warn-text: #8E1F1F;
        --info-bg: #EAF6F5; --info-line: rgba(0,124,118,0.30); --info-text: #123F3C;
        --neutral-bg: #FFFFFF; --neutral-line: rgba(18,22,22,0.12); --neutral-text: #4B5357;
        --bub-them: #EFF1F0; --bub-them-text: #121416; --bub-fail: #FDECEC; --bub-fail-text: #9B1C1C;
        --nav-text: #4B5357; --nav-bg: #EFF1F0; --nav-line: #D8DCDB;
        --seat-line: rgba(0,124,118,0.45); --cancel-line: rgba(198,40,40,0.30); --done-panel-line: rgba(0,124,118,0.35);
        --call: #007C76; --callmsg: #4B5357;
        color-scheme: light;
        --ssbar-bg: rgba(255,255,255,0.9); --ssbar-line: rgba(18,22,22,0.10); --ssbar-tab: #5B6368; --ssbar-strong: #121416; --ssbar-signin: #23272A; --ssbar-btnline: #D8DCDB; --ssbar-panel: #FFFFFF; --ssbar-hover: rgba(18,22,22,0.06); --ssbar-shadow: rgba(0,0,0,0.12); --ssbar-eat: #00A89F; --ssmenu-btnbg: #EFF1F0; --ssmenu-ini: #007C76; --ssmenu-cap: #687176; --ssmenu-danger: #C62828;
      }
      /* A shade under the caption gray: 4.5:1 on the raised input fill. */
      input::placeholder, textarea::placeholder { color: #5F686D; }
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 32px 20px 48px;
    }
    a { color: var(--link); text-decoration: none; }

    .wrap { width: 100%; max-width: 440px; }
    /* Desktop: the 440px mobile column reads cramped on a laptop. */
    /* Desktop is a console, not a phone column — matches /driving. The
       laptop layout (960px and up) is at the end of this block. */
    @media (min-width: 720px) { .wrap { max-width: 700px; } }
    /* Dashboard header + stat strip, same system as /driving. */
    .dashhead { margin-bottom: 20px; }
    .dashhead h1 { font-size: 27px; font-weight: 800; letter-spacing: -0.6px; margin-bottom: 4px; }
    .dashhead .said { font-size: 14.5px; color: var(--sub2); }
    .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 22px; }
    @media (min-width: 720px) { .stats { grid-template-columns: repeat(4, 1fr); gap: 12px; } }
    .stat { background: var(--tile); border: 1px solid var(--tile-line); border-radius: 14px; padding: 14px 16px; }
    .stat .n { font-size: 25px; font-weight: 800; letter-spacing: -0.6px; line-height: 1.1;
      font-variant-numeric: tabular-nums; }
    .stat .k { font-size: 12px; color: var(--sub3); margin-top: 4px; font-weight: 600; }
    .stat.act { border-color: var(--amber-line); background: var(--amber-bg); }
    .stat.act .n { color: var(--amber); }
    .stat.act .k { color: var(--amber-k); }
    /* Collapsible past-trips header, same control as /driving. */
    .pasthead {
      display: flex; align-items: center; gap: 10px; width: 100%;
      background: none; border: none; cursor: pointer; font-family: inherit;
      color: var(--sub3); font-size: 14px; font-weight: 700; letter-spacing: 1.2px;
      text-transform: uppercase; padding: 20px 2px 10px; text-align: left;
    }
    .pasthead:hover { color: var(--hover-text); }
    .pasthead .caret { color: var(--link); font-size: 12px; }
    .unpaidnote { color: var(--cap2); font-size: 13px; line-height: 1.55; margin: 0 0 10px; }
    .pasthead .pastcount {
      background: var(--count-bg); color: var(--sub3); border-radius: 999px;
      padding: 1px 8px; font-size: 11px; letter-spacing: 0;
    }

    .brand { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 28px; }

    .card {
      background: linear-gradient(180deg, var(--grad-a) 0%, var(--grad-b) 100%);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      margin-bottom: 20px;
    }
    .card .eyebrow {
      font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;
      color: var(--sub2); margin-bottom: 12px;
    }
    .route { font-size: 20px; font-weight: 700; letter-spacing: -0.3px; line-height: 1.3; }
    .meta { font-size: 14px; color: var(--sub); margin-top: 6px; }

    /* Rating stars. Big tap targets - this is used one-handed, often on a
       phone, right after getting out of a car. */
    .starrow { display: flex; gap: 6px; margin: 14px 0 4px; }
    button.star {
      background: none; border: none; padding: 4px 6px; cursor: pointer;
      font-size: 34px; line-height: 1; color: var(--star-off); transition: color .12s;
    }
    button.star:hover { color: var(--star-hover); }
    button.star.on { color: var(--link); }

    h1 { font-size: 21px; font-weight: 800; letter-spacing: -0.3px; margin-bottom: 6px; }
    h2 { font-size: 14px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: var(--sub2); margin: 26px 0 12px; }
    p.sub { font-size: 14px; color: var(--sub); line-height: 1.5; margin-bottom: 18px; }
    label { display: block; font-size: 12px; color: var(--sub2); letter-spacing: 0.3px; margin-bottom: 6px; text-transform: uppercase; }
    input, textarea {
      width: 100%; background: var(--input-bg); border: 1px solid var(--line-input);
      border-radius: 12px; padding: 14px 16px; color: var(--text); font-size: 16px; margin-bottom: 14px;
      outline: none; transition: border-color 0.15s; font-family: inherit;
    }
    input:focus, textarea:focus { border-color: var(--focus); }
    input:disabled, textarea:disabled { opacity: 0.5; }
    textarea { resize: vertical; min-height: 88px; }
    .codeinput { text-align: center; letter-spacing: 10px; font-size: 22px; font-weight: 700; }
    button.primary {
      width: 100%; background: var(--teal); color: var(--on-teal); border: none; border-radius: 12px;
      padding: 15px; font-size: 16px; font-weight: 700; cursor: pointer; transition: opacity 0.15s;
      font-family: inherit;
    }
    button.primary:disabled { opacity: 0.5; cursor: default; }
    button.outline {
      width: 100%; background: none; color: var(--text); border: 1px solid var(--line-outline);
      border-radius: 12px; padding: 14px; font-size: 15px; font-weight: 700; cursor: pointer;
      font-family: inherit;
    }
    button.outline:disabled { opacity: 0.5; cursor: default; }
    .linkbtn {
      background: none; border: none; color: var(--link); font-size: 14px; font-weight: 600;
      cursor: pointer; padding: 0; font-family: inherit;
    }
    .linkbtn:disabled { color: var(--cap); cursor: default; }
    .linkbtn.danger { color: var(--danger); }
    .rowlinks { display: flex; justify-content: space-between; margin-top: 4px; font-size: 14px; }
    .msg { font-size: 14px; line-height: 1.5; margin-top: 12px; }
    .msg.err { color: var(--danger); }
    .msg.ok { color: var(--ok); }
    .hidden { display: none !important; }
    .center { text-align: center; }
    .icon { font-size: 44px; margin-bottom: 12px; }
    .hint { font-size: 12px; color: var(--sub2); margin: -8px 0 14px; line-height: 1.5; }

    .refcode {
      display: inline-block; background: var(--ref-bg); border: 1px solid var(--ref-line);
      color: var(--ref-text); font-weight: 800; letter-spacing: 1.5px; border-radius: 10px;
      padding: 8px 16px; margin: 6px 0 0; font-size: 15px;
    }

    .spinner {
      width: 28px; height: 28px; margin: 0 auto 16px;
      border: 3px solid var(--spin-track); border-top-color: var(--teal);
      border-radius: 50%; animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .signedin { text-align: center; font-size: 12px; color: var(--cap); margin-top: 14px; }
    .signedin button { font-size: 12px; }
    .legal { text-align: center; margin-top: 28px; font-size: 12px; color: var(--cap); line-height: 1.6; }
    .legal a { color: var(--sub2); }

    /* ── Trips-specific ──────────────────────────────────────────────────── */

    .backrow { margin-bottom: 14px; }

    /* Status pill. Colours map to the four booking states so a rider can scan
       the list without reading. */
    .pill {
      display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.8px;
      text-transform: uppercase; border-radius: 100px; padding: 5px 11px;
      border: 1px solid transparent;
    }
    .pill.pending   { background: var(--pend-bg); border-color: var(--pend-line); color: var(--pend); }
    .pill.confirmed { background: var(--conf-bg); border-color: var(--conf-line); color: var(--conf); }
    .pill.cancelled { background: var(--canc-bg); border-color: var(--canc-line); color: var(--canc); }
    .pill.completed { background: var(--done-bg); border-color: var(--done-line); color: var(--done); }

    /* List rows are buttons, not anchors — the whole page is one document and
       navigation is pushState, so an <a href> would be a lie. */
    .trip {
      display: block; width: 100%; text-align: left; font-family: inherit;
      background: linear-gradient(180deg, var(--grad-a) 0%, var(--grad-b) 100%);
      border: 1px solid var(--line); border-radius: 16px;
      padding: 16px 18px; margin-bottom: 12px; cursor: pointer; color: var(--text);
      transition: border-color 0.15s, transform 0.15s;
    }
    .trip:hover { border-color: var(--teal-hover); transform: translateY(-1px); }
    .trip .triptop { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
    .trip .triproute { font-size: 16px; font-weight: 700; letter-spacing: -0.2px; line-height: 1.3; }
    .trip .tripmeta { font-size: 14px; color: var(--sub); margin-top: 5px; }
    .trip .tripfoot { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; font-size: 14px; color: var(--sub2); }

    .driverrow { display: flex; align-items: center; gap: 12px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line-soft); }
    .avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: 50% 25%; background: var(--bg); border: 1px solid var(--line-av); flex-shrink: 0; }
    .avatar.ph { display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; color: var(--avatar-ini); }
    .drivername { font-size: 15px; font-weight: 700; }
    .driversub { font-size: 12px; color: var(--sub2); margin-top: 2px; }

    .sumline { display: flex; justify-content: space-between; font-size: 14px; color: var(--sub); margin-top: 8px; }
    .sumline.total { font-size: 16px; color: var(--strong); font-weight: 800; border-top: 1px solid var(--line-soft); padding-top: 10px; margin-top: 12px; }

    /* Pickup code — the single most important thing on this page. It is what
       lets the driver get reimbursed at all (0043 escrow gate). */
    .pickup { text-align: center; border-color: var(--pickup-line); }
    .pickuplabel { font-size: 14px; color: var(--sub); line-height: 1.5; }
    .pickupval {
      font-size: 46px; font-weight: 800; letter-spacing: 6px; color: var(--code);
      margin: 14px 0 12px; font-variant-numeric: tabular-nums;
    }
    .pickuphint { font-size: 12px; color: var(--sub2); line-height: 1.6; }

    .banner { border-radius: 14px; padding: 16px 18px; margin-bottom: 20px; font-size: 14px; line-height: 1.55; }
    .banner.warn { background: var(--warn-bg); border: 1px solid var(--warn-line); color: var(--warn-text); }
    .banner.info { background: var(--info-bg); border: 1px solid var(--info-line); color: var(--info-text); }
    .banner.neutral { background: var(--neutral-bg); border: 1px solid var(--neutral-line); color: var(--neutral-text); }
    .banner strong { color: var(--strong); }

    .policy { list-style: none; margin: 8px 0 14px; padding: 0; }
    .policy li { font-size: 14px; color: var(--sub); line-height: 1.6; margin-bottom: 4px; }

    /* ── Chat ─────────────────────────────────────────────────────────────── */
    .thread {
      max-height: 58vh; overflow-y: auto; padding: 4px 2px 6px;
      display: flex; flex-direction: column; gap: 8px;
    }
    .brow { display: flex; }
    .brow.me { justify-content: flex-end; }
    .brow.them { justify-content: flex-start; }
    .brow.sys { justify-content: center; }
    .bubble {
      max-width: 78%; border-radius: 16px; padding: 10px 14px; font-size: 15px; line-height: 1.45;
      white-space: pre-wrap; overflow-wrap: anywhere;
    }
    .brow.me .bubble { background: var(--teal); color: var(--on-teal); border-bottom-right-radius: 5px; }
    .brow.them .bubble { background: var(--bub-them); color: var(--bub-them-text); border-bottom-left-radius: 5px; }
    .brow.sys .bubble { background: none; color: var(--sub2); font-size: 14px; text-align: center; max-width: 92%; }
    .bubble.sending { opacity: 0.55; }
    .bubble.failed { background: var(--bub-fail); color: var(--bub-fail-text); }
    .btime { font-size: 10px; color: var(--cap); margin: 2px 4px 0; text-align: right; }
    .brow.them + .btime { text-align: left; }
    .composer { display: flex; gap: 10px; align-items: flex-end; margin-top: 14px; }
    .composer textarea { min-height: 46px; max-height: 140px; margin-bottom: 0; padding: 12px 14px; font-size: 15px; }
    .composer button { width: auto; flex-shrink: 0; padding: 13px 18px; }
    .emptythread { text-align: center; color: var(--sub2); font-size: 14px; line-height: 1.6; padding: 22px 8px; }
    .consolenav {
      display: flex; gap: 8px; flex-wrap: wrap; justify-content: center;
      margin: 14px 0 4px;
    }
    .consolenav a {
      font-family: inherit; font-size: 13.5px; font-weight: 600;
      color: var(--nav-text); text-decoration: none; background: var(--nav-bg);
      border: 1px solid var(--nav-line); border-radius: 999px; padding: 8px 16px;
    }
    .consolenav a:hover { border-color: var(--teal-hover); color: var(--text); }
    .rolepair { display: inline-flex; gap: 6px; }
    .consolenav a.rolepill { border-color: var(--teal-hover); color: var(--link); font-weight: 700; }
    .consolenav a.rolepill.active { background: var(--teal); color: var(--on-teal); border-color: var(--teal); }
    .consolenav a.rolepill.active:hover { color: var(--on-teal); }

    /* ── Laptop layout (2026-10-12, Justin: "on my laptop it's still geared
       toward mobile vertical") ───────────────────────────────────────────
       Below 960px nothing here applies, so phones and tablets keep the single
       column above. From 960px the page is a desktop console: a 1160px
       column (the shared header lines up with it), trips as a card grid, a
       trip as its summary with the code, status and actions beside it, and
       the chat as a conversation pane with the trip details on the side.
       Layout only: every node, id and handler is the one the phone uses. */
    @media (min-width: 960px) {
      .wrap { max-width: 1160px; }
      /* Sign in, the code, loading and errors are single tasks: a narrow
         card, set down from the top rather than stretched across. */
      #stLoading, #stBoot, #stEmail, #stCode, #stNotFound, #stError,
      #listBody > .card.center { width: 100%; max-width: 460px; margin: 7vh auto 20px; }

      .dashhead { margin-bottom: 24px; }
      .dashhead h1 { font-size: 32px; }
      .dashhead .said { font-size: 16px; }
      .stats { gap: 14px; margin-bottom: 26px; }
      .stat { padding: 16px 18px; }
      .stat .k { font-size: 13px; }
      /* Trips as a grid of equal-height cards, footers on one line. */
      .tripgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: stretch; margin-bottom: 6px; }
      .tripgrid > .trip { margin-bottom: 0; display: flex; flex-direction: column; }
      .tripgrid > .trip .tripfoot { margin-top: auto; padding-top: 10px; }
      .tripgrid > .unpaidnote { grid-column: 1 / -1; margin: 0; }

      /* One trip: summary on the left, everything you act on to its right.
         The 15th row is flexible, so a tall summary card stretches only that
