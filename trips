    $('codeChangeEmail').addEventListener('click', () => { setMsg('codeMsg', ''); show('stEmail'); });

    $('codeBtn').addEventListener('click', async () => {
      setMsg('codeMsg', '');
      const code = $('emailCode').value.replace(/\D/g, '');
      // 6–8: Supabase's OTP length is a dashboard setting — never stricter here.
