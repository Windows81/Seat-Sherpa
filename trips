    }

    // ── LIST ──────────────────────────────────────────────────────────────
    function tripRow(b) {
      const btn = el('button', 'trip');
      btn.type = 'button';
      const st = effectiveStatus(b);

      const top = el('div', 'triptop');
      top.appendChild(el('div', 'triproute', routeLabel(b.ride)));
      top.appendChild(pill(st, !!b.__unpaid, isDeclined(b)));
      btn.appendChild(top);

      btn.appendChild(el('div', 'tripmeta', whenLabel(b.ride)));

      const foot = el('div', 'tripfoot');
      const n = (b.seat_ids || []).length;
      foot.appendChild(el('span', null, n + ' seat' + (n === 1 ? '' : 's') + ' · ' + fmt$(allInTotal(b))));
      foot.appendChild(el('span', null, b.ref_code || ''));
      btn.appendChild(foot);

      btn.addEventListener('click', () => go('/trips?ref=' + encodeURIComponent(b.ref_code)));
      return btn;
    }

    function renderList(rows) {
      const body = $('listBody');
      clear(body);

      if (rows.length === 0) {
        // Zero rows is an EMPTY STATE, never an error. A rider who cancelled
        // their only trip should not be told something broke.
        const c = el('div', 'card center');
        c.appendChild(el('div', 'icon', '🧭'));
        c.appendChild(el('h1', null, 'No trips yet'));
        c.appendChild(el('p', 'sub', "When you book a seat, it shows up here with your driver's details and your pickup code."));
        const a = document.createElement('a');
        a.href = '/rides';
        a.textContent = 'Browse rides →';
        a.style.fontWeight = '700';
        c.appendChild(a);
        body.appendChild(c);
        body.appendChild(signedInFooter());
        show('stList');
        return;
      }

      const now = Date.now();
      const upcoming = [];
      const past = [];
      const unpaid = [];
      for (const b of rows) {
        const st = effectiveStatus(b);
        const dep = departureMs(b.ride);
        // "Upcoming" holds anything still live: a Confirmed trip stays here
        // through the 12h completion horizon so a rider mid-trip (or one whose
        // driver hasn't entered the PIN yet) still finds their code up top.
        if (b.__unpaid) unpaid.push(b);
        else if ((st === 'Pending' || st === 'Confirmed') && dep + 12 * 60 * 60 * 1000 > now) upcoming.push(b);
        else past.push(b);
      }
      // Upcoming reads soonest-first; past reads most-recent-first.
      upcoming.sort((a, z) => departureMs(a.ride) - departureMs(z.ride));
      past.sort((a, z) => departureMs(z.ride) - departureMs(a.ride));
      unpaid.sort((a, z) => departureMs(z.ride) - departureMs(a.ride));

      const awaiting = upcoming.filter((b) => effectiveStatus(b) === 'Pending').length;
      const completed = rows.filter((b) => b.status === 'Completed');
      const spent = completed.reduce((s, b) => s + (allInTotal(b) || 0), 0);

      const head = el('div', 'dashhead');
      head.appendChild(el('h1', null, 'Your trips'));
      head.appendChild(el('div', 'said',
        awaiting > 0
          ? awaiting + ' request' + (awaiting === 1 ? '' : 's') + ' waiting on a driver to confirm.'
          : upcoming.length
            ? 'Next up: ' + routeLabel(upcoming[0].ride) + ' · ' + whenLabel(upcoming[0].ride) + '.'
            : 'No upcoming trips — book a seat and it shows up here.'));
      body.appendChild(head);

      // Same stat system as the driver console. Spend is the rider-side
      // number that's actually theirs: what completed trips cost, all in.
      const stats = el('div', 'stats');
      const statTile = (n, k, cls) => {
        const t = el('div', 'stat' + (cls ? ' ' + cls : ''));
        t.appendChild(el('div', 'n', String(n)));
        t.appendChild(el('div', 'k', k));
        return t;
      };
      stats.appendChild(statTile(upcoming.length, upcoming.length === 1 ? 'Upcoming trip' : 'Upcoming trips'));
      stats.appendChild(statTile(awaiting, 'Awaiting driver', awaiting > 0 ? 'act' : ''));
      stats.appendChild(statTile(completed.length, completed.length === 1 ? 'Trip taken' : 'Trips taken'));
      stats.appendChild(statTile(completed.length ? fmt$(spent) : '—', 'Spent, all in'));
      body.appendChild(stats);

      if (upcoming.length) {
        body.appendChild(el('h2', null, 'Upcoming'));
        const upGrid = el('div', 'tripgrid');
        upcoming.forEach((b) => upGrid.appendChild(tripRow(b)));
        body.appendChild(upGrid);
      }
      if (past.length) {
        // Collapsed by default — finished trips are reference, not work.
        const openPast = sessionStorage.getItem('ss_past_open') === '1';
        const phead = el('button', 'pasthead');
        phead.type = 'button';
        phead.setAttribute('aria-expanded', String(openPast));
        const caret = el('span', 'caret', openPast ? '▾' : '▸');
        phead.appendChild(caret);
        phead.appendChild(el('span', null, 'Past trips'));
        phead.appendChild(el('span', 'pastcount', String(past.length)));
        const pastWrap = el('div', 'tripgrid');
        if (!openPast) pastWrap.classList.add('hidden');
        past.forEach((b) => pastWrap.appendChild(tripRow(b)));
        phead.addEventListener('click', () => {
          const nowOpen = pastWrap.classList.contains('hidden');
          pastWrap.classList.toggle('hidden', !nowOpen);
          caret.textContent = nowOpen ? '▾' : '▸';
          phead.setAttribute('aria-expanded', String(nowOpen));
          try { sessionStorage.setItem('ss_past_open', nowOpen ? '1' : '0'); } catch (_) {}
        });
        body.appendChild(phead);
        body.appendChild(pastWrap);
      }
      if (unpaid.length) {
        // Requests that never reached payment. Out of Past trips because they
        // were never booked, but reachable so nothing silently disappears.
        const openUp = sessionStorage.getItem('ss_unpaid_open') === '1';
        const uhead = el('button', 'pasthead');
        uhead.type = 'button';
        uhead.setAttribute('aria-expanded', String(openUp));
        const ucaret = el('span', 'caret', openUp ? '▾' : '▸');
        uhead.appendChild(ucaret);
        uhead.appendChild(el('span', null, 'Unfinished requests'));
        uhead.appendChild(el('span', 'pastcount', String(unpaid.length)));
        const uWrap = el('div', 'tripgrid');
        if (!openUp) uWrap.classList.add('hidden');
        const unote = el('p', 'unpaidnote', 'You did not finish checking out, so this never became a booking.');
        uWrap.appendChild(unote);
        unpaid.forEach((b2) => uWrap.appendChild(tripRow(b2)));
        uhead.addEventListener('click', () => {
          const nowOpen = uWrap.classList.contains('hidden');
          uWrap.classList.toggle('hidden', !nowOpen);
          ucaret.textContent = nowOpen ? '▾' : '▸';
          uhead.setAttribute('aria-expanded', String(nowOpen));
          try { sessionStorage.setItem('ss_unpaid_open', nowOpen ? '1' : '0'); } catch (_) {}
        });
        body.appendChild(uhead);
        body.appendChild(uWrap);
      }
      // Your impact (2026-08-28, app parity — lib/co2.computePassengerImpact):
      // completed trips only, same 0.88 lbs/mi + $0.76/mi constants.
      {
        const done = rows.filter((b) => b.status === 'Completed' && b.pickup_code_entered_at);
        if (done.length > 0) {
          const hav = (a, c) => {
            if (!a || !c || !isFinite(a.lat)) return 0;
            const R = 3958.8, toRad = (d) => (d * Math.PI) / 180;
            const dLat = toRad(c.lat - a.lat), dLng = toRad(c.lng - a.lng);
            const h = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a.lat)) * Math.cos(toRad(c.lat)) * Math.sin(dLng / 2) ** 2;
            return 2 * R * Math.asin(Math.sqrt(h));
          };
          let miles = 0, perSeatPaid = 0;
          for (const b of done) {
            const r = b.ride || {};
            const s = r.start_lat != null ? { lat: Number(r.start_lat), lng: Number(r.start_lng) } : null;
            const e2 = r.end_lat != null ? { lat: Number(r.end_lat), lng: Number(r.end_lng) } : null;
            miles += hav(s, e2);
            const seats = Array.isArray(b.seat_ids) && b.seat_ids.length ? b.seat_ids.length : 1;
            perSeatPaid += (Number(b.total_price) || 0) / seats;
          }
          const co2 = Math.round(miles * 0.88);
          const saved = Math.max(0, Math.round(miles * 0.76 - perSeatPaid));
          if (miles > 0) {
            const ic = el('div', 'card');
            ic.appendChild(el('div', 'eyebrow', 'Your impact'));
            ic.appendChild(el('div', 'meta',
              done.length + ' trip' + (done.length === 1 ? '' : 's') + ' · ' + Math.round(miles)
              + ' miles shared · ~' + co2 + ' lbs CO₂ saved'
              + (saved > 0 ? ' · ~$' + saved + ' saved vs driving alone' : '')));
            body.appendChild(ic);
          }
        }
      }
      // Ride credit (app-parity, 2026-08-27). credit_balance_cents (0082) is
      // built for exactly this caller — a user session. Shown only when >0 so
      // the common zero case adds no noise.
      {
        const credLine = el('div', 'meta hidden');
        credLine.style.textAlign = 'center';
        credLine.style.marginTop = '6px';
        body.appendChild(credLine);
        supabase.rpc('credit_balance_cents', { p_user: me }).then(({ data, error }) => {
          const cents = !error && typeof data === 'number' ? data : 0;
          if (cents > 0) {
            credLine.textContent = 'Ride credit: $' + (cents / 100).toFixed(2) + ' — applies automatically at booking.';
            credLine.classList.remove('hidden');
          }
        }, () => {});
      }
      body.appendChild(signedInFooter());
      show('stList');
      document.title = 'Your trips — Seat Sherpa';
    }

    // ── PICKUP CODE ───────────────────────────────────────────────────────
    // The payout unblock. Ported from app/booking-detail.tsx (~line 699).
    let pickupCode = null;

    async function fetchPickupCode(bookingId) {
      try {
        const { data, error } = await supabase.rpc('get_my_pickup_code', { p_booking_id: bookingId });
        if (error) return null;
        return data || null;
      } catch (_) { return null; }
    }

    /** "1234" → "12 34" — the app's read-aloud grouping, so a rider reading off
     *  a phone and a driver typing into theirs are looking at the same shape. */
    function groupCode(code) {
      return String(code).split('').reduce((acc, ch, i) => acc + (i === 2 ? ' ' : '') + ch, '');
    }

    function pickupCard(b) {
      const wrap = el('div', 'card pickup');
      const dep = departureMs(b.ride);
      const windowOpen = Date.now() >= dep - PICKUP_CODE_OPENS_BEFORE_MS;

      wrap.appendChild(el('div', 'eyebrow', 'Your pickup code'));

      if (!windowOpen) {
        wrap.appendChild(el('div', 'pickuplabel', 'Your code unlocks 2 hours before departure'));
        wrap.appendChild(el('div', 'pickupval', '••••'));
        wrap.appendChild(el('div', 'pickuphint',
          'For safety, your pickup code stays hidden until 2 hours before the ride ('
          + dateLabel(b.ride.dep_date) + ' · ' + timeLabel(b.ride.dep_time)
          + "). It'll be right here when it's time to head out."));
        return wrap;
      }

      const who = driverFirst(b);
      wrap.appendChild(el('div', 'pickuplabel', 'Read this to ' + who + ' at pickup'));
      wrap.appendChild(el('div', 'pickupval', pickupCode ? groupCode(pickupCode) : '••••'));
      // Verbatim from the app. "reimbursed", never "earn" — NRS 706A.
      wrap.appendChild(el('div', 'pickuphint',
        'Only give this code to ' + who + " once you're physically in their car. "
        + "It's how they confirm the trip started and get reimbursed — never share it "
        + 'beforehand or with anyone else.'));
      return wrap;
    }

    // ── RATING ────────────────────────────────────────────────────────────
    //
    // WHY (Justin, 2026-08-22): web riders had no way to rate at all. The
    // trip-complete email asked them to REPLY with "a rating out of 5 and a
    // sentence" and promised "we'll post your review for you" — i.e. the
    // founder hand-entering ratings from his inbox, which doesn't scale past
    // about ten trips and loses every rider who can't be bothered to compose
    // an email. App riders rate at 50% (drivers 83%, because the driver's
    // modal auto-opens); web riders were structurally at ~0%.
    //
    // Writes straight to public.ratings under the rider's own session — the
    // same path services/ratings.ts submitRating uses. RLS policy
    // ratings_insert_party enforces rater_id = auth.uid() AND
    // user_can_rate_booking(booking_id), and migration 0093's trigger rejects
    // any booking with no pickup on record. So the browser needs no privileged
    // endpoint: the database is the gate, exactly as it is for the app.
    let myRatingByBooking = {};   // booking_id -> { stars } already submitted
    // The page-level rating gate (/js/ss-rating-gate.js) may submit a rating
    // over this page; keep our cache in step so the card flips to "you rated"
    // instead of offering the form a second time (review 2026-09-08).
    window.addEventListener('ss:rated', (e) => {
      const d = e && e.detail;
      if (!d || !d.bookingId) return;
      myRatingByBooking[d.bookingId] = { booking_id: d.bookingId, stars: d.stars };
      try { render(); } catch (_) { /* not on a view that needs it */ }
    });

    /** One rating row for each booking on screen, so the card can show
     *  "you rated 5 stars" instead of re-offering the form. */
    async function loadMyRatings(rows) {
      if (!me || !rows.length) return;
      try {
        const { data, error } = await supabase
          .from('ratings')
          .select('booking_id, stars')
          .eq('rater_id', me)
          .in('booking_id', rows.map((r) => r.id));
        if (error) return;                       // non-fatal: card just offers the form
        myRatingByBooking = {};
        (data || []).forEach((r) => { myRatingByBooking[r.booking_id] = r; });
      } catch (_) { /* non-fatal */ }
    }

    function ratingCard(b) {
      const wrap = el('div', 'card');
      const who = driverFirst(b);
      const mine = myRatingByBooking[b.id];

      if (mine) {
        wrap.appendChild(el('div', 'eyebrow', 'Your rating'));
        wrap.appendChild(el('div', 'pickuplabel',
          '★'.repeat(mine.stars) + '☆'.repeat(5 - mine.stars) + '  ·  Thanks!'));
        wrap.appendChild(el('div', 'pickuphint',
          'You rated ' + who + ' ' + mine.stars + ' out of 5. Ratings help other riders '
          + 'choose who to ride with.'));
        return wrap;
      }

      wrap.appendChild(el('div', 'eyebrow', 'Rate your trip'));
      wrap.appendChild(el('div', 'pickuplabel', 'How was the ride with ' + who + '?'));

      // Pre-filled 5 (Justin, 2026-08-22) — matches components/rating-modal.tsx
      // so a rider sees the same starting point whichever surface they use.
      // Submit is enabled from the start; tapping a star still overrides it.
      let chosen = 5;
      const starRow = el('div', 'starrow');
      const starBtns = [];
      for (let i = 1; i <= 5; i++) {
        const btn = el('button', 'star', '★');
        btn.classList.add('on');
        btn.type = 'button';
        btn.setAttribute('aria-label', i + ' star' + (i === 1 ? '' : 's'));
        btn.addEventListener('click', () => {
          chosen = i;
          starBtns.forEach((s, idx) => {
            s.textContent = idx < chosen ? '★' : '☆';
            s.classList.toggle('on', idx < chosen);
          });
          submit.disabled = false;
          msg.textContent = '';
        });
        starBtns.push(btn);
        starRow.appendChild(btn);
      }
      wrap.appendChild(starRow);

      const note = el('textarea');
      note.placeholder = 'Anything worth telling other riders? (optional)';
      note.maxLength = 500;
      wrap.appendChild(note);

      const msg = el('div', 'pickuphint');
      const submit = el('button', 'primary', 'Submit rating');
      submit.type = 'button';
      submit.style.marginTop = '12px';
      submit.addEventListener('click', async () => {
        if (!chosen) return;
        submit.disabled = true;
        submit.textContent = 'Submitting…';
        msg.textContent = '';
        try {
          // ratee is the DRIVER: this page is rider-side only, so the role is
          // never ambiguous the way it is in the app's shared submitRating.
          const { error } = await supabase.from('ratings').insert({
            booking_id: b.id,
            rater_id: me,
            ratee_id: b.ride.driver_id,
            rater_role: 'passenger',
            stars: chosen,
            comment: note.value.trim() || null,
          });
          if (error) throw error;
          myRatingByBooking[b.id] = { booking_id: b.id, stars: chosen };
          renderDetail(b);                      // swap to the "you rated" state
          // Fellow riders next (0400): the page gate (js/ss-rating-gate.js)
          // listens and asks about the others who shared this car.
          try { window.dispatchEvent(new CustomEvent('ss:driver-rated', { detail: { bookingId: b.id } })); } catch (_) {}
        } catch (e) {
          const raw = (e && e.message) || '';
          msg.textContent =
            raw.includes('ratings_one_per_rater') ? 'You already rated this trip.'
            : raw.includes('user_can_rate_booking') ? 'The rating window has closed for this trip.'
            : raw.includes('no pickup on record') ? "This trip has no pickup on record, so it can't be rated."
            : 'Could not submit that just now. Try again in a moment.';
          submit.disabled = false;
          submit.textContent = 'Submit rating';
        }
      });
      wrap.appendChild(submit);
      wrap.appendChild(msg);
      return wrap;
    }

    // ── DETAIL ────────────────────────────────────────────────────────────
    function renderDetail(b) {
      // renderDetail re-enters itself from its own timers (the 30s wall-clock
      // tick, the pickup-code poll). Without this it would stack a fresh pair
      // of intervals on every tick — after ten minutes the page is polling the
      // RPC twenty times a cycle. Clearing first makes re-entry idempotent.
      clearTimers();
      const body = $('detailBody');
      clear(body);
      const st = effectiveStatus(b);
      const ride = b.ride;
      const dep = departureMs(ride);
      const departed = dep > 0 && Date.now() >= dep;

      body.appendChild(backRow('All trips', () => go('/trips')));

      // ── Summary card
      const card = el('div', 'card');
      const top = el('div');
      top.style.marginBottom = '12px';
      top.appendChild(pill(st, false, isDeclined(b)));
      card.appendChild(top);
      card.appendChild(el('div', 'route', routeLabel(ride)));
      card.appendChild(el('div', 'meta', whenLabel(ride)));
      // Full pickup/drop-off addresses live HERE, not in the header (Justin,
      // 2026-08-28: "city to city — click in and it says the address").
      if (ride.departure_area || ride.arrival_area) {
        const addr = el('div', 'meta');
        addr.style.cssText = 'font-size:13.5px;color:var(--sub2);margin-top:4px;line-height:1.5;';
        addr.textContent = '📍 ' + (ride.departure_area || 'Pickup TBD') + '  →  ' + (ride.arrival_area || 'Drop-off TBD');
        card.appendChild(addr);
      }

      const boarding = stopName(b.boarding_stop);
      const alighting = stopName(b.alighting_stop);
      if (boarding) card.appendChild(el('div', 'meta', 'Pickup: ' + boarding));
      if (alighting) card.appendChild(el('div', 'meta', 'Drop-off: ' + alighting));

      // Meeting spot (0347): the newest spot shared in this trip's chat, by
      // either side. Filled in when the lookup lands; nothing shows without one.
      if (st === 'Confirmed' && window.SSMeetingSpot) {
        const spotHost = el('div');
        spotHost.style.marginTop = '10px';
        card.appendChild(spotHost);
        // Any of my bookings on this ride (bug check 2026-10-05): "Message all
        // riders" lands on my newest one only, and the chat groups them.
        supabase.from('bookings').select('id').eq('ride_id', b.ride.id).eq('passenger_id', me)
          .in('status', ['Confirmed', 'Completed'])
          .then(({ data: sibs }) => {
            const ids = Array.from(new Set([b.id].concat((sibs || []).map((s) => s.id))));
            return supabase.from('messages')
              .select('place, sender_id, created_at, body')
              .in('booking_id', ids)
              .not('place', 'is', null)
              .order('created_at', { ascending: false })
              .limit(50);
          })
          .then(({ data }) => {
            // "Send my location" pins (2026-10-18) carry a place too but are
            // not meeting spots: the newest REAL spot is the current one.
            const row = (data || []).find((r) => !(SSMeetingSpot.isHere && SSMeetingSpot.isHere(r.body)));
            if (!row || !SSMeetingSpot.valid(row.place)) return;
            const who = row.sender_id === me ? 'you' : (driverDisplay(b) || 'your driver');
            const when = new Date(row.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
            spotHost.appendChild(SSMeetingSpot.card(row.place, { from: pickupPointOf(b), footer: 'Set by ' + who + ' · ' + when }));
          }, () => {});
      }

      card.appendChild(driverRow(b));

      const seats = seatLabels(b);
      const seatLine = el('div', 'sumline');
      seatLine.appendChild(el('span', null, seats.length + ' seat' + (seats.length === 1 ? '' : 's')));
      seatLine.appendChild(el('span', null, seats.join(', ')));
      card.appendChild(seatLine);

      const totalLine = el('div', 'sumline total');
      totalLine.appendChild(el('span', null, st === 'Cancelled' ? 'Booking total' : 'Total'));
      totalLine.appendChild(el('span', null, fmt$(allInTotal(b))));
      card.appendChild(totalLine);

      const refWrap = el('div');
      refWrap.style.marginTop = '10px';
      refWrap.appendChild(el('div', 'refcode', b.ref_code || ''));
      card.appendChild(refWrap);
      body.appendChild(card);

      // ── Status banners
      if (st === 'Pending') {
        body.appendChild(el('div', 'banner info',
          'Waiting on the driver — your card is authorized, not charged. '
          + "We'll email you the moment " + driverFirst(b) + ' responds.'));
      }

      if (ride.cancelled_at) {
        body.appendChild(el('div', 'banner warn',
          'The driver cancelled this ride. Any payment is refunded in full, including the booking fee — '
          + "it can take 5–10 business days to appear on your statement."));
      } else if (st === 'Cancelled' && isDeclined(b)) {
        // A decline was never charged: the card was only authorized, and the
        // hold is released (by the driver's tap, or the server within minutes).
        const bn = el('div', 'banner warn');
        bn.appendChild(document.createTextNode(driverFirst(b) + " couldn't take this request, so you weren't charged. "
          + 'Any hold on your card has been released, though your bank may take a few days to drop it from your statement.'));
        const note = String(b.cancel_reason || '').trim();
        if (note && !SYSTEM_REASON.test(note)) {
          const p = el('div', null, 'Note from ' + driverFirst(b) + ': “' + note + '”');
          p.style.marginTop = '8px';
          bn.appendChild(p);
        }
        if (Number(b.credit_applied_cents) > 0 && b.refund_amount_cents == null) {
          const c = el('div', null, 'The ' + fmtCents(b.credit_applied_cents) + ' of ride credit you used is back in your account.');
          c.style.marginTop = '8px';
          bn.appendChild(c);
        }
        const more = el('a', null, 'Find another ride');
        more.href = '/rides';
        more.style.display = 'inline-block';
        more.style.marginTop = '8px';
        more.style.fontWeight = '700';
        bn.appendChild(more);
        body.appendChild(bn);
      } else if (st === 'Cancelled') {
        const bn = el('div', 'banner warn');
        bn.appendChild(document.createTextNode('This booking is cancelled. '));
        if (typeof b.refund_amount_cents === 'number' && b.refund_amount_cents > 0) {
          // refund_amount_cents is the TOTAL value returned, card PLUS any ride
          // credit put back (stripe-refund-booking). Calling all of it a card
          // refund was wrong whenever credit was involved (2026-09-09). 0249
          // records the credit half; when it is null the split is a trigger-side
          // proportional fallback we cannot reproduce here, so we state the
          // value and make no claim about where it landed.
          var credBack = typeof b.credit_restore_cents === 'number' ? b.credit_restore_cents : null;
          var cardBack = credBack === null ? null : Math.max(0, b.refund_amount_cents - credBack);
          bn.appendChild(document.createTextNode(
            (credBack && cardBack !== null)
              ? fmtCents(cardBack) + ' was refunded to your original payment method and ' + fmtCents(credBack) + ' was returned as ride credit — the card refund can take 5–10 business days to appear.'
              : (cardBack !== null)
                ? fmtCents(cardBack) + ' was refunded to your original payment method — it can take 5–10 business days to appear.'
                : fmtCents(b.refund_amount_cents) + ' was refunded — anything charged to your card can take 5–10 business days to appear.'));
        } else if (b.refund_amount_cents === 0) {
          bn.appendChild(document.createTextNode(
            'No refund was due under the ride’s cancellation policy. Questions? Email support@seatsherpa.app.'));
        } else {
          bn.appendChild(document.createTextNode(
            'If a refund is due, it goes back to your original payment method within 5–10 business days.'));
        }
        body.appendChild(bn);
      }

      // ── PICKUP CODE — the whole reason this page exists.
      if (st === 'Confirmed' && !b.pickup_code_entered_at) {
        body.appendChild(pickupCard(b));
      }

      // Trip started
      if (b.pickup_code_entered_at && (st === 'Confirmed' || st === 'Completed')) {
        const started = new Date(b.pickup_code_entered_at)
          .toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
        body.appendChild(el('div', 'banner info',
          (st === 'Completed' ? 'Trip completed' : 'Trip in progress') + ' · Started ' + started));
      }

      // ── RATE THE TRIP ──
      // Completed WITH a pickup on record — the same pair of conditions
      // migration 0093 enforces on the insert, checked here so the form is
      // never offered for a trip the database will refuse.
      if (st === 'Completed' && b.pickup_code_entered_at) {
        body.appendChild(ratingCard(b));
      }

      // Confirmed, departure passed, no PIN — the driver never entered the
      // code. Say what to do rather than showing a cancel button the server
      // will 409 (stripe-refund-booking's post-departure gate).
      if (st === 'Confirmed' && departed && !b.pickup_code_entered_at && !b.no_show_reported_at) {
        const bn = el('div', 'banner neutral');
        bn.appendChild(document.createTextNode(
          'Departure has passed. If you rode, ' + driverFirst(b) + ' still needs to enter your pickup code above to close out the trip — '
          + "it's right there, just read it to them. If the driver never showed up: "));
        // Report-driver-no-show (2026-08-28, app parity — booking-detail.tsx:245):
        // the report-driver-noshow fn runs the 24h dispute window and the
        // automatic full refund including fees; email-support was the only
        // web path before this.
        const rBtn = el('button', 'linkbtn', 'Report driver no-show');
        rBtn.type = 'button';
        rBtn.addEventListener('click', async () => {
          if (rBtn.dataset.armed !== '1') {
            rBtn.dataset.armed = '1';
            rBtn.textContent = 'Confirm — the driver never showed';
            // report-driver-noshow requires a short reason (>= 5 chars); the
            // web path sent none, so every report 400'd (comms audit
            // 2026-09-01). Ask, with a sensible default if left blank.
            const ta = document.createElement('textarea');
            ta.placeholder = 'What happened? e.g. waited 30 min at the pickup, no reply';
            ta.rows = 2; ta.style.width = '100%'; ta.style.margin = '6px 0';
            rBtn.parentNode.insertBefore(ta, rBtn);
            rBtn._reason = ta;
            return;
          }
          const reason = ((rBtn._reason && rBtn._reason.value) || '').trim()
            || 'Driver did not show at the pickup (reported from the web console).';
          rBtn.disabled = true; rBtn.textContent = 'Reporting…';
          try {
            await callFn('report-driver-noshow', { bookingId: b.id, reason });
            bn.textContent = 'Report received. ' + driverFirst(b) + ' has 24 hours to respond; if they don’t, you’re automatically refunded in full — including all fees, and we’ll email you when that happens.';
          } catch (e) {
            rBtn.disabled = false; rBtn.dataset.armed = ''; rBtn.textContent = 'Report driver no-show';
            bn.appendChild(el('div', 'rowhint', (e && e.message) || 'Could not report just now — email support@seatsherpa.app.'));
          }
        });
        bn.appendChild(rBtn);
        body.appendChild(bn);
      }

      // No-show reported against this rider — the dispute is ACTIONABLE now
      // (2026-08-28, app parity — services/bookings.ts disputeNoShow: the
      // conditional update freezes the payout for admin review; guards mirror
      // the app's exactly, incl. the not-yet-transferred check).
      if (b.no_show_reported_at && !b.pickup_code_entered_at && st === 'Confirmed') {
        const bn = el('div', 'banner warn');
        if (b.no_show_disputed_at) {
          bn.textContent = 'Dispute received. The reimbursement is frozen while our team reviews — '
            + "we'll reach out at your account email if we need more detail (support@seatsherpa.app).";
        } else {
          bn.appendChild(document.createTextNode(
            'Your driver reported you as a no-show for this trip. If that’s not right: '));
          const dBtn = el('button', 'linkbtn', 'Dispute this report');
          dBtn.type = 'button';
          dBtn.addEventListener('click', async () => {
            dBtn.disabled = true; dBtn.textContent = 'Disputing…';
            try {
              const { data, error } = await supabase
                .from('bookings')
                .update({ no_show_disputed_at: new Date().toISOString() })
                .eq('id', b.id)
                .not('no_show_reported_at', 'is', null)
                .is('no_show_disputed_at', null)
                .is('stripe_transfer_id', null)
                .select('id');
              if (error) throw error;
              if (!data || data.length === 0) throw new Error('This report can no longer be disputed — the deposit already released. Email support@seatsherpa.app.');
              bn.textContent = 'Dispute received. The reimbursement is frozen while our team reviews — '
                + "we'll reach out at your account email if we need more detail.";
            } catch (e) {
              dBtn.disabled = false; dBtn.textContent = 'Dispute this report';
              bn.appendChild(el('div', 'rowhint', (e && e.message) || 'Could not dispute just now — email support@seatsherpa.app.'));
            }
          });
          bn.appendChild(dBtn);
          bn.appendChild(document.createTextNode(
            ' You have 48 hours from the report — after that the fare releases to the driver per the cancellation policy.'));
        }
        body.appendChild(bn);
      }

      // ── Chat entry — or, for a web request that never reached payment, the
      //    way to finish it (2026-09-03, Sascha → Derek: she chatted for 30
      //    minutes instead of paying and the request lapsed under her). No
      //    chat until the card is authorized; that is also the moment the
      //    driver sees the request at all.
      if (unpaidWeb(b)) {
        const pay = el('button', 'primary', 'Finish payment to send your request');
        pay.type = 'button';
        pay.style.marginBottom = '8px';
        pay.addEventListener('click', () => go('/book?id=' + encodeURIComponent(b.ride.id)));
        body.appendChild(pay);
        body.appendChild(el('p', 'sub', driverFirst(b) + " won't see this request, and messaging opens, only once your card is authorized. The seat is only charged if they accept."));
      } else {
        // Read-only once a declined request's hour is over (0395).
        const chatClosedNow = chatClosesAt(b) !== null && Date.now() > chatClosesAt(b);
        const chatBtn = el('button', 'outline', chatClosedNow ? 'View messages' : 'Message ' + driverFirst(b));
        chatBtn.type = 'button';
        chatBtn.style.marginBottom = '12px';
        chatBtn.addEventListener('click', () => go('/trips?ref=' + encodeURIComponent(b.ref_code) + '&chat=1'));
        body.appendChild(chatBtn);
      }

      // ── Add to calendar (confirmed and not yet departed)
      body.appendChild(calendarSection(b, st, departed));

      // ── Seat moved: keep the new seat or withdraw (0373)
      body.appendChild(seatChangeSection(b, st));

      // ── Cancel
      body.appendChild(cancelSection(b, st, departed));

      // From the seat-change email: ?seat=withdraw opens the withdraw panel
      // (the rider still confirms; a link never acts on its own).
      try {
        const qs = new URLSearchParams(location.search);
        if (qs.has('seat')) {
          if (st === 'Pending' && qs.get('seat') === 'withdraw') {
            const w = body.querySelector('[data-withdraw-open]');
            if (w) setTimeout(() => w.click(), 0);
          }
          // Once only: the page refreshes every minute, and a rider who closed
          // the panel must not see it pop open again.
          qs.delete('seat');
          const rest = qs.toString();
          history.replaceState(history.state, '', location.pathname + (rest ? '?' + rest : '') + location.hash);
        }
      } catch (_) {}

      body.appendChild(signedInFooter());
      show('stDetail');
      document.title = routeLabel(ride) + ' — Seat Sherpa';

      // Pickup-code timers. Both of these are bugs the app already paid for:
      //   • poll every 15s until the code is non-null, then STOP. Never cache a
      //     null — a fetch racing the 2h boundary comes back empty, and a
      //     blanket cache pinned that empty result ("four dots at pickup time",
      //     booking 213, 2026-07-31).
      //   • re-render every 30s while awaiting, so a page left open actually
      //     CROSSES the 2h boundary instead of sitting on "unlocks in 2 hours".
      //
      // The periodic pass REFETCHES rather than repainting the row we already
      // have: the driver entering the PIN, or accepting a Pending request, both
      // change this screen, and a rider watching it should see that happen.
      if (st === 'Confirmed' && !b.pickup_code_entered_at) {
        const dueSoon = Date.now() >= dep - PICKUP_CODE_OPENS_BEFORE_MS;
        if (dueSoon && !pickupCode) {
          const takeCode = (code) => {
            if (!code || pickupCode) return;
            pickupCode = code;
            if (detailIsLive()) renderDetail(b);
          };
          fetchPickupCode(b.id).then(takeCode);
          every(15000, async () => {
            if (pickupCode) return;
            takeCode(await fetchPickupCode(b.id));
          });
        }
        every(30000, () => { void refreshDetail(b); });
      } else if (st === 'Pending') {
        // Slower cadence — nothing here is time-critical until the driver
        // accepts, at which point the pickup-code card needs to appear.
        every(60000, () => { void refreshDetail(b); });
      }
    }

    /** True when the detail state is on screen AND safe to repaint. The cancel
     *  panel holds a half-typed reason; a background refresh that blew it away
     *  mid-sentence would be its own small betrayal. */
    function detailIsLive() {
      return !$('stDetail').classList.contains('hidden') && !cancelPanelOpen;
    }

    async function refreshDetail(prev) {
      if (!detailIsLive()) return;
      try {
        const fresh = await loadBooking(prev.ref_code);
        if (!detailIsLive()) return;
        renderDetail(fresh || prev);
      } catch (_) {
        // Offline / transient — repaint what we have so the wall-clock gates
        // (the 2h window) still advance.
        if (detailIsLive()) renderDetail(prev);
      }
    }

    // ── ADD TO CALENDAR ───────────────────────────────────────────────────
    // Justin, 2026-10-03. A confirmed ride that has not left yet. The two
    // links come from the calendar-event function, signed for this booking,
    // so nothing about the event is built on this page. Two named choices
    // rather than a guess at which calendar the person uses.
    //
    // The state lives OUTSIDE the section. The detail view repaints itself
    // every 30 seconds and whenever the pickup code arrives, which used to
    // snap the two links back to the button and orphan a request in flight
    // (bug check 2026-10-03). The links are a stable signature of the booking
    // id, so keeping them for the life of the page is safe.
    const calLinks = new Map();   // booking id -> { ics, google }
    let calBusyId = null;         // booking id with a request in flight
    let calError = null;          // { id, text } from the last failed tap
    // The section that is on screen right now. An answer repaints THIS one,
    // and only when it is for the same booking. It used to call renderDetail
    // with the booking captured at tap time, so going back and opening another
    // trip before the answer landed jumped the page to the first trip under
    // the second trip's address (bug sweep 2026-10-03).
    let calOnScreen = null;       // { id, wrap, paint }

    function calendarSection(b, st, departed) {
      const wrap = el('div');
      // Never beside the "driver cancelled this ride" banner either.
      if (st !== 'Confirmed' || departed || b.pickup_code_entered_at || (b.ride && b.ride.cancelled_at)) return wrap;
      wrap.style.textAlign = 'center';
      wrap.style.margin = '0 0 2px';
      wrap.setAttribute('aria-live', 'polite');

      // A real tap target: the bare .linkbtn is one 18px line of text.
      const roomy = (n) => { n.style.display = 'inline-block'; n.style.padding = '12px 8px'; n.style.textDecoration = 'none'; };
      const quiet = (text) => {
        const s = el('span', null, text);
        s.style.fontSize = '14px';
        s.style.color = 'var(--cap)';
        return s;
      };

      const paint = (moveFocus) => {
        // Focus moves only when the person is not busy elsewhere (typing a
        // cancel reason, say): a link that takes focus would turn their next
        // Enter into "open Google Calendar".
        const focusFree = !document.activeElement || document.activeElement === document.body || wrap.contains(document.activeElement);
        clear(wrap);
        const links = calLinks.get(b.id);
        if (links) {
          const g = el('a', 'linkbtn', 'Google Calendar');
          g.href = links.google; g.target = '_blank'; g.rel = 'noopener'; roomy(g);
          const i = el('a', 'linkbtn', 'Apple and Outlook');
          i.href = links.ics; roomy(i);
          wrap.appendChild(quiet('Add to'));
          wrap.appendChild(g);
          wrap.appendChild(quiet('or'));
          wrap.appendChild(i);
          // The button that had focus is gone; hand focus to the first link.
          if (moveFocus && focusFree) g.focus();
          return;
        }
        const busy = calBusyId === b.id;
        const btn = el('button', 'linkbtn', busy ? 'One moment' : 'Add to calendar');
        btn.type = 'button';
        btn.disabled = busy;
        roomy(btn);
        btn.addEventListener('click', onTap);
        wrap.appendChild(btn);
        if (calError && calError.id === b.id) {
          const p = el('p', 'hint', calError.text);
          p.style.margin = '0 0 8px'; // .hint is built to tuck under an input
          wrap.appendChild(p);
        }
        // After a failed tap the rebuilt button gets focus back, so a keyboard
        // or screen-reader user is not dropped at the top of the page.
        if (moveFocus && focusFree && !busy) btn.focus();
      };

      async function onTap() {
        if (calBusyId !== null) return;
        const id = b.id;
        calBusyId = id;
        calError = null;
        paint(false);
        let giveUp = null;
        try {
          // 15 seconds, then give up: a hung request must not leave
          // calBusyId set, which would swallow every later tap until reload.
          const out = await Promise.race([
            callFn('calendar-event', { bookingId: id }),
            new Promise((_, reject) => { giveUp = setTimeout(() => reject(new Error('')), 15000); }),
          ]);
          if (!out || !out.ok || !out.ics || !out.google) {
            const err = new Error((out && out.reason) || '');
            err.shown = !!(out && out.reason);
            throw err;
          }
          calLinks.set(id, { ics: out.ics, google: out.google });
        } catch (e) {
          // The shared caller signs the page out on a 401, so "try again"
          // would be a dead end there; say what actually helps.
          const expired = !!e && (e.status === 401 || e.sessionExpired === true || e.message === 'not signed in');
          calError = {
            id,
            text: expired
              ? 'Your sign-in expired. Refresh the page and sign in again.'
              : (e && e.shown && e.message ? e.message : "The calendar link didn't load. Try again."),
          };
        } finally {
          if (giveUp) clearTimeout(giveUp);
          calBusyId = null;
        }
        // Repaint whichever copy of this section is on screen now, and only if
        // it is still this booking's. Another trip, or the list, gets nothing:
        // the links are cached and show the next time this trip is opened.
        const live = calOnScreen;
        if (live && live.wrap.isConnected) live.paint(live.id === id);
      }

      calOnScreen = { id: b.id, wrap, paint };
      paint(false);
      return wrap;
    }

    // ── SEAT CHANGED (0373, Justin 2026-10-07) ─────────────────────────────
    // Another rider was confirmed for the seat this rider asked for, so the
    // request moved to an open seat at the same price. The driver can't accept
    // it until the rider keeps the new seat here. Nothing is charged before
    // that. Withdraw uses the normal withdraw panel below.
    function seatChangeSection(b, st) {
      const wrap = el('div');
      if (st !== 'Pending' || !b.seat_change_at || b.seat_change_ok_at) return wrap;
      const seats = (b.ride && Array.isArray(b.ride.seats)) ? b.ride.seats : [];
      const labelOf = (id) => { const x = seats.find((q) => q && q.id === id); return (x && x.label) || id; };
      const now = Array.isArray(b.seat_ids) ? b.seat_ids : [];
      const toLabel = now.map(labelOf).join(', ') || 'another seat';
      const lost = (Array.isArray(b.seat_change_from) ? b.seat_change_from : []).filter((id) => !now.includes(id));
      const fromLabel = lost.map(labelOf).join(', ');
      // The whole card hold (seat + fees − credit), the number on their card.
      const hold = Math.round((Number(b.total_price) || 0) * 100)
        + (Number(b.service_fee_cents) || 0) + (Number(b.booking_fee_cents) || 0) - (Number(b.credit_applied_cents) || 0);
      const price = Number.isFinite(hold) && hold > 0 ? ' $' + (hold % 100 === 0 ? String(hold / 100) : (hold / 100).toFixed(2)) + ' total.' : '';
      const card = el('div', 'card');
      card.style.borderColor = 'var(--seat-line)';
      card.appendChild(el('h2', null, fromLabel ? 'The ' + fromLabel.toLowerCase() + ' seat went to another rider' : 'Your seat changed'));
      card.appendChild(el('p', 'sub', 'Want ' + toLabel + ' instead? Same price.' + price + " The seat isn't charged unless the driver accepts."));
      const msg = el('p', 'sub');
      const keep = el('button', 'primary', 'Keep ' + toLabel);
      keep.type = 'button';
      keep.style.marginBottom = '8px';
      keep.addEventListener('click', async () => {
        keep.disabled = true; keep.textContent = 'Saving…'; msg.textContent = '';
        try {
          // The move on screen: if the request moved again since, the server
          // says so instead of OK'ing a seat the rider hasn't seen.
          await callFn('confirm-seat-change', { bookingId: b.id, seenSeatChangeAt: b.seat_change_at });
          clear(card);
          card.appendChild(el('h2', null, 'You kept ' + toLabel));
          card.appendChild(el('p', 'sub', "We told the driver. The seat is only charged if they accept."));
        } catch (e) {
          keep.disabled = false; keep.textContent = 'Keep ' + toLabel;
          msg.textContent = (e && e.message) || 'Could not save that just now. Try again in a moment.';
        }
      });
      card.appendChild(keep);
      const wd = el('button', 'linkbtn danger', 'Withdraw my request');
      wd.type = 'button';
      wd.style.display = 'block';
      wd.addEventListener('click', () => {
        const w = document.querySelector('[data-withdraw-open]');
        if (w) { w.click(); try { w.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (_) {} }
      });
      card.appendChild(wd);
      card.appendChild(msg);
      wrap.appendChild(card);
      return wrap;
    }

    // ── CANCEL ────────────────────────────────────────────────────────────
    // A proxy call, not a refund path. web-cancel-booking forwards the rider's
    // own JWT to stripe-refund-booking, which owns every gate, the tier math,
    // the timezone handling and the idempotency. Nothing about refunds is
    // reimplemented here.
    let cancelPanelOpen = false;

    function cancelSection(b, st, departed) {
      const wrap = el('div');

      // Once the PIN is in, the server 409s (stripe-refund-booking's
      // pickup_code_entered_at gate) — don't offer a button that can't work.
      if (b.pickup_code_entered_at) return wrap;
      if (st !== 'Pending' && st !== 'Confirmed') return wrap;
      if (st === 'Confirmed' && departed) return wrap;

      const isPending = st === 'Pending';
      const openBtn = el('button', 'linkbtn danger', isPending ? 'Withdraw my request' : 'Cancel this booking');
      openBtn.type = 'button';
      openBtn.setAttribute('data-withdraw-open', '1');
      openBtn.style.display = 'block';
      openBtn.style.margin = '4px auto 0';

      const panel = el('div', 'card hidden');
      panel.style.borderColor = 'var(--cancel-line)';

      panel.appendChild(el('div', 'eyebrow', isPending ? 'Withdraw request' : 'Cancel booking'));
      panel.appendChild(el('h1', null, isPending ? 'Withdraw this request?' : 'Cancel this booking?'));

      const hrs = (departureMs(b.ride) - Date.now()) / 3600000;
      if (isPending) {
        panel.appendChild(el('p', 'sub',
          "The driver hasn't accepted yet, so nothing has been charged — withdrawing releases the authorization on your card in full."));
      } else {
        panel.appendChild(el('p', 'sub',
          'Departure is about ' + Math.max(0, Math.round(hrs)) + ' hour' + (Math.round(hrs) === 1 ? '' : 's')
          + " away. Here's this ride's cancellation policy:"));
        const ul = el('ul', 'policy');
        // 0387 (Justin, 2026-10-12): the driver moved the departure after this
        // rider booked, so a cancel refunds everything, booking fee included,
        // whatever the tier says. Same rule as stripe-refund-booking's
        // rescheduledUnderRider branch; this line only tells the rider.
        const movedAfterBooking = b.status === 'Confirmed' && b.ride.schedule_changed_at && b.created_at
          && Date.parse(b.ride.schedule_changed_at) > Date.parse(b.created_at);
        if (movedAfterBooking) {
          ul.appendChild(el('li', null, 'The driver changed the departure time after you booked: cancel 2 hours or more before the new departure and everything is refunded, booking fee included.'));
        }
        policyDetails(b.ride.cancellation_policy).forEach((line) => ul.appendChild(el('li', null, line)));
        panel.appendChild(ul);
        panel.appendChild(el('p', 'hint', "We'll show you the exact refund amount as soon as it's processed."));
      }

      const ta = document.createElement('textarea');
      ta.id = 'cancelReason';
      ta.maxLength = 500;
      ta.placeholder = isPending
        ? 'e.g. My plans changed and I no longer need this ride'
        : 'e.g. My plans changed and I can no longer make this trip';
      const lbl = el('label', null, 'Reason (required)');
      lbl.setAttribute('for', 'cancelReason');
      panel.appendChild(lbl);
      panel.appendChild(ta);
      const counter = el('p', 'hint', '0 / 10 characters minimum');
      panel.appendChild(counter);

      const confirm = el('button', 'primary', isPending ? 'Withdraw request' : 'Cancel booking');
      confirm.type = 'button';
      confirm.disabled = true;
      panel.appendChild(confirm);

      const keep = el('button', 'linkbtn', isPending ? 'Never mind, keep my request' : 'Never mind, keep my booking');
      keep.type = 'button';
      keep.style.display = 'block';
      keep.style.margin = '14px auto 0';
      panel.appendChild(keep);

      const msg = el('div', 'msg err hidden');
      panel.appendChild(msg);

      // The server rejects reasons shorter than 10 chars — mirror the bar here
      // so the rider learns it while typing, not after a round trip.
      ta.addEventListener('input', () => {
        const n = ta.value.trim().length;
        counter.textContent = n + ' / 10 characters minimum';
        confirm.disabled = n < 10;
      });

      openBtn.addEventListener('click', () => {
        cancelPanelOpen = true;   // freezes the background refresh — see detailIsLive()
        panel.classList.remove('hidden');
        openBtn.classList.add('hidden');
        ta.focus();
      });
      keep.addEventListener('click', () => {
        cancelPanelOpen = false;
        panel.classList.add('hidden');
        openBtn.classList.remove('hidden');
        msg.classList.add('hidden');
      });

      confirm.addEventListener('click', async () => {
        const reason = ta.value.trim();
        if (reason.length < 10) return;
        confirm.disabled = true; confirm.textContent = 'Cancelling…';
        keep.disabled = true; ta.disabled = true;
        msg.classList.add('hidden');
        try {
          const out = await callFn('web-cancel-booking', { bookingId: b.id, reason });
          // Done — swap the whole panel for the outcome. alreadyRefunded is a
          // success, not an error: the rider double-tapped or came back to a
          // stale tab. cancelPanelOpen stays TRUE on purpose so the background
          // refresh can't repaint this confirmation out from under them; the
          // next real navigation resets it in render().
          clear(panel);
          panel.style.borderColor = 'var(--done-panel-line)';
          panel.appendChild(el('div', 'icon center', '✓'));
          panel.appendChild(el('h1', 'center', isPending ? 'Request withdrawn' : 'Booking cancelled'));
          let line;
          if (typeof out.refundAmountCents === 'number' && out.refundAmountCents > 0) {
            line = fmtCents(out.refundAmountCents) + ' is on its way back to your original payment method — '
              + 'it can take 5–10 business days to appear on your statement.';
          } else if (isPending) {
            line = 'Your card was never charged — the authorization is released and the seat is open again.';
          } else {
            line = "No refund was due under this ride's cancellation policy. If you think that's wrong, "
              + 'email support@seatsherpa.app with your booking reference.';
          }
          panel.appendChild(el('p', 'sub center', line));
          const backBtn = el('button', 'outline', 'Back to my trips');
          backBtn.type = 'button';
          backBtn.addEventListener('click', () => go('/trips'));
          panel.appendChild(backBtn);
        } catch (e) {
          msg.textContent = cancelErrorCopy(e);
          msg.classList.remove('hidden');
          confirm.disabled = false; confirm.textContent = isPending ? 'Withdraw request' : 'Cancel booking';
          keep.disabled = false; ta.disabled = false;
        }
      });

      wrap.appendChild(openBtn);
      wrap.appendChild(panel);
      return wrap;
    }

    /** stripe-refund-booking's error strings are already written for riders
     *  (they name support@seatsherpa.app and explain why), so pass them through
     *  VERBATIM rather than paraphrasing support copy into a second dialect.
     *  The one exception is the raw status string, which leaks internals. */
    function cancelErrorCopy(e) {
      const raw = String((e && (e.error || e.message)) || '');
      if (/cannot refund booking in status/i.test(raw)) {
        return 'This booking can no longer be cancelled here. Refresh to see its current status, '
          + 'or email support@seatsherpa.app with your booking reference.';
      }
      if (e && e.status === 401) {
        return 'Your sign-in expired. Refresh the page and sign in again.';
      }
      if (e && e.status === 403 && !raw) {
        return 'You can’t cancel this booking from here. Email support@seatsherpa.app with your booking reference.';
      }
      if (raw) return raw;
      return "We couldn't cancel that just now. Try again, or email support@seatsherpa.app with your booking reference.";
    }

    // ── Edge-function call ────────────────────────────────────────────────
    // Prefer the shared helper (it owns the two header shapes — `apikey` AND a
    // user `Authorization`, which is the classic 401 when mixed up). Local
    // fallback keeps this page working if the module ships without it.
    async function callFn(name, body) {
      if (typeof S.callFn === 'function') {
        return await S.callFn(name, { body, auth: 'user' });
      }
      const { data: sd } = await supabase.auth.getSession();
      const token = sd && sd.session && sd.session.access_token;
      if (!token) { const err = new Error('not signed in'); err.status = 401; throw err; }
      const res = await fetch(SUPA + '/functions/v1/' + name, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: ANON, Authorization: 'Bearer ' + token },
        body: JSON.stringify(body),
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok) {
        const err = new Error((out && (out.error || out.message)) || ('HTTP ' + res.status));
        err.status = res.status;
        err.error = out && out.error;
        throw err;
      }
      return out;
    }

    // ── CHAT ──────────────────────────────────────────────────────────────
    // POLLING, not realtime — and I'd rather say so than pretend. The messages
    // table's policies aren't in any migration and there is no
    // supabase_realtime publication anywhere in the repo, so I can't verify
    // from source that a browser `authenticated` session can subscribe. On top
    // of that a WebSocket needs realtime.setAuth re-applied on token refresh
    // and silently fails to reconnect after mobile-Safari backgrounding — the
    // wrong failure mode for a page whose whole job is to work at a curb.
    //
    // The honest cost: up to ~6s of latency, and a web rider gets NO
    // notification when the driver messages them (no push token, and chat
    // messages don't email). That's a real downgrade versus the app.
    // broadcast_id (0346) marks a "Message all riders" copy; place (0347) is
    // a meeting spot.
    const MSG_SELECT = 'id, booking_id, sender_id, body, created_at, read_at, is_system, broadcast_id, place';
    // The open chat's original pickup (my boarding stop, else the ride's
    // start), for "0.4 mi from the original pickup" on spot cards.
    let chatSpotFrom = null;
    // The driver's first name in the open chat, for "Derek's location" on a
    // "Send my location" pin (2026-10-18).
    let chatThemFirst = '';
    function pickupPointOf(b) {
      const s = b && b.boarding_stop;
      if (s && typeof s.lat === 'number' && typeof s.lng === 'number') return { lat: s.lat, lng: s.lng };
      const r = b && b.ride;
      if (r && r.start_lat != null && r.start_lng != null) return { lat: Number(r.start_lat), lng: Number(r.start_lng) };
      return null;
    }
    let chatMsgs = new Map();   // id → row (dedupes optimistic vs polled)
    let chatSince = null;       // max created_at seen
    let composerFocused = false;
    let chatClosedNow = false;  // set by renderChat: the declined request's hour is over (0395)

    function uuid() {
      try { return crypto.randomUUID(); } catch (_) {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
          const r = (Math.random() * 16) | 0;
          return (c === 'x' ? r : ((r & 0x3) | 0x8)).toString(16);
        });
      }
    }

    function orderedMsgs() {
      return Array.from(chatMsgs.values()).sort((a, z) => {
        const d = String(a.created_at).localeCompare(String(z.created_at));
        return d !== 0 ? d : String(a.id).localeCompare(String(z.id));
      });
    }

    function absorb(rows) {
      let changed = false;
      for (const r of rows || []) {
        const prev = chatMsgs.get(r.id);
        // Never let a polled row clobber the local _state flag on a row we're
        // still sending — but a confirmed row does clear it.
        chatMsgs.set(r.id, Object.assign({}, prev || {}, r, { _state: null }));
        if (!prev) changed = true;
        if (!chatSince || String(r.created_at) > chatSince) chatSince = String(r.created_at);
      }
      return changed;
    }

    function paintThread() {
      const box = $('chatThread');
      if (!box) return;
      const atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 60;
      clear(box);
      const rows = orderedMsgs();
      if (rows.length === 0) {
        box.appendChild(el('div', 'emptythread', chatClosedNow
          ? 'No messages were sent before this conversation closed.'
          : 'No messages yet. Say hi — most drivers answer within a few hours.'));
      }
      for (const m of rows) {
        const mine = m.sender_id === me;
        const sys = m.is_system === true;
        // The 24h "How was your trip?" card is one shared bubble; hide it once
        // THIS viewer has rated (Justin, 2026-09-05). The other side may still
        // need it, so the row stays in the thread for them.
        if (sys && /^⭐ How was your trip\?/.test(String(m.body || '')) && myRatingByBooking[m.booking_id]) continue;
        // Meeting spot (0347): the note (if any) as a bubble, then the map card.
        const spot = !sys && m.place && window.SSMeetingSpot && SSMeetingSpot.valid(m.place) ? m.place : null;
        // "Send my location" pin (2026-10-18): the same card, labeled by whose.
        const here = !!spot && !!SSMeetingSpot.isHere && SSMeetingSpot.isHere(m.body);
        const text = spot ? SSMeetingSpot.noteOf(m.body, spot) : (m.body || '');
        if (!spot || text) {
          const row = el('div', 'brow ' + (sys ? 'sys' : mine ? 'me' : 'them'));
          const bub = el('div', 'bubble' + (m._state === 'sending' ? ' sending' : m._state === 'failed' ? ' failed' : ''));
          // Text nodes only: chat bodies are typed by the other party.
          // Addresses and map links become links (2026-10-18).
          if (window.SSChatLinks) SSChatLinks.fill(bub, text); else bub.textContent = text;
          row.appendChild(bub);
          box.appendChild(row);
        }
        if (spot) {
          const srow = el('div', 'brow ' + (mine ? 'me' : 'them'));
          srow.style.marginTop = '4px';
          const hereTitle = mine ? 'Your location' : chatThemFirst ? chatThemFirst + '’s location' : 'Their location';
          srow.appendChild(SSMeetingSpot.card(spot, { from: chatSpotFrom, here: here ? { title: hereTitle } : null }));
          box.appendChild(srow);
        }
        if (!sys) {
          const t = el('div', 'btime', m._state === 'sending' ? 'Sending…'
            : m._state === 'failed' ? 'Not sent — tap send to retry'
            : new Date(m.created_at).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }));
          if (!mine) t.style.textAlign = 'left';
          box.appendChild(t);
          // "Message all riders" (0346): the driver sent this same message
          // to every confirmed rider, each in their own chat.
          if (m.broadcast_id) {
            const bc = el('div', 'btime', 'Sent to every booked rider on this drive');
            bc.style.fontSize = '12px';
            bc.style.marginBottom = '6px';
            if (!mine) bc.style.textAlign = 'left';
            box.appendChild(bc);
          }
        }
      }
      if (atBottom) box.scrollTop = box.scrollHeight;
    }

    async function pollMessages(bookingId, initial) {
      let q = supabase.from('messages').select(MSG_SELECT).eq('booking_id', bookingId).order('created_at', { ascending: true });
      // gte, not gt: equal timestamps at the boundary would drop a message, and
      // the id-keyed Map makes the one-row overlap free.
      if (!initial && chatSince) q = q.gte('created_at', chatSince);
      const { data, error } = await q;
      if (error) throw error;
      const changed = absorb(data);
      if (changed || initial) paintThread();
      if (changed) void markRead(bookingId);
      return data || [];
    }

    async function markRead(bookingId) {
      try {
        await supabase.from('messages')
          .update({ read_at: new Date().toISOString() })
          .eq('booking_id', bookingId)
          .neq('sender_id', me)
          .is('read_at', null);
      } catch (_) { /* read receipts are cosmetic — never block the thread */ }
    }

    function threadIsHot() {
      if (composerFocused) return true;
      const rows = orderedMsgs();
      if (rows.length === 0) return false;
      const last = rows[rows.length - 1];
      return Date.now() - new Date(last.created_at).getTime() < 5 * 60 * 1000;
    }

    /** A browser request that has not reached payment: Pending, web, no
     *  payment_verified_at. It is not a request yet from the driver's side. */
    function unpaidWeb(b) {
      return !!b && b.source === 'web' && b.status === 'Pending' && !b.payment_verified_at;
    }

    /** Suggest a meeting spot (0347) to my driver: a map card in our chat,
     *  then the same notification as a typed message. */
    async function sendSpotMessage(b, place, note, bodyText) {
      const id = uuid();
      // bodyText: a "Send my location" pin's own text (SSMeetingSpot.hereBody).
      const text = bodyText || SSMeetingSpot.body(note, place);
      const { data, error } = await supabase
        .from('messages')
        .insert({ id, booking_id: b.id, sender_id: me, body: text, place })
        .select(MSG_SELECT)
        .single();
      if (error) throw error;
      absorb([data]);
      paintThread();
      const driverId = b.ride && b.ride.driver_id;
      if (driverId && driverId !== me) {
        void callFn('send-push', {
          recipientIds: [driverId],
          title: 'Seat Sherpa',
          body: myRawName ? 'You have a new message from rider ' + myRawName : 'You have a new message',
          data: { type: 'new_message', bookingId: b.id, messageId: id },
        }).catch(() => {});
      }
    }

    function renderChat(b) {
      const body = $('chatBody');
      clear(body);
      chatMsgs = new Map();
      chatSince = null;
      composerFocused = false;
      chatSpotFrom = pickupPointOf(b);
      // A real first name only: firstName() falls back to "your driver".
      chatThemFirst = driverRawName(b) ? driverFirst(b) : '';
      // Chat window after a decline / withdrawal (0395, 2026-10-16): while
      // the hour runs the standing line counts down and points back to a new
      // request; after it the composer is gone and the server refuses sends.
      // Same copy as the app (lib/chat-window.ts). A whole-ride cancel gets
      // the plain "cancelled" lines: there is no ride left to request.
      const closesAt = chatClosesAt(b);
      const chatClosed = closesAt !== null && Date.now() > closesAt;
      chatClosedNow = chatClosed;
      const endedWord = isDeclined(b) ? 'declined' : b.cancelled_by === 'passenger' ? 'withdrawn' : 'cancelled';
      const countdownCopy = (n) => 'This request was ' + endedWord + ', so messages here close in ' + n + (n === 1 ? ' minute' : ' minutes')
        + (endedWord === 'cancelled' ? '.' : ". If you still want to ride together, send a new request. Rides arranged outside Seat Sherpa aren't covered, and the booking fee still applies.");
      const closedCopy = 'This conversation closed an hour after the request was ' + endedWord
        + (endedWord === 'cancelled' ? '.' : '. To ride together, send a new request.');
      const minutesLeft = closesAt === null ? null : Math.max(1, Math.ceil((closesAt - Date.now()) / 60000));

      body.appendChild(backRow('Back to trip', () => go('/trips?ref=' + encodeURIComponent(b.ref_code))));

      // Unpaid web request: no thread yet (2026-09-03). Finishing payment is
      // what sends the request; messaging opens right after.
      if (unpaidWeb(b)) {
        const c = el('div', 'card');
        c.appendChild(el('div', 'eyebrow', routeLabel(b.ride) + ' · ' + dateLabel(b.ride.dep_date)));
        c.appendChild(el('h1', null, 'Finish your request first'));
        c.appendChild(el('p', 'sub', 'Your request to ' + driverFirst(b) + " hasn't been sent yet. It reaches them the moment your card is authorized, and that's also when messaging opens. The seat is only charged if they accept."));
        const pay = el('button', 'primary', 'Finish payment');
        pay.type = 'button';
        pay.addEventListener('click', () => go('/book?id=' + encodeURIComponent(b.ride.id)));
        c.appendChild(pay);
        body.appendChild(c);
        body.appendChild(signedInFooter());
        return;
      }

      const card = el('div', 'card');
      card.appendChild(el('div', 'eyebrow', routeLabel(b.ride) + ' · ' + dateLabel(b.ride.dep_date)));
      card.appendChild(el('h1', null, driverDisplay(b)));
      card.appendChild(el('p', 'sub', chatClosed
        ? 'This conversation is closed. Earlier messages stay here.'
        : 'Messages here reach ' + driverFirst(b) + ' right away, wherever they use Seat Sherpa. '
          + 'This page checks for replies every few seconds while it’s open.'));

      const thread = el('div', 'thread');
      thread.id = 'chatThread';
      card.appendChild(thread);

      // CALL (2026-09-03, app parity): the number comes from counterparty_phone()
      // — Confirmed only (0381), 24h either side of departure, parties only —
      // and is fetched only when tapped. The pre-checks just give a friendlier
      // message than the RPC's empty result.
      const callRow = el('div', 'callrow');
      callRow.style.cssText = 'display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:6px 0 10px;';
      const callBtn = el('button', 'linkbtn', 'Call ' + driverFirst(b));
      callBtn.type = 'button';
      callBtn.style.cssText = 'border:1px solid var(--call);color:var(--call);background:transparent;border-radius:999px;padding:8px 14px;font-weight:700;font-size:14px;cursor:pointer;';
      const callMsg = el('div', 'msg hidden');
      callMsg.style.cssText = 'font-size:14px;color:var(--callmsg);margin:0;';
      callRow.appendChild(callBtn);
      callRow.appendChild(callMsg);
      card.appendChild(callRow);
      if (chatClosed) callRow.style.display = 'none';
      // The call window ends when the ride is completed (0381, 2026-10-08).
      // The REAL status, not the pickup-code display status: calling works for
      // the whole ride and stops once the booking is Completed.
      if (b.status === 'Completed') {
        callBtn.style.display = 'none';
        callMsg.textContent = 'Calling ended when the ride was completed. Message here instead.';
        callMsg.classList.remove('hidden');
      }
      callBtn.addEventListener('click', async () => {
        callMsg.classList.add('hidden');
        const say = (t) => { callMsg.textContent = t; callMsg.classList.remove('hidden'); };
        const st = (b.pickup_code_entered_at ? 'Completed' : b.status);
        if (st !== 'Confirmed' && st !== 'Completed') { say('Calling opens once the booking is confirmed — message here for now.'); return; }
        const dep = departureMs(b.ride);
        const H = 3600 * 1000;
        if (Number.isFinite(dep)) {
          const now = Date.now();
          if (now < dep - 24 * H) {
            const h = Math.ceil((dep - 24 * H - now) / H);
            say('Calling opens 24 hours before pickup (' + (h <= 24 ? 'in ' + h + (h === 1 ? ' hour' : ' hours') : 'in ' + Math.round(h / 24) + ' days') + '). Until then, message here.');
            return;
          }
          if (now > dep + 24 * H) { say('Calling closed 24 hours after the ride. Message here instead.'); return; }
        }
        callBtn.disabled = true;
        try {
          const { data, error } = await supabase.rpc('counterparty_phone', { p_booking_id: b.id });
          const row = Array.isArray(data) ? data[0] : data;
          const cc = String((row && row.phone_country_code) || '').replace(/\D/g, '');
          const num = String((row && row.phone) || '').replace(/\D/g, '');
          // No row = the server refused (window closed, ride completed, status
          // changed while this page was open); a row with no number = no number.
          if (error || !row) { say("Calling isn't available for this booking right now. Message here instead."); return; }
          if (!cc || !num) { say("They haven't added a phone number yet. Message here instead."); return; }
          location.href = 'tel:+' + cc + num;
        } catch (_) {
          say("Couldn't get the number just now — try again in a moment.");
        } finally {
          callBtn.disabled = false;
        }
      });

      // STANDING off-platform line, ALWAYS visible above the chat box, before
      // anyone types (Justin, 2026-09-20: "make sure that they get warned
      // before posting/messaging. since tibor was not"). The pop-up below only
      // fires when the detector recognizes the text; a driver spelled his
      // number one letter at a time with asterisks and was never told. Same
      // wording as the app (lib/off-platform-guard.ts offPlatformStandingNotice).
      const standing = el('div', 'hint');
      standing.style.margin = '12px 0 0';
      standing.textContent = closesAt !== null && !chatClosed
        ? countdownCopy(minutesLeft)
        : b.status === 'Completed'
        // The call window ended at completion (0381).
        ? 'Keep it on Seat Sherpa. Payment and no-show protection only cover rides kept here.'
        : b.status === 'Confirmed'
        ? 'Keep it on Seat Sherpa. Payment and no-show protection only cover rides kept here, and you can call each other from this chat the day before the ride.'
        : b.status === 'Pending'
          ? 'Phone numbers, emails and handles stay hidden until your driver accepts. After that you can call each other from this chat.'
          : "Phone numbers, emails and handles are hidden in this chat because the booking isn't confirmed.";
      if (!chatClosed) card.appendChild(standing);

      const composer = el('div', 'composer');
      const ta = document.createElement('textarea');
      ta.placeholder = 'Message ' + driverFirst(b) + '…';
      ta.maxLength = 2000; // same cap as sendMessage() and web-create-booking's driverMessage
      ta.rows = 1;
      const sendBtn = el('button', 'primary', 'Send');
      sendBtn.type = 'button';
      composer.appendChild(ta);
      composer.appendChild(sendBtn);
      if (chatClosed) {
        const closedNote = el('div', 'hint');
        closedNote.style.margin = '12px 0 0';
        closedNote.textContent = closedCopy;
        card.appendChild(closedNote);
      } else {
        card.appendChild(composer);
      }

      const cmsg = el('div', 'msg err hidden');
      card.appendChild(cmsg);

      // The hour keeps running while the page is open (review 2026-10-16):
      // refresh the countdown every 30 s and swap the composer for the
      // closed note when it ends. The interval dies with the card.
      if (closesAt !== null && !chatClosed) {
        const tick = setInterval(() => {
          if (!document.body.contains(card)) { clearInterval(tick); return; }
          // A send refused as chat_closed already swapped the composer for the
          // closed copy; adding the note too showed it twice (bug check 2026-10-19).
          if (chatClosedNow) { clearInterval(tick); return; }
          if (Date.now() > closesAt) {
            clearInterval(tick);
            chatClosedNow = true;
            standing.remove();
            composer.remove();
            const closedNote = el('div', 'hint');
            closedNote.style.margin = '12px 0 0';
            closedNote.textContent = closedCopy;
            cmsg.before(closedNote);
            return;
          }
          standing.textContent = countdownCopy(Math.max(1, Math.ceil((closesAt - Date.now()) / 60000)));
        }, 30000);
      }

      // Meeting spot (0347, Justin 2026-10-04): suggest a spot to the driver
      // as a map card; the newest one is the current spot, no accept step.
      // Confirmed bookings only.
      if (b.status === 'Confirmed' && window.SSMeetingSpot) {
        const spotActions = el('div');
        spotActions.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px 20px;margin-top:10px;';
        const spotBtn = el('button', 'linkbtn', 'Share a meeting spot');
        spotBtn.type = 'button';
        spotActions.appendChild(spotBtn);
        // "Send my location" (Justin, 2026-10-18): a one-time pin of where I
        // am right now, as a map card. Day-of only (the call window, 24 h
        // either side of departure), so nobody's home shows up days ahead.
        const depAt = departureMs(b.ride);
        const hereOk = Number.isFinite(depAt) && Math.abs(Date.now() - depAt) <= 24 * 3600 * 1000;
        const hereBtn = hereOk ? el('button', 'linkbtn', 'Send my location') : null;
        if (hereBtn) { hereBtn.type = 'button'; spotActions.appendChild(hereBtn); }
        const spotPanel = el('div', 'hidden');
        spotPanel.style.marginTop = '10px';
        card.appendChild(spotActions);
        card.appendChild(spotPanel);
        // Which panel owns spotPanel right now (review 2026-10-18): opening the
        // other panel, or "Never mind", bumps it, so a location request still
        // in flight can neither send nor close a panel it no longer owns.
        let panelSeq = 0;
        if (hereBtn) hereBtn.addEventListener('click', () => {
          const mySeq = ++panelSeq;
          hereBtn.classList.add('hidden');
          spotBtn.classList.remove('hidden');
          clear(spotPanel);
          cmsg.classList.add('hidden');
          const live = () => mySeq === panelSeq;
          const closeHere = () => {
            if (!live()) return;
            panelSeq++;
            clear(spotPanel); spotPanel.classList.add('hidden');
            hereBtn.classList.remove('hidden'); spotBtn.classList.remove('hidden');
          };
          const who = driverFirst(b);
          const hint = el('div', null, who.charAt(0).toUpperCase() + who.slice(1) + ' will see where you are right now on a map. It’s a one-time pin, not live tracking.');
          hint.style.cssText = 'font-size:13px;color:var(--sub2);margin:0 0 10px;line-height:1.5;';
          const send = el('button', 'primary', 'Send my location');
          send.type = 'button';
          const never = el('button', 'linkbtn', 'Never mind');
          never.type = 'button';
          never.style.display = 'block';
          never.style.marginTop = '6px';
          never.addEventListener('click', closeHere);
          send.addEventListener('click', () => {
            const fail = (t) => {
              if (!live()) return;
              send.disabled = false; send.textContent = 'Send my location';
              cmsg.textContent = t; cmsg.classList.remove('hidden');
            };
            if (!navigator.geolocation) { fail('This browser can’t share your location.'); return; }
            cmsg.classList.add('hidden');
            send.disabled = true; send.textContent = 'Finding you…';
            navigator.geolocation.getCurrentPosition(async (pos) => {
              if (!live()) return; // "Never mind" while it was finding you
              // An approximate fix (laptop Wi-Fi or IP) would still become an
              // exact street address, so it is never sent.
              if (pos.coords.accuracy > 250) {
                fail('Your location is only approximate right now. Try again from your phone, or share a meeting spot instead.');
                return;
              }
              const lat = pos.coords.latitude;
              const lng = pos.coords.longitude;
              const address = await SSMeetingSpot.reverse(lat, lng);
              if (!live()) return;
              const place = { name: '', address: address || (lat.toFixed(5) + ', ' + lng.toFixed(5)), lat, lng };
              try {
                await sendSpotMessage(b, place, '', SSMeetingSpot.hereBody(place));
                closeHere();
              } catch (e) {
                fail('Location not sent: ' + ((e && e.message) || 'check your connection and try again.'));
              }
            }, (err) => {
              fail(err && err.code === 1
                ? 'Location is blocked for this site. Allow it in your browser settings, then try again.'
                : 'Couldn’t find your location. Try again in a moment.');
            }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
          });
          spotPanel.appendChild(hint);
          spotPanel.appendChild(send);
          spotPanel.appendChild(never);
          spotPanel.classList.remove('hidden');
        });
        spotBtn.addEventListener('click', () => {
          const spotSeq = ++panelSeq;
          if (hereBtn) hereBtn.classList.remove('hidden');
          spotBtn.classList.add('hidden');
          clear(spotPanel);
          let picked = null;
          const preview = el('div');
          const share = el('button', 'primary', 'Share this spot');
          share.type = 'button';
          share.disabled = true;
          const pick = SSMeetingSpot.picker((p) => {
            picked = p;
            clear(preview);
            if (p) preview.appendChild(SSMeetingSpot.card(p, { from: chatSpotFrom }));
            share.disabled = !p;
          });
          const note = document.createElement('input');
          note.type = 'text';
          note.maxLength = 200;
          note.placeholder = 'Add a note (optional), e.g. "by the front entrance"';
          note.setAttribute('aria-label', 'Note with the meeting spot');
          const closeSpot = () => {
            if (spotSeq !== panelSeq) return; // the location panel took over
            panelSeq++;
            clear(spotPanel); spotPanel.classList.add('hidden');
            spotBtn.classList.remove('hidden'); if (hereBtn) hereBtn.classList.remove('hidden');
          };
          share.addEventListener('click', async () => {
            if (!picked) return;
            // The chat's off-platform speed bump, for the note too (bug check
            // 2026-10-05): warn once, a second tap sends it anyway.
            const noteText = note.value.trim();
            const spotLog = (action) => { try { supabase.from('offplatform_warnings').insert({ surface: 'web_chat_rider', hit: 'phone', action, booking_id: b.id }).then(() => {}, () => {}); } catch (_) {} };
            if (noteText && SSMeetingSpot.phoneHit && SSMeetingSpot.phoneHit(noteText)) {
              if (share.dataset.warned !== noteText) {
                share.dataset.warned = noteText;
                spotLog('shown');
                cmsg.textContent = SSMeetingSpot.PHONE_WARNING;
                cmsg.classList.remove('hidden');
                return;
              }
              spotLog('sent_anyway');
            }
            cmsg.classList.add('hidden');
            share.disabled = true; share.textContent = 'Sharing…';
            try {
              await sendSpotMessage(b, picked, note.value);
              closeSpot();
            } catch (e) {
              share.disabled = false; share.textContent = 'Share this spot';
              cmsg.textContent = 'Spot not shared: ' + ((e && e.message) || 'check your connection and try again.');
              cmsg.classList.remove('hidden');
            }
          });
          const never = el('button', 'linkbtn', 'Never mind');
          never.type = 'button';
          never.style.display = 'block';
          never.style.marginTop = '6px';
          never.addEventListener('click', closeSpot);
          const spotHint = el('div', null, 'Pick a place. Your driver gets a map card they can open in Google Maps or Apple Maps.');
          spotHint.style.cssText = 'font-size:12px;color:var(--sub2);margin:0 0 8px;line-height:1.5;';
          spotPanel.appendChild(spotHint);
          spotPanel.appendChild(pick);
          spotPanel.appendChild(preview);
          spotPanel.appendChild(note);
          spotPanel.appendChild(share);
          spotPanel.appendChild(never);
          spotPanel.classList.remove('hidden');
          pick.focusInput();
        });
      }

      body.appendChild(card);
      body.appendChild(signedInFooter());

      ta.addEventListener('focus', () => { composerFocused = true; });
      ta.addEventListener('blur', () => { composerFocused = false; });
      ta.addEventListener('keydown', (e) => {
        // Enter sends on a desktop keyboard; Shift+Enter and mobile keyboards
        // keep the newline.
        if (e.key === 'Enter' && !e.shiftKey && !/Mobi|Android/i.test(navigator.userAgent)) {
          e.preventDefault(); sendBtn.click();
        }
      });

      async function doSend() {
        cmsg.classList.add('hidden');
        if (chatClosed) return;
        // Retry path: a previously failed bubble re-sends when the composer is
        // empty and the user taps Send again.
        const failed = orderedMsgs().filter((m) => m._state === 'failed');
        let text = ta.value.trim();
        let retryRow = null;
        if (!text && failed.length) { retryRow = failed[failed.length - 1]; text = retryRow.body; }
        if (!text) return;
        if (text.length > 2000) { cmsg.textContent = 'That message is too long (2000 characters max).'; cmsg.classList.remove('hidden'); return; }
        // 0305: log that the warning was shown and whether they sent anyway.
        // Fire and forget; a missing table or a refusal changes nothing here.
        const logWarn = (action) => { try { supabase.from('offplatform_warnings').insert({ surface: 'web_chat_rider', hit: hitKind, action, booking_id: b.id }).then(() => {}, () => {}); } catch (_) {} };
        let hitKind = 'phone';
        // 0306: while the ride is not confirmed the server hides numbers,
        // emails and @handles; after that only the number warning applies.
        const hiddenNow = !(b.status === 'Confirmed' || b.status === 'Completed');
        const confirmedAfterWarning = !retryRow && !!text && sendBtn.dataset.warned === text;
        // Off-platform contact WARNING — never a block (app parity; covers
        // plain numbers and the letter-interleaved evasion, 0216).
        if (!retryRow && sendBtn.dataset.warned !== text) {
          // Spelled-out digits ("five one zero, nine zero one, eight three zero
          // two", 2026-10-11): a run of three or more number words, seven or
          // more digits in all, is read as the number it spells. Mirrors
          // lib/off-platform-guard.ts normalizeNumberWords and migration 0386;
          // the same snippet lives in driving.html and book.html.
          const probe = text.replace(/\b(?:zero|one|two|three|four|five|six|seven|eight|nine|oh|o|\d+)(?:[\s,.\-()/·*]{0,3}\b(?:zero|one|two|three|four|five|six|seven|eight|nine|oh|o|\d+)\b){2,}/gi, (run) => {
            const words = (run.match(/\b(zero|one|two|three|four|five|six|seven|eight|nine)\b/gi) || []).length;
            const digits = run.toLowerCase().replace(/\b(zero|oh|o)\b/g, '0').replace(/\bone\b/g, '1').replace(/\btwo\b/g, '2').replace(/\bthree\b/g, '3').replace(/\bfour\b/g, '4').replace(/\bfive\b/g, '5').replace(/\bsix\b/g, '6').replace(/\bseven\b/g, '7').replace(/\beight\b/g, '8').replace(/\bnine\b/g, '9').replace(/[^0-9]/g, '');
            return words >= 3 && digits.length >= 10 ? digits : run;
          });
          let hit = /(^|\D)(\+?1[\s.\-·]?)?\(?\d{3}\)?[\s.\-·]?\d{3}[\s.\-·]?\d{4}(?!\d)/.test(probe);
          if (!hit) {
            const digs = [];
            for (let i2 = 0; i2 < probe.length; i2++) if (probe[i2] >= '0' && probe[i2] <= '9') digs.push(i2);
            for (let i2 = 0; i2 + 9 < digs.length; i2++) {
              const win = probe.slice(digs[i2], digs[i2 + 9] + 1);
              // Mirrors the server masker (0307): skip times, dates, prices, prose, coordinates.
              if (win.length <= 22 && !/[:/$%]/.test(win) && !/^((19|20)\d\d\D{0,3})+$/.test(win) && !/(^|[^A-Za-z0-9])[A-Za-z]{2,}([^A-Za-z0-9]|$)/.test(win) && !/\d\.\d{3,}/.test(win) && !/(^|[^0-9-])((0?[1-9]|1[0-2])-(0?[1-9]|[12]\d|3[01])-(19|20)?\d{2}|(19|20)\d{2}-(0?[1-9]|1[0-2])-(0?[1-9]|[12]\d|3[01]))([^0-9-]|$)/.test(win)) { hit = true; break; }
            }
          }
          if (!hit && hiddenNow) {
            if (/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/.test(text)) { hit = true; hitKind = 'email'; }
            else if (/(^|[^A-Za-z0-9_.])@[A-Za-z0-9_.]{3,}/.test(text)) { hit = true; hitKind = 'handle'; }
          }
          if (hit) {
            sendBtn.dataset.warned = text;
            logWarn('shown');
            // 0306: while the ride is not confirmed the server hides the
            // number, so say that instead of pretending it will arrive. Every
            // version ends with the same fact (Justin, 2026-10-11): numbers
            // are handed over 24 hours before the ride on a confirmed booking.
            cmsg.textContent = !hiddenNow
              ? 'Sharing phone numbers moves you off Seat Sherpa. Payment and no-show protection only work here. Seat Sherpa gives you each other\'s phone numbers 24 hours before the ride, so there\'s no need to exchange them now.'
              : b.status === 'Pending'
                ? 'Phone numbers, emails and handles stay hidden until this ride is confirmed, so yours will be removed from this message. Once the booking is confirmed, Seat Sherpa gives you each other\'s phone numbers 24 hours before the ride, so there\'s no need to exchange them now.'
                : 'Phone numbers, emails and handles are hidden in this chat because the booking isn\'t confirmed, so yours will be removed from this message. On a confirmed booking, Seat Sherpa gives you each other\'s phone numbers 24 hours before the ride.';
            cmsg.classList.remove('hidden');
            return;
          }
        }
        if (confirmedAfterWarning) logWarn('sent_anyway');
        sendBtn.dataset.warned = '';
        cmsg.classList.add('hidden');

        const id = retryRow ? retryRow.id : uuid();
        const now = new Date().toISOString();
        // Optimistic append keyed on the uuid we're about to insert, so the
        // composer feels instant regardless of where we are in the poll cycle
        // and the polled copy dedupes onto the same row.
        chatMsgs.set(id, { id, booking_id: b.id, sender_id: me, body: text, created_at: retryRow ? retryRow.created_at : now, read_at: null, is_system: false, _state: 'sending' });
        ta.value = '';
        sendBtn.disabled = true;
        paintThread();

        try {
          const { data, error } = await supabase
            .from('messages')
            .insert({ id, booking_id: b.id, sender_id: me, body: text })
            .select(MSG_SELECT)
            .single();
          if (error) throw error;
          absorb([data]);
          paintThread();
          // Push the driver. send-push accepts a USER token: it applies a
          // 30/min cap plus a relationship gate scoped to people you share a
          // booking with, and rider → their own driver passes both. Pass the
          // RAW profile name — send-push re-abbreviates server-side for
          // type:'new_message'. Fire-and-forget; the message is already
          // committed and a failed push must never look like a failed send.
          const driverId = b.ride && b.ride.driver_id;
          if (driverId && driverId !== me) {
            void callFn('send-push', {
              recipientIds: [driverId],
              title: 'Seat Sherpa',
              body: myRawName
                ? 'You have a new message from rider ' + myRawName
                : 'You have a new message',
              data: { type: 'new_message', bookingId: b.id, messageId: id },
            }).catch(() => {});
          }
        } catch (e) {
          const row = chatMsgs.get(id);
          if (row) { row._state = 'failed'; chatMsgs.set(id, row); }
          paintThread();
          // The hour ran out while this page was open (0395): say so and
          // take the box away rather than offer a retry.
          if (e && /chat_closed/i.test(e.message || '')) {
            // Drop the optimistic bubble too: there is no Send left to retry.
            chatMsgs.delete(id);
            chatClosedNow = true;
            paintThread();
            composer.remove();
            standing.remove();
            cmsg.textContent = closedCopy;
          } else {
            cmsg.textContent = (e && e.message)
              ? 'Message not sent: ' + e.message
              : "Message not sent. Check your connection and tap Send to retry.";
          }
          cmsg.classList.remove('hidden');
        } finally {
          sendBtn.disabled = false;
        }
      }
      sendBtn.addEventListener('click', doSend);

      show('stChat');
      document.title = 'Chat with ' + driverDisplay(b) + ' — Seat Sherpa';

      // Initial load. A hard failure here is honest — an empty thread that's
      // actually a permissions error would have the rider believe the driver
      // never replied.
      pollMessages(b.id, true)
        .then(() => markRead(b.id))
        .catch(() => {
          cmsg.textContent = "We couldn't load this conversation. Refresh, or email support@seatsherpa.app.";
          cmsg.classList.remove('hidden');
        });

      // Incremental polling: 6s while visible and hot (recent message or the
      // composer has focus), 20s while visible and idle, PAUSED while hidden.
      let sinceLastTick = 0;
      every(2000, () => {
        if (document.hidden) return;
        sinceLastTick += 2000;
        const interval = threadIsHot() ? 6000 : 20000;
        if (sinceLastTick < interval) return;
        sinceLastTick = 0;
        pollMessages(b.id, false).catch(() => {});
      });

      const catchUp = () => {
        if (document.hidden) return;
        sinceLastTick = 0;
        pollMessages(b.id, false).catch(() => {});
      };
      document.addEventListener('visibilitychange', catchUp);
      window.addEventListener('focus', catchUp);
      // Listeners aren't intervals, so clearTimers() can't reach them. render()
      // calls this cleanup before it draws anything else — otherwise every trip
      // to the chat and back would leave another catch-up handler bound.
      chatListenerCleanup = () => {
        document.removeEventListener('visibilitychange', catchUp);
        window.removeEventListener('focus', catchUp);
      };
    }

    let chatListenerCleanup = null;

    // ── Render ────────────────────────────────────────────────────────────
    async function render() {
      // Every entry point funnels through here, so this is the single place
      // timers and listeners get torn down.
      clearTimers();
      if (chatListenerCleanup) { chatListenerCleanup(); chatListenerCleanup = null; }
      cancelPanelOpen = false;
      // A calendar error belongs to the visit it happened on: "Your sign-in
      // expired" must not greet the rider again after they sign back in.
      calError = null;

      const qp = new URLSearchParams(location.search);
      const ref = normRef(qp.get('ref'));
      const wantChat = qp.get('chat') === '1';

      let session = null;
      try {
        const { data } = await supabase.auth.getSession();
        session = data ? data.session : null;
      } catch (_) { session = null; }

      if (!session) {
        setMsg('emailMsg', '');
        show('stEmail');
        document.title = 'Your trips — Seat Sherpa';
        return;
      }

      show('stLoading');
      try {
        // getUser() = a fresh /auth/v1/user round trip, so a revoked/expired
        // session surfaces as a sign-in prompt rather than an empty list.
        const { data: ud, error: uerr } = await supabase.auth.getUser();
        if (uerr || !ud || !ud.user) { show('stEmail'); return; }
        me = ud.user.id; try { localStorage.setItem('ss_last_role', 'rider'); } catch (_) {} // /signin routes by last role
        myEmail = ud.user.email || '';
        $('nfEmail').textContent = myEmail;

        if (!myRawName) {
          const { data: prof } = await supabase.from('profiles').select('name').eq('id', me).maybeSingle();
          myRawName = (prof && prof.name) || '';
        }

        if (!ref) {
          const rows = await loadMyBookings();
          await loadMyRatings(rows);
          renderList(rows);
          return;
        }

        const b = await loadBooking(ref);
        if (!b) { show('stNotFound'); document.title = 'Booking not found — Seat Sherpa'; return; }
        // The code belongs to one booking; a new ref means a new code.
        if (!render._lastRef || render._lastRef !== ref) { pickupCode = null; render._lastRef = ref; }

        await loadMyRatings([b]);

        if (wantChat) renderChat(b);
        else renderDetail(b);
      } catch (e) {
        $('errSub').textContent = (e && e.message)
          ? "We couldn't load that: " + e.message
          : 'Something went wrong on our end. Check your connection and try again.';
        show('stError');
      }
    }

    render();
  </script>
  <script type="module" src="/js/ss-rating-gate.js"></script>
</body>
</html>
