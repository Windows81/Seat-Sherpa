      const btn = $('codeBtn');
      btn.disabled = true; btn.textContent = 'Verifying…';
      const { error } = await supabase.auth.verifyOtp({ email: pendingEmail, token: code, type: 'email' });
      // Re-enable ONLY on failure (2026-10-14): re-enabling before render() let a
      // second tap or Enter send the already-used code, which came back
      // "expired" a second after a successful sign-in.
