  <script>
    // Form submission handler. Wires the embedded form to the
    // submit-driver-waitlist Supabase edge function.
    (function () {
      const form = document.getElementById('driver-signup-form');
      const submitBtn = document.getElementById('signup-submit');
      const errorBox = document.getElementById('signup-error');
      const successBox = document.getElementById('signup-success');
      if (!form) return;

      // The Supabase project's edge functions URL. Hardcoding the project
      // ref is fine here — it's not a secret, just an HTTPS endpoint.
      const ENDPOINT = 'https://vmfmbntacifqoqxqxgsk.supabase.co/functions/v1/submit-driver-waitlist';

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        errorBox.hidden = true;

        // Trigger native validation. If the form's invalid (missing
        // required fields, bad email), bail and show browser errors.
        if (!form.checkValidity()) {
          form.classList.add('show-validation');
          form.reportValidity();
          return;
        }

        // Collect form values. FormData → plain object.
        const data = Object.fromEntries(new FormData(form));

        // Disable button + loading state. Don't change text color — just
        // dim via :disabled style.
        submitBtn.disabled = true;
        const originalLabel = submitBtn.textContent;
        submitBtn.textContent = 'Submitting…';

        try {
          const res = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          if (!res.ok) {
            let errMsg = 'Something went wrong. Please try again.';
            try {
              const body = await res.json();
              if (body && body.error) errMsg = body.error;
            } catch (_) {
              // Non-JSON error response — leave generic message
            }
            throw new Error(errMsg);
          }

          // Conversion signal for ad platforms. Fired only on a CONFIRMED
          // server success — a validation failure or network error is not a
          // conversion, and feeding false positives back is how ad
          // optimisation learns to chase the wrong people.
          //
          // SignUp, not Lead: Lead now means "tapped through to an app store"
          // (Justin, 2026-08-11). Reporting both as Lead would let the
          // optimiser trade a driver application for a curious badge tap,
          // since it cannot tell them apart.
          // One call fires Reddit (SignUp), Meta (CompleteRegistration), and
          // the Conversions API with a shared event_id so Meta counts it once.
          // The email is passed for match quality — it is SHA-256 hashed
          // server-side in the meta-capi function and never stored raw.
          try {
            if (window.ssTrack) window.ssTrack('CompleteRegistration', { em: data.email });
            else if (window.rdt) window.rdt('track', 'SignUp');
          } catch (_) {}
          try {
            if (window.gtag) window.gtag('event', 'conversion', { send_to: 'AW-18365966554' });
          } catch (_) {}

          // Success — hide form, show thank-you state.
          form.hidden = true;
          successBox.hidden = false;
          // Scroll the success card into view in case the form was tall.
          successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err) {
          errorBox.textContent = (err && err.message) || 'Something went wrong. Please try again.';
          errorBox.hidden = false;
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      });
    })();
  </script>

  <!-- Channel attribution for driver outreach. Link drivers to
       seatsherpa.app/drive?c=<code> (e.g. ?c=fb-calpoly). We log the visit so
       it shows in the daily digest's QR table, and carry the code onto the
       store links (Play &referrer, Apple ?ct) so the eventual install is
       attributed rather than counted as organic. Untagged visits untouched. -->
  <script>
    (function () {
      var qs = new URLSearchParams(location.search);
      // Accept src= too — the Meta campaign checklist used ?src=meta, and the
      // beacon silently ignoring it meant a whole ad's landings went unlogged.
      var campaign = (qs.get('c') || qs.get('utm_campaign') || qs.get('src') || '').slice(0, 40); // Apple ct caps at 40
      if (!campaign) return;
      // Log the visit (fire-and-forget; log-qr-scan 302s, we don't follow it).
      try {
        fetch('https://vmfmbntacifqoqxqxgsk.supabase.co/functions/v1/log-qr-scan?c=' +
          encodeURIComponent(campaign), { redirect: 'manual', keepalive: true }).catch(function () {});
      } catch (e) {}
      var ref =
        'utm_source=' + encodeURIComponent(qs.get('utm_source') || 'driver') +
        '&utm_medium=' + encodeURIComponent(qs.get('utm_medium') || 'referral') +
        '&utm_campaign=' + encodeURIComponent(campaign);
      var apple = document.getElementById('driveAppleBtn');
      var play = document.getElementById('drivePlayBtn');
      if (apple) apple.href = 'https://seatsherpa.onelink.me/cGHs?pid=web&c=drive&ct=' + encodeURIComponent(campaign);
      if (play) play.href = 'https://seatsherpa.onelink.me/cGHs?pid=web&c=drive&referrer=' + encodeURIComponent(ref);
    })();
  </script>

  <!-- Store-tap conversion. This page had store buttons but no tap listener at
       all, so a driver who skipped the waitlist form and went straight to the
       app registered as a bounce. Lead (the form) and store_tap are different
       intents and both worth counting. -->
  <script>
    (function () {
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        if (!/apps\.apple\.com|play\.google\.com/.test(a.href)) return;
        try { if (window.rdt) window.rdt('track', 'ViewContent'); } catch (_) {}
        try { if (window.fbq) window.fbq('track', 'ViewContent'); } catch (_) {}
        try {
          if (window.gtag) window.gtag('event', 'conversion', { send_to: 'AW-18365966554' });
        } catch (_) {}
        try {
          var q = new URLSearchParams(location.search);
          var c = (q.get('c') || q.get('utm_campaign') || q.get('src') || '').slice(0, 40);
          if (c) {
            // keepalive: the click navigates away and would cancel a plain fetch.
            fetch('https://vmfmbntacifqoqxqxgsk.supabase.co/functions/v1/log-qr-scan?e=store_tap&c=' +
              encodeURIComponent(c), { redirect: 'manual', keepalive: true }).catch(function () {});
          }
        } catch (_) {}
      }, true);
    })();
  </script>

  <!-- Hero post-widget: Mapbox Searchbox autocomplete + savings calc +
       hand-off to /post via localStorage ss-post-prefill-v1 (post.html boot
       validates again and opens on the route chooser). Public pk token —
       the same one post.html ships inline. -->
  <script>
  (function () {
    var TOKEN = 'pk.eyJ1IjoiamR0MjYyIiwiYSI6ImNtcDhnb3pvNzBkbGYyenBpN2psY3g2bGsifQ.sqsxq8sjfLaq978oqGExHg';
    var $ = function (id) { return document.getElementById(id); };
    if (!$('pcFrom')) return;
    var picks = { from: null, to: null };
    function uuid() { try { return crypto.randomUUID(); } catch (_) { return String(Date.now()) + '-' + Math.random().toString(16).slice(2); } }
    function stripCountry(s) { return String(s || '').replace(/,\s*United States$/, ''); }
    function hav(a, b) {
      var R = 3958.8, toR = Math.PI / 180;
      var dLat = (b.lat - a.lat) * toR, dLng = (b.lng - a.lng) * toR;
      var s = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(a.lat * toR) * Math.cos(b.lat * toR) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
      return 2 * R * Math.asin(Math.sqrt(s));
    }
    var inCANV = function (c) { return c.lat >= 32.0 && c.lat <= 42.0 && c.lng >= -124.5 && c.lng <= -114.0; };
    function updateSave() {
      var line = $('pcSaveLine');
      if (picks.from && picks.to) {
        // Same math as /post's savings hook: 4 open seats (standard car;
        // Justin 2026-08-30) × cost-share cap (hav ×1.25 mi × $0.76/4,
        // $10 floor, $55 ceiling) minus the 5% fee.
        var miles = hav(picks.from.coords, picks.to.coords) * 1.25;
        if (isFinite(miles) && miles > 0) {
          var perSeat = Math.min(55, Math.max(10, (miles * 0.76) / 4));
          // Never advertise more than the trip's actual shareable cost —
          // the $10 floor × seats overstates short trips (Fable E2).
          var net = Math.round(Math.min(4 * perSeat, miles * 0.76) * 0.95);
          $('pcSaveAmt').textContent = '$' + net;
          line.classList.remove('hidden');
          $('hSaveAmt').textContent = '$' + net;
          $('hSaveWord').textContent = 'on this trip';
          return;
        }
      }
      line.classList.add('hidden');
      $('hSaveAmt').textContent = '$209';
      $('hSaveWord').textContent = "on routes you're already driving";
    }
    function wire(inputId, listId, key) {
      var input = $(inputId), list = $(listId);
      var session = uuid(), timer = null, pickSeq = 0;
      function render(items) {
        list.innerHTML = '';
        if (!items.length) { list.classList.add('hidden'); return; }
        items.forEach(function (it) {
          var b = document.createElement('button');
          b.type = 'button';
          var p = document.createElement('span'); p.className = 'p'; p.textContent = it.primary;
          var s = document.createElement('span'); s.className = 's'; s.textContent = it.secondary;
          b.appendChild(p); b.appendChild(s);
          b.addEventListener('click', function () {
            var seq = ++pickSeq;
            list.classList.add('hidden');
            input.value = it.full;
            fetch('https://api.mapbox.com/search/searchbox/v1/retrieve/' + encodeURIComponent(it.id) + '?access_token=' + TOKEN + '&session_token=' + session)
              .then(function (r) { return r.ok ? r.json() : null; })
              .then(function (j) {
                var f = j && j.features && j.features[0];
                session = uuid();
                if (seq !== pickSeq) return; // a newer pick superseded this one
                if (!f) return;
                picks[key] = { addr: it.full, coords: { lat: f.geometry.coordinates[1], lng: f.geometry.coordinates[0] } };
                updateSave();
              }).catch(function () {});
          });
          list.appendChild(b);
        });
        list.classList.remove('hidden');
      }
      input.addEventListener('input', function () {
        picks[key] = null; updateSave();
        var q = input.value.trim();
        clearTimeout(timer);
        if (q.length < 3) { list.classList.add('hidden'); return; }
        timer = setTimeout(function () {
          fetch('https://api.mapbox.com/search/searchbox/v1/suggest?q=' + encodeURIComponent(q)
            + '&access_token=' + TOKEN + '&session_token=' + session
            + '&country=us&bbox=-124.5,32.0,-114.0,42.0&limit=6&types=poi,address,place,locality,neighborhood')
            .then(function (r) { return r.ok ? r.json() : { suggestions: [] }; })
            .then(function (j) {
              if (input.value.trim() !== q) return; // out-of-order response guard
              render((j.suggestions || []).map(function (s) {
                return { id: s.mapbox_id, primary: s.name, secondary: stripCountry(s.place_formatted || ''), full: stripCountry(s.full_address || (s.name + (s.place_formatted ? ', ' + s.place_formatted : ''))) };
              }));
            }).catch(function () {});
        }, 250);
      });
      document.addEventListener('click', function (e) {
        if (!list.contains(e.target) && e.target !== input) list.classList.add('hidden');
      });
    }
    wire('pcFrom', 'pcFromList', 'from');
    wire('pcTo', 'pcToList', 'to');
    function err(m) { var e = $('pcErr'); e.textContent = m; e.classList.remove('hidden'); }
    $('pcGo').addEventListener('click', function (ev) {
      // The CTA is a real <a href="/post"> so it still works if this script
      // fails to load; JS takes over to validate + carry the picks across.
      if (ev && ev.preventDefault) ev.preventDefault();
      $('pcErr').classList.add('hidden');
      if (!picks.from) { err('Pick your starting point from the suggestions.'); return; }
      if (!picks.to) { err('Pick your destination from the suggestions.'); return; }
      if (!inCANV(picks.from.coords) || !inCANV(picks.to.coords)) { err('Seat Sherpa has only launched in California and Nevada so far — pick addresses inside CA/NV.'); return; }
      if (hav(picks.from.coords, picks.to.coords) * 1.25 < 15) { err('Seat Sherpa is for longer trips — 15 miles or more.'); return; }
      try {
        localStorage.setItem('ss-post-prefill-v1', JSON.stringify({
          fromAddress: picks.from.addr, toAddress: picks.to.addr,
          start: picks.from.coords, end: picks.to.coords, ts: Date.now(),
        }));
      } catch (_) {}
      location.href = '/post';
    });
  })();
  </script>

