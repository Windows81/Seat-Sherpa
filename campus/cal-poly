<!-- Campus campaign beacon — this page IS a campaign, so every landing logs
     (default campus-calpoly); ?c= overrides for sub-placements (?c=cal-poly-flyer).
     Store taps log a second-stage event with the same code. -->
<script>
(function(){
  var qs=new URLSearchParams(location.search);
  var campaign=(qs.get('c')||qs.get('utm_campaign')||qs.get('src')||'campus-calpoly').slice(0,40);
  try{
    fetch('https://vmfmbntacifqoqxqxgsk.supabase.co/functions/v1/log-qr-scan?c='+encodeURIComponent(campaign),{redirect:'manual',keepalive:true}).catch(function(){});
  }catch(e){}
  var sent=false;
  document.addEventListener('click',function(e){
    var t=e.target; if(!t||!t.closest) return;
    var a=t.closest('a[href*="apps.apple.com"],a[href*="play.google.com"],a[href*="onelink.me"]');
    if(!a||sent) return; sent=true;
    try{
      fetch('https://vmfmbntacifqoqxqxgsk.supabase.co/functions/v1/log-qr-scan?e=store_tap&c='+encodeURIComponent(campaign),{redirect:'manual',keepalive:true}).catch(function(){});
    }catch(_){}
  },true);
})();
</script>
