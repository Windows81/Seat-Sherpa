  h1,h2,h3{font-family:Outfit,Inter,system-ui,sans-serif;font-weight:600;letter-spacing:-.01em;text-wrap:balance;margin:0}
  h1{font-size:2.35rem;line-height:1.1}
  h3{font-size:1.02rem;margin-bottom:4px}
  p{margin:0 0 12px;max-width:66ch}
  a{color:var(--teal-ink);text-decoration:none;border-bottom:1px solid color-mix(in srgb,var(--teal-ink) 40%,transparent)}
  .eyebrow{display:inline-block;font:600 .74rem/1 Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--teal-ink);margin-bottom:10px}
  header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:20px;border-bottom:1px solid var(--line);margin-bottom:28px}
  .wordmark{width:168px;height:40px;background:var(--wordmark) left center/contain no-repeat}
  .meta{font-size:.82rem;color:var(--muted);text-align:right;line-height:1.35}
