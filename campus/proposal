  .fine{font-size:.86rem;color:var(--muted)}
  footer{margin-top:40px;padding-top:18px;border-top:1px solid var(--line);font-size:.88rem;color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
  @media (max-width:560px){.price{grid-template-columns:1fr}h1{font-size:1.9rem}}
  @media print{.picker{display:none}body{background:#fff}.page{padding:0}}
  select:focus-visible,a:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
  @media (prefers-reduced-motion: reduce){*{transition:none!important}}
</style>

<div class="page">
  <header>
    <div class="wordmark" role="img" aria-label="Seat Sherpa"></div>
    <div class="meta">Campus proposal<br>2026–27 academic year</div>
  </header>

  <div class="picker">
    <label for="campus">Campus</label>
    <select id="campus"></select>
    <small>Pick the school before sharing or printing. Names and routes on this page update to match.</small>
  </div>

  <span class="eyebrow">Seat Sherpa Campus</span>
  <h1>A verified ride board for <span data-campus="name">the campus</span> students, run for the school</h1>
  <p class="lede"><span data-campus="short">Students</span> students go home to <span data-campus="homes">the Bay Area and Los Angeles</span> every break, and most of them do it alone in a car or on a peak-price flight or bus. Seat Sherpa Campus gives <span data-campus="dept">Transportation Services</span> a branded, student-verified carpool board with safety, payments, and reporting already built, for one flat annual fee.</p>

  <section>
    <span class="eyebrow">Why now</span>
    <p>Zimride, the paid campus ride board most UC and CSU campuses ran for a decade, was shut down by Enterprise at the end of 2020. What replaced it is a regional commute-matching tool built for the daily drive to campus, and a Facebook group for everything else. The trip students take most, home for the weekend or the break, has no verified place to happen.</p>
  </section>

  <section>
    <span class="eyebrow">What the school gets</span>
    <div class="grid">
      <div class="card"><h3>A campus page</h3><p><span data-campus="sub">campus</span>.seatsherpa.app with preset routes, the live ride list, and the ride request board where students post the trip they need and drivers get pinged.</p></div>
      <div class="card"><h3>Student verification</h3><p>Students who confirm a <span data-campus="domain">campus .edu</span> email get a “<span data-campus="short">Campus</span> verified” badge and a students-only filter, so a rider can choose to travel only with classmates.</p></div>
      <div class="card"><h3>Safety that already exists</h3><p>Drivers must have a current driver’s license on file before they can post. Every account is phone-verified. Payment happens in the app, never cash or Venmo. In-app chat, first-name-only display, and two-way ratings.</p></div>
      <div class="card"><h3>Quarterly usage report</h3><p>Rides posted, seats filled, trips by corridor, and CO₂ avoided, delivered to the department each quarter. Aggregates only, no student identities.</p></div>
      <div class="card"><h3>Orientation-ready materials</h3><p>A student email you can forward, a flyer, QR posters for the transportation office and residence halls, and a tabling visit within the first month.</p></div>
      <div class="card"><h3>No per-student cost</h3><p>Free for students. Drivers set a price capped by Seat Sherpa’s cost-share formula (IRS mileage rate divided by seats), so it is gas-splitting, never a business.</p></div>
    </div>
  </section>

  <section>
    <span class="eyebrow">Routes preset for <span data-campus="short">the campus</span></span>
    <p>Each campus page opens on the corridors its students actually drive. These already have live route pages on seatsherpa.app.</p>
    <div class="routes" data-campus="routes"></div>
  </section>

  <section>
    <span class="eyebrow">Compared with what students use today</span>
    <div class="tablewrap"><table>
      <thead><tr><th></th><th>Regional commute match (511, Cruz511, NorCal GO)</th><th>Facebook / GroupMe ride group</th><th>Seat Sherpa Campus</th></tr></thead>
      <tbody>
        <tr><td>Built for</td><td>The daily drive to campus</td><td>Whatever gets posted</td><td>Intercity trips: weekends, breaks, holidays</td></tr>
        <tr><td>Who can post</td><td>The general public in the region</td><td>Anyone admitted to the group</td><td>Phone-verified accounts; drivers with a current license on file; campus-verified badge</td></tr>
        <tr><td>Payment</td><td>Not handled</td><td>Cash or Venmo, arranged in DMs</td><td>In the app; the rider is charged and the driver is paid after the trip</td></tr>
        <tr><td>Pricing</td><td>Not handled</td><td>Whatever the driver asks</td><td>Driver sets it under a mileage-based cost-share cap</td></tr>
        <tr><td>If plans change</td><td>Not handled</td><td>Ghosting</td><td>Cancellation and refund rules, ratings both ways</td></tr>
        <tr><td>What the school sees</td><td>Regional totals at best</td><td>Nothing</td><td>Quarterly campus report</td></tr>
      </tbody>
    </table></div>
  </section>

  <section>
    <span class="eyebrow">Pricing</span>
    <div class="price">
      <div class="card hi"><h3>Founding campus</h3><div class="amount">$2,500 <small>/ academic year</small></div><p>First three campuses to sign for 2026–27. Everything above, plus a say in what the campus page becomes.</p></div>
      <div class="card"><h3>Standard</h3><div class="amount">$3,500 <small>/ academic year</small></div><p>Same product. Renews yearly; cancel at year end with no penalty.</p></div>
    </div>
    <p class="fine" style="margin-top:12px">Flat fee, invoiced once. No per-student or per-ride charges to the school. Under the $10,000 UC low-value purchase limit, so a department can buy directly without quotes; CSU policy requires no competition below $100,000. For scale, Zimride charged campuses about $10,000 a year.</p>
  </section>

  <section>
    <span class="eyebrow">Timeline</span>
    <div class="steps">
      <div class="step"><b>Sign</b><span>One-page agreement, invoice on signature.</span></div>
      <div class="step"><b>Live in 10 business days</b><span>Campus page, routes, and verification switched on.</span></div>
      <div class="step"><b>Launch email + tabling</b><span>You forward our email; we table within 30 days.</span></div>
      <div class="step"><b>First report</b><span>End of the first quarter, then every quarter.</span></div>
    </div>
  </section>

  <section>
    <span class="eyebrow">What we ask of <span data-campus="dept">the department</span></span>
    <ul class="clean">
      <li>List Seat Sherpa Campus on the commute and rideshare page.</li>
      <li>Forward one launch email to students (we write it) before Thanksgiving break.</li>
      <li>Let us table twice a year, ideally the week before Thanksgiving and spring break.</li>
      <li>A point of contact for the quarterly report.</li>
    </ul>
  </section>

  <section>
    <span class="eyebrow">About Seat Sherpa</span>
    <p>Seat Sherpa is a California carpool marketplace for intercity trips, live on iOS, Android, and the web. Drivers post the empty seats on a drive they are already making; riders book a seat and split the gas. It exists because the founder missed a Tahoe trip for want of a seat, and because the train between the Bay Area and Los Angeles still does not.</p>
    <p class="fine">Justin Tang, founder · justin@seatsherpa.app · seatsherpa.app</p>
  </section>

  <footer><span>Seat Sherpa Campus · proposal</span><span>Valid through December 31, 2026</span></footer>
</div>

<script>
(function(){
  var CAMPUSES = {
    ucsb:    {name:"UC Santa Barbara", short:"UCSB", dept:"Transportation & Parking Services", homes:"the Bay Area and Los Angeles", sub:"ucsb", domain:"@ucsb.edu", routes:["Santa Barbara → San Francisco","Santa Barbara → Los Angeles","San Francisco → Santa Barbara","Los Angeles → Santa Barbara"]},
    calpoly: {name:"Cal Poly San Luis Obispo", short:"Cal Poly", dept:"Transportation & Parking Services", homes:"the Bay Area and Los Angeles", sub:"calpoly", domain:"@calpoly.edu", routes:["San Luis Obispo → San Francisco","San Luis Obispo → Los Angeles","San Francisco → San Luis Obispo","Los Angeles → San Luis Obispo"]},
    ucdavis: {name:"UC Davis", short:"UC Davis", dept:"Transportation Services", homes:"the Bay Area and Los Angeles", sub:"ucdavis", domain:"@ucdavis.edu", routes:["Sacramento → San Francisco","San Francisco → Sacramento","Sacramento → Los Angeles","Sacramento → Lake Tahoe"]},
    ucsc:    {name:"UC Santa Cruz", short:"UCSC", dept:"Transportation and Parking Services", homes:"Los Angeles and the East Bay", sub:"ucsc", domain:"@ucsc.edu", routes:["Santa Cruz → Los Angeles","Los Angeles → Santa Cruz","Santa Cruz → San Francisco"]},
    ucmerced:{name:"UC Merced", short:"UC Merced", dept:"Transportation and Parking Services", homes:"the Bay Area and Los Angeles", sub:"ucmerced", domain:"@ucmerced.edu", routes:["Fresno → San Francisco","Fresno → Los Angeles","San Francisco → Fresno","Los Angeles → Fresno"]},
    chico:   {name:"Chico State", short:"Chico State", dept:"Parking Services", homes:"the Bay Area and Sacramento", sub:"chico", domain:"@csuchico.edu", routes:["Chico → San Francisco","Chico → Sacramento","San Francisco → Chico"]},
    ucla:    {name:"UCLA", short:"UCLA", dept:"UCLA Transportation", homes:"the Bay Area", sub:"ucla", domain:"@ucla.edu", routes:["Los Angeles → San Francisco","San Francisco → Los Angeles","Los Angeles → Las Vegas","Los Angeles → San Diego"]},
    usc:     {name:"USC", short:"USC", dept:"USC Transportation", homes:"the Bay Area", sub:"usc", domain:"@usc.edu", routes:["Los Angeles → San Francisco","San Francisco → Los Angeles","Los Angeles → Las Vegas","Los Angeles → San Diego"]},
    stanford:{name:"Stanford", short:"Stanford", dept:"Stanford Transportation", homes:"Los Angeles", sub:"stanford", domain:"@stanford.edu", routes:["San Francisco → Los Angeles","Los Angeles → San Francisco","San Francisco → Lake Tahoe"]}
  };
  var sel = document.getElementById('campus');
  Object.keys(CAMPUSES).forEach(function(k){ var o=document.createElement('option'); o.value=k; o.textContent=CAMPUSES[k].name; sel.appendChild(o); });
  function apply(k){
    var c = CAMPUSES[k]; if(!c) return;
    document.querySelectorAll('[data-campus]').forEach(function(el){
      var f = el.getAttribute('data-campus');
      if (f === 'routes'){ el.innerHTML=''; c.routes.forEach(function(r){ var s=document.createElement('span'); s.className='chip'; s.textContent=r; el.appendChild(s); }); }
      else if (c[f] != null) el.textContent = c[f];
    });
    try { localStorage.setItem('ss-campus', k); } catch(e){}
  }
  var start = 'calpoly';
  try { start = localStorage.getItem('ss-campus') || start; } catch(e){}
  try { var q = new URLSearchParams(location.search).get('campus'); if (q && CAMPUSES[q]) start = q; } catch(e){}
  if (!CAMPUSES[start]) start = 'ucsb';
  sel.value = start; apply(start);
  sel.addEventListener('change', function(){ apply(sel.value); });
})();
</script>

