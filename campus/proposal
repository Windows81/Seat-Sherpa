<style>
  :root{
    --bg:#F7F8FA; --surface:#FFFFFF; --ink:#1F2937; --muted:#5B6270; --line:#E3E6EB;
    --teal:#00D4C8; --teal-ink:#0F9C93; --teal-soft:#E4FAF8;
    --wordmark:url("data:image/png;base64,");
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#0E0E10; --surface:#18181C; --ink:#F5F5F7; --muted:#A3A3B8; --line:#2A2A31;
      --teal:#24E4D8; --teal-ink:#24E4D8; --teal-soft:#0F2A29;
      --wordmark:url("data:image/png;base64,");
    }
  }
  :root[data-theme="dark"]{
    --bg:#0E0E10; --surface:#18181C; --ink:#F5F5F7; --muted:#A3A3B8; --line:#2A2A31;
    --teal:#24E4D8; --teal-ink:#24E4D8; --teal-soft:#0F2A29;
    --wordmark:url("data:image/png;base64,");
  }
  html{color-scheme:light dark}
  body{background:var(--bg);color:var(--ink);font:16px/1.55 Inter,system-ui,-apple-system,"Segoe UI",sans-serif;margin:0;-webkit-font-smoothing:antialiased}
