<script src="/js/ss-appbar.js"></script>
<script>
// /rides is BOTH a public marketing page and the signed-in marketplace.
// Signed in, the shared app bar carries the console tabs, so browsing rides
// sits in the same chrome as Trips/Driving/Messages (Justin, 2026-08-28).
// 2026-10-12: signed-out visitors get the shared bar too, so /rides, the ride
// page and the booking page carry ONE header (it used to switch from logo +
// "Sign in" here to logo + tabs + "+" one tap later). The marketing <nav>
// stays in the markup as the no-JS fallback.
try {
  if (window.SS_APPBAR) {
    SS_APPBAR.mount({
      active: 'rides',
      // Replaces the marketing <nav> outright.
      mountTo: document.querySelector('nav'),
      // Align to the CONTENT column, not the nav's own .wrap — that one is
      // being replaced and would measure wrong.
      alignTo: document.querySelector('body > .wrap'),
    });
  }
} catch (_) { /* the marketing nav is a fine fallback */ }
</script>
