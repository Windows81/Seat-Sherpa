  // and fires 'change', so the filtering and URL logic is untouched.
  (function(){
    var GROUPS=[['Bay Area',['sfba','sanjose','napasonoma']],['Sacramento and the Sierra',['sacramento','tahoereno']],['Central Coast',['santacruz','slo','santabarbara']],['Central Valley',['fresno']],['Southern California',['la','oc','sd','palm']],['Nevada',['vegas']]];
    var picker=document.getElementById('cityPicker'), fromBtn=document.getElementById('fromBtn'), toBtn=document.getElementById('toBtn');
    var openFor=null;
    function labelFor(sel){return sel.value&&M[sel.value]?M[sel.value].n:'Anywhere';}
    function paintFields(){
      document.getElementById('fromV').textContent=labelFor(fromS);
      document.getElementById('toV').textContent=labelFor(toS);
      fromBtn.classList.toggle('set',!!fromS.value); toBtn.classList.toggle('set',!!toS.value);
    }
    function closePicker(){picker.classList.add('hidden');picker.innerHTML='';fromBtn.classList.remove('open');toBtn.classList.remove('open');openFor=null;}
    function pick(sel,val){sel.value=val;sel.dispatchEvent(new Event('change',{bubbles:true}));paintFields();closePicker();}
    function renderPicker(sel,q){
      picker.innerHTML='';
      var s=document.createElement('input');s.type='search';s.placeholder='Search a city';s.value=q||'';s.setAttribute('autocomplete','off');
      s.addEventListener('input',function(){var v=s.value;renderPicker(sel,v);var n=picker.querySelector('input');if(n){n.focus();try{n.setSelectionRange(n.value.length,n.value.length);}catch(_){}}});
      picker.appendChild(s);
      var any=document.createElement('button');any.type='button';any.className='opt'+(sel.value?'':' on');any.textContent='Anywhere';any.addEventListener('click',function(){pick(sel,'');});
      picker.appendChild(any);
      var ql=(q||'').trim().toLowerCase();
      GROUPS.forEach(function(g){
        var ks=g[1].filter(function(k){return !ql||M[k].n.toLowerCase().indexOf(ql)>=0||g[0].toLowerCase().indexOf(ql)>=0;});
        if(!ks.length)return;
        var h=document.createElement('div');h.className='grp';h.textContent=g[0];picker.appendChild(h);
        ks.forEach(function(k){var b=document.createElement('button');b.type='button';b.className='opt'+(sel.value===k?' on':'');b.textContent=M[k].n;b.setAttribute('role','option');b.addEventListener('click',function(){pick(sel,k);});picker.appendChild(b);});
      });
      if(!ql)return; else if(picker.querySelectorAll('.opt').length<=1){var n=document.createElement('div');n.className='grp';n.textContent='No city matches that';picker.appendChild(n);}
    }
    function openPicker(which){
      var sel=which==='from'?fromS:toS, btn=which==='from'?fromBtn:toBtn;
      if(openFor===which){closePicker();return;}
      closePicker();openFor=which;btn.classList.add('open');
      picker.classList.toggle('right',which==='to');
      picker.classList.remove('hidden');
      renderPicker(sel,'');
      var s=picker.querySelector('input');if(s&&window.matchMedia('(pointer: fine)').matches)s.focus();
    }
    fromBtn.addEventListener('click',function(){openPicker('from');});
    toBtn.addEventListener('click',function(){openPicker('to');});
    document.addEventListener('click',function(e){if(openFor&&!picker.contains(e.target)&&e.target!==fromBtn&&e.target!==toBtn&&!fromBtn.contains(e.target)&&!toBtn.contains(e.target))closePicker();});
    document.addEventListener('keydown',function(e){if(e.key==='Escape')closePicker();});
    document.getElementById('swap').addEventListener('click',function(){setTimeout(paintFields,0);});
    fromS.addEventListener('change',paintFields);toS.addEventListener('change',paintFields);
    paintFields();

    // Date chips: Any date, Today, Tomorrow, the next three days, Pick a date.
    // Flexible (±3 days) and Open seats are chips too; flexible only shows
    // once a date is chosen, since it means nothing without one.
    var dateF=document.getElementById('dateF'), flexF=document.getElementById('flexF'), availF=document.getElementById('availF'), host=document.getElementById('dateChips');
    function ymd(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
    function addDays(d,n){var x=new Date(d);x.setDate(x.getDate()+n);return x;}
    function shortDay(v){var p=v.split('-').map(Number);return new Date(p[0],p[1]-1,p[2]).toLocaleDateString('en-US',{weekday:'short',month:'numeric',day:'numeric'});}
    function chip(label,on,fn,extra){var b=document.createElement('button');b.type='button';b.className='chip'+(on?' on':'')+(extra?' '+extra:'');b.textContent=label;b.setAttribute('aria-pressed',on?'true':'false');b.addEventListener('click',fn);return b;}
    function setDate(v){dateF.value=v;dateF.dispatchEvent(new Event('change',{bubbles:true}));renderChips();}
    function renderChips(){
      host.innerHTML='';
      // "Today" is Pacific, like every date on the site, not the viewer's zone.
      var pt=new Date().toLocaleDateString('en-CA',{timeZone:'America/Los_Angeles'}).split('-').map(Number);
      var today=new Date(pt[0],pt[1]-1,pt[2]);
      var dv=dateF.value||'';
      var items=[['Any date',''],['Today',ymd(today)],['Tomorrow',ymd(addDays(today,1))]];
      for(var i=2;i<=4;i++){var d=addDays(today,i);items.push([shortDay(ymd(d)),ymd(d)]);}
      var listed=items.some(function(it){return it[1]===dv;});
      if(dv&&!listed)items.push([shortDay(dv),dv]);
      items.forEach(function(it){host.appendChild(chip(it[0],dv===it[1],function(){setDate(it[1]);}));});
      host.appendChild(chip('Pick a date',false,function(){
        try{ if(dateF.showPicker){dateF.showPicker();return;} }catch(_){}
        dateF.style.cssText='position:absolute;opacity:0;width:1px;height:1px;';dateF.focus();dateF.click();
      }));
      var sep=document.createElement('span');sep.className='chip sep';host.appendChild(sep);
      if(dv)host.appendChild(chip('Flexible, 3 days either way',flexF.checked,function(){flexF.checked=!flexF.checked;flexF.dispatchEvent(new Event('change',{bubbles:true}));renderChips();}));
      host.appendChild(chip('Open seats',availF.checked,function(){availF.checked=!availF.checked;availF.dispatchEvent(new Event('change',{bubbles:true}));renderChips();}));
      // Laptop twin of the "Near an address" link (CSS shows one or the
      // other). On while the address row is open or an address is applied.
      var addrOn=!document.getElementById('addrRow').classList.contains('hidden')||!!addrCoords;
      host.appendChild(chip('Near an address',addrOn,function(){document.getElementById('addrToggle').click();renderChips();},'addrchip'));
    }
    dateF.addEventListener('change',renderChips);
    renderChips();

    // Address search stays, one link away: it is a power filter, not the
    // first thing every visitor should meet.
    var addrRow=document.getElementById('addrRow'), addrToggle=document.getElementById('addrToggle');
    addrToggle.addEventListener('click',function(){
      var open=addrRow.classList.toggle('hidden');
      addrToggle.textContent=open?'Near an address':'Hide address search';
      if(!open){var inp=document.getElementById('addrF');if(inp)inp.focus();}
    });
  })();
  // ── Address autocomplete (Mapbox forward geocode, CA/NV bbox) ──────────
  (function(){
    var MB='pk.eyJ1IjoiamR0MjYyIiwiYSI6ImNtcDhnb3pvNzBkbGYyenBpN2psY3g2bGsifQ.sqsxq8sjfLaq978oqGExHg';
    var inp=document.getElementById('addrF'),sg=document.getElementById('addrSugg'),clr=document.getElementById('addrClear');
    var t=null;
    function hide(){sg.classList.add('hidden');sg.innerHTML='';}
    inp.addEventListener('input',function(){
      addrCoords=null;clr.classList.toggle('hidden',!inp.value);
      clearTimeout(t);
      var q=inp.value.trim();
      if(q.length<3){hide();renderRides();return;}
      t=setTimeout(function(){
        fetch('https://api.mapbox.com/geocoding/v5/mapbox.places/'+encodeURIComponent(q)+'.json?limit=5&bbox=-124.5,32,-114,42&access_token='+MB)
          .then(function(r){return r.json();})
          .then(function(j){
            if(inp.value.trim()!==q)return; // stale response — input changed or was cleared
            sg.innerHTML='';
            var fs=(j&&j.features)||[];
            if(!fs.length){hide();return;}
            fs.forEach(function(f){
              var b=document.createElement('button');
              b.type='button';
              b.textContent=f.place_name;
              b.style.cssText='display:block;width:100%;text-align:left;background:none;border:0;color:var(--text2);font-family:inherit;font-size:14px;padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--line)';
              b.addEventListener('click',function(){
                inp.value=f.place_name;
                addrCoords={lat:f.center[1],lng:f.center[0]};
                clr.classList.remove('hidden');
                hide();renderRides();
              });
              sg.appendChild(b);
            });
            sg.classList.remove('hidden');
          }).catch(hide);
      },300);
    });
    clr.addEventListener('click',function(){inp.value='';addrCoords=null;clr.classList.add('hidden');hide();renderRides();});
    document.addEventListener('click',function(e){if(!sg.contains(e.target)&&e.target!==inp)hide();});
  })();
  // Signed-in searches log client-side (search_log RLS is authenticated-only
  // — anon inserts were silently dropped for weeks; public-rides now logs
  // anonymous searches server-side with source=web, 0227). Route alerts
  // email these searchers when a driver posts; drivers see the demand tiles.
  var SRC_WEB_OK=true; // 0228 ran 9/1: search_log source CHECK admits 'web'
  function logSearch(resultsCount){
    try{
      var tok=null;
      try{var raw=localStorage.getItem('sb-vmfmbntacifqoqxqxgsk-auth-token');if(raw)tok=(JSON.parse(raw)||{}).access_token||null;}catch(_){}
      var uid=null;
      if(tok){try{uid=JSON.parse(atob(tok.split('.')[1])).sub||null;}catch(_){}}
      if(!tok||!uid)return; // anon searches are logged server-side by public-rides
      // 0220 stamp: /rides never loaded ss-session.js — signed-in searchers
      // here looked "Unknown surface" in admin. Once per page load.
      if(!window.__wseen){window.__wseen=1;fetch(SUPA+'/rest/v1/profiles?id=eq.'+uid,{method:'PATCH',headers:{apikey:ANON,Authorization:'Bearer '+tok,'Content-Type':'application/json',Prefer:'return=minimal'},body:JSON.stringify({web_seen_at:new Date().toISOString()})}).catch(function(){});}
      // (ToS acceptance is logged only on pages that show the notice — audit 2026-09-02.)
      fetch(SUPA+'/rest/v1/search_log',{method:'POST',headers:{apikey:ANON,Authorization:'Bearer '+(tok||ANON),'Content-Type':'application/json',Prefer:'return=minimal'},body:JSON.stringify({user_id:uid,from_dest:fromS.value,to_dest:toS.value,search_date:document.getElementById('dateF').value||null,results_count:resultsCount,source:SRC_WEB_OK?'web':undefined})}).catch(function(){});
    }catch(_){}
  }
  function load(){
    list.innerHTML='<div class="loading">Loading rides…</div>'; countEl.textContent='';
    var u=SUPA+'/functions/v1/public-rides?from='+encodeURIComponent(fromS.value)+'&to='+encodeURIComponent(toS.value);
    // 0227 attribution: date filter + landing referrer + campaign tag ride
    // along so the server can log what anonymous visitors wanted and how
    // they found us.
    try{
      var dF=document.getElementById('dateF');
      if(dF&&dF.value)u+='&date='+encodeURIComponent(dF.value);
      // 0258: colour preference + screen class, so the light-theme question
      // is answered by data (browsers report light when no preference is set).
      try{
        var dark=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;
        u+='&cs='+(dark?'dark':'light')+'&scr='+(window.innerWidth<=768?'phone':'desktop');
      }catch(_){}
      var qp=new URLSearchParams(location.search);
      var camp=qp.get('c')||qp.get('utm_source')||'';
      if(camp)u+='&c='+encodeURIComponent(camp.slice(0,80));
      if(document.referrer)u+='&ref='+encodeURIComponent(document.referrer.slice(0,300));
    }catch(_){}
    var utok=null;try{var raw0=localStorage.getItem('sb-vmfmbntacifqoqxqxgsk-auth-token');if(raw0)utok=(JSON.parse(raw0)||{}).access_token||null;}catch(_){}
    fetch(u,{headers:{apikey:ANON,Authorization:'Bearer '+(utok||ANON)}}).then(function(r){return r.json();}).then(function(d){
      var rides=(d&&d.rides)||[];
      allRides=rides;
      logSearch(rides.filter(function(r){return !r.adjacent;}).length); // exact matches only - nearby top-ups are not met demand
      renderRides();
      loadPreferred(rides);
    }).catch(function(){ list.innerHTML='<div class="empty">Could not load rides right now. Refresh to try again.</div>'; });
  }
  // Preferred medal (Justin, 2026-09-14: "lets have it on web too"): drivers
  // this signed-in rider has rated 5 stars get the app's small teal medal on
  // their photo. public-rides is publicly cached and carries no driver ids, so
  // this is a separate private call: the ride ids on screen go in, the ids
  // whose driver you rated 5 stars come back. Automatic ratings never count.
  // Signed out or an expired token: no medals, nothing else changes.
  var preferredRideIds={};
  function loadPreferred(rides){
    try{
      var tok=null;
      try{var raw=localStorage.getItem('sb-vmfmbntacifqoqxqxgsk-auth-token');if(raw)tok=(JSON.parse(raw)||{}).access_token||null;}catch(_){}
      if(!tok||!rides.length)return;
      var ids=rides.map(function(r){return Number(r.id);}).filter(function(n){return isFinite(n)&&n>0;}).slice(0,200);
      fetch(SUPA+'/functions/v1/web-preferred-rides',{method:'POST',headers:{apikey:ANON,Authorization:'Bearer '+tok,'Content-Type':'application/json'},body:JSON.stringify({rideIds:ids})})
        .then(function(r){return r.ok?r.json():null;})
        .then(function(d){
          var got=(d&&d.rideIds)||[];
          if(!got.length)return;
          got.forEach(function(id){preferredRideIds[String(id)]=true;});
          if(allRides===rides)renderRides(); // a newer search already replaced this list
        }).catch(function(){});
    }catch(_){}
  }
  // Booking-intent signal: fires when someone taps a ride to open it. Filter
  // this event by Desktop in Vercel Analytics to size web-checkout demand.
  list.addEventListener('click',function(e){ if(e.target.closest('.ride')) window.va('event',{name:'ride_click'}); });
  fromS.onchange=load; toS.onchange=load;
  document.getElementById('swap').onclick=function(){var a=fromS.value;fromS.value=toS.value;toS.value=a;load();};
  load();
})();
</script>
