<script>
(function(){
  var SUPA='https://vmfmbntacifqoqxqxgsk.supabase.co';
  var ANON='sb_publishable_TGebz9q_z0kkH0Tuivlr4w_3MPLMxF3';
  var M={
    sfba:{n:'SF Bay Area',e:'🌉'}, sanjose:{n:'San Jose',e:'💻'}, la:{n:'LA Metro',e:'🌴'}, sd:{n:'San Diego',e:'🌮'},
    sacramento:{n:'Sacramento',e:'🏛️'}, vegas:{n:'Las Vegas',e:'🎲'}, palm:{n:'Palm Springs',e:'☀️'},
    napasonoma:{n:'Napa / Sonoma',e:'🍇'}, fresno:{n:'Fresno',e:'🐄'}, santabarbara:{n:'Santa Barbara',e:'🌊'},
    slo:{n:'San Luis Obispo',e:'🌊'}, oc:{n:'Orange County',e:'🍊'}, tahoereno:{n:'Tahoe / Reno',e:'🏂'}
  };
  var order=['sfba','sanjose','la','sd','sacramento','vegas','palm','napasonoma','oc','santabarbara','slo','fresno','tahoereno'];
  var fromS=document.getElementById('from'), toS=document.getElementById('to'), list=document.getElementById('list'), countEl=document.getElementById('count');
  function opts(sel,label){var h='<option value="">'+label+'</option>';order.forEach(function(k){h+='<option value="'+k+'">'+M[k].e+' '+M[k].n+'</option>';});sel.innerHTML=h;}
  opts(fromS,'Anywhere (from)'); opts(toS,'Anywhere (to)');
  var qp=new URLSearchParams(location.search);
  // Hidden web-booking funnel: /rides?web=1 keeps the rider in the browser —
  // ride links carry web=1 so /ride shows "Book online" instead of app-only.
  var webMode=qp.get('web')==='1';
  if(qp.get('from')&&M[qp.get('from')])fromS.value=qp.get('from');
  if(qp.get('to')&&M[qp.get('to')])toS.value=qp.get('to');
  // Web mode is the BOOKABLE surface — "grab a seat in the app" was the
  // app-funnel line leaking through (benchmark fix 8/26).
  if(webMode){document.getElementById('subLine').textContent='Live carpools across California & Nevada. Book your seat right here — no app needed.';}

  function fmt(dateStr,timeStr){
    var d=new Date(dateStr+'T'+(timeStr||'12:00'));
    var day=d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});
    var t=timeStr?d.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}):'';
    return day+(t?' · '+t:'');
  }
  // "All-in" = seat + per-metro service fee + per-ride booking fee (99¢ on
  // fee-waived drivers, from public-rides). Omitting the booking fee left the
  // label 99¢ under checkout on waived rides — the SB 478 drip-pricing
  // pattern this label exists to avoid (audit M1).
  function allIn(r){var b=(typeof r.serviceFeeBps==='number')?r.serviceFeeBps:500;var bk=(typeof r.bookingFeeCents==='number'?r.bookingFeeCents:0)/100;return (r.minPrice+Math.ceil(r.minPrice*100*b/10000)/100+bk).toFixed(2);}
    function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
  function card(r){
    var f=M[r.fromDest]||{n:r.fromDest,e:''}, t=M[r.toDest]||{n:r.toDest,e:''};
    var fromLabel=r.fromArea||f.n, toLabel=r.toArea||t.n;
    var link='/ride?id='+r.id+'&from='+encodeURIComponent(fromLabel)+'&to='+encodeURIComponent(toLabel)+'&date='+encodeURIComponent(fmt(r.depDate,'').split(' · ')[0])+'&time='+encodeURIComponent(r.depTime||'')+'&price='+r.minPrice+(webMode?'&web=1':'');
    // Driver line with FACE (benchmark 8/26): avatar + name + rating with
    // review count + trip count. Riders book people; a faceless card was our
    // single biggest trust gap vs BlaBlaCar.
    var dAvatar=(r.driverPhotoUrl&&/^https:\/\//.test(r.driverPhotoUrl))
      ?'<img src="'+esc(r.driverPhotoUrl)+'" alt="" style="width:22px;height:22px;border-radius:50%;object-fit:cover;vertical-align:-5px;margin-right:5px;border:1px solid rgba(0,212,200,0.45);" loading="lazy" />'
      :'';
    var dRating=r.driverRating
      ?(' <span class="star">★</span> '+Number(r.driverRating).toFixed(1)+(r.driverRatingCount?' ('+r.driverRatingCount+')':''))
      :'';
    var dTrips=(typeof r.driverTrips==='number'&&r.driverTrips>0)?(' · '+r.driverTrips+' trip'+(r.driverTrips===1?'':'s')):'';
    var driver=r.driverFirst?('· '+dAvatar+esc(r.driverFirst)+dRating+dTrips):'';
    var stops=(r.stops&&r.stops.length)?'<div class="meta" style="color:#00D4C8;">⤷ Also picks up / drops off in '+r.stops.map(esc).join(' · ')+'</div>':'';
    return '<a class="ride" href="'+link+'">'
      +'<div class="top"><div class="route">'+f.e+' '+esc(fromLabel)+' → '+t.e+' '+esc(toLabel)+'</div>'
      +(r.soldOut
        ?'<div class="price" style="color:#8a8a92;">$'+(allIn(r))+' <small>/seat</small></div></div>'
        :'<div class="price">$'+(allIn(r))+' <small>/seat all-in</small></div></div>')
      +stops
      +'<div class="meta"><span>'+fmt(r.depDate,r.depTime)+'</span>'
      +(r.instant&&!r.soldOut?'<span class="pill inst">⚡ Instant book</span>':'')
      +(r.soldOut
        ?'<span class="pill seats" style="color:#8a8a92;">Sold out</span>'
        :'<span class="pill seats">'+r.seatsLeft+' seat'+(r.seatsLeft===1?'':'s')+' left</span>')
      +'<span>'+driver+'</span></div></a>';
  }
  function load(){
    list.innerHTML='<div class="loading">Loading rides…</div>'; countEl.textContent='';
    var u=SUPA+'/functions/v1/public-rides?from='+encodeURIComponent(fromS.value)+'&to='+encodeURIComponent(toS.value);
    fetch(u,{headers:{apikey:ANON,Authorization:'Bearer '+ANON}}).then(function(r){return r.json();}).then(function(d){
      var rides=(d&&d.rides)||[];
      if(!rides.length){
        // The zero-result state is THE conversion leak (acquisition memo:
        // in-market riders searched, found nothing, evaporated). In web mode,
        // capture the demand right here: request board for riders, /post for
        // drivers. Without the flag, keep funneling to the app.
        list.innerHTML = webMode
          ? '<div class="empty">No rides match that yet.<br><br>'
            + '<a href="/requests">Tell drivers you need this ride →</a><br>'
            + 'Drivers who’ve driven the route get notified, and you’ll get an email the moment one posts it.<br><br>'
            + 'Driving this route yourself? <a href="/post">Post the ride</a>.</div>'
          : '<div class="empty">No rides match that yet.<br><br>Be the first — <a href="/#get">post or request one in the app</a>, or try different cities.</div>';
        return;
      }
      countEl.textContent=rides.length+' upcoming ride'+(rides.length===1?'':'s');
      // Persistent supply-side CTA in web mode (benchmark 8/26): BlaBlaCar
      // puts "Offer a ride" on every results page; ours only appeared on the
      // ZERO-results state — a populated marketplace never recruited drivers.
      if(webMode){
        countEl.innerHTML=esc(countEl.textContent)
          +' &nbsp;·&nbsp; <a href="/post" style="color:#00D4C8;text-decoration:none;">Driving one of these routes? Post your ride →</a>'
          +' &nbsp;·&nbsp; <a href="/requests" style="color:#7dd3fc;text-decoration:none;">Need a ride nobody posted? Request it →</a>';
      }
      list.innerHTML=rides.map(card).join('');
    }).catch(function(){ list.innerHTML='<div class="empty">Could not load rides right now. <a href="/#get">Open the app</a> to browse.</div>'; });
  }
  // Booking-intent signal: fires when someone taps a ride to open it. Filter
  // this event by Desktop in Vercel Analytics to size web-checkout demand.
  list.addEventListener('click',function(e){ if(e.target.closest('.ride')) window.va('event',{name:'ride_click'}); });
  fromS.onchange=load; toS.onchange=load;
  document.getElementById('swap').onclick=function(){var a=fromS.value;fromS.value=toS.value;toS.value=a;load();};
  load();
})();
</script>
