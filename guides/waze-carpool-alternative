<script id="ss-toc">
/* "On this page" for laptops (2026-10-12): a card listing the article's h2s.
   The CSS only shows it at 1100px and wider, so phones never see it. Headings
   without an id get one made from their text. build-compare.mjs lifts this
   script from guides/blablacar-usa.html. */
(function(){
  var art=document.querySelector('article.wrap');if(!art||!art.firstChild)return;
  var hs=[],i,k;
  for(i=0;i<art.children.length;i++){if(art.children[i].tagName==='H2')hs.push(art.children[i]);}
  if(hs.length<3)return;
  var box=document.createElement('aside');box.className='toc';box.setAttribute('aria-label','On this page');
  var inner=document.createElement('div');inner.className='toc-in';
  var t=document.createElement('div');t.className='toc-t';t.textContent='On this page';inner.appendChild(t);
  for(i=0;i<hs.length;i++){
    var h=hs[i];
    if(!h.id){
      var base=(h.textContent||'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,60)||'section',id=base;
      for(k=2;document.getElementById(id);k++)id=base+'-'+k;
      h.id=id;
    }
    var a=document.createElement('a');a.href='#'+h.id;a.textContent=h.textContent;inner.appendChild(a);
  }
  box.appendChild(inner);art.insertBefore(box,art.firstChild);
})();
</script>
</body>
</html>
