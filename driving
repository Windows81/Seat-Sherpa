      const pc = el('div', 'card');
      pc.appendChild(el('div', 'eyebrow', 'Deposits'));
      pc.appendChild(el('div', 'meta',
        payout.credit
          ? 'Your deposits are credited to your Seat Sherpa balance — no bank account involved.'
          : payout.enabled
            ? "Connected — riders' cost share deposits to your bank via Stripe."
            : payout.started
              ? 'Stripe setup was started but not finished — finish it to accept bookings.'
              : 'Not set up yet. Takes about 2 minutes with Stripe.'));
      if (!payout.credit) {
        const bmsg = el('div', 'msg err hidden');
        if (payout.enabled) {
          const hist = el('button', 'primary', 'Deposit history & bank (Stripe)');
          hist.type = 'button'; hist.style.marginTop = '12px';
          hist.addEventListener('click', () => { void openStripeDashboard(hist); });
          pc.appendChild(hist);
        } else {
          const setup = el('button', 'primary', 'Set up deposits');
          setup.type = 'button'; setup.style.marginTop = '12px';
          setup.addEventListener('click', () => startStripeOnboarding(setup, bmsg));
