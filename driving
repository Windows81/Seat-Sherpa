          const narrow = await supabase
            .from('profiles')
            .select('name_public, stripe_account_id, stripe_charges_enabled')
            .eq('id', me)
            .maybeSingle();
          if (narrow.error) return;
          row = narrow.data;
        }
        if (!row) return;
        myName = row.name_public || myName;
        payout = {
          loaded: true,
          started: !!row.stripe_account_id,
          enabled: row.stripe_charges_enabled === true,
          credit: row.payout_method === 'credit',
        };

        // Rohan lesson (stripe-refresh-account-status header): the webhook is
        // best-effort, so an account that LOOKS half-onboarded gets reconciled
        // against Stripe itself, once per page load. Copies Stripe's truth
        // onto the profile row; never invents a `true`.
        if (payout.started && !payout.enabled && !payout.credit && !loadPayoutState._reconciled) {
          loadPayoutState._reconciled = true;
          try {
            const out = await callFn('stripe-refresh-account-status', {});
            if (out && out.ok) {
              payout.started = out.started === true;
              payout.enabled = out.chargesEnabled === true;
            }
          } catch (_) { /* reconcile is best-effort */ }
        }
      } catch (_) { /* payout banner is informational; never block the page */ }
    }

