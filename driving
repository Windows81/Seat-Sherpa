    function paxRow(b, subText) {
      const row = el('div', 'paxrow');
      const initial = el('div', 'avatar ph', (paxDisplay(b)[0] || '?').toUpperCase());
      const photo = safePhoto(b.passenger && b.passenger.photo_url);
      if (photo) {
        const img = document.createElement('img');
        img.className = 'avatar';
        img.alt = '';
        img.src = photo;
        img.addEventListener('error', () => {
          if (img.parentNode) img.parentNode.replaceChild(initial, img);
        });
        // Click to see it bigger (2026-10-04, /js/ss-photo-zoom.js).
        if (window.SSPhotoZoom) SSPhotoZoom.mark(img, paxDisplay(b));
