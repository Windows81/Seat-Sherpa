    }

    /** lib/format-name.ts abbreviateName. name_public is already "First L."
     *  server-side (0203); this is the belt-and-braces second pass and is
     *  idempotent on already-short values. */
    function abbreviateName(name) {
      if (!name) return '';
      const parts = String(name).trim().split(/\s+/).filter(Boolean);
      if (parts.length === 0) return '';
      if (parts.length === 1) return parts[0];
