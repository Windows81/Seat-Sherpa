    function noteProblem(text) {
      const t = noteNormalize(text);
      if (!t) return null;
      const hit = noteHitFor(t);
      if (hit) return NOTE_HIT_CODE[hit];
      if (t.length > NOTE_MAX) return 'NOTE_TOO_LONG';
      return null;
    }
    /** The machine code inside a code or a Postgres message, or null. */
    function noteCodeOf(codeOrMessage) {
      const m = String(codeOrMessage || '').match(/NOTE_(CONTACT|OFFPLATFORM|EXTRA|TOO_LONG)/);
      return m ? m[0] : null;
    }
    /** Refusal copy for a machine code, or a Postgres message that contains
     *  one. Empty string for anything else. */
    function noteErrorCopy(codeOrMessage) {
      const code = noteCodeOf(codeOrMessage);
      return code ? NOTE_COPY[code] : '';
    }
