         under the text, only as wide as its label. */
      .banner button.primary { display: block; width: fit-content; padding: 13px 28px; margin-top: 14px; }

      /* One-card states: a centered card with some air above it. */
      #stLoading, #stBoot, #stEmail, #stCode, #stNotFound, #stError {
        max-width: 480px; margin-left: auto; margin-right: auto; margin-top: 7vh;
      }

      /* One ride: work on the left, summary + Manage on the right. The
         wrappers are plain blocks on a phone, in the same order as before. */
      .ridelayout {
        display: grid; grid-template-columns: minmax(0, 1fr) 380px; column-gap: 28px;
        grid-template-rows: auto 1fr; grid-template-areas: "main head" "main side"; align-items: start;
      }
      .ridehead { grid-area: head; min-width: 0; }
      .ridemain { grid-area: main; min-width: 0; }
      .rideside { grid-area: side; min-width: 0; }
      .ridemain > :first-child { margin-top: 0; }
      .ridehead .route { font-size: 22px; }
      .pinwrap { max-width: 440px; }
      .pair { display: grid; grid-template-columns: 1fr 1fr; column-gap: 10px; }

      /* Chat: the conversation is the wide pane, with the note and message
         box straight under the thread. Only short, fixed-size details sit
         beside it (how messages work, ask for ID, call); the meeting spot
         button and its picker go under the message box, as on /trips, so
         opening the picker can never push the message box down. */
      .chatcard {
        display: grid; grid-template-columns: minmax(0, 1fr) 300px; column-gap: 36px;
        grid-template-areas:
          "eyebrow eyebrow" "name name" "thread sub" "thread ask" "thread call" "thread ."
          "hint ." "composer ." "msg ." "spot ." "spotpanel .";
        grid-template-rows: auto auto auto auto auto 1fr auto auto auto auto auto;
        padding: 28px;
      }
      .chatcard > .eyebrow { grid-area: eyebrow; }
      .chatcard > h1 { grid-area: name; font-size: 26px; margin-bottom: 16px; }
      .chatcard > p.sub { grid-area: sub; }
      .chatcard > .chatask { grid-area: ask; margin: -8px 0 14px; }
      .chatcard > .thread {
        grid-area: thread; height: clamp(320px, calc(100vh - 380px), 640px); max-height: none;
        padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--box-bg);
      }
      .chatcard > .callrow { grid-area: call; margin-top: 0 !important; }
      .chatcard > .hint { grid-area: hint; }
      .chatcard > .composer { grid-area: composer; }
      .chatcard > .msg { grid-area: msg; }
      .chatcard > .chatspot { grid-area: spot; justify-self: start; }
      .chatcard > .chatspotpanel { grid-area: spotpanel; max-width: 560px; }
      .chatcard .bubble { max-width: 70%; }

      /* Wallet and Car & license: two columns, back link and footer across. */
      #walletBody, #accountBody {
        display: grid; grid-template-columns: minmax(0, 1fr) 380px; column-gap: 24px; align-items: start;
      }
      #walletBody > .backrow, #walletBody > .signedin,
      #accountBody > .backrow, #accountBody > .signedin { grid-column: 1 / -1; }
      #walletBody > .card, #accountBody > .card { margin-bottom: 0; }
      #walletBody .card > .rowhint { margin-top: 18px; padding-bottom: 6px; }
      #walletBody .card > .rowhint ~ .meta { margin-top: 0 !important; padding: 10px 0; border-top: 1px solid var(--hair); }
      .caredit:not(.hidden) { display: grid; grid-template-columns: 1fr 1fr; column-gap: 12px; align-items: center; }
      .caredit > .disc, .caredit > .linkbtn { justify-self: start; }
    }
