    }

    // -- LIST ---------------------------------------------------------------
    /** Filled pip per sold seat, hollow per seat still open. Capped at 8 so a
     *  big van doesn't overflow the row. */
    function seatPips(booked, total) {
      const wrap = el('span', 'seatpips');
      const n = Math.min(total, 8);
      for (let i = 0; i < n; i++) wrap.appendChild(el('i', i < booked ? 'on' : null));
      return wrap;
    }

    /** The one chip that matters most, in priority order: something to answer
     *  beats sold-out beats seats-still-open. Never more than one \u2014 a card
     *  with three badges tells you nothing. */
    function rideChip(entry, isPast) {
      // A departed ride nobody booked never ran — say so instead of "Completed".
      if (isPast) return el('span', 'chip off', entry.bookedSeats > 0 ? 'Completed' : 'No bookings');
      // Departed within the last 12h with riders on board: it is in progress,
      // not "3 seats left" (2026-09-03).
      if (departureMs(entry.ride) <= Date.now()) return el('span', 'chip act', 'In progress');
      if (entry.pendingCount > 0) {
        return el('span', 'chip act',
          entry.pendingCount + ' request' + (entry.pendingCount === 1 ? '' : 's'));
      }
      if (entry.totalSeats > 0 && entry.bookedSeats >= entry.totalSeats) {
        return el('span', 'chip full', 'Full');
      }
      const left = Math.max(0, entry.totalSeats - entry.bookedSeats);
      return el('span', 'chip open', left + ' seat' + (left === 1 ? '' : 's') + ' left');
    }

    function rideCard(entry, isPast) {
      const btn = el('button', 'ridecard' + (entry.pendingCount > 0 ? ' attention' : ''));
      btn.type = 'button';
      const top = el('div', 'cardtop');
      const left = el('div');
      left.appendChild(el('div', 'cardroute', routeLabel(entry.ride)));
      // Flexible departure (0326) rides along on the time line.
      const flexLbl = flexChipLabel(entry.ride.depart_flex_minutes);
      left.appendChild(el('div', 'cardmeta', whenLabel(entry.ride) + (flexLbl ? ' · ' + flexLbl : '')));
      top.appendChild(left);
      top.appendChild(rideChip(entry, isPast));
      btn.appendChild(top);

      const foot = el('div', 'cardfoot');
      const fill = el('div', 'fillrow');
      fill.appendChild(seatPips(entry.bookedSeats, entry.totalSeats));
      fill.appendChild(el('span', null,
        entry.bookedSeats + ' of ' + entry.totalSeats + ' seat' + (entry.totalSeats === 1 ? '' : 's') + ' booked'));
      foot.appendChild(fill);
      if (entry.unreadCount > 0) {
        foot.appendChild(el('span', null,
          '\u2709 ' + entry.unreadCount + ' unread'));
      }
      btn.appendChild(foot);
      btn.addEventListener('click', () => go('/driving?ride=' + encodeURIComponent(entry.ride.id)));
      return btn;
    }

