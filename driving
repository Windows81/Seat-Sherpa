    /** Cancel the WHOLE ride — mirrors cancelRide (services/rides.ts:815):
     *  refund every Confirmed seat, decline every Pending request, flip the
     *  ride row. Blocked once any trip has started (PIN entered). */
    async function doCancelRide(ride, reason) {
      const trimmed = String(reason || '').trim();
      if (trimmed.length < 10) throw new Error('Give riders a reason — at least 10 characters.');
      const { data: rows, error } = await supabase
        .from('bookings')
        .select('id, status, passenger_id, pickup_code_entered_at')
        .eq('ride_id', ride.id)
        .in('status', ['Confirmed', 'Pending']);
      if (error) throw error;
      const started = (rows || []).some((b) => b.status === 'Confirmed' && b.pickup_code_entered_at);
      if (started) throw new Error("A trip on this ride has already started — it can't be cancelled. Email support@seatsherpa.app.");
      // Flip the ride row FIRST (bug check 2026-09-30, same order as the
      // app): the dormant-driver triggers (0325) read rides.cancelled_at to
      // tell a declined request from a cancelled ride, and the seat release
      // behind each booking cancel must not read as a hand reopen. The ride
      // ended up cancelled even when a booking cancel failed before this
      // change, so only the order moved.
      const { error: upErr } = await supabase
        .from('rides')
        .update({ cancelled_at: new Date().toISOString(), cancellation_reason: trimmed })
        .eq('id', ride.id);
      if (upErr) throw upErr;
      let failed = 0;
      for (const b of (rows || [])) {
        try {
          if (b.status === 'Confirmed') await doCancelConfirmed(b, ride, trimmed);
          else await doDecline(b, ride, trimmed);
        } catch (_) { failed += 1; }
      }
      return { failed };
    }

    /** Edit departure — bookings or not (2026-10-12), through the
     *  update-ride-time edge function, the same path the app uses. The server
     *  checks ownership, the 15-minute floor and the 4-hour spacing, writes
     *  the row, and for every Pending or Confirmed booking posts a system
     *  line in the chat, pushes or emails the rider, and resets the pickup
     *  reminders. A rider who booked before the move can cancel for a full
     *  refund, fee included, until 2 hours before the new departure (0387).
     *  Returns the server's summary ({ riders, chat, pushed, emailed }). */
    async function doEditDateTime(ride, depDate, depTime) {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(depDate) || !/^\d{2}:\d{2}$/.test(depTime)) {
        throw new Error('Pick a valid date and time.');
      }
      const pacFloor = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Los_Angeles', hour12: false,
        year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit',
      }).format(new Date(Date.now() + 15 * 60 * 1000)).replace(', ', 'T').replace(' ', 'T')
        // Some ICU builds render the midnight hour as 24:xx — same defense
        // as the check-in clock (Fable audit P4).
        .replace('T24', 'T00');
      if ((depDate + 'T' + depTime) <= pacFloor) throw new Error('Pick a date and time at least 15 minutes from now.');
      const { data: sess } = await supabase.auth.getSession();
      const token = sess && sess.session ? sess.session.access_token : null;
      if (!token) throw new Error('Please sign in again.');
      const res = await fetch(SUPA + '/functions/v1/update-ride-time', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: JSON.stringify({ rideId: ride.id, depDate, depTime }),
      });
      let out = null;
      try { out = await res.json(); } catch (_) { out = null; }
      if (!res.ok) throw new Error((out && (out.message || out.error)) || ('Could not save (HTTP ' + res.status + ').'));
      return out || {};
    }

    /** The Manage card on a ride: edit date/time, cancel one booking, cancel
     *  the ride. Replaces the old "do it in the app" banner (2026-08-27 —
     *  web drivers get the full console, standing rule). */
    // ── Seats (2026-09-03) — the app's driver seat grid on the web ──────────
    const SEAT_SHORT = { fp: 'Front', ml: 'Mid left', mr: 'Mid right', rl: 'Rear left', rc: 'Rear center', rr: 'Rear right' };
    const seatPrice = (n) => {
      const v = Number(n || 0);
      return '$' + (Number.isInteger(v) ? String(v) : v.toFixed(2));
    };

    /** Port of updateRideSeats (services/rides.ts:774). MERGE, never a blind
     *  write: re-read the ride, force-close any seat held by a CONFIRMED (or
     *  completed) booking, take the driver's toggle for the rest, and keep
     *  seats the server has that this snapshot doesn't. 0202's trigger is the
     *  final word server-side if a booking lands between read and write. A
     *  driver-CLOSED seat is the driver's to reopen — only a booking makes a
     *  seat untouchable. */
    async function doUpdateSeats(ride, wanted) {
      const [fresh, live] = await Promise.all([
        supabase.from('rides').select('seats').eq('id', ride.id).single(),
        supabase.from('bookings').select('seat_ids, status').eq('ride_id', ride.id).neq('status', 'Cancelled'),
      ]);
      if (fresh.error) throw fresh.error;
      if (live.error) throw live.error;
      // Only a Confirmed (or Completed) booking holds a seat: requests never
      // do (0217). Forcing avail=false for a Pending request's seat read, since
      // 0356, as "the driver closed this seat" (closed=true), so after a
      // decline the seat stayed Closed for good, on every ride (bug check
      // 2026-10-06; same fix as the app, services/rides.ts:800-807).
      const held = new Set();
      // The PRICE stays frozen for any live booking (sweep 2026-09-03): a
      // Pending request authorized the OLD price and the accept captures
      // exactly that, so the listed price must not drift.
      const priceFrozen = new Set();
      (live.data || []).forEach((b) => (b.seat_ids || []).forEach((id) => {
        priceFrozen.add(id);
        if (b.status === 'Confirmed' || b.status === 'Completed') held.add(id);
      }));
      const server = (fresh.data && Array.isArray(fresh.data.seats)) ? fresh.data.seats : [];
      const byId = new Map(server.map((x) => [x.id, x]));
      const merged = wanted.map((w) => {
        if (!byId.has(w.id)) return w;
        const cur0 = byId.get(w.id);
        return Object.assign({}, w, { avail: held.has(w.id) ? false : !!w.avail, price: priceFrozen.has(w.id) ? cur0.price : w.price });
      });
      for (const x of server) if (!merged.some((m) => m.id === x.id)) merged.push(x);
      const { error } = await supabase.from('rides').update({ seats: merged }).eq('id', ride.id);
      if (error) throw error;
      return merged;
    }

    /** Until when a later stop on this ride can still be boarded, in ms.
     *  Bookings close at the rider's BOARDING point (2026-10-06,
     *  _shared/boarding-time.ts), so a ride that has left its origin can still
     *  sell a stretch from a stop ahead, and the driver needs the Seats card
     *  to close it. Late, never early: the server's estimate for any stop is
     *  at most the whole road (road_minutes, else road miles at 62 mph) plus
     *  its 15% buffer for a stop on the route, the straight line × 1.25 at
     *  62 mph plus 15% for one off it, or the ride's end (road minutes, else
     *  12 h) for one it cannot place; plus 5 minutes per stop for rounding
     *  and its keep-stops-in-order nudge. Rides without stops: departure. */
    function lastBoardingMs(ride) {
      const dep = departureMs(ride);
      const stops = Array.isArray(ride.route_stops) ? ride.route_stops : [];
      if (!dep || stops.length === 0) return dep;
      const rm = Number(ride.road_minutes);
      const roadMin = Number.isFinite(rm) && rm > 0 ? rm : null;
      const rmi = Number(ride.road_miles);
      let bound = roadMin != null ? roadMin * 1.15 : (Number.isFinite(rmi) && rmi > 0 ? (rmi / 62) * 60 * 1.15 : 0);
      const start = (ride.start_lat != null && ride.start_lng != null)
        ? { lat: Number(ride.start_lat), lng: Number(ride.start_lng) } : null;
      stops.forEach((s) => {
        const p = typeof s === 'string' ? (window.SS_STOPS && SS_STOPS.STOP_BY_ID[s]) : s;
        const placed = start && Number.isFinite(start.lat) && Number.isFinite(start.lng) && window.SS_STOPS
          && p && typeof p.lat === 'number' && typeof p.lng === 'number';
        bound = Math.max(bound, placed
          ? ((SS_STOPS.haversineMiles(start, p) * 1.25) / 62) * 60 * 1.15
          : (roadMin != null ? roadMin : 12 * 60));
      });
      return dep + (bound + 5 * (stops.length + 1)) * 60 * 1000;
    }

    /** The Seats card on a live ride: one tappable tile per passenger seat.
     *  Returns null when there is nothing to show (no passenger seats, or the
     *  car is past every point a rider can still board: the origin, or on a
     *  ride with stops the last stop). */
    function seatsSection(entry) {
      const ride = entry.ride;
      const seats = Array.isArray(ride.seats) ? ride.seats : [];
      const passengerSeats = seats.filter((x) => x && !x.isDriver);
      if (passengerSeats.length === 0) return null;
      const dep = lastBoardingMs(ride);
      if (dep && Date.now() > dep) return null;

      // Who holds which seat — same rule as the merge (any non-cancelled
      // booking), shown by first name so the driver sees it at a glance.
      // Leg-aware seats (0356, parity 2026-10-06): one seat can carry a
      // confirmed rider for one stretch and another booking for a later one.
      // The tile keeps the CONFIRMED rider and counts the rest ("+1"); every
      // booking is still in the riders list below.
      const holder = new Map();
      entry.bookings
        .slice()
        .sort((a, b) => (effectiveStatus(a, ride) === 'Confirmed' ? 0 : 1) - (effectiveStatus(b, ride) === 'Confirmed' ? 0 : 1))
        .forEach((b) => {
          if (b.status === 'Cancelled') return;
          const raw = (b.passenger && b.passenger.name) || b.passenger_name || '';
          const first = abbreviateName(raw).split(' ')[0] || 'Rider';
          const st = effectiveStatus(b, ride);
          (b.seat_ids || []).forEach((id) => {
            const cur = holder.get(id);
            if (cur) cur.others += 1;
            else holder.set(id, { name: first, pending: st === 'Pending', others: 0 });
          });
        });
      const holderLabel = (h) => (h.pending ? 'Requested · ' : 'Booked · ') + h.name + (h.others ? ' +' + h.others : '');

      const wrap = el('div', 'card');
      wrap.appendChild(el('div', 'eyebrow', 'Seats'));
      wrap.appendChild(el('div', 'rowhint', 'Tap a seat to close or reopen it. One price covers every seat; a seat with a booking or request stays as it is.'));
      const msg = el('div', 'rowhint hidden');
      msg.style.color = 'var(--err)';

      const unbooked = passengerSeats.filter((x) => !holder.has(x.id));
      const openSeats = unbooked.filter((x) => x.avail);
      const priceSeat = openSeats[0] || unbooked[0] || passengerSeats[0];
      let saving = false;
      const tiles = [];
      const chipBtns = [];
      const setBusy = (b) => {
        saving = b;
        tiles.forEach((t) => { t.disabled = b || !!holder.get(t.dataset.seat) || t.classList.contains('driver'); t.classList.toggle('saving', b); });
        chipBtns.forEach((c) => { c.disabled = b; });
      };
      async function toggleSeat(id) {
        if (saving) return;
        setBusy(true); msg.classList.add('hidden');
        const wanted = seats.map((x) => (x && x.id === id) ? Object.assign({}, x, { avail: !x.avail }) : x);
        try {
          await doUpdateSeats(ride, wanted);
          await refreshRide(ride.id);
        } catch (e) {
          setBusy(false);
          msg.textContent = (e && e.message) || 'Could not update that seat — try again.';
          msg.classList.remove('hidden');
        }
      }

      // ── Layout: portrait car on the left, controls on the right ────────
      const layout = el('div', 'seatlayout');
      const carcol = el('div', 'carcol');
      const chipcol = el('div', 'chipcol');

      const ids = new Set(passengerSeats.map((x) => x.id));
      const rows = [['driver', 'fp'], ['ml', 'mr'], ['rl', 'rc', 'rr']]
        .map((r) => r.filter((id) => id === 'driver' || ids.has(id)))
        .filter((r) => r.some((id) => id !== 'driver'));

      function tile(id) {
        if (id === 'driver') {
          const t = el('button', 'seattile driver');
          t.type = 'button'; t.disabled = true;
          t.appendChild(el('div', 'drvbadge', (((ride.driver_name || myEmail || 'You').trim().charAt(0)) || 'Y').toUpperCase()));
          t.appendChild(el('div', 'ss', 'Driver'));
          return t;
        }
        const seat = passengerSeats.find((x) => x.id === id);
        const h = holder.get(id);
        const state = h ? 'held' : (seat.avail ? 'open' : 'closed');
        const t = el('button', 'seattile ' + state);
        t.type = 'button';
        t.appendChild(el('div', 'sl', SEAT_SHORT[id] || seat.label || id));
        // The price lives in the column on the right (one price per ride);
        // a held seat shows what its rider is paying.
        if (h) t.appendChild(el('div', 'sp', seatPrice(seat.price)));
        t.appendChild(el('div', 'ss', h ? holderLabel(h) : (seat.avail ? 'Open' : 'Closed')));
        t.setAttribute('aria-label', (SEAT_SHORT[id] || id) + ' seat, ' + (h ? 'held by ' + h.name + (h.others ? ' and ' + h.others + ' more' : '') : (seat.avail ? 'open, tap to close' : 'closed, tap to reopen')));
        if (h) { t.disabled = true; return t; }
        t.addEventListener('click', () => toggleSeat(id));
        return t;
      }

      // Car chrome, the booking page's cabin: wheels flush on the sides,
      // mirrors up front, a long rounded shell, windshield bar after row 1.
      const carwrap = el('div', 'carwrap');
      ['wfl', 'wfr', 'wrl', 'wrr'].forEach((w) => carwrap.appendChild(el('div', 'carwheel ' + w)));
      ['mml', 'mmr'].forEach((m) => carwrap.appendChild(el('div', 'carmirror ' + m)));
      const shell = el('div', 'carshell');
      rows.forEach((r, i) => {
        const row = el('div', 'carrow' + (r.length === 3 ? ' three' : ''));
        r.forEach((id) => { const t = tile(id); t.dataset.seat = id; tiles.push(t); row.appendChild(t); });
        shell.appendChild(row);
        if (i < rows.length - 1) shell.appendChild(el('div', i === 0 ? 'windshield' : 'rowdiv'));
      });
      carwrap.appendChild(shell);
      carcol.appendChild(carwrap);

      // ── Right column: one price (editable), a summary, one chip per seat ─
      if (unbooked.length > 0 && priceSeat) {
        const priceRow = el('div', 'seatchip price');
        const priceTxt = el('span', 'val', seatPrice(priceSeat.price) + ' per seat');
        const priceRowEdit = el('button', 'chipact', 'Edit');
        priceRowEdit.type = 'button';
        priceRow.appendChild(priceTxt); priceRow.appendChild(priceRowEdit);
        chipcol.appendChild(priceRow);
        const editBox = el('div', 'priceedit hidden');
        const priceInp = inp('number', '', String(priceSeat.price || ''));
        // max = the highest ceiling any trip can have; Save checks this ride's.
        priceInp.min = '10'; priceInp.max = '60'; priceInp.step = '1';
        const priceSave = el('button', 'primary', 'Save');
        priceSave.type = 'button';
        editBox.appendChild(el('span', 'cur', '$'));
        editBox.appendChild(priceInp); editBox.appendChild(priceSave);
        chipcol.appendChild(editBox);
        // actionBusy freezes the periodic refresh while the box is open —
        // otherwise a 30/60s repaint wiped a half-typed price (audit 2026-09-04).
        priceRowEdit.addEventListener('click', () => {
          editBox.classList.toggle('hidden');
          const open = !editBox.classList.contains('hidden');
          actionBusy = open;
          if (open) priceInp.focus();
        });
        priceSave.addEventListener('click', async () => {
          msg.classList.add('hidden');
          const n = Math.round(Number(priceInp.value));
          // Same cap rule as the app's grid: (drivable miles × $0.76 − what
          // booked seats already collect) ÷ open seats, floor $10, ceiling $55
          // ($60 from 400 miles, 2026-10-12, lib/seat-price-cap.ts hardCapForMiles).
          const start = (ride.start_lat != null) ? { lat: Number(ride.start_lat), lng: Number(ride.start_lng) } : null;
          const end = (ride.end_lat != null) ? { lat: Number(ride.end_lat), lng: Number(ride.end_lng) } : null;
          const miles = (typeof ride.road_miles === 'number' && ride.road_miles > 0)
            ? Number(ride.road_miles)
            : (start && end && window.SS_STOPS ? SS_STOPS.haversineMiles(start, end) * 1.25 : 0);
          const bookedSeats = passengerSeats.filter((x) => holder.has(x.id));
          const bookedSum = bookedSeats.reduce((t, x) => t + (Number(x.price) || 0), 0);
          // No mileage (no coords / stops lib failed to load) → the price can
          // only be held or lowered, never raised toward the $55 ceiling
          // blind (audit 2026-09-04).
          // Remainder splits across the open seats but never across fewer than
          // (4 − booked): the trip is always shared by at least four riders
          // (2026-09-06), so closing seats can't raise the cap here either.
          // $60 tier on MEASURED road miles only, never on the x1.25 estimate.
          const ceiling = (typeof ride.road_miles === 'number' && ride.road_miles >= 400) ? 60 : 55;
          const cap = miles > 0
            ? Math.max(10, Math.min(ceiling, Math.floor((miles * 0.76 - bookedSum) / Math.max(1, 4 - bookedSeats.length, openSeats.length))))
            : Math.max(10, Math.min(60, Math.round(Number(priceSeat.price) || 10)));
          if (!Number.isFinite(n) || n < 10 || n > cap) {
            msg.textContent = 'Enter a whole dollar amount between $10 and $' + cap + ' — the cost-sharing cap for this trip, split across at least four riders.';
            msg.classList.remove('hidden');
            return;
          }
          actionBusy = false;
          priceSave.disabled = true; priceSave.textContent = 'Saving…';
          try {
            const wanted = seats.map((x) => (x && !x.isDriver && !holder.has(x.id)) ? Object.assign({}, x, { price: n }) : x);
            await doUpdateSeats(ride, wanted);
            await refreshRide(ride.id);
          } catch (e) {
            priceSave.disabled = false; priceSave.textContent = 'Save';
            msg.textContent = (e && e.message) || 'Could not save the price — try again.';
            msg.classList.remove('hidden');
          }
        });
      }
      chipcol.appendChild(el('div', 'seatsum',
        openSeats.length + ' open · ' + (unbooked.length - openSeats.length) + ' closed · '
        + (passengerSeats.length - unbooked.length) + (passengerSeats.length - unbooked.length === 1 ? ' taken' : ' taken')));
      passengerSeats.forEach((seat) => {
        const h = holder.get(seat.id);
        const chip = el('div', 'seatchip ' + (h ? 'held' : (seat.avail ? 'open' : 'closed')));
        chip.appendChild(el('span', 'nm', SEAT_SHORT[seat.id] || seat.label || seat.id));
        chip.appendChild(el('span', 'st', h ? holderLabel(h) : (seat.avail ? 'Open' : 'Closed')));
        if (!h) {
          const act = el('button', 'chipact', seat.avail ? 'Close' : 'Reopen');
          act.type = 'button';
          act.addEventListener('click', () => toggleSeat(seat.id));
          chipBtns.push(act);
          chip.appendChild(act);
        }
        chipcol.appendChild(chip);
      });

      layout.appendChild(carcol);
      layout.appendChild(chipcol);
      wrap.appendChild(layout);
      if (openSeats.length === 0) {
        wrap.appendChild(el('div', 'rowhint', 'Every seat is closed or taken — riders can\'t book this ride until you reopen one.'));
      }
      wrap.appendChild(msg);
      return wrap;
    }

    // "Add to calendar" state lives OUT here, not in the card: the card is
    // rebuilt on a timer and by other actions, and anything kept in its
    // closure would be lost or left pointing at a card no longer on screen
    // (bug sweep 2026-10-03).
    const rideCalLinks = new Map();    // ride id -> { ics, google }
    const rideCalRepaint = new Map();  // ride id -> paint(note, moveFocus) of the card on screen now
    // A one-shot note for a ride's Manage row, painted by the NEXT render of
    // that ride (a save refreshes the whole ride page, so a note set on the
    // old row would be lost; review 2026-10-12).
    const rideNotice = new Map();      // ride id -> text
    let rideCalBusyId = null;          // the ride with a request in flight
    // The ride whose "Manage ride" row is open, so a timed redraw does not
    // fold it shut under the driver (and hide the calendar links with it).
    let manageOpenRideId = null;

    // Ask the server for one ride's two calendar links. Gives up after 15
    // seconds so a hung request cannot leave "One moment" up for good; a late
    // answer still fills the cache.
    async function requestRideCalendar(rideId) {
      if (rideCalBusyId !== null) return;
      rideCalBusyId = rideId;
      const repaint = (note, moveFocus) => { const fn = rideCalRepaint.get(rideId); if (fn) fn(note, moveFocus); };
      repaint('', false);
      let note = '';
      const ask = callFn('calendar-event', { rideId })
        .then((out) => {
          if (out && out.ok && out.ics && out.google) { rideCalLinks.set(rideId, { ics: out.ics, google: out.google }); return ''; }
          return (out && out.reason) || "The calendar link didn't load. Try again.";
        })
        // The shared caller signs the page out on a 401, so "try again" would
        // be a dead end there.
        .catch((e) => (e && (e.status === 401 || e.sessionExpired === true)
          ? 'Your sign-in expired. Refresh the page and sign in again.'
          : "The calendar link didn't load. Try again."));
      let timer = null;
      const gaveUp = new Promise((resolve) => { timer = setTimeout(() => resolve(null), 15000); });
      const first = await Promise.race([ask, gaveUp]);
      clearTimeout(timer);
      if (first === null) {
        note = "The calendar link didn't load. Try again.";
        // A late answer: keep the links, and show them if nothing else is going on.
        ask.then((late) => { if (late === '' && rideCalBusyId === null) repaint('', false); });
      } else {
        note = first;
      }
      rideCalBusyId = null;
      repaint(note, true);
    }

    // "Message all riders" (0346, Justin 2026-10-04: "just confirmed riders,
    // and show sent to every booked rider on this drive and yes quick picks").
    // One message, and every CONFIRMED rider gets it in their own chat with
    // the driver; replies stay one to one. Same edge function and quick picks
    // as the app (components/ride-broadcast-modal.tsx). Shown with 2+
    // confirmed riders: with one, their chat is the same thing.
    const BROADCAST_PICKS = [
      ['Running 10 min late', 'Running about 10 minutes late. See you soon!'],
      ["I'm at the pickup spot", "I'm at the pickup spot."],
      ['Pickup spot changed', 'Pickup spot changed: '],
    ];
    function broadcastSection(entry) {
      const ride = entry.ride;
      if (ride.cancelled_at) return null;
      const byRider = new Map();
      for (const b of entry.bookings) {
        if (b.status === 'Confirmed' && b.passenger_id && !byRider.has(b.passenger_id)) byRider.set(b.passenger_id, paxDisplay(b));
      }
      if (byRider.size < 2) return null;
      const names = [...byRider.values()];

      const wrap = el('div', 'card');
      const open = el('button', 'outline', 'Message all riders');
      open.type = 'button';
      const panel = el('div', 'hidden');
      const msg = el('div', 'rowhint hidden');
      wrap.appendChild(open);
      wrap.appendChild(panel);
      wrap.appendChild(msg);

      open.addEventListener('click', () => {
        // Hold the timed redraw while the box is open (see rideIsLive).
        actionBusy = true;
        open.classList.add('hidden');
        msg.classList.add('hidden');
        clear(panel);
        panel.appendChild(el('div', 'eyebrow', 'Message all riders'));
        panel.appendChild(el('div', 'rowhint', 'To: ' + names.join(', ')));
        const ta = document.createElement('textarea');
        ta.maxLength = 2000;
        ta.placeholder = 'Write a message';
        ta.setAttribute('aria-label', 'Message to all riders');
        // Meeting spot (0347): optional, sent to everyone as a map card.
        let spotPlace = null;
        const spotWrap = el('div', 'hidden');
        const spotPreview = el('div');
        const addSpot = el('button', 'linkbtn', 'Add a meeting spot');
        addSpot.type = 'button';
        addSpot.style.margin = '0 0 10px';
        const showSpot = () => {
          if (!window.SSMeetingSpot || !spotWrap.classList.contains('hidden')) return;
          addSpot.classList.add('hidden');
          const pk = SSMeetingSpot.picker((p) => {
            spotPlace = p;
            clear(spotPreview);
            if (p) spotPreview.appendChild(SSMeetingSpot.card(p, { from: (ride.start_lat != null) ? { lat: Number(ride.start_lat), lng: Number(ride.start_lng) } : null }));
            sync();
          });
          spotWrap.appendChild(pk);
          spotWrap.appendChild(spotPreview);
          spotWrap.classList.remove('hidden');
          pk.focusInput();
        };
        addSpot.addEventListener('click', showSpot);

        const picks = el('div', 'qpicks');
        for (const [label, text] of BROADCAST_PICKS) {
          const p = el('button', 'qpick', label);
          p.type = 'button';
          p.addEventListener('click', () => {
            ta.value = text;
            ta.focus();
            ta.setSelectionRange(ta.value.length, ta.value.length);
            sync();
            // "Pickup spot changed" opens the place search too.
            if (label === 'Pickup spot changed') showSpot();
          });
          picks.appendChild(p);
        }
        panel.appendChild(picks);
        panel.appendChild(ta);
        if (window.SSMeetingSpot) { panel.appendChild(addSpot); panel.appendChild(spotWrap); }
        panel.appendChild(el('div', 'rowhint', 'Each rider gets this in their own chat with you. Replies come back to you privately.'));
        const send = el('button', 'primary', 'Send to ' + names.length + ' riders');
        send.type = 'button';
        const sync = () => { send.disabled = !ta.value.trim() && !spotPlace; };
        ta.addEventListener('input', sync);
        sync();
        const close = () => {
          clear(panel);
          panel.classList.add('hidden');
          open.classList.remove('hidden');
          actionBusy = false;
        };
        send.addEventListener('click', async () => {
          let text = ta.value.trim();
          // The quick pick's bare prefix adds nothing next to a spot card.
          if (spotPlace && /^Pickup spot changed:?$/.test(text)) text = 'Pickup spot changed';
          if (!text && !spotPlace) return;
          // Alone, with no spot picked, the prefix tells riders nothing
          // (bug check 2026-10-05): ask for the spot instead of sending it.
          if (!spotPlace && /^Pickup spot changed:?$/.test(text)) {
            msg.textContent = 'Pick the new spot from the suggestions first.';
            msg.classList.remove('hidden');
            return;
          }
          msg.classList.add('hidden');
          send.disabled = true; send.textContent = 'Sending…';
          // One key per message (bug check 2026-10-05): Send again after a
          // timeout reuses it and the server answers "already sent" instead
          // of messaging every rider twice. Editing makes a new key.
          const sig = text + '|' + (spotPlace ? spotPlace.lat + ',' + spotPlace.lng : '');
          if (!panel.__sendKey || panel.__sendKey.sig !== sig) panel.__sendKey = { sig: sig, key: ssUuid() };
          try {
            const out = await callFn('send-ride-broadcast', Object.assign(
              { rideId: ride.id, body: text, sendKey: panel.__sendKey.key },
              spotPlace ? { place: spotPlace } : {}));
            panel.__sendKey = null; // the next message is a new send
            close();
            const n = (out && out.sent) || 0;
            msg.textContent = 'Sent to ' + n + ' rider' + (n === 1 ? '' : 's') + '. Each one gets it in their own chat with you.';
            msg.classList.remove('hidden');
          } catch (e) {
            send.disabled = false; send.textContent = 'Send to ' + names.length + ' riders';
            msg.textContent = (e && e.body && e.body.message) || (e && e.status === 401
              ? 'Your session expired. Sign in again to send this.'
              : 'Could not send right now. Try again.');
            msg.classList.remove('hidden');
          }
        });
        panel.appendChild(send);
        const never = el('button', 'linkbtn', 'Never mind');
        never.type = 'button';
        never.style.display = 'block';
        never.style.marginTop = '6px';
        never.addEventListener('click', close);
        panel.appendChild(never);
        panel.classList.remove('hidden');
        ta.focus();
      });
      return wrap;
    }

    function manageSection(entry) {
      const ride = entry.ride;
      const wrap = el('div', 'card');
      wrap.appendChild(el('div', 'eyebrow', 'Manage'));

      // PARITY WITH THE APP (Justin, 2026-09-12: "match the app for web posting
      // console"). trips.tsx sorts a ride into Past purely on time once it is
      // PAST_GRACE_MS (12h) past departure, and the Past list passes only
      // onOpenBooking, onOpenMessages, onStartTrip and onPostAgain. It never
      // passes onCancelRide or onEditRide, so the app offers NO edit and NO
      // cancel on a departed ride.
      //
      // This console offered all of them forever, because its ride cards open
      // the detail page for past rides like any other and none of these actions
      // checked the clock. Kevin M. cancelled ride 425 three days after it
      // departed; he has never opened the app, so this was his only surface.
      //
      // Deliberately NOT gated: viewing, messaging, the late pickup PIN and
      // Post again. The app keeps all four on past rides, and each has a real
      // use after the fact (a rider left a jacket; a driver forgot the PIN).
      const PAST_GRACE_MS = 12 * 60 * 60 * 1000;
      const depForGate = departureMs(ride);
      const ridePast = !!depForGate && Date.now() > depForGate + PAST_GRACE_MS;

      const active = entry.bookings.filter((b) => {
        const st = effectiveStatus(b, ride);
        return st === 'Pending' || st === 'Confirmed';
      });
      const confirmedActive = entry.bookings.filter((b) => effectiveStatus(b, ride) === 'Confirmed' && !b.pickup_code_entered_at);
      const panel = el('div', 'hidden');
      const msg = el('div', 'rowhint hidden');
      if (rideNotice.has(ride.id)) {
        msg.textContent = rideNotice.get(ride.id);
        msg.classList.remove('hidden');
        rideNotice.delete(ride.id);
      }

      // Every panel gets an escape hatch — a destructive flow with no visible
      // way out reads as a trap, and closing also unfreezes the refresh.
      function neverMind() {
        const b = el('button', 'linkbtn', 'Never mind');
        b.type = 'button';
        b.style.display = 'block';
        b.style.marginTop = '6px';
        b.addEventListener('click', () => {
          clear(panel);
          panel.classList.add('hidden');
          msg.classList.add('hidden');
          actionBusy = false;
        });
        return b;
      }

      const row = el('div', 'managerow');
      row.style.display = 'flex'; row.style.gap = '10px'; row.style.flexWrap = 'wrap';
      // One "Manage ride" disclosure per card (primary-action audit, Justin
      // 2026-09-05): five edit/cancel pills on every ride turned the list into
      // a control panel. The pills still exist, they just wait behind a toggle.
      // Programmatic editBtn.click() from the cancel flow still works hidden.
      const startOpen = manageOpenRideId === ride.id;
      if (!startOpen) row.classList.add('hidden');
      const manageBtn = el('button', 'linkbtn', startOpen ? 'Manage ride ▴' : 'Manage ride ▾');
      manageBtn.type = 'button';
      manageBtn.setAttribute('aria-expanded', String(startOpen));
      manageBtn.style.fontWeight = '700';
      manageBtn.addEventListener('click', () => {
        const open = !row.classList.toggle('hidden');
        manageBtn.textContent = open ? 'Manage ride ▴' : 'Manage ride ▾';
        manageBtn.setAttribute('aria-expanded', String(open));
        if (open) manageOpenRideId = ride.id;
        else if (manageOpenRideId === ride.id) manageOpenRideId = null;
      });

      // Add to calendar (Justin, 2026-10-03: "the driver should get the drive
      // on their calendar too"). The driver's own entry for this ride, signed
      // by the calendar-event function, so nothing about the event is built
      // here. The links are kept per ride for the life of the page (see the
      // state above manageSection). An upcoming, live ride only.
      //
      // This never touches actionBusy: that flag belongs to whichever edit,
      // cancel or decline panel is open, and lifting it from here let the next
      // timed redraw wipe a half-typed panel (bug sweep 2026-10-03). The
      // answer repaints whichever card is on screen for this ride when it
      // lands, so the page does not need holding still.
      if (!ridePast && !ride.cancelled_at) {
        const calBox = el('span');
