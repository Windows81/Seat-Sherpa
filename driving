      // bookings.ts:401 cancelPaymentIntentForBooking - releases the rider's
      // authorization hold in minutes instead of Stripe's 7-day auto-expiry.
      // If it fails, the hold expires on its own; never surfaces as an error.
      callFn('stripe-cancel-payment-intent', { bookingId }).catch(() => {});
