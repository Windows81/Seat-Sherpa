      } else {
        row.appendChild(initial);
      }
      const col = el('div');
      const nameLine = el('div', 'paxname', paxDisplay(b));
      if (b.passenger && b.passenger.id_verified === true) {
        nameLine.classList.add('withtag');
        nameLine.appendChild(idVerifiedTag());
      }
      // ♀ for anyone whose gender is female (Justin, 2026-10-08), ID verified or not.
      if (b.passenger && b.passenger.gender === 'female') {
        nameLine.classList.add('withtag');
        nameLine.appendChild(riderFemaleTag());
      }
      // School badge (0294): the rider's school, as text only, next to the name.
      const paxSchool = b.passenger && typeof b.passenger.org_name === 'string' ? b.passenger.org_name.trim() : '';
      if (paxSchool) {
        nameLine.classList.add('withtag');
        nameLine.appendChild(schoolTag(paxSchool));
      }
      col.appendChild(nameLine);
      if (subText) col.appendChild(el('div', 'paxsub', subText));
      row.appendChild(col);
