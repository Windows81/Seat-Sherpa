          panel.appendChild(dtPair);
          const save = el('button', 'primary', 'Save new departure');
          save.type = 'button';
          save.addEventListener('click', async () => {
            msg.classList.add('hidden');
            save.disabled = true; save.textContent = 'Saving…';
            try {
              const out = await doEditDateTime(ride, d.value, t.value);
              actionBusy = false;
              if (out && out.riders > 0) {
                // Painted by the re-render below (the current msg node is about to be replaced).
                rideNotice.set(ride.id, 'Departure moved. ' + out.riders + ' rider' + (out.riders === 1 ? ' was' : 's were') + ' told in the chat' + (out.emailed > 0 ? ' and by email' : '') + '.');
              }
              await refreshRide(ride.id);
            } catch (e) {
              save.disabled = false; save.textContent = 'Save new departure';
