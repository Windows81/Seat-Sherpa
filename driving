      // Rounded DOWN to one decimal (2026-10-05): 4.95 shows 4.9.
      return '★ ' + (Math.floor(Math.round(r.avg * 1000) / 100) / 10).toFixed(1);
    }

    async function loadUnreadCounts(bookingIds) {
