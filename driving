<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your rides &mdash; Seat Sherpa</title>

  <!-- DRIVER WEB CONSOLE (2026-08-22) - the driver-side twin of /trips.
       Transactional, signed-in-only, and DELIBERATELY UNLINKED. Nothing on
       index/rides/ride/book/post, the sitemap, robots.txt, or any app screen
       points here - a driver reaches it by typing the URL (or from the /post
       success email, if we ever add one). noindex is the belt to that
       suspenders: this page renders pending payment requests, rider chats and
       the check-in surface that releases escrow - it must never land in a
       search index even if someone pastes the link somewhere public. -->
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="#0E0E10" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#F5F6F5" media="(prefers-color-scheme: light)" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- NO marketing pixels here, same reasoning as trips.html: this is
       post-signup account plumbing, not a conversion funnel. -->

  <style>
    /* Color tokens + light theme (2026-10-12): every color on this page is a
       token. The dark values are the page's original literals, so dark looks
       exactly as before; the light set follows the visitor's own system
       setting (no toggle). --teal is the button FILL; --link is teal TEXT for
       things you can tap; --link-deep is teal text on a teal-tinted or gray
       chip (the lighter teal falls under 4.5:1 there in light). --ssbar-* and
       --ssmenu-* theme the shared header, menu and rating popup. */
    :root {
      --bg: #0E0E10; --text: #fff; --text2: #E8E8EC;
      --sub: #adadb8; --sub2: #b9b9c6; --cap: #8f8f98; --subhover: #cfcfd6;
      --teal: #00D4C8; --on-teal: #04201e; --link: #00D4C8; --link-deep: #00D4C8; --focus: #00D4C8;
      --card-a: #1a1a1d; --card-b: #141416; --line: rgba(255,255,255,0.10); --hair: rgba(255,255,255,0.07);
      --input-bg: #0E0E10; --input-line: rgba(255,255,255,0.14); --outline-line: rgba(255,255,255,0.22);
      --err: #ff8a8a; --ok: #4ade80; --late: #ff8a80;
      --danger-fill: #ff5d5d; --danger-ink: #2a0505;
      --spin-track: rgba(255,255,255,0.15); --spin-top: #00D4C8;
      --count-bg: rgba(255,255,255,0.08);
      --soft-line: rgba(0,212,200,0.40); --soft-bg: rgba(0,212,200,0.10);
      --pend-bg: #24200d; --pend-line: rgba(255,193,7,0.35); --pend-line2: rgba(255,193,7,0.5); --pend-text: #ffc94a;
      --conf-bg: #0d1f1e; --conf-line: rgba(0,212,200,0.35); --conf-text: #00D4C8;
      --canc-bg: #241416; --canc-line: rgba(255,138,138,0.3); --canc-text: #ff8a8a;
      --done-bg: #16181c; --done-line: rgba(255,255,255,0.15); --done-text: #b9b9c6;
      --stat-bg: #141417; --stat-line: #232329; --stat-text: #f5f5f7; --stat-k: #a3a3ae;
      --stat-act-line: rgba(255,184,77,0.45); --stat-act-bg: #191509; --amber: #FFB84D; --stat-act-k: #e8c88c;
      --teal-hover: rgba(0,212,200,0.45); --ride-hover: rgba(0,212,200,0.4); --attn-line: rgba(255,193,7,0.45);
      --chip-act-bg: rgba(255,184,77,0.16); --chip-full-bg: rgba(61,220,151,0.15); --chip-full-text: #3ddc97;
      --chip-open-bg: rgba(255,255,255,0.07); --chip-off-bg: rgba(255,255,255,0.05); --chip-off-text: #8e8e99;
      --idv-bg: rgba(0,212,200,0.12);
      --pip: rgba(255,255,255,0.14); --pip-on: #00D4C8;
      --avatar-bg: #0E0E10; --avatar-line: rgba(255,255,255,0.12);
      --box-bg: rgba(255,255,255,0.02); --req-line: rgba(255,193,7,0.4); --req-bg: #17150c;
      --note-bg: #0E0E10; --note-line: rgba(255,255,255,0.1);
      --tile-bg: #18181C; --tile-line: #2C2C38; --tile-dim: #8888A8; --tile-ss: #C0C0D0;
      --tile-open-line: rgba(0,212,200,.45); --tile-open-bg: rgba(0,212,200,.08);
      --held-line: rgba(255,214,10,.4); --held-line2: rgba(255,214,10,.35); --held-bg: rgba(255,214,10,.08); --held-text: #FFD60A;
      --wheel: #26262e; --mirror: #2f2f38; --shell-line: #2a2a33; --shell-bg: #101014; --windshield: rgba(0,212,200,.14);
      --chip-bg: #18181C; --price-bg: rgba(0,212,200,.06); --hover-line: rgba(0,212,200,.5); --danger-line: rgba(255,138,138,.35);
      --warn-bg: #241416; --warn-line: rgba(255,138,138,0.3); --warn-text: #ffb3b3;
      --info-bg: #141d1c; --info-line: rgba(0,212,200,0.3); --info-text: #cfe9e7;
      --neutral-bg: #16181c; --neutral-line: rgba(255,255,255,0.12);
      --amber-bg: #24200d; --amber-line: rgba(255,193,7,0.35); --amber-text: #ffe1a3;
      --them-bg: #1f1f23; --failed-bg: #3a1c1f;
      --nav-bg: #17171d; --nav-line: #2a2a33; --nav-hover: rgba(0,212,200,0.4);
      --ac-line: #202027; --ac-bg: #141418; --ac-text: #e8e8ee;
      --sel-line: rgba(0,212,200,0.6);
      --star-off: #a3a3ae; --star-on: #FFD75A; --call: #00a8a0; --callmsg: #6b7280;
    }
    @media (prefers-color-scheme: light) {
      :root {
        color-scheme: light;
        --bg: #F5F6F5; --text: #121416; --text2: #23272A;
        --sub: #4B5357; --sub2: #4B5357; --cap: #687176; --subhover: #23272A;
        --teal: #00D4C8; --on-teal: #04201e; --link: #007C76; --link-deep: #006B65; --focus: #007C76;
        --card-a: #FFFFFF; --card-b: #FFFFFF; --line: rgba(18,22,22,0.10); --hair: rgba(18,22,22,0.08);
        --input-bg: #EFF1F0; --input-line: rgba(18,22,22,0.18); --outline-line: rgba(18,22,22,0.18);
        --err: #C62828; --ok: #1E7B3A; --late: #C62828;
        --danger-fill: #C62828; --danger-ink: #FFFFFF;
        --spin-track: rgba(18,22,22,0.12); --spin-top: #00A89F;
        --count-bg: rgba(18,22,22,0.06);
        --soft-line: rgba(0,124,118,0.45); --soft-bg: rgba(0,168,159,0.12);
        --pend-bg: #FFF4DB; --pend-line: rgba(138,90,0,0.30); --pend-line2: rgba(138,90,0,0.45); --pend-text: #8A5A00;
        --conf-bg: #E3F4F2; --conf-line: rgba(0,124,118,0.35); --conf-text: #00665F;
        --canc-bg: #FDECEC; --canc-line: rgba(198,40,40,0.28); --canc-text: #C62828;
        --done-bg: #EFF1F0; --done-line: rgba(18,22,22,0.12); --done-text: #4B5357;
        --stat-bg: #FFFFFF; --stat-line: rgba(18,22,22,0.10); --stat-text: #121416; --stat-k: #4B5357;
        --stat-act-line: rgba(138,90,0,0.35); --stat-act-bg: #FFF4DB; --amber: #8A5A00; --stat-act-k: #6B4600;
        --teal-hover: rgba(0,124,118,0.45); --ride-hover: rgba(0,124,118,0.45); --attn-line: rgba(138,90,0,0.45);
        --chip-act-bg: #FFF4DB; --chip-full-bg: rgba(30,123,58,0.10); --chip-full-text: #1E7B3A;
        --chip-open-bg: #EFF1F0; --chip-off-bg: #EFF1F0; --chip-off-text: #5C6569;
        --idv-bg: rgba(0,168,159,0.12);
        --pip: rgba(18,22,22,0.16); --pip-on: #00968E;
        --avatar-bg: #EFF1F0; --avatar-line: rgba(18,22,22,0.12);
        --box-bg: #FFFFFF; --req-line: rgba(138,90,0,0.35); --req-bg: #FFFAF0;
        --note-bg: #FFFFFF; --note-line: rgba(18,22,22,0.10);
        --tile-bg: #FFFFFF; --tile-line: #D8DCDB; --tile-dim: #4B5357; --tile-ss: #4B5357;
        --tile-open-line: rgba(0,124,118,0.45); --tile-open-bg: rgba(0,168,159,0.08);
        --held-line: rgba(138,90,0,0.40); --held-line2: rgba(138,90,0,0.35); --held-bg: #FFF8E6; --held-text: #8A5A00;
        --wheel: #C4CAC8; --mirror: #CDD3D1; --shell-line: #D8DCDB; --shell-bg: #F5F6F5; --windshield: rgba(0,168,159,0.20);
        --chip-bg: #EFF1F0; --price-bg: rgba(0,168,159,0.06); --hover-line: rgba(0,124,118,0.5); --danger-line: rgba(198,40,40,0.35);
        --warn-bg: #FDECEC; --warn-line: rgba(198,40,40,0.25); --warn-text: #8E1C1C;
        --info-bg: #E6F5F3; --info-line: rgba(0,124,118,0.30); --info-text: #1D3B39;
        --neutral-bg: #EFF1F0; --neutral-line: rgba(18,22,22,0.10);
        --amber-bg: #FFF4DB; --amber-line: rgba(138,90,0,0.30); --amber-text: #8A5A00;
        --them-bg: #EFF1F0; --failed-bg: #FDECEC;
        --nav-bg: #EFF1F0; --nav-line: #D8DCDB; --nav-hover: rgba(0,124,118,0.45);
        --ac-line: rgba(18,22,22,0.10); --ac-bg: #FFFFFF; --ac-text: #23272A;
        --sel-line: rgba(0,124,118,0.55);
        --star-off: #687176; --star-on: #8A5A00; --call: #007C76; --callmsg: #4B5357;
        --ssbar-bg: rgba(255,255,255,0.9); --ssbar-line: rgba(18,22,22,0.10); --ssbar-tab: #5B6368; --ssbar-strong: #121416; --ssbar-signin: #23272A; --ssbar-btnline: #D8DCDB; --ssbar-panel: #FFFFFF; --ssbar-hover: rgba(18,22,22,0.06); --ssbar-shadow: rgba(0,0,0,0.12); --ssbar-eat: #00A89F; --ssmenu-btnbg: #EFF1F0; --ssmenu-ini: #007C76; --ssmenu-cap: #687176; --ssmenu-danger: #C62828;
      }
      input::placeholder, textarea::placeholder { color: var(--cap); }
    }

    /* Styling lifted wholesale from trips.html so the driver console feels
       like the same product as the funnel that created the ride. */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 32px 20px 48px;
    }
    a { color: var(--link); text-decoration: none; }

    /* Desktop is a console, not a phone column (Justin, 2026-08-28). */
    .wrap { width: 100%; max-width: 440px; }
    /* Desktop: the 440px mobile column reads cramped on a laptop. */
    @media (min-width: 720px) { .wrap { max-width: 700px; } }
    /* Collapsible "Past rides" header. */
    .pasthead {
      display: flex; align-items: center; gap: 10px; width: 100%;
      background: none; border: none; cursor: pointer; font-family: inherit;
      color: var(--sub); font-size: 14px; font-weight: 700; letter-spacing: 1.2px;
      text-transform: uppercase; padding: 20px 2px 10px; text-align: left;
    }
    .pasthead:hover { color: var(--subhover); }
    .pasthead .caret { color: var(--link); font-size: 12px; }
    .pasthead .pastcount {
      background: var(--count-bg); color: var(--sub); border-radius: 999px;
      padding: 1px 8px; font-size: 11px; letter-spacing: 0;
    }

    .brand { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 28px; }

    .card {
      background: linear-gradient(180deg, var(--card-a) 0%, var(--card-b) 100%);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      margin-bottom: 20px;
    }
    .card .eyebrow {
      font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;
      color: var(--sub); margin-bottom: 12px;
    }
    .route { font-size: 20px; font-weight: 700; letter-spacing: -0.3px; line-height: 1.3; }
    /* Exact pickup/dropoff, opened-ride view only. */
    .addr { font-size: 13.5px; color: var(--sub); line-height: 1.5; margin-top: 6px; }
    .meta { font-size: 14px; color: var(--sub2); margin-top: 6px; }

    h1 { font-size: 21px; font-weight: 800; letter-spacing: -0.3px; margin-bottom: 6px; }
    h2 { font-size: 14px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: var(--sub); margin: 26px 0 12px; }
    p.sub { font-size: 14px; color: var(--sub2); line-height: 1.5; margin-bottom: 18px; }
    label { display: block; font-size: 12px; color: var(--sub); letter-spacing: 0.3px; margin-bottom: 6px; text-transform: uppercase; }
    input, textarea {
      width: 100%; background: var(--input-bg); border: 1px solid var(--input-line);
      border-radius: 12px; padding: 14px 16px; color: var(--text); font-size: 16px; margin-bottom: 14px;
      outline: none; transition: border-color 0.15s; font-family: inherit;
    }
    input:focus, textarea:focus { border-color: var(--focus); }
    input:disabled, textarea:disabled { opacity: 0.5; }
    textarea { resize: vertical; min-height: 88px; }
    .codeinput { text-align: center; letter-spacing: 10px; font-size: 22px; font-weight: 700; }
    button.primary {
      width: 100%; background: var(--teal); color: var(--on-teal); border: none; border-radius: 12px;
      padding: 15px; font-size: 16px; font-weight: 700; cursor: pointer; transition: opacity 0.15s;
      font-family: inherit;
    }
    button.primary:disabled { opacity: 0.5; cursor: default; }
    button.outline {
      width: 100%; background: none; color: var(--text); border: 1px solid var(--outline-line);
      border-radius: 12px; padding: 14px; font-size: 15px; font-weight: 700; cursor: pointer;
      font-family: inherit;
    }
    button.outline:disabled { opacity: 0.5; cursor: default; }
    .linkbtn {
      background: none; border: none; color: var(--link); font-size: 14px; font-weight: 600;
      cursor: pointer; padding: 0; font-family: inherit;
    }
    .linkbtn:disabled { color: var(--cap); cursor: default; }
    .linkbtn.danger { color: var(--err); }
    /* "This is a rental car" on the car form (2026-10-12): it had no styles
       and showed as a bare browser button. A checkbox row instead; the box
       glyph shows the state and role=switch carries it for screen readers. */
    .disc {
      display: inline-flex; align-items: center; gap: 8px; background: none; border: 0;
      padding: 6px 0; font-family: inherit; font-size: 15px; font-weight: 600; color: var(--text2);
      cursor: pointer; text-align: left;
    }
    .disc .caret { font-size: 20px; line-height: 1; color: var(--sub); }
    .disc[aria-checked="true"] .caret, .disc:hover .caret { color: var(--link); }
    .disc:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 6px; }
    /* "Message all riders" quick picks (0346): tap to fill the box. */
    .qpicks { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 10px; }
    .qpick {
      border: 1px solid var(--soft-line); background: var(--soft-bg); color: var(--link-deep);
      border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 700; cursor: pointer;
      font-family: inherit;
    }
    .qpick:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
    /* "Sent to every booked rider on this drive" under a group message. */
    .bcast { font-size: 12px; color: var(--cap); margin: 0 4px 6px; text-align: right; }
    .bcast.them { text-align: left; }
    .rowlinks { display: flex; justify-content: space-between; margin-top: 4px; font-size: 14px; }
    .msg { font-size: 14px; line-height: 1.5; margin-top: 12px; }
    .msg.err { color: var(--err); }
    .msg.ok { color: var(--ok); }
    .hidden { display: none !important; }
    .center { text-align: center; }
    .icon { font-size: 44px; margin-bottom: 12px; }
    .hint { font-size: 12px; color: var(--sub); margin: -8px 0 14px; line-height: 1.5; }

    .spinner {
      width: 28px; height: 28px; margin: 0 auto 16px;
      border: 3px solid var(--spin-track); border-top-color: var(--spin-top);
      border-radius: 50%; animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .signedin { text-align: center; font-size: 12px; color: var(--cap); margin-top: 14px; }
    .signedin button { font-size: 12px; }
    .legal { text-align: center; margin-top: 28px; font-size: 12px; color: var(--cap); line-height: 1.6; }
    .legal a { color: var(--sub); }

    /* Status pills - booking states plus the driver-side "action needed". */
    .pill {
      display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.8px;
      text-transform: uppercase; border-radius: 100px; padding: 5px 11px;
      border: 1px solid transparent;
    }
    .pill.pending   { background: var(--pend-bg); border-color: var(--pend-line);  color: var(--pend-text); }
    .pill.confirmed { background: var(--conf-bg); border-color: var(--conf-line);  color: var(--conf-text); }
    .pill.cancelled { background: var(--canc-bg); border-color: var(--canc-line); color: var(--canc-text); }
    .pill.completed { background: var(--done-bg); border-color: var(--done-line);color: var(--done-text); }
    .pill.action    { background: var(--pend-bg); border-color: var(--pend-line2);   color: var(--pend-text); }

    /* ── Dashboard header ────────────────────────────────────────────────
       The console opens on a state-of-play strip rather than a raw list —
       the Airbnb-host / Rover pattern. Every figure here is computed from
       rides already loaded; nothing is a placeholder. */
    .dashhead { margin-bottom: 20px; }
    .dashhead h1 { font-size: 27px; font-weight: 800; letter-spacing: -0.6px; margin-bottom: 4px; }
    .dashhead .said { font-size: 14.5px; color: var(--sub); }
    .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 22px; }
    @media (min-width: 720px) { .stats { grid-template-columns: repeat(4, 1fr); gap: 12px; } }
    .stat {
      background: var(--stat-bg); border: 1px solid var(--stat-line); border-radius: 14px;
      padding: 14px 16px; text-align: left;
      /* The unread tile is a <button>, and buttons don't inherit the page's
         text colour — the "0" rendered near-black on the dark tile (Justin,
         2026-09-04: "black on grey is not good on the very right"). */
      color: var(--stat-text); font: inherit;
    }
    .stat .n { color: var(--stat-text); }
    .stat .n { font-size: 25px; font-weight: 800; letter-spacing: -0.6px; line-height: 1.1;
      font-variant-numeric: tabular-nums; }
    .stat .k { font-size: 12px; color: var(--stat-k); margin-top: 4px; font-weight: 600; }
    /* Only a stat that needs the driver to DO something takes colour. */
    .stat.act { border-color: var(--stat-act-line); background: var(--stat-act-bg); }
    .stat.act .n { color: var(--amber); }
    .stat.act .k { color: var(--stat-act-k); }
    .stat.link { cursor: pointer; font-family: inherit; width: 100%; }
    .stat.link:hover { border-color: var(--teal-hover); }

    /* Ride list rows are buttons - navigation is pushState. */
    .ridecard {
      display: block; width: 100%; text-align: left; font-family: inherit;
      background: linear-gradient(180deg, var(--card-a) 0%, var(--card-b) 100%);
      border: 1px solid var(--line); border-radius: 16px;
      padding: 16px 18px; margin-bottom: 12px; cursor: pointer; color: var(--text);
      transition: border-color 0.15s, transform 0.15s;
    }
    .ridecard:hover { border-color: var(--ride-hover); transform: translateY(-1px); }
    .ridecard.attention { border-color: var(--attn-line); }
    .ridecard .cardtop { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
    .ridecard .cardroute { font-size: 17px; font-weight: 700; letter-spacing: -0.25px; line-height: 1.3; }
    /* The departure date is the #1 thing distinguishing one ride card from
       the next (Justin, 2026-08-28) — teal + larger so it scans instantly. */
    .ridecard .cardmeta { font-size: 15px; font-weight: 600; color: var(--link); margin-top: 6px; }
    .ridecard .cardfoot {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--hair);
      font-size: 14px; color: var(--sub);
    }
    /* Status chip. Semantic colour, separate from the teal accent. */
    .chip {
      display: inline-flex; align-items: center; gap: 5px; flex: none;
      padding: 4px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 700;
      letter-spacing: 0.2px; white-space: nowrap;
    }
    .chip.act { background: var(--chip-act-bg); color: var(--amber); }
    .chip.full { background: var(--chip-full-bg); color: var(--chip-full-text); }
    .chip.open { background: var(--chip-open-bg); color: var(--sub); }
    .chip.off { background: var(--chip-off-bg); color: var(--chip-off-text); }
    /* ID verified (0314): teal because it is a feature, not a status. Sits
       inline after the rider's name and wraps under it on a narrow phone. */
    .chip.idv { background: var(--idv-bg); color: var(--link-deep); font-size: 12px;
      padding: 3px 9px 3px 7px; gap: 4px; }
    .chip.idv svg { width: 12px; height: 12px; flex: none; }
    /* Rider ♀ (0376): the app's pink circle, inline. */
