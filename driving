    // -- Car & license page (2026-08-28): multi-vehicle + photos + insurance
    //    + license status/re-upload. Profile basics moved to /account. -------
    async function dlDownscale(file, max) {
      const url = URL.createObjectURL(file);
      try {
        const img = await new Promise((res, rej) => {
          const i = new Image();
          i.onload = () => res(i); i.onerror = () => rej(new Error('decode'));
          i.src = url;
        });
        const MAX = max || 1600;
        const scale = Math.min(1, MAX / Math.max(img.naturalWidth, img.naturalHeight));
        const w = Math.max(1, Math.round(img.naturalWidth * scale));
        const h = Math.max(1, Math.round(img.naturalHeight * scale));
        const c = document.createElement('canvas');
        c.width = w; c.height = h;
        c.getContext('2d').drawImage(img, 0, 0, w, h);
        const blob = await new Promise((res) => c.toBlob(res, 'image/jpeg', 0.85));
        if (!blob) throw new Error('encode');
        return blob;
      } finally { URL.revokeObjectURL(url); }
    }
    function pickFile(accept) {
      return new Promise((resolve) => {
        const i = document.createElement('input');
        i.type = 'file'; i.accept = accept || 'image/*';
        i.addEventListener('change', () => resolve(i.files && i.files[0] ? i.files[0] : null));
        i.click();
      });
    }

