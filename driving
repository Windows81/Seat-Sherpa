<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your rides &mdash; Seat Sherpa</title>

  <!-- DRIVER WEB CONSOLE (2026-08-22) - the driver-side twin of /trips.
       Transactional, signed-in-only, and DELIBERATELY UNLINKED. Nothing on
       index/rides/ride/book/post, the sitemap, robots.txt, or any app screen
       points here - a driver reaches it by typing the URL (or from the /post
       success email, if we ever add one). noindex is the belt to that
       suspenders: this page renders pending payment requests, rider chats and
       the check-in surface that releases escrow - it must never land in a
       search index even if someone pastes the link somewhere public. -->
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="#0E0E10" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- NO marketing pixels here, same reasoning as trips.html: this is
       post-signup account plumbing, not a conversion funnel. -->

  <style>
    /* Styling lifted wholesale from trips.html so the driver console feels
       like the same product as the funnel that created the ride. */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: #0E0E10;
      color: #fff;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 32px 20px 48px;
    }
    a { color: #00D4C8; text-decoration: none; }

    /* Desktop is a console, not a phone column (Justin, 2026-08-28). */
    .wrap { width: 100%; max-width: 440px; }
    /* Desktop: the 440px mobile column reads cramped on a laptop. */
    @media (min-width: 720px) { .wrap { max-width: 700px; } }
    @media (min-width: 1100px) { .wrap { max-width: 980px; } }
    /* Ride list goes two-up once there's room — a single 980px column of
       full-width cards is just a wider ribbon (Justin, 2026-08-28). */
    @media (min-width: 1100px) {
      .ridegrid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: start; }
      .ridegrid > .entry { margin-bottom: 0; }
    }
    /* Collapsible "Past rides" header. */
    .pasthead {
      display: flex; align-items: center; gap: 10px; width: 100%;
      background: none; border: none; cursor: pointer; font-family: inherit;
      color: #adadb8; font-size: 13px; font-weight: 700; letter-spacing: 1.2px;
      text-transform: uppercase; padding: 20px 2px 10px; text-align: left;
    }
    .pasthead:hover { color: #cfcfd6; }
    .pasthead .caret { color: #00D4C8; font-size: 12px; }
    .pasthead .pastcount {
      background: rgba(255,255,255,0.08); color: #adadb8; border-radius: 999px;
      padding: 1px 8px; font-size: 11px; letter-spacing: 0;
    }

    .brand { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 28px; }

    .card {
      background: linear-gradient(180deg, #1a1a1d 0%, #141416 100%);
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 18px;
      padding: 24px;
      margin-bottom: 20px;
    }
    .card .eyebrow {
      font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;
      color: #adadb8; margin-bottom: 12px;
    }
    .route { font-size: 20px; font-weight: 700; letter-spacing: -0.3px; line-height: 1.3; }
    /* Exact pickup/dropoff, opened-ride view only. */
    .addr { font-size: 13.5px; color: #adadb8; line-height: 1.5; margin-top: 6px; }
    .meta { font-size: 14px; color: #b9b9c6; margin-top: 6px; }

    h1 { font-size: 21px; font-weight: 800; letter-spacing: -0.3px; margin-bottom: 6px; }
    h2 { font-size: 13px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: #adadb8; margin: 26px 0 12px; }
    p.sub { font-size: 14px; color: #b9b9c6; line-height: 1.5; margin-bottom: 18px; }
    label { display: block; font-size: 12px; color: #adadb8; letter-spacing: 0.3px; margin-bottom: 6px; text-transform: uppercase; }
    input, textarea {
      width: 100%; background: #0E0E10; border: 1px solid rgba(255,255,255,0.14);
      border-radius: 12px; padding: 14px 16px; color: #fff; font-size: 16px; margin-bottom: 14px;
      outline: none; transition: border-color 0.15s; font-family: inherit;
    }
    input:focus, textarea:focus { border-color: #00D4C8; }
    input:disabled, textarea:disabled { opacity: 0.5; }
    textarea { resize: vertical; min-height: 88px; }
    .codeinput { text-align: center; letter-spacing: 10px; font-size: 22px; font-weight: 700; }
    button.primary {
      width: 100%; background: #00D4C8; color: #04201e; border: none; border-radius: 12px;
      padding: 15px; font-size: 16px; font-weight: 700; cursor: pointer; transition: opacity 0.15s;
      font-family: inherit;
    }
    button.primary:disabled { opacity: 0.5; cursor: default; }
    button.outline {
      width: 100%; background: none; color: #fff; border: 1px solid rgba(255,255,255,0.22);
      border-radius: 12px; padding: 14px; font-size: 15px; font-weight: 700; cursor: pointer;
      font-family: inherit;
    }
    button.outline:disabled { opacity: 0.5; cursor: default; }
    .linkbtn {
      background: none; border: none; color: #00D4C8; font-size: 14px; font-weight: 600;
      cursor: pointer; padding: 0; font-family: inherit;
    }
    .linkbtn:disabled { color: #8f8f98; cursor: default; }
    .linkbtn.danger { color: #ff8a8a; }
    .rowlinks { display: flex; justify-content: space-between; margin-top: 4px; font-size: 14px; }
    .msg { font-size: 14px; line-height: 1.5; margin-top: 12px; }
    .msg.err { color: #ff8a8a; }
    .msg.ok { color: #4ade80; }
    .hidden { display: none !important; }
    .center { text-align: center; }
    .icon { font-size: 44px; margin-bottom: 12px; }
    .hint { font-size: 12px; color: #adadb8; margin: -8px 0 14px; line-height: 1.5; }

    .spinner {
      width: 28px; height: 28px; margin: 0 auto 16px;
      border: 3px solid rgba(255,255,255,0.15); border-top-color: #00D4C8;
      border-radius: 50%; animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .signedin { text-align: center; font-size: 12px; color: #8f8f98; margin-top: 14px; }
    .signedin button { font-size: 12px; }
    .legal { text-align: center; margin-top: 28px; font-size: 12px; color: #8f8f98; line-height: 1.6; }
    .legal a { color: #adadb8; }

    /* Status pills - booking states plus the driver-side "action needed". */
    .pill {
      display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.8px;
      text-transform: uppercase; border-radius: 100px; padding: 5px 11px;
      border: 1px solid transparent;
    }
    .pill.pending   { background: #24200d; border-color: rgba(255,193,7,0.35);  color: #ffc94a; }
    .pill.confirmed { background: #0d1f1e; border-color: rgba(0,212,200,0.35);  color: #00D4C8; }
    .pill.cancelled { background: #241416; border-color: rgba(255,138,138,0.3); color: #ff8a8a; }
    .pill.completed { background: #16181c; border-color: rgba(255,255,255,0.15);color: #b9b9c6; }
    .pill.action    { background: #24200d; border-color: rgba(255,193,7,0.5);   color: #ffc94a; }

    /* ── Dashboard header ────────────────────────────────────────────────
       The console opens on a state-of-play strip rather than a raw list —
       the Airbnb-host / Rover pattern. Every figure here is computed from
       rides already loaded; nothing is a placeholder. */
    .dashhead { margin-bottom: 20px; }
    .dashhead h1 { font-size: 27px; font-weight: 800; letter-spacing: -0.6px; margin-bottom: 4px; }
    .dashhead .said { font-size: 14.5px; color: #adadb8; }
    .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 22px; }
    @media (min-width: 720px) { .stats { grid-template-columns: repeat(4, 1fr); gap: 12px; } }
    .stat {
      background: #141417; border: 1px solid #232329; border-radius: 14px;
      padding: 14px 16px; text-align: left;
    }
    .stat .n { font-size: 25px; font-weight: 800; letter-spacing: -0.6px; line-height: 1.1;
      font-variant-numeric: tabular-nums; }
    .stat .k { font-size: 12px; color: #a3a3ae; margin-top: 4px; font-weight: 600; }
    /* Only a stat that needs the driver to DO something takes colour. */
    .stat.act { border-color: rgba(255,184,77,0.45); background: #191509; }
    .stat.act .n { color: #FFB84D; }
    .stat.act .k { color: #e8c88c; }
    .stat.link { cursor: pointer; font-family: inherit; width: 100%; }
    .stat.link:hover { border-color: rgba(0,212,200,0.45); }

    /* Ride list rows are buttons - navigation is pushState. */
    .ridecard {
      display: block; width: 100%; text-align: left; font-family: inherit;
      background: linear-gradient(180deg, #1a1a1d 0%, #141416 100%);
      border: 1px solid rgba(255,255,255,0.10); border-radius: 16px;
      padding: 16px 18px; margin-bottom: 12px; cursor: pointer; color: #fff;
      transition: border-color 0.15s, transform 0.15s;
    }
    .ridecard:hover { border-color: rgba(0,212,200,0.4); transform: translateY(-1px); }
    .ridecard.attention { border-color: rgba(255,193,7,0.45); }
    .ridecard .cardtop { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
    .ridecard .cardroute { font-size: 17px; font-weight: 700; letter-spacing: -0.25px; line-height: 1.3; }
    /* The departure date is the #1 thing distinguishing one ride card from
       the next (Justin, 2026-08-28) — teal + larger so it scans instantly. */
    .ridecard .cardmeta { font-size: 15px; font-weight: 600; color: #00D4C8; margin-top: 6px; }
    .ridecard .cardfoot {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.07);
      font-size: 13px; color: #adadb8;
    }
    /* Status chip. Semantic colour, separate from the teal accent. */
    .chip {
      display: inline-flex; align-items: center; gap: 5px; flex: none;
      padding: 4px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 700;
      letter-spacing: 0.2px; white-space: nowrap;
    }
    .chip.act { background: rgba(255,184,77,0.16); color: #FFB84D; }
    .chip.full { background: rgba(61,220,151,0.15); color: #3ddc97; }
    .chip.open { background: rgba(255,255,255,0.07); color: #adadb8; }
    .chip.off { background: rgba(255,255,255,0.05); color: #8e8e99; }
    /* Seat fill, read at a glance — filled pips are sold seats. BlaBlaCar
       shows seat icons for the same reason: "2 of 3" is a sentence, pips
       are a picture. */
    .seatpips { display: inline-flex; align-items: center; gap: 4px; }
    .seatpips i {
      width: 9px; height: 9px; border-radius: 50%; display: block;
      background: rgba(255,255,255,0.14);
    }
    .seatpips i.on { background: #00D4C8; }
    .fillrow { display: flex; align-items: center; gap: 9px; }

    .paxrow { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; object-position: 50% 25%; background: #0E0E10; border: 1px solid rgba(255,255,255,0.12); flex-shrink: 0; }
    .avatar.ph { display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; color: #00D4C8; }
    .paxname { font-size: 15px; font-weight: 700; }
    .paxsub { font-size: 12px; color: #adadb8; margin-top: 2px; }

    .bookingbox {
      border: 1px solid rgba(255,255,255,0.10); border-radius: 14px;
      padding: 14px 16px; margin-bottom: 12px; background: rgba(255,255,255,0.02);
    }
    .bookingbox.request { border-color: rgba(255,193,7,0.4); background: #17150c; }
    .bookingtop { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .ridernote {
      background: #0E0E10; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px;
      padding: 10px 12px; font-size: 13px; color: #b9b9c6; line-height: 1.5; margin-top: 10px;
      white-space: pre-wrap; overflow-wrap: anywhere;
    }
    .actrow { display: flex; gap: 10px; margin-top: 12px; }
    .actrow button { flex: 1; padding: 12px; font-size: 14px; }
    .rowhint { font-size: 12px; color: #adadb8; margin-top: 8px; line-height: 1.5; }
    /* Seats card (2026-09-03): the app's driver seat grid, on the web. One
       tile per passenger seat; open = teal, closed = dashed + dim, held by a
       booking/request = gold and not tappable. The driver tile is decoration. */
    .seatgrid { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
    .seatrow { display: flex; gap: 8px; }
    .seattile {
      flex: 1; min-width: 0; font: inherit; color: #E8E8EC; text-align: center;
      background: #18181C; border: 1px solid #2C2C38; border-radius: 12px;
      padding: 10px 6px; cursor: pointer; transition: transform .12s, opacity .12s;
    }
    .seattile:active { transform: scale(.97); }
    .seattile .sl { font-size: 11px; letter-spacing: .5px; text-transform: uppercase; color: #8888A8; }
    .seattile .sp { font-weight: 700; font-size: 15px; margin-top: 2px; font-variant-numeric: tabular-nums; }
    .seattile .ss { font-size: 12px; margin-top: 4px; color: #C0C0D0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .seattile.open { border-color: rgba(0,212,200,.45); background: rgba(0,212,200,.08); }
    .seattile.open .ss { color: #00D4C8; }
    .seattile.closed { opacity: .55; border-style: dashed; }
    .seattile.held { border-color: rgba(255,214,10,.4); background: rgba(255,214,10,.08); cursor: default; }
    .seattile.held .ss { color: #FFD60A; }
    .seattile.driver { opacity: .75; cursor: default; }
    /* Seats card v2 (2026-09-03): portrait car on the left (the booking
       page's cabin chrome — wheels flush on the sides, mirrors up front),
       controls on the right. Stacks on narrow screens. */
    /* Centered as a pair; the car is a portrait (longer than wide) shell
       (Justin, 2026-09-04: "the car should be longer than it is wide, and we
       should center this"). */
    .seatlayout { display: flex; gap: 28px; align-items: flex-start; justify-content: center; margin-top: 14px; }
    .carcol { flex: 0 0 auto; width: 250px; }
    .chipcol { flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding-top: 4px; }
    @media (max-width: 640px) { .seatlayout { flex-direction: column; align-items: center; } .carcol { width: 100%; max-width: 250px; } }
    .carwrap { position: relative; width: 100%; margin: 6px auto 12px; }
    .carshell { min-height: 400px; justify-content: space-evenly; }
    .carwheel { position: absolute; width: 14px; height: 62px; border-radius: 7px; background: #26262e; z-index: 0; }
    .carwheel.wfl { left: -7px; top: 58px; } .carwheel.wfr { right: -7px; top: 58px; }
    .carwheel.wrl { left: -7px; bottom: 48px; } .carwheel.wrr { right: -7px; bottom: 48px; }
    .carmirror { position: absolute; width: 18px; height: 9px; border-radius: 4px 4px 2px 2px; background: #2f2f38; z-index: 2; top: 36px; }
    .carmirror.mml { left: -14px; transform: rotate(-14deg); } .carmirror.mmr { right: -14px; transform: rotate(14deg); }
    .carshell { position: relative; z-index: 1; border: 2px solid #2a2a33; border-radius: 46px 46px 30px 30px; background: #101014; padding: 38px 14px 32px; display: flex; flex-direction: column; gap: 18px; align-items: center; }
    .carrow { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; width: 100%; }
    .carrow.three { grid-template-columns: 1fr 1fr 1fr; }
    .carshell .seattile { padding: 12px 6px; min-height: 86px; border-radius: 12px; }
    .carshell .seattile .sl { font-size: 11px; letter-spacing: .5px; }
    .carshell .seattile .ss { font-size: 12px; margin-top: 4px; }
    .carshell .seattile .sp { font-size: 13px; }
    .windshield { width: 86%; height: 6px; border-radius: 999px; background: rgba(0,212,200,.14); }
    .rowdiv { width: 60%; height: 1px; background: #2C2C38; }
    .drvbadge { width: 26px; height: 26px; border-radius: 50%; background: #2C2C38; color: #E8E8EC; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 3px; font-size: 12px; }
    .seatchip { display: inline-flex; width: auto; max-width: 100%; align-items: center; gap: 8px; border: 1px solid #2C2C38; border-radius: 999px; padding: 4px 5px 4px 12px; background: #18181C; font-size: 12.5px; }
    .seatchip .nm { font-weight: 700; color: #E8E8EC; }
    .seatchip .st { color: #8888A8; white-space: nowrap; }
    .seatchip.open .st { color: #00D4C8; }
    .seatchip.held { border-color: rgba(255,214,10,.35); } .seatchip.held .st { color: #FFD60A; }
    .seatchip.closed { opacity: .75; }
    .seatchip.price { border-color: rgba(0,212,200,.45); background: rgba(0,212,200,.06); }
    .seatchip.price .val { font-weight: 800; font-size: 14px; color: #E8E8EC; }
    .chipact { font: inherit; font-size: 11px; font-weight: 700; color: #00D4C8; background: transparent; border: 1px solid rgba(0,212,200,.45); border-radius: 999px; padding: 3px 9px; cursor: pointer; margin: 0; }
    .chipact:disabled { opacity: .5; cursor: default; }
    .priceedit { display: flex; gap: 8px; align-items: center; margin: -2px 0 4px; }
    .priceedit .cur { color: #8888A8; }
    .priceedit input { width: 100px; margin: 0; }
    .priceedit .primary { width: auto; padding: 10px 18px; margin: 0; }
    .seatsum { font-size: 12px; color: #8888A8; padding: 2px 4px 4px; }
    .managerow .linkbtn { border: 1px solid #2C2C38; border-radius: 999px; padding: 8px 14px; background: #18181C; color: #E8E8EC; }
    .managerow .linkbtn:hover { border-color: rgba(0,212,200,.5); color: #00D4C8; }
    .managerow .linkbtn.danger { color: #ff8a8a; border-color: rgba(255,138,138,.35); }
    .seattile:disabled { cursor: default; }
    .seattile.saving { opacity: .6; }
    .rowmsg { font-size: 13px; line-height: 1.5; margin-top: 10px; }
    .rowmsg.err { color: #ff8a8a; }
    .rowmsg.ok { color: #4ade80; }

    .banner { border-radius: 14px; padding: 16px 18px; margin-bottom: 20px; font-size: 14px; line-height: 1.55; }
    .banner.warn { background: #241416; border: 1px solid rgba(255,138,138,0.3); color: #ffb3b3; }
    .banner.info { background: #141d1c; border: 1px solid rgba(0,212,200,0.3); color: #cfe9e7; }
    .banner.neutral { background: #16181c; border: 1px solid rgba(255,255,255,0.12); color: #b9b9c6; }
    .banner.amber { background: #24200d; border: 1px solid rgba(255,193,7,0.35); color: #ffe1a3; }
    .banner strong { color: #fff; }
    .banner button { margin-top: 12px; }

    .backrow { margin-bottom: 14px; }

    /* Check-in card - the money moment on this page. */
    .checkin { border-color: rgba(0,212,200,0.35); }
    .pinwrap { display: flex; gap: 10px; align-items: flex-start; margin-top: 4px; }
    .pinwrap input { text-align: center; letter-spacing: 8px; font-size: 22px; font-weight: 700; margin-bottom: 0; }
    .pinwrap button { width: auto; flex-shrink: 0; padding: 14px 18px; }
    .checkedrow { display: flex; align-items: center; justify-content: space-between; font-size: 14px; color: #b9b9c6; margin-top: 10px; }
    .checkedrow .ok { color: #4ade80; font-weight: 700; }

    /* Chat (trips.html verbatim, sides swapped in JS) */
    .thread {
      max-height: 58vh; overflow-y: auto; padding: 4px 2px 6px;
      display: flex; flex-direction: column; gap: 8px;
    }
    .brow { display: flex; }
    .brow.me { justify-content: flex-end; }
    .brow.them { justify-content: flex-start; }
    .brow.sys { justify-content: center; }
    .bubble {
      max-width: 78%; border-radius: 16px; padding: 10px 14px; font-size: 15px; line-height: 1.45;
      white-space: pre-wrap; overflow-wrap: anywhere;
    }
    .brow.me .bubble { background: #00D4C8; color: #04201e; border-bottom-right-radius: 5px; }
    .brow.them .bubble { background: #1f1f23; color: #fff; border-bottom-left-radius: 5px; }
    .brow.sys .bubble { background: none; color: #adadb8; font-size: 13px; text-align: center; max-width: 92%; }
    .bubble.sending { opacity: 0.55; }
    .bubble.failed { background: #3a1c1f; color: #ffb3b3; }
    .btime { font-size: 10px; color: #8f8f98; margin: 2px 4px 0; text-align: right; }
    .brow.them + .btime { text-align: left; }
    .composer { display: flex; gap: 10px; align-items: flex-end; margin-top: 14px; }
    .composer textarea { min-height: 46px; max-height: 140px; margin-bottom: 0; padding: 12px 14px; font-size: 15px; }
    .composer button { width: auto; flex-shrink: 0; padding: 13px 18px; }
    .emptythread { text-align: center; color: #adadb8; font-size: 13px; line-height: 1.6; padding: 22px 8px; }
    .consolenav {
      display: flex; gap: 8px; flex-wrap: wrap; justify-content: center;
      margin: 14px 0 4px;
    }
    .consolenav a, .consolenav button {
      font-family: inherit; font-size: 13.5px; font-weight: 600;
      color: #b9b9c6; text-decoration: none; background: #17171d;
      border: 1px solid #2a2a33; border-radius: 999px; padding: 8px 16px;
      cursor: pointer;
    }
    .consolenav a:hover, .consolenav button:hover { border-color: rgba(0,212,200,0.4); color: #fff; }
    .rolepair { display: inline-flex; gap: 6px; }
    .consolenav a.rolepill { border-color: rgba(0,212,200,0.4); color: #00D4C8; font-weight: 700; }
    .consolenav a.rolepill.active { background: #00D4C8; color: #04201e; border-color: #00D4C8; }
    .consolenav a.rolepill.active:hover { color: #04201e; }
  </style>
</head>
<body>
  <!-- Shared console app bar (ss-appbar.js), body-level for full bleed. -->
  <div id="ssAppBar"></div>
  <div class="wrap">

    <!-- STATES -->

    <div class="card center" id="stLoading">
      <div class="spinner"></div>
      <h1>Loading&hellip;</h1>
      <p class="sub" style="margin-bottom:0;">One moment.</p>
    </div>

    <!-- Boot failure: the shared session module didn't load. Honest, not blank. -->
    <div class="card center hidden" id="stBoot">
      <div class="icon">&#9888;&#65039;</div>
      <h1>This page didn't finish loading</h1>
      <p class="sub" style="margin-bottom:0;">Refresh to try again. If it keeps happening, email <a href="mailto:support@seatsherpa.app">support@seatsherpa.app</a> and we'll sort out your ride.</p>
    </div>

    <!-- Signed out - a driver checking requests from a laptop lands here. -->
    <div class="card hidden" id="stEmail">
      <div class="eyebrow">Your rides</div>
      <h1>Sign in to manage your rides</h1>
      <p class="sub">Enter the email you posted your ride with and we'll send a sign-in code &mdash; no password needed.</p>
      <label for="email">Email</label>
      <input id="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" />
      <button class="primary" id="emailBtn">Email me a code</button>
      <div class="msg err hidden" id="emailMsg"></div>
    </div>

    <div class="card hidden" id="stCode">
      <div class="eyebrow">Your rides &middot; Verify email</div>
      <h1>Enter the code we emailed you</h1>
      <p class="sub">We sent it to <strong id="codeEmailEcho"></strong>. It can take a minute &mdash; check spam too.</p>
      <input id="emailCode" class="codeinput" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;" />
      <button class="primary" id="codeBtn">Verify</button>
      <div class="rowlinks">
        <button class="linkbtn" id="codeResend">Resend code</button>
        <button class="linkbtn" id="codeChangeEmail">Use a different email</button>
      </div>
      <div class="msg err hidden" id="codeMsg"></div>
    </div>

    <!-- List / ride / chat are JS-built so every string from the database goes
         through textContent. See the DOM helpers in the module below. -->
    <div class="hidden" id="stList"><div id="listBody"></div></div>
    <div class="hidden" id="stWallet"><div id="walletBody"></div></div>
    <div class="hidden" id="stAccount"><div id="accountBody"></div></div>
    <div class="hidden" id="stRide"><div id="rideBody"></div></div>
    <div class="hidden" id="stChat"><div id="chatBody"></div></div>

    <div class="card center hidden" id="stNotFound">
      <div class="icon">&#128269;</div>
      <h1>We couldn't find that ride</h1>
      <!-- Identical copy for "no such ride" and "not your ride" - same
           non-oracle reasoning as trips.html. -->
      <p class="sub">That ride isn't on this account. Sign in with the email you posted it with, or head back to all your rides.</p>
      <button class="outline" id="nfAllRides">See all my rides</button>
      <div class="signedin" id="nfSignedIn">Signed in as <span id="nfEmail"></span> &middot; <button class="linkbtn" id="nfSignOut">Not you?</button></div>
    </div>

    <div class="card center hidden" id="stError">
      <div class="icon">&#128225;</div>
      <h1>Couldn't load your rides</h1>
      <p class="sub" id="errSub">Something went wrong on our end. Check your connection and try again.</p>
      <button class="primary" id="errRetry">Try again</button>
    </div>

    <p class="legal">
      Seat Sherpa is a cost-sharing carpool marketplace, not a ride-hail service.<br />
      <a href="/terms">Terms</a> &middot; <a href="/privacy">Privacy</a> &middot; <a href="mailto:support@seatsherpa.app">support@seatsherpa.app</a>
    </p>
  </div>

  <script src="/js/ss-menu.js"></script>
  <script src="/js/ss-appbar.js"></script>
  <script>
    // Wallet and Car & license switch in-page state rather than navigating,
    // so they ride in the bar as `extra` buttons. The module below binds the
    // handlers by id once its render functions exist.
    if (window.SS_APPBAR) SS_APPBAR.mount({
      active: 'driving', id: 'consoleNav', startHidden: true,
      extra: [
        { label: 'Wallet', id: 'navWallet', onClick: function () {} },
        { label: 'Car & license', id: 'navAccount', onClick: function () {} },
      ],
    });
  </script>
  <script src="/js/ss-stops.js"></script>
  <script type="module">
    // driving.html - DRIVER web console, everything AFTER "your ride is posted".
    //
    // /driving                          -> the driver's rides
    // /driving?ride=<id>                -> one ride: requests, riders, check-in, complete
    // /driving?ride=<id>&chat=<bookingId> -> chat with one rider
    //
    // WHY this page exists: /post (built 2026-08-21) lets a driver post from a
    // browser, but every action AFTER a rider appears - accept, decline, chat,
    // check riders in, mark complete - lived only in the app. An app-less
    // driver's pending requests rotted until the card hold expired. This page
    // closes that loop.
    //
    // THE CONTRACT: services/bookings.ts is the source of truth for every
    // action here. Each handler below mirrors its app twin - the same server
    // call, the same conditional status guard, and the SAME follow-up side
    // effects (push + email + chat + Stripe hold release), because skipping a
    // follow-up means a rider who is never told they were accepted. File/line
    // references are inline at each handler.
    //
    // ONE hard rule throughout (same as trips.html): every value that came out
    // of the database reaches the DOM via textContent, never innerHTML. Rider
    // names, chat messages, ride areas, seat labels and rider notes are all
    // user-authored. The el()/clear() helpers make textContent the path of
    // least resistance.

    // -- Session plumbing (owned by /js/ss-session.js) ----------------------
    let S = null;
    try {
      S = await import('/js/ss-session.js');
    } catch (_) {
      document.getElementById('stLoading').classList.add('hidden');
      document.getElementById('stBoot').classList.remove('hidden');
      throw new Error('ss-session.js failed to load');
    }
    const supabase = S.supabase;
    const SUPA = S.SUPA;
    const ANON = S.ANON;

    // -- Wallet + Account pages (in-console; Stripe is a BUTTON inside the
    //    wallet, not a bounce — Justin, 2026-08-28) ------------------------
    // Optional chaining on purpose: these two buttons live in the shared app
    // bar, which does not mount when signed out. An unguarded call here would
    // throw at module top level and take the whole sign-in screen with it.
    document.getElementById('navWallet')?.addEventListener('click', () => { void renderWallet(); });
    document.getElementById('navAccount')?.addEventListener('click', () => { void renderAccount(); });

    /** Open the hosted Stripe Express dashboard (payout history, bank on
     *  file) in a new tab. Tab opened SYNCHRONOUSLY on click — popup blockers
     *  kill a window.open that happens after an await. */
    async function openStripeDashboard(btn) {
      const original = btn.textContent;
      btn.disabled = true; btn.textContent = 'Opening…';
      const tab = window.open('about:blank', '_blank');
      try {
        const out = await S.callFn('web-stripe-onboarding-link', { body: { mode: 'dashboard' } });
        if (out && out.url) { if (tab) tab.location = out.url; else window.location = out.url; btn.textContent = original; }
        else throw new Error('no url');
      } catch (e) {
        if (tab) tab.close();
        btn.textContent = /NO_ACCOUNT/.test(String((e && (e.error || e.message)) || ''))
          ? 'Set up deposits first'
          : 'Unavailable — try again';
        setTimeout(() => { btn.textContent = original; }, 3500);
      } finally { btn.disabled = false; }
    }

    // -- DOM helpers - the XSS fence ----------------------------------------
    const $ = (id) => document.getElementById(id);
    /** Build an element. `text` always lands as textContent. */
    function el(tag, cls, text) {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined && text !== null) n.textContent = String(text);
      return n;
    }
    /** Empty a node without innerHTML so a grep for innerHTML stays at zero. */
    function clear(node) { while (node.firstChild) node.removeChild(node.firstChild); }

    const STATES = ['stLoading','stBoot','stEmail','stCode','stList','stWallet','stAccount','stRide','stChat','stNotFound','stError'];
    // The console nav only makes sense once you're in — signed-out states
    // keep the page focused on the code entry.
    const NAV_STATES = new Set(['stList','stWallet','stAccount','stRide','stChat']);
    function show(id) {
      STATES.forEach((s) => $(s).classList.toggle('hidden', s !== id));
      // Sign-in happens in-page, so the bar may not exist yet on first paint.
      if (window.SS_APPBAR) SS_APPBAR.ensure();
      const nav = $('consoleNav');
      if (nav) nav.classList.toggle('hidden', !NAV_STATES.has(id));
    }
    function setMsg(id, text, kind) {
      const n = $(id);
      if (!text) { n.classList.add('hidden'); return; }
      n.textContent = text;
      n.className = 'msg ' + (kind || 'err');
    }

    // Timers are per-render; render() tears the previous set down.
    let timers = [];
    function every(ms, fn) { timers.push(setInterval(fn, ms)); }
    function clearTimers() { timers.forEach(clearInterval); timers = []; }

    // -- Time: ported verbatim from lib/booking-time.ts (via trips.html) -----
    // Two-pass DST solve. Do NOT approximate - a single-pass version is an
    // hour wrong on transition days, which here means the check-in window and
    // the 30-minute complete gate both opening at the wrong time.
    function zonedWallClockToUtc(year, month, day, hour, minute, timezone) {
      const desiredWallUtc = Date.UTC(year, month - 1, day, hour, minute);
      const offsetAt = (instant) => {
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: timezone, year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
        }).formatToParts(new Date(instant));
        const f = {};
        for (const p of parts) f[p.type] = p.value;
        const asUtc = Date.UTC(
          Number(f.year), Number(f.month) - 1, Number(f.day),
          f.hour === '24' ? 0 : Number(f.hour), Number(f.minute), Number(f.second),
        );
        return asUtc - instant;
      };
      try {
        let offset = offsetAt(desiredWallUtc);
        offset = offsetAt(desiredWallUtc - offset);
        return desiredWallUtc - offset;
      } catch (_) {
        return desiredWallUtc;
      }
    }

    const DEFAULT_TZ = 'America/Los_Angeles';
    /** Absolute departure instant (ms). Math only, never display. */
    function departureMs(ride) {
      if (!ride || !ride.dep_date) return 0;
      const m = /^(\d{1,2}):(\d{2})/.exec(String(ride.dep_time || '').trim());
      const hour = m ? parseInt(m[1], 10) : 0;
      const minute = m ? parseInt(m[2], 10) : 0;
      const p = String(ride.dep_date).split('-').map(Number);
      if (!p[0] || !p[1] || !p[2]) return 0;
      return zonedWallClockToUtc(p[0], p[1], p[2], hour, minute, ride.dep_timezone || DEFAULT_TZ);
    }

    function dateLabel(depDate) {
      const p = String(depDate || '').split('-').map(Number);
      if (!p[0] || !p[1] || !p[2]) return String(depDate || '');
      return new Date(p[0], p[1] - 1, p[2])
        .toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
    }

    /** Literal wall clock in the RIDE's zone - never browser-local parsing. */
    function timeLabel(depTime) {
      const m = /^(\d{1,2}):(\d{2})/.exec(String(depTime || '').trim());
      if (!m) return String(depTime || '');
      let h = parseInt(m[1], 10);
      const ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12; if (h === 0) h = 12;
      return h + ':' + m[2] + ' ' + ampm;
    }

    function tzLabel(ride) {
      try {
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: ride.dep_timezone || DEFAULT_TZ, timeZoneName: 'short',
        }).formatToParts(new Date(departureMs(ride) || Date.now()));
        const p = parts.find((x) => x.type === 'timeZoneName');
        return p ? p.value : '';
      } catch (_) { return ''; }
    }

    function whenLabel(ride) {
      const tz = tzLabel(ride);
      return dateLabel(ride.dep_date) + ' \u00b7 ' + timeLabel(ride.dep_time) + (tz ? ' ' + tz : '');
    }

    // lib/booking-time.ts:45 - check-in affordance hidden until 2h before.
    const PICKUP_CODE_OPENS_BEFORE_MS = 2 * 60 * 60 * 1000;
    // services/bookings.ts:377 - complete gate: 30 min after departure.
    const COMPLETE_AFTER_DEPARTURE_MS = 30 * 60 * 1000;

    /** UI-level status, mirroring lib/booking-time.ts effectiveStatus(). The
     *  SERVER (0206 trigger + edge fns) is always the authority. */
    function effectiveStatus(b, ride) {
      if (b.status === 'Cancelled' || b.status === 'Completed') return b.status;
      const dep = departureMs(ride);
      if (dep && Date.now() > dep + 12 * 60 * 60 * 1000) {
        if (b.status === 'Pending') return 'Cancelled';
        return b.pickup_code_entered_at ? 'Completed' : b.status;
      }
      return b.status;
    }

    // -- Formatting ---------------------------------------------------------
    const fmt$ = (n) => '$' + Number(n || 0).toFixed(2);

    /** lib/format-name.ts abbreviateName. name_public is already "First L."
     *  server-side (0203); this is the belt-and-braces second pass and is
     *  idempotent on already-short values. */
    function abbreviateName(name) {
      if (!name) return '';
      const parts = String(name).trim().split(/\s+/).filter(Boolean);
      if (parts.length === 0) return '';
      if (parts.length === 1) return parts[0];
      const initial = (parts[parts.length - 1][0] || '').toUpperCase();
      return initial ? parts[0] + ' ' + initial + '.' : parts[0];
    }
    function firstName(name) {
      const p = String(name || '').trim().split(/\s+/).filter(Boolean);
      return p[0] || 'your rider';
    }

    function paxRawName(b) {
      return (b.passenger && b.passenger.name) || b.passenger_name || '';
    }
    function paxDisplay(b) { return abbreviateName(paxRawName(b)) || 'Rider'; }
    function paxFirst(b) { return firstName(paxRawName(b)); }

    /** Strip the street line, ZIP and state so a card reads "Los Altos \u2192
     *  San Francisco" instead of a full postal address (Justin, 2026-08-28).
     *  Same helper as trips.html. Exact addresses still show once a ride is
     *  opened \u2014 the list is for scanning, the detail is for driving to. */
    function cityOf(area) {
      if (!area) return '';
      const parts = String(area).split(',').map((s) => s.trim()).filter(Boolean);
      if (!parts.length) return String(area);
      const STATE = /^(california|ca|nevada|nv|arizona|az|oregon|or|usa|united states|us)( +\d{5}(-\d{4})?)?$/i;
      const ZIP = /^\d{5}(-\d{4})?$/;
      const cleaned = parts.filter((p) => !/^\d/.test(p) && !STATE.test(p) && !ZIP.test(p));
      if (!cleaned.length) return parts[0];
      return cleaned[cleaned.length - 1];
    }
    function routeLabel(ride) {
      const from = cityOf(ride.departure_area) || ((window.SS_STOPS && SS_STOPS.STOP_BY_ID[ride.from_dest] && SS_STOPS.STOP_BY_ID[ride.from_dest].name) || 'Origin');
      const to = cityOf(ride.arrival_area) || ((window.SS_STOPS && SS_STOPS.STOP_BY_ID[ride.to_dest] && SS_STOPS.STOP_BY_ID[ride.to_dest].name) || 'Destination');
      return from + ' \u2192 ' + to;
    }
    /** Full postal addresses, for the opened-ride view only. */
    function fullRouteLabel(ride) {
      const from = ride.departure_area || cityOf(ride.departure_area) || 'Origin';
      const to = ride.arrival_area || cityOf(ride.arrival_area) || 'Destination';
      return from + ' \u2192 ' + to;
    }

    /** Map seat_ids onto the driver's own seat labels. */
    function seatLabels(b, ride) {
      const ids = Array.isArray(b.seat_ids) ? b.seat_ids : [];
      const seats = (ride && Array.isArray(ride.seats)) ? ride.seats : [];
      return ids.map((id) => {
        const s = seats.find((x) => x && x.id === id);
        return (s && (s.label || s.id)) || id;
      });
    }

    function stopName(stop) {
      if (!stop) return '';
      if (typeof stop === 'string') return stop;
      return stop.name || '';
    }

    /** Only ever assign an https image URL (photo_url is user-writable). */
    function safePhoto(url) {
      const u = String(url || '');
      return /^https:\/\//i.test(u) ? u : '';
    }

    // -- Push copy: ported from services/bookings.ts so the passenger's phone
    // shows the SAME notification whether the driver acted in the app or here.
    // formatRideTimeForPush (bookings.ts:521) -> "3:00pm"
    function pushTime(depTime) {
      const m = /^(\d{1,2}):(\d{2})$/.exec(String(depTime || '').trim());
      if (!m) return String(depTime || '');
      const h24 = parseInt(m[1], 10);
      if (!(h24 >= 0 && h24 <= 23)) return String(depTime);
      const ampm = h24 >= 12 ? 'pm' : 'am';
      const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
      return h12 + ':' + m[2] + ampm;
    }
    // formatRideDateForPush (bookings.ts:505) - UTC-parsed to avoid day drift.
    function pushDate(depDate) {
      const p = String(depDate || '').split('-').map(Number);
      if (!p[0] || !p[1] || !p[2]) return String(depDate || '');
      return new Date(Date.UTC(p[0], p[1] - 1, p[2]))
        .toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
    }
    // cityFromAddress - ported from the send-booking-email copy of
    // lib/format-address.ts. City -> city, never the search region.
    function cityFromAddress(address) {
      if (!address) return '';
      const parts = String(address).split(',').map((s) => s.trim()).filter(Boolean);
      if (parts.length === 0) return String(address).trim();
      const STATE_OR_COUNTRY =
        /^(california|ca|nevada|nv|arizona|az|oregon|or|usa|united states|us)( +\d{5}(-\d{4})?)?$/i;
      const ZIP = /^\d{5}(-\d{4})?$/;
      const cleaned = parts.filter((p) => {
        if (/^\d/.test(p)) return false;
        if (STATE_OR_COUNTRY.test(p)) return false;
        if (ZIP.test(p)) return false;
        return true;
      });
      if (cleaned.length === 0) return parts[0];
      return cleaned[cleaned.length - 1];
    }
    // buildRideDescriptor (bookings.ts:558). The app's fallback chain includes
    // the destinations map (lib/destinations.ts) - not available here, so the
    // fallback is the raw dest id. departure_area is NOT NULL in the schema,
    // so cityFromAddress carries this in practice.
    function rideDescriptor(ride) {
      const fromName = cityFromAddress(ride.departure_area) || ((window.SS_STOPS && SS_STOPS.STOP_BY_ID[ride.from_dest] && SS_STOPS.STOP_BY_ID[ride.from_dest].name) || 'origin');
      const toName = cityFromAddress(ride.arrival_area) || ((window.SS_STOPS && SS_STOPS.STOP_BY_ID[ride.to_dest] && SS_STOPS.STOP_BY_ID[ride.to_dest].name) || 'destination');
      return pushTime(ride.dep_time) + ' ride on ' + pushDate(ride.dep_date)
        + ' from ' + fromName + ' to ' + toName;
    }

    // -- Data ---------------------------------------------------------------
    // Explicit column lists, never select('*') - house web style, and it keeps
    // this page honest about exactly which fields it consumes. Passenger name
    // comes ONLY through the name_public alias (0203); profiles.name (the
    // private legal name) is never selected anywhere in this file.
    const RIDE_SELECT = [
      'id, driver_id, from_dest, to_dest, departure_area, arrival_area',
      'dep_date, dep_time, dep_timezone, instant, seats, cancelled_at, created_at',
      // Stops editor (2026-08-28): current stops + endpoints for the
      // suggester + road miles for the distance-aware stop cap.
      'route_stops, start_lat, start_lng, end_lat, end_lng, road_miles',
      // Driver-set leg prices (0226) — re-keyed when stops are edited.
      'segment_prices',
    ].join(', ');

    const BOOKING_SELECT = [
      'id, ride_id, passenger_id, passenger_name, seat_ids, total_price, status',
      'driver_message, cancel_reason, ref_code, created_at',
      'pickup_code_entered_at, no_show_reported_at, no_show_disputed_at',
      'boarding_stop, alighting_stop, source, stripe_payment_intent_id',
      'passenger:profiles!bookings_passenger_profile_fkey(name:name_public, photo_url)',
    ].join(', ');

    let me = null;          // auth uid
    let myEmail = '';
    let myName = '';        // name_public - already "First L."
    let payout = { loaded: false, started: false, enabled: false, credit: false };

    async function loadMyRides() {
      // RLS: rides_select_all lets any authenticated user read rides, but this
      // page only ever asks for its own (driver_id = me). Mirrors
      // getMyRidesWithBookings (bookings.ts:261) including the cancelled-rides
      // exclusion - cascade-cancel already flipped those bookings and the
      // riders see them on /trips.
      const { data, error } = await supabase
        .from('rides')
        .select(RIDE_SELECT)
        .eq('driver_id', me)
        .is('cancelled_at', null)
        .order('dep_date', { ascending: true });
      if (error) throw error;
      return data || [];
    }

    async function loadRide(rideId) {
      // Scoped by driver_id = me as well as RLS: a pasted ?ride= id belonging
      // to someone else comes back null, indistinguishable from "no such
      // ride" - the URL is never trusted.
      const { data, error } = await supabase
        .from('rides')
        .select(RIDE_SELECT)
        .eq('id', rideId)
        .eq('driver_id', me)
        .maybeSingle();
      if (error) throw error;
      return data || null;
    }

    async function loadBookingsForRides(rideIds) {
      if (!rideIds.length) return [];
      // RLS bookings_select_driver_rides (0002) scopes rows to rides I drive.
      const { data, error } = await supabase
        .from('bookings')
        .select(BOOKING_SELECT)
        .in('ride_id', rideIds)
        .order('created_at', { ascending: true });
      if (error) throw error;
      // UNPAID WEB REQUESTS (2026-09-02): a browser booking is inserted Pending
      // before Stripe Checkout and only gets its PaymentIntent when the card is
      // authorized. Until then it is nothing the driver can act on, so it stays
      // invisible to them (the 30-minute session expiry cancels abandoned ones).
      const rows = (data || []).filter((b) => !(b.status === 'Pending' && b.source === 'web' && !b.stripe_payment_intent_id));
      try { await loadRiderRep(rows.map((b) => b.passenger_id)); } catch (_) {}
      return rows;
    }

    // Rider reputation (audit 8/28): deciding whether to charge a stranger's
    // card with nothing but a name is worse than the app, which shows a
    // rating. Ratings are readable (same table this page writes to).
    const riderRep = new Map(); // passenger_id -> {avg, n}
    async function loadRiderRep(ids) {
      const want = [...new Set((ids || []).filter((x) => x && !riderRep.has(x)))];
      if (!want.length) return;
      const { data, error } = await supabase
        .from('ratings')
        .select('ratee_id, stars')
        .in('ratee_id', want);
      if (error) return;
      const acc = new Map();
      for (const r of data || []) {
        const cur = acc.get(r.ratee_id) || { sum: 0, n: 0 };
        cur.sum += Number(r.stars) || 0; cur.n += 1;
        acc.set(r.ratee_id, cur);
      }
      for (const id of want) {
        const a = acc.get(id);
        riderRep.set(id, a && a.n ? { avg: a.sum / a.n, n: a.n } : null);
      }
    }
