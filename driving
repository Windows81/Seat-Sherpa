    /**
     * ACCEPT - mirrors acceptBooking (services/bookings.ts:972).
     * 1. stripe-capture-booking with the driver's JWT: authorizes the caller
     *    as the driver, captures the rider's card into escrow, and flips
     *    Pending -> Confirmed server-side (conditionally - it owns the
     *    accept-vs-withdraw race, including refunding a race capture).
     * 2. On success: push 'booking_accepted' + email 'confirmed' to the rider.
     *    Both fire on ok INCLUDING alreadyConfirmed, exactly as the app does.
     * Throws a driver-readable message on failure; the booking stays Pending.
     */
    async function doAccept(booking, ride) {
      const out = await callFn('stripe-capture-booking', { bookingId: booking.id });
      if (!out || out.ok !== true) throw new Error('Could not accept just now. Refresh and try again.');
      const p = pushAccepted(ride, booking.id);
      firePush(booking.passenger_id, p.title, p.body, p.data);
      fireBookingEmail(booking.id, 'confirmed');
      return out;
    }

    function acceptErrorCopy(e) {
      // stripe-capture-booking puts MACHINE codes in `code` and human copy in
      // `error` — fnError stores those as e.body.code / e.error respectively.
      // Reading only e.error meant none of the branches below ever matched
      // (launch audit H3); the payouts one survived by regexing the copy.
      const code = (e && ((e.body && e.body.code) || e.error)) || '';
      const msg = String((e && e.message) || '');
      if (code === 'DRIVER_PAYOUTS_NOT_ACTIVE' || /set up deposits/i.test(msg)) {
        return "Set up deposits first — your rider's card is only charged after you confirm, and we can only charge it once you can be paid. Use the deposits button at the top of this ride.";
      }
      if (code === 'SEAT_TAKEN') {
        return msg || "You've already confirmed another rider for that seat — each seat can only be confirmed once. Decline this request, or ask the rider to book a different seat.";
      }
      if (code === 'AUTH_NOT_CAPTURABLE') {
        return 'This request expired before it could be accepted \u2014 card holds only last about 7 days. The seat is open again; ask the rider to book again.';
      }
      if (code === 'BOOKING_CANCELLED_RACE' || code === 'BOOKING_NOT_PENDING') {
        return 'This request was withdrawn or cancelled before you accepted. Nothing was charged.';
      }
      if (code === 'RIDE_CANCELLED') {
        return 'This ride has been cancelled, so the request can no longer be accepted.';
      }
      if (code === 'NO_PAYMENT_INTENT') {
        return "This request has no payment authorization on it, so it can't be accepted. The rider needs to book again.";
      }
      if (e && e.status === 401) return 'Your sign-in expired. Refresh the page and sign in again.';
      if (msg) return msg;
      return 'Could not accept just now. Check your connection and try again.';
    }

    /**
     * DECLINE - mirrors declineBooking (services/bookings.ts:995), driver arm.
     * 1. CONDITIONAL flip Pending -> Cancelled (.eq status 'Pending') so a
     *    simultaneous accept can never be clobbered - whoever commits second
     *    loses cleanly (bookings.ts:996-1002).
     * 2. 0 rows -> re-fetch and explain honestly (Confirmed = accepted in
     *    another tab/the app; Cancelled = rider already withdrew).
     * 3. Follow-ups, all fire-and-forget like the app:
     *    - attribution write {cancelled_by:'driver', declined_at} (bookings.ts:1054,
     *      grant 0182) - written AFTER the flip, never inside its patch.
     *    - push 'booking_declined' to the rider (bookings.ts:1066).
     *    - stripe-cancel-payment-intent releases the hold (bookings.ts:1083).
     *    - email 'declined' - rider only (bookings.ts:1095).
     *    - reason (if given) auto-posts to chat as a system notice
     *      (bookings.ts:1099).
     * Returns 'declined' | 'already-confirmed' | 'already-cancelled'.
     */
    async function doDecline(booking, ride, reason) {
      const trimmed = String(reason || '').trim();
      const patch = { status: 'Cancelled', cancel_reason: trimmed || null };
      const { data, error } = await supabase
        .from('bookings')
        .update(patch)
        .eq('id', booking.id)
        .eq('status', 'Pending')
        .select('id')
        .maybeSingle();
      if (error) throw error;

      if (!data) {
        // Lost the race - find out to whom.
        const { data: cur } = await supabase
          .from('bookings')
          .select('id, status')
          .eq('id', booking.id)
          .maybeSingle();
        if (cur && cur.status === 'Confirmed') return 'already-confirmed';
        return 'already-cancelled';
      }

      // Attribution (fire-and-forget; failure lands on today's null behavior).
      supabase.from('bookings')
        .update({ cancelled_by: 'driver', declined_at: new Date().toISOString() })
        .eq('id', booking.id)
        .then(() => {}, () => {});

      const p = pushDeclined(ride, booking.id);
      firePush(booking.passenger_id, p.title, p.body, p.data);
      fireCancelPaymentIntent(booking.id);
      fireBookingEmail(booking.id, 'declined');
      if (trimmed.length > 0) {
        fireSystemChat(booking.id, "The driver wasn't able to accept this request. Reason: " + trimmed);
      }
      return 'declined';
    }

    /**
     * CHECK-IN - mirrors submitPickupCode (services/bookings.ts:1517).
     * submit_pickup_code RPC (0043/0192): driver-gated SECURITY DEFINER; the
     * driver types ANY rider's 4-digit code and the server finds the booking.
     * Idempotent (alreadyEntered). On ok: fire stripe-release-to-driver
     * (bookings.ts:1554), then count remaining un-checked-in Confirmed
     * bookings so the flow can announce "everyone's in" (bookings.ts:1563).
     */
    async function doCheckin(ride, code) {
      const trimmed = String(code || '').trim();
      if (!/^\d{4}$/.test(trimmed)) return { ok: false, error: 'Code must be 4 digits.' };
      const { data, error } = await supabase.rpc('submit_pickup_code', {
        p_ride_id: ride.id, p_code: trimmed,
      });
      if (error) return { ok: false, error: error.message };
      const result = data || {};
      if (result.ok === true && typeof result.bookingId === 'number') {
        fireReleaseToDriver(result.bookingId);
      }
      let remaining;
      if (result.ok === true) {
        const { count, error: countErr } = await supabase
          .from('bookings')
          .select('id', { count: 'exact', head: true })
          .eq('ride_id', ride.id)
          .eq('status', 'Confirmed')
          .is('pickup_code_entered_at', null);
        if (!countErr) remaining = count || 0;
      }
      return {
        ok: result.ok === true,
        error: result.error,
        bookingId: result.bookingId,
        passengerName: result.passengerName,
        alreadyEntered: result.alreadyEntered === true,
        remaining,
      };
    }

    /**
     * COMPLETE - mirrors completeBooking (services/bookings.ts:1366).
     * Client-side gates first (same order as the app):
     *   - PIN gate: pickup_code_entered_at must be set (bookings.ts:1372).
     *   - Time gate: departure + 30 min (bookings.ts:1381), message verbatim.
     * Then a CONDITIONAL flip Confirmed -> Completed. Server-side, migration
     * 0206 permits exactly this transition for the ride's driver and rejects
     * everything else with ILLEGAL_STATUS_TRANSITION.
     * On success: push 'booking_completed' + email 'completed' (bookings.ts:1393-1400).
     */
    async function doComplete(booking, ride) {
      if (!booking.pickup_code_entered_at) {
        throw new Error("Enter the rider's pickup code before marking complete. Ask them to read the 4-digit code from their booking.");
      }
      const earliest = departureMs(ride) + COMPLETE_AFTER_DEPARTURE_MS;
      if (Date.now() < earliest) {
        // In the ride's zone, not the device's (time audit 2026-09-03).
        const eta = new Date(earliest).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: DEFAULT_TZ }) + ' PT';
        throw new Error('Too early to mark complete. Try again after ' + eta + '.');
      }
      const { data, error } = await supabase
        .from('bookings')
        .update({ status: 'Completed' })
        .eq('id', booking.id)
        .eq('status', 'Confirmed')
        .select('id')
        .maybeSingle();
      if (error) {
        if (/ILLEGAL_STATUS_TRANSITION/i.test(error.message || '')) {
          throw new Error('This booking can no longer be completed from here. Refresh to see its current status.');
        }
        throw error;
      }
      if (!data) {
        throw new Error('This booking changed while you were looking at it \u2014 refresh to see its current status.');
      }
      const p = pushCompleted(ride, booking.id);
      firePush(booking.passenger_id, p.title, p.body, p.data);
      fireBookingEmail(booking.id, 'completed');
    }

