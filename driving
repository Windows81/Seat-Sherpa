      if (error) throw error;
      // UNPAID WEB REQUESTS (2026-09-02): a browser booking is inserted Pending
      // before Stripe Checkout and only gets its PaymentIntent when the card is
      // authorized. Until then it is nothing the driver can act on, so it stays
      // invisible to them (the 30-minute session expiry cancels abandoned ones).
      const rows = (data || []).filter((b) => !(b.status === 'Pending' && b.source === 'web' && !b.stripe_payment_intent_id));
      try { await loadRiderRep(rows.map((b) => b.passenger_id)); } catch (_) {}
      return rows;
