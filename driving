      <button class="primary" id="errRetry">Try again</button>
    </div>

    <p class="legal">
      Seat Sherpa is a cost-sharing carpool marketplace, not a ride-hail service.<br />
      <a href="/terms">Terms</a> &middot; <a href="/privacy">Privacy</a> &middot; <a href="mailto:support@seatsherpa.app">support@seatsherpa.app</a>
    </p>
