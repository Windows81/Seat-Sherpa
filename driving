    // -- Edge-function call (shared helper first; local fallback) -----------
    // ── Edit route (2026-09-03): Mapbox Search Box autocomplete, the same
    //    public token post.html ships. One billable session per pick.
    const MAPBOX_TOKEN = 'pk.eyJ1IjoiamR0MjYyIiwiYSI6ImNtcDhnb3pvNzBkbGYyenBpN2psY3g2bGsifQ.sqsxq8sjfLaq978oqGExHg';
    function ssUuid() { try { return crypto.randomUUID(); } catch (_) { return String(Date.now()) + Math.random().toString(16).slice(2); } }
    /** Drivable route through ordered points (start, stops…, end): the line,
     *  miles and minutes saved on the ride, so every map and stop pickup-time
     *  estimate follows the road the driver set (Justin, 2026-10-05: "it
     *  should just always be the map the driver sets"). Same Directions call
     *  and limits as the app's lib/road-route.ts mapboxDirections. Null on any
     *  failure; never throws. */
    async function roadThrough(points) {
      if (!Array.isArray(points) || points.length < 2 || points.length > 25) return null;
      if (points.some((p) => !Number.isFinite(p.lat) || !Number.isFinite(p.lng))) return null;
      const coords = points.map((p) => p.lng.toFixed(5) + ',' + p.lat.toFixed(5)).join(';');
      const ctl = new AbortController();
      const timer = setTimeout(() => ctl.abort(), 6000);
      try {
        const res = await fetch('https://api.mapbox.com/directions/v5/mapbox/driving/' + coords
          + '?overview=simplified&geometries=polyline&alternatives=false&access_token=' + MAPBOX_TOKEN, { signal: ctl.signal });
        if (!res.ok) return null;
        const body = await res.json();
        const r = body && body.routes && body.routes[0];
        if (!r || !(r.distance > 0) || typeof r.geometry !== 'string' || r.geometry.length < 2 || r.geometry.length > 8000) return null;
        return {
          geom: r.geometry,
          miles: Math.round((r.distance / 1609.344) * 10) / 10,
          minutes: r.duration > 0 ? Math.round(r.duration / 60) : null,
        };
      } catch (_) {
        return null;
      } finally {
        clearTimeout(timer);
      }
    }
    function stripCountry(s) { return (s || '').replace(/,?\s*(United States|USA|US)\s*$/i, ''); }
    function wireRouteAc(input, list, onPick) {
      let session = ssUuid(); let timer = null; let seq = 0;
      list.style.cssText = 'display:none;border:1px solid var(--ac-line);border-radius:10px;overflow:hidden;margin:-4px 0 10px;background:var(--ac-bg);';
      function render(items) {
