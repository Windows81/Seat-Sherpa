              const j = r.ok ? await r.json() : null;
              const f = j && j.features && j.features[0];
              session = ssUuid();
              if (f) onPick({ lat: f.geometry.coordinates[1], lng: f.geometry.coordinates[0], address: input.value, name: s.name || '' });
            } catch (_) { /* leave unpicked */ }
