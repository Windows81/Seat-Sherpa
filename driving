            chip.style.cssText = 'border:1px solid ' + (on ? 'var(--sel-line)' : 'var(--nav-line)') + ';border-radius:999px;padding:7px 14px;margin:0;color:' + (on ? 'var(--link)' : 'var(--sub2)');
            chip.addEventListener('click', () => { flexSel = c.v; paintFlex(); });
            flexRow.appendChild(chip);
          }
        };
        paintFlex();
        panel.appendChild(flexRow);

        panel.appendChild(sectionLabel('Note to riders'));
        const ta = document.createElement('textarea');
        ta.maxLength = NOTE_MAX; ta.rows = 3;
        ta.placeholder = 'Pickup options, luggage room, anything riders should know.';
        ta.value = String(ride.driver_note || '');
        ta.style.width = '100%'; ta.style.marginTop = '8px'; ta.style.marginBottom = '0';
        panel.appendChild(ta);
        const counter = el('span', null, ta.value.length + '/' + NOTE_MAX);
        const noteHelp = helper('Shown on your ride. No phone numbers, emails, or links. ');
        noteHelp.appendChild(counter);
        noteHelp.style.marginBottom = '12px';
        ta.addEventListener('input', () => { counter.textContent = ta.value.length + '/' + NOTE_MAX; });
        panel.appendChild(noteHelp);

        const save = el('button', 'primary', 'Save note');
        save.type = 'button';
        save.addEventListener('click', async () => {
          msg.classList.add('hidden');
          const text = ta.value.trim();
          const problem = noteProblem(text);
          if (problem) {
            // 0327: the refusal is a row for the founder (too_long has no hit, so no row).
            logNoteFlag({ hit: noteHitFor(text), action: 'blocked', rideId: ride.id, snippet: noteSnippet(text) });
            msg.textContent = noteErrorCopy(problem);
            msg.classList.remove('hidden');
            return;
          }
          save.disabled = true; save.textContent = 'Saving…';
          try {
            const { error } = await supabase
              .from('rides')
              .update({ driver_note: text || null, depart_flex_minutes: flexSel })
              .eq('id', ride.id);
            if (error) throw error;
            actionBusy = false;
            await refreshRide(ride.id);
            // 0327: saved, but a plain mention of cash is still logged (allowed).
