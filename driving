    /** Cancel ONE Confirmed booking: stripe-refund-booking flips the row and
     *  refunds; then the same fire-and-forget follow-ups the app sends. */
    async function doCancelConfirmed(booking, ride, reason) {
      await callFn('stripe-refund-booking', { bookingId: booking.id, reason });
      const p = pushCancelled(ride, booking.id);
      firePush(booking.passenger_id, p.title, p.body, p.data);
      fireBookingEmail(booking.id, 'cancelled');
      fireSystemChat(booking.id, 'I had to cancel this trip. Reason: ' + reason);
    }

    /** Cancel the WHOLE ride — mirrors cancelRide (services/rides.ts:815):
     *  refund every Confirmed seat, decline every Pending request, flip the
     *  ride row. Blocked once any trip has started (PIN entered). */
    async function doCancelRide(ride, reason) {
      const trimmed = String(reason || '').trim();
      if (trimmed.length < 10) throw new Error('Give riders a reason — at least 10 characters.');
      const { data: rows, error } = await supabase
        .from('bookings')
        .select('id, status, passenger_id, pickup_code_entered_at')
        .eq('ride_id', ride.id)
        .in('status', ['Confirmed', 'Pending']);
      if (error) throw error;
      const started = (rows || []).some((b) => b.status === 'Confirmed' && b.pickup_code_entered_at);
      if (started) throw new Error("A trip on this ride has already started — it can't be cancelled. Email support@seatsherpa.app.");
      let failed = 0;
      for (const b of (rows || [])) {
        try {
          if (b.status === 'Confirmed') await doCancelConfirmed(b, ride, trimmed);
          else await doDecline(b, ride, trimmed);
        } catch (_) { failed += 1; }
      }
      const { error: upErr } = await supabase
        .from('rides')
        .update({ cancelled_at: new Date().toISOString(), cancellation_reason: trimmed })
        .eq('id', ride.id);
      if (upErr) throw upErr;
      return { failed };
    }

    /** Edit departure — mirrors updateRideDateTime (services/rides.ts:640):
     *  only with ZERO active bookings, ≥15 min out, ≥4h from the
     *  driver's other rides. All rides are Pacific wall-clock. */
    async function doEditDateTime(ride, depDate, depTime) {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(depDate) || !/^\d{2}:\d{2}$/.test(depTime)) {
        throw new Error('Pick a valid date and time.');
      }
      const { count, error: cErr } = await supabase
        .from('bookings')
        .select('id', { count: 'exact', head: true })
        .eq('ride_id', ride.id)
        .in('status', ['Confirmed', 'Pending']);
      if (cErr) throw cErr;
      if ((count || 0) > 0) throw new Error("You can't change the date or time once there are bookings or requests — cancel them or post a new ride instead.");
      const pacFloor = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Los_Angeles', hour12: false,
        year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit',
      }).format(new Date(Date.now() + 15 * 60 * 1000)).replace(', ', 'T').replace(' ', 'T')
        // Some ICU builds render the midnight hour as 24:xx — same defense
        // as the check-in clock (Fable audit P4).
        .replace('T24', 'T00');
      if ((depDate + 'T' + depTime) <= pacFloor) throw new Error('Pick a date and time at least 15 minutes from now.');
      // 4h spacing — both sides parsed the same way, so the math is exact.
      const wall = (d, t) => Date.UTC(+d.slice(0, 4), +d.slice(5, 7) - 1, +d.slice(8, 10), +t.slice(0, 2), +t.slice(3, 5));
      const target = wall(depDate, depTime);
      const { data: others } = await supabase
        .from('rides')
        .select('id, dep_date, dep_time')
        .eq('driver_id', me)
        .is('cancelled_at', null)
        .neq('id', ride.id);
      for (const r of (others || [])) {
        if (r.dep_date && r.dep_time && Math.abs(wall(r.dep_date, String(r.dep_time).slice(0, 5)) - target) < 4 * 3600 * 1000) {
          throw new Error('You have another ride within 4 hours of this time — space your rides at least 4 hours apart.');
        }
      }
      const label = new Date(Date.UTC(+depDate.slice(0, 4), +depDate.slice(5, 7) - 1, +depDate.slice(8, 10)))
        .toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
      const patch = { dep_date: depDate, dep_time: depTime, date_label: label };
      if (ride.dep_date !== depDate) patch.fill_nudge_sent_at = null; // re-arm the fill nudge for the new window
      const { error: uErr } = await supabase.from('rides').update(patch).eq('id', ride.id);
      if (uErr) throw uErr;
    }

    /** The Manage card on a ride: edit date/time, cancel one booking, cancel
     *  the ride. Replaces the old "do it in the app" banner (2026-08-27 —
     *  web drivers get the full console, standing rule). */
    // ── Seats (2026-09-03) — the app's driver seat grid on the web ──────────
    const SEAT_SHORT = { fp: 'Front', ml: 'Mid left', mr: 'Mid right', rl: 'Rear left', rc: 'Rear center', rr: 'Rear right' };
    const seatPrice = (n) => {
      const v = Number(n || 0);
      return '$' + (Number.isInteger(v) ? String(v) : v.toFixed(2));
    };

    /** Port of updateRideSeats (services/rides.ts:587). MERGE, never a blind
     *  write: re-read the ride, force-close any seat held by a live booking
     *  (anything not Cancelled), take the driver's toggle for the rest, and
     *  keep seats the server has that this snapshot doesn't. 0202's trigger
     *  is the final word server-side if a booking lands between read and
     *  write. A driver-CLOSED seat is the driver's to reopen — only a booking
     *  makes a seat untouchable. */
    async function doUpdateSeats(ride, wanted) {
      const [fresh, live] = await Promise.all([
        supabase.from('rides').select('seats').eq('id', ride.id).single(),
        supabase.from('bookings').select('seat_ids, status').eq('ride_id', ride.id).neq('status', 'Cancelled'),
      ]);
      if (fresh.error) throw fresh.error;
      if (live.error) throw live.error;
      const held = new Set();
      (live.data || []).forEach((b) => (b.seat_ids || []).forEach((id) => held.add(id)));
      const server = (fresh.data && Array.isArray(fresh.data.seats)) ? fresh.data.seats : [];
      const byId = new Map(server.map((x) => [x.id, x]));
      const merged = wanted.map((w) => {
        if (!byId.has(w.id)) return w;
        // Price is frozen too while a booking holds the seat (sweep
        // 2026-09-03): a Pending request authorized the OLD price and the
        // accept captures exactly that, so the listed price must not drift.
        const cur0 = byId.get(w.id);
        return Object.assign({}, w, { avail: held.has(w.id) ? false : !!w.avail, price: held.has(w.id) ? cur0.price : w.price });
      });
      for (const x of server) if (!merged.some((m) => m.id === x.id)) merged.push(x);
      const { error } = await supabase.from('rides').update({ seats: merged }).eq('id', ride.id);
      if (error) throw error;
      return merged;
    }

    /** The Seats card on a live ride: one tappable tile per passenger seat.
     *  Returns null when there is nothing to show (no passenger seats, or the
     *  ride has departed). */
    function seatsSection(entry) {
      const ride = entry.ride;
      const seats = Array.isArray(ride.seats) ? ride.seats : [];
      const passengerSeats = seats.filter((x) => x && !x.isDriver);
      if (passengerSeats.length === 0) return null;
      const dep = departureMs(ride);
      if (dep && Date.now() > dep) return null;

      // Who holds which seat — same rule as the merge (any non-cancelled
      // booking), shown by first name so the driver sees it at a glance.
      const holder = new Map();
      entry.bookings.forEach((b) => {
        if (b.status === 'Cancelled') return;
        const raw = (b.passenger && b.passenger.name) || b.passenger_name || '';
        const first = abbreviateName(raw).split(' ')[0] || 'Rider';
        const st = effectiveStatus(b, ride);
        (b.seat_ids || []).forEach((id) => holder.set(id, { name: first, pending: st === 'Pending' }));
      });

      const wrap = el('div', 'card');
      wrap.appendChild(el('div', 'eyebrow', 'Seats'));
      wrap.appendChild(el('div', 'rowhint', 'Tap a seat to close or reopen it. One price covers every seat; a seat with a booking or request stays as it is.'));
      const msg = el('div', 'rowhint hidden');
      msg.style.color = '#ff8a8a';

      const unbooked = passengerSeats.filter((x) => !holder.has(x.id));
      const openSeats = unbooked.filter((x) => x.avail);
      const priceSeat = openSeats[0] || unbooked[0] || passengerSeats[0];
      let saving = false;
      const tiles = [];
      const chipBtns = [];
      const setBusy = (b) => {
        saving = b;
        tiles.forEach((t) => { t.disabled = b || !!holder.get(t.dataset.seat) || t.classList.contains('driver'); t.classList.toggle('saving', b); });
        chipBtns.forEach((c) => { c.disabled = b; });
      };
      async function toggleSeat(id) {
        if (saving) return;
        setBusy(true); msg.classList.add('hidden');
        const wanted = seats.map((x) => (x && x.id === id) ? Object.assign({}, x, { avail: !x.avail }) : x);
        try {
          await doUpdateSeats(ride, wanted);
          await refreshRide(ride.id);
        } catch (e) {
          setBusy(false);
          msg.textContent = (e && e.message) || 'Could not update that seat — try again.';
          msg.classList.remove('hidden');
        }
      }

      // ── Layout: portrait car on the left, controls on the right ────────
      const layout = el('div', 'seatlayout');
      const carcol = el('div', 'carcol');
      const chipcol = el('div', 'chipcol');

      const ids = new Set(passengerSeats.map((x) => x.id));
      const rows = [['driver', 'fp'], ['ml', 'mr'], ['rl', 'rc', 'rr']]
        .map((r) => r.filter((id) => id === 'driver' || ids.has(id)))
        .filter((r) => r.some((id) => id !== 'driver'));

      function tile(id) {
        if (id === 'driver') {
          const t = el('button', 'seattile driver');
          t.type = 'button'; t.disabled = true;
          t.appendChild(el('div', 'drvbadge', (((ride.driver_name || myEmail || 'You').trim().charAt(0)) || 'Y').toUpperCase()));
          t.appendChild(el('div', 'ss', 'Driver'));
          return t;
        }
        const seat = passengerSeats.find((x) => x.id === id);
        const h = holder.get(id);
        const state = h ? 'held' : (seat.avail ? 'open' : 'closed');
        const t = el('button', 'seattile ' + state);
        t.type = 'button';
        t.appendChild(el('div', 'sl', SEAT_SHORT[id] || seat.label || id));
        // The price lives in the column on the right (one price per ride);
        // a held seat shows what its rider is paying.
        if (h) t.appendChild(el('div', 'sp', seatPrice(seat.price)));
        t.appendChild(el('div', 'ss', h ? ((h.pending ? 'Requested · ' : 'Booked · ') + h.name) : (seat.avail ? 'Open' : 'Closed')));
        t.setAttribute('aria-label', (SEAT_SHORT[id] || id) + ' seat, ' + (h ? 'held by ' + h.name : (seat.avail ? 'open, tap to close' : 'closed, tap to reopen')));
        if (h) { t.disabled = true; return t; }
        t.addEventListener('click', () => toggleSeat(id));
        return t;
      }

      // Car chrome, the booking page's cabin: wheels flush on the sides,
      // mirrors up front, a long rounded shell, windshield bar after row 1.
      const carwrap = el('div', 'carwrap');
      ['wfl', 'wfr', 'wrl', 'wrr'].forEach((w) => carwrap.appendChild(el('div', 'carwheel ' + w)));
      ['mml', 'mmr'].forEach((m) => carwrap.appendChild(el('div', 'carmirror ' + m)));
      const shell = el('div', 'carshell');
      rows.forEach((r, i) => {
        const row = el('div', 'carrow' + (r.length === 3 ? ' three' : ''));
        r.forEach((id) => { const t = tile(id); t.dataset.seat = id; tiles.push(t); row.appendChild(t); });
        shell.appendChild(row);
        if (i < rows.length - 1) shell.appendChild(el('div', i === 0 ? 'windshield' : 'rowdiv'));
      });
      carwrap.appendChild(shell);
      carcol.appendChild(carwrap);

      // ── Right column: one price (editable), a summary, one chip per seat ─
      if (unbooked.length > 0 && priceSeat) {
        const priceRow = el('div', 'seatchip price');
        const priceTxt = el('span', 'val', seatPrice(priceSeat.price) + ' per seat');
        const priceRowEdit = el('button', 'chipact', 'Edit');
        priceRowEdit.type = 'button';
        priceRow.appendChild(priceTxt); priceRow.appendChild(priceRowEdit);
        chipcol.appendChild(priceRow);
        const editBox = el('div', 'priceedit hidden');
        const priceInp = inp('number', '', String(priceSeat.price || ''));
        priceInp.min = '10'; priceInp.max = '55'; priceInp.step = '1';
        const priceSave = el('button', 'primary', 'Save');
        priceSave.type = 'button';
        editBox.appendChild(el('span', 'cur', '$'));
        editBox.appendChild(priceInp); editBox.appendChild(priceSave);
        chipcol.appendChild(editBox);
        // actionBusy freezes the periodic refresh while the box is open —
        // otherwise a 30/60s repaint wiped a half-typed price (audit 2026-09-04).
        priceRowEdit.addEventListener('click', () => {
          editBox.classList.toggle('hidden');
          const open = !editBox.classList.contains('hidden');
          actionBusy = open;
          if (open) priceInp.focus();
        });
        priceSave.addEventListener('click', async () => {
          msg.classList.add('hidden');
          const n = Math.round(Number(priceInp.value));
          // Same cap rule as the app's grid: (drivable miles × $0.76 − what
          // booked seats already collect) ÷ open seats, floor $10, ceiling $55.
          const start = (ride.start_lat != null) ? { lat: Number(ride.start_lat), lng: Number(ride.start_lng) } : null;
          const end = (ride.end_lat != null) ? { lat: Number(ride.end_lat), lng: Number(ride.end_lng) } : null;
          const miles = (typeof ride.road_miles === 'number' && ride.road_miles > 0)
            ? Number(ride.road_miles)
            : (start && end && window.SS_STOPS ? SS_STOPS.haversineMiles(start, end) * 1.25 : 0);
          const bookedSum = passengerSeats.filter((x) => holder.has(x.id)).reduce((t, x) => t + (Number(x.price) || 0), 0);
          // No mileage (no coords / stops lib failed to load) → the price can
          // only be held or lowered, never raised toward the $55 ceiling
          // blind (audit 2026-09-04).
          const cap = miles > 0
            ? Math.max(10, Math.min(55, Math.floor((miles * 0.76 - bookedSum) / Math.max(1, openSeats.length))))
            : Math.max(10, Math.min(55, Math.round(Number(priceSeat.price) || 10)));
          if (!Number.isFinite(n) || n < 10 || n > cap) {
            msg.textContent = 'Enter a whole dollar amount between $10 and $' + cap + ' — the cost-sharing cap for this trip at its current open seat count.';
            msg.classList.remove('hidden');
            return;
          }
          actionBusy = false;
          priceSave.disabled = true; priceSave.textContent = 'Saving…';
          try {
            const wanted = seats.map((x) => (x && !x.isDriver && !holder.has(x.id)) ? Object.assign({}, x, { price: n }) : x);
            await doUpdateSeats(ride, wanted);
            await refreshRide(ride.id);
          } catch (e) {
            priceSave.disabled = false; priceSave.textContent = 'Save';
            msg.textContent = (e && e.message) || 'Could not save the price — try again.';
            msg.classList.remove('hidden');
          }
        });
      }
      chipcol.appendChild(el('div', 'seatsum',
        openSeats.length + ' open · ' + (unbooked.length - openSeats.length) + ' closed · '
        + (passengerSeats.length - unbooked.length) + (passengerSeats.length - unbooked.length === 1 ? ' taken' : ' taken')));
      passengerSeats.forEach((seat) => {
        const h = holder.get(seat.id);
        const chip = el('div', 'seatchip ' + (h ? 'held' : (seat.avail ? 'open' : 'closed')));
        chip.appendChild(el('span', 'nm', SEAT_SHORT[seat.id] || seat.label || seat.id));
        chip.appendChild(el('span', 'st', h ? ((h.pending ? 'Requested · ' : 'Booked · ') + h.name) : (seat.avail ? 'Open' : 'Closed')));
        if (!h) {
          const act = el('button', 'chipact', seat.avail ? 'Close' : 'Reopen');
          act.type = 'button';
          act.addEventListener('click', () => toggleSeat(seat.id));
          chipBtns.push(act);
          chip.appendChild(act);
        }
        chipcol.appendChild(chip);
      });

      layout.appendChild(carcol);
      layout.appendChild(chipcol);
      wrap.appendChild(layout);
      if (openSeats.length === 0) {
        wrap.appendChild(el('div', 'rowhint', 'Every seat is closed or taken — riders can\'t book this ride until you reopen one.'));
      }
      wrap.appendChild(msg);
      return wrap;
    }

    function manageSection(entry) {
      const ride = entry.ride;
      const wrap = el('div', 'card');
      wrap.appendChild(el('div', 'eyebrow', 'Manage'));
      const active = entry.bookings.filter((b) => {
        const st = effectiveStatus(b, ride);
        return st === 'Pending' || st === 'Confirmed';
      });
      const confirmedActive = entry.bookings.filter((b) => effectiveStatus(b, ride) === 'Confirmed' && !b.pickup_code_entered_at);
      const panel = el('div', 'hidden');
      const msg = el('div', 'rowhint hidden');

      // Every panel gets an escape hatch — a destructive flow with no visible
      // way out reads as a trap, and closing also unfreezes the refresh.
      function neverMind() {
        const b = el('button', 'linkbtn', 'Never mind');
        b.type = 'button';
        b.style.display = 'block';
        b.style.marginTop = '6px';
        b.addEventListener('click', () => {
          clear(panel);
          panel.classList.add('hidden');
          msg.classList.add('hidden');
          actionBusy = false;
        });
        return b;
      }

      const row = el('div', 'managerow');
      row.style.display = 'flex'; row.style.gap = '10px'; row.style.flexWrap = 'wrap';

      // Edit date & time — zero-bookings only, like the app. Hoisted so the
      // cancel flow below can offer "edit instead" (2026-09-01).
      let editBtn = null;
      if (active.length === 0) {
        editBtn = el('button', 'linkbtn', 'Edit date & time');
        editBtn.type = 'button';
        editBtn.addEventListener('click', () => {
          actionBusy = true;
          clear(panel); msg.classList.add('hidden');
          const d = inp('date', '', ride.dep_date || '');
          const t = inp('time', '', String(ride.dep_time || '').slice(0, 5));
          d.style.marginBottom = '8px'; t.style.marginBottom = '8px';
          panel.appendChild(d); panel.appendChild(t);
          const save = el('button', 'primary', 'Save new departure');
          save.type = 'button';
          save.addEventListener('click', async () => {
            msg.classList.add('hidden');
            save.disabled = true; save.textContent = 'Saving…';
            try {
              await doEditDateTime(ride, d.value, t.value);
              actionBusy = false;
              await refreshRide(ride.id);
            } catch (e) {
              save.disabled = false; save.textContent = 'Save new departure';
              msg.textContent = (e && e.message) || 'Could not save.';
              msg.classList.remove('hidden');
            }
          });
          panel.appendChild(save);
          panel.appendChild(neverMind());
          panel.classList.remove('hidden');
        });
        row.appendChild(editBtn);

        // Edit route — pickup/dropoff. Server re-derives metros, drivable
        // miles, the cost-share cap (prices above it are clamped) and clears
        // stops/leg prices, which belonged to the old road.
        const editRouteBtn = el('button', 'linkbtn', 'Edit route');
        editRouteBtn.type = 'button';
        editRouteBtn.addEventListener('click', () => {
          actionBusy = true;
          clear(panel); msg.classList.add('hidden');
          const picks = {
            from: (ride.start_lat != null) ? { lat: Number(ride.start_lat), lng: Number(ride.start_lng), address: ride.departure_area || '' } : null,
            to: (ride.end_lat != null) ? { lat: Number(ride.end_lat), lng: Number(ride.end_lng), address: ride.arrival_area || '' } : null,
          };
          const mk = (label, key) => {
            panel.appendChild(el('div', 'rowhint', label));
            const i = inp('text', '', (picks[key] && picks[key].address) || '');
            i.placeholder = key === 'from' ? 'e.g. Caltrain Station, San Jose' : 'e.g. Union Station, Los Angeles';
            i.autocomplete = 'off';
            i.style.marginBottom = '6px';
            const l = el('div');
            panel.appendChild(i); panel.appendChild(l);
            wireRouteAc(i, l, (p) => { picks[key] = p; });
          };
          mk('Leaving from', 'from');
          mk('Going to', 'to');
          panel.appendChild(el('div', 'rowhint', 'Pick both from the suggestions. Stops and leg prices reset for the new road, and seat prices drop to the new cost-share cap if the drive got shorter.'));
          const save = el('button', 'primary', 'Save new route');
          save.type = 'button';
          save.addEventListener('click', async () => {
            msg.classList.add('hidden');
            if (!picks.from || !picks.to) { msg.textContent = 'Pick both addresses from the suggestions.'; msg.classList.remove('hidden'); return; }
            save.disabled = true; save.textContent = 'Saving…';
            try {
              const out = await callFn('web-update-ride-route', {
                rideId: ride.id,
                fromAddress: picks.from.address, toAddress: picks.to.address,
                startLat: picks.from.lat, startLng: picks.from.lng,
                endLat: picks.to.lat, endLng: picks.to.lng,
              });
              actionBusy = false;
              await refreshRide(ride.id);
              const notes = [];
              if (out && out.priceClamped) notes.push('Seat prices were lowered from $' + out.priceClamped.from + ' to $' + out.priceClamped.to + ' to stay within the cost-share cap for the new distance.');
              if (out && out.stopsCleared) notes.push('Your stops were cleared — add them again with Edit stops if they still sit on the new road.');
              if (notes.length) { const m2 = document.getElementById('manageMsg') || msg; m2.textContent = notes.join(' '); m2.classList.remove('hidden'); }
            } catch (e) {
              save.disabled = false; save.textContent = 'Save new route';
              msg.textContent = (e && e.body && e.body.message) || (e && e.message) || 'Could not save the route.';
              msg.classList.remove('hidden');
            }
          });
          panel.appendChild(save);
          panel.appendChild(neverMind());
          panel.classList.remove('hidden');
        });
        row.appendChild(editRouteBtn);
      } else {
        wrap.appendChild(el('div', 'rowhint', "Date and time can't change once there are bookings or requests."));
      }

      // Edit stops — allowed even WITH bookings (adding stops is how a driver
      // fills remaining seats); only removing a stop a rider boards/alights
      // at is blocked, mirroring the app's updateRideStops guard.
      const editStopsBtn = el('button', 'linkbtn', 'Edit stops');
      editStopsBtn.type = 'button';
      editStopsBtn.addEventListener('click', () => {
        actionBusy = true;
        clear(panel); msg.classList.add('hidden');
        const start = (ride.start_lat != null && ride.start_lng != null) ? { lat: Number(ride.start_lat), lng: Number(ride.start_lng) } : null;
        const end = (ride.end_lat != null && ride.end_lng != null) ? { lat: Number(ride.end_lat), lng: Number(ride.end_lng) } : null;
        const current = Array.isArray(ride.route_stops) ? ride.route_stops.slice() : [];
        const currentIds = new Set(current.filter((s) => typeof s === 'string'));
        const customs = current.filter((s) => s && typeof s === 'object');
        const suggestions = (start && end && window.SS_STOPS) ? SS_STOPS.looseSuggest(start, end) : [];
        // Union: every currently-saved id stays visible even if no longer
        // suggested — otherwise it would be invisible yet still on the ride.
        const byId = {};
        for (const s of suggestions) byId[s.id] = s;
        for (const id of currentIds) {
          if (!byId[id] && window.SS_STOPS && SS_STOPS.STOP_BY_ID[id]) byId[id] = { ...SS_STOPS.STOP_BY_ID[id], t: (start && end) ? SS_STOPS.routeT(start, end, SS_STOPS.STOP_BY_ID[id]) : 0 };
        }
        const options = Object.values(byId).sort((a, z) => (a.t || 0) - (z.t || 0));
        const selected = new Set(currentIds);
        const keptCustoms = customs.slice();
        const milesEst = (typeof ride.road_miles === 'number' && ride.road_miles > 0)
          ? Number(ride.road_miles)
          : (start && end && window.SS_STOPS ? SS_STOPS.haversineMiles(start, end) * 1.25 : 0);
        // Mirrors post.html maxStopsFor / lib/route-fill.ts maxStopsForMiles.
        const cap = milesEst > 165 ? 8 : milesEst > 100 ? 5 : 3;

        if (options.length === 0 && keptCustoms.length === 0) {
          panel.appendChild(el('div', 'rowhint', 'No suggested stops sit on this route — add a town on the way below.'));
        } else {
          panel.appendChild(el('div', 'rowhint', 'Riders at these stops can find and book your ride. Max ' + cap + ' stops.'));
        }
        const chipRow = el('div');
        chipRow.style.display = 'flex'; chipRow.style.flexWrap = 'wrap'; chipRow.style.gap = '8px'; chipRow.style.margin = '10px 0';
        const paintChips = () => {
          clear(chipRow);
          for (const s of options) {
            const on = selected.has(s.id);
            const chip = el('button', 'linkbtn', (on ? '✓ ' : '') + s.name);
            chip.type = 'button';
            chip.style.cssText = 'border:1px solid ' + (on ? 'rgba(0,212,200,0.6)' : '#2a2a33') + ';border-radius:999px;padding:7px 14px;margin:0;color:' + (on ? '#00D4C8' : '#b9b9c6');
            chip.addEventListener('click', () => {
              if (!on && selected.size + keptCustoms.length >= cap) {
                msg.textContent = 'Max ' + cap + ' stops — more stops means a longer trip for every rider.';
                msg.classList.remove('hidden');
                return;
              }
              msg.classList.add('hidden');
              if (on) selected.delete(s.id); else selected.add(s.id);
              paintChips();
            });
            chipRow.appendChild(chip);
          }
          keptCustoms.forEach((c, i) => {
            const chip = el('button', 'linkbtn', '✓ ' + (c.name || 'Custom stop') + '  ✕');
            chip.type = 'button';
            chip.style.cssText = 'border:1px solid rgba(0,212,200,0.6);border-radius:999px;padding:7px 14px;margin:0;color:#00D4C8';
            chip.addEventListener('click', () => { keptCustoms.splice(i, 1); paintChips(); });
            chipRow.appendChild(chip);
          });
        };
        paintChips();
        panel.appendChild(chipRow);

        // Add a stop by name (2026-09-03, Justin: "there should be an add
        // stops button") — the same Mapbox search as posting, and the same
        // envelope the server enforces: at least 9 mi from both ends and no
        // more than a 30 mi straight-line detour. Custom stops are stored as
        // {name, lat, lng} exactly like the posting page writes them.
        if (start && end && window.SS_STOPS) {
          const addWrap = el('div');
          addWrap.style.margin = '2px 0 10px';
          const addBtn = el('button', 'linkbtn', '+ Add a stop');
          addBtn.type = 'button';
          const addInput = inp('text', '', '');
          addInput.placeholder = 'Town on the way, e.g. Santa Barbara';
          addInput.autocomplete = 'off';
          addInput.style.cssText = 'display:none;margin:8px 0 4px;';
          const addList = el('div');
          addBtn.addEventListener('click', () => { addInput.style.display = 'block'; addInput.focus(); });
          wireRouteAc(addInput, addList, (p) => {
            if (!p) return;
            const name = ((p.name || p.address || '').split(',')[0] || '').trim() || 'Stop';
            const direct = SS_STOPS.haversineMiles(start, end);
            const toS = SS_STOPS.haversineMiles(start, p), toE = SS_STOPS.haversineMiles(end, p);
            const say = (t) => { msg.textContent = t; msg.classList.remove('hidden'); };
            if (toS < 9 || toE < 9) { say(name + ' is too close to your start or destination to be a stop.'); return; }
            if (toS + toE - direct > 30) { say(name + " isn't on the way for this route — stops must sit along it."); return; }
            if (selected.size + keptCustoms.length >= cap) { say('Max ' + cap + ' stops — more stops means a longer trip for every rider.'); return; }
            const lc = name.toLowerCase();
            if (options.some((s) => (s.name || '').toLowerCase() === lc) || keptCustoms.some((c) => (c.name || '').toLowerCase() === lc)) { say(name + ' is already in the list.'); return; }
            msg.classList.add('hidden');
            keptCustoms.push({ name, lat: p.lat, lng: p.lng });
            addInput.value = ''; addInput.style.display = 'none';
            paintChips();
          });
          addWrap.appendChild(addBtn); addWrap.appendChild(addInput); addWrap.appendChild(addList);
          panel.appendChild(addWrap);
        }

        const saveStops = el('button', 'primary', 'Save stops');
        saveStops.type = 'button';
        saveStops.addEventListener('click', async () => {
          msg.classList.add('hidden');
          saveStops.disabled = true; saveStops.textContent = 'Saving…';
          try {
            // Booked-stop guard, mirroring services/rides.ts updateRideStops:
            // a stop an active booking boards/alights at can't be removed.
            const { data: abs } = await supabase
              .from('bookings')
              .select('passenger_name, boarding_stop, alighting_stop, status')
              .eq('ride_id', ride.id)
              .in('status', ['Pending', 'Confirmed']);
            const keptNames = new Set(
              [...selected].map((id) => (window.SS_STOPS ? SS_STOPS.stopName(id) : id))
                .concat(keptCustoms.map((c) => c.name)),
            );
            const keptIds = new Set([...selected]);
            for (const bkg of (abs || [])) {
              for (const bs of [bkg.boarding_stop, bkg.alighting_stop]) {
                if (bs && bs.name && !keptNames.has(bs.name) && !(bs.id && keptIds.has(bs.id))) {
                  throw new Error("Can't remove the " + bs.name + ' stop — '
                    + ((bkg.passenger_name || 'A rider').split(/\s+/)[0])
                    + ' is booked to board or get off there. Handle that booking first.');
                }
              }
            }
            const ordered = options.filter((s) => selected.has(s.id)).map((s) => s.id);
            const merged = ordered.concat(keptCustoms);
            const patch = { route_stops: merged };
            if (merged.length > 0) patch.instant = false; // multi-stop = request-to-book
            // Driver-set leg prices (0226) key custom stops by POSITION — re-key
            // them to the new order or the wrong leg bills at the old price.
            // Mirrors lib/segment-price-keys.ts remapSegmentPrices; change both.
            if (ride.segment_prices && typeof ride.segment_prices === 'object') {
              const nameOf = (s) => (s && typeof s === 'object' && typeof s.name === 'string') ? s.name.trim().toLowerCase() : null;
              const olds = Array.isArray(ride.route_stops) ? ride.route_stops : [];
              const catalogNow = new Set(merged.filter((s) => typeof s === 'string'));
              const custIdx = new Map();
              merged.forEach((s, i) => { const n = nameOf(s); if (n && !custIdx.has(n)) custIdx.set(n, i); });
              const mapTok = (t) => {
                if (t === 'origin' || t === 'end') return t;
                const m = /^cust-(\d+)$/.exec(t);
                if (m) { const n = nameOf(olds[Number(m[1])]); const j = n ? custIdx.get(n) : undefined; return j === undefined ? null : 'cust-' + j; }
                return catalogNow.has(t) ? t : null;
              };
              const out = {}; let n = 0;
              for (const [k, v] of Object.entries(ride.segment_prices)) {
                const p = k.split('|');
                if (p.length !== 2 || typeof v !== 'number') continue;
                const a = mapTok(p[0]), b = mapTok(p[1]);
                if (!a || !b || a === b) continue;
                out[a + '|' + b] = v; n++;
              }
              patch.segment_prices = n > 0 ? out : null;
            }
            const { error } = await supabase.from('rides').update(patch).eq('id', ride.id);
            if (error) throw error;
            actionBusy = false;
            await refreshRide(ride.id);
          } catch (e) {
            saveStops.disabled = false; saveStops.textContent = 'Save stops';
            msg.textContent = (e && e.message) || 'Could not save stops.';
            msg.classList.remove('hidden');
          }
        });
        panel.appendChild(saveStops);
        panel.appendChild(neverMind());
        panel.classList.remove('hidden');
      });
      row.appendChild(editStopsBtn);

      // Cancel ONE confirmed booking.
      if (confirmedActive.length > 0) {
        const oneBtn = el('button', 'linkbtn', 'Cancel one booking');
        oneBtn.type = 'button';
        oneBtn.addEventListener('click', () => {
          actionBusy = true;
          clear(panel); msg.classList.add('hidden');
          panel.appendChild(el('div', 'rowhint', 'Which rider? They get a full refund and a note with your reason.'));
          for (const b of confirmedActive) {
            const pick = el('button', 'linkbtn', paxDisplay(b));
            pick.type = 'button';
            pick.addEventListener('click', () => {
              clear(panel);
              const ta = document.createElement('textarea');
              ta.placeholder = 'Reason (riders see this) — at least 10 characters';
              ta.rows = 3; ta.style.width = '100%'; ta.style.marginBottom = '8px';
              panel.appendChild(ta);
              const go2 = el('button', 'primary', 'Cancel ' + paxDisplay(b) + "'s booking");
              go2.type = 'button';
              go2.style.background = '#ff5d5d'; go2.style.color = '#2a0505';
              go2.addEventListener('click', async () => {
                msg.classList.add('hidden');
                if (ta.value.trim().length < 10) { msg.textContent = 'Give a reason — at least 10 characters.'; msg.classList.remove('hidden'); return; }
                go2.disabled = true; go2.textContent = 'Cancelling…';
                try {
                  await doCancelConfirmed(b, ride, ta.value.trim());
                  actionBusy = false;
                  await refreshRide(ride.id);
                } catch (e) {
                  go2.disabled = false; go2.textContent = 'Cancel ' + paxDisplay(b) + "'s booking";
                  msg.textContent = (e && e.message) || 'Cancellation failed — email support@seatsherpa.app.';
                  msg.classList.remove('hidden');
                }
              });
              panel.appendChild(go2);
              panel.appendChild(neverMind());
            });
            panel.appendChild(pick);
          }
          panel.appendChild(neverMind());
          panel.classList.remove('hidden');
        });
        row.appendChild(oneBtn);
      }

      // Cancel the whole ride.
      // "Just changing the time?" — mirrors lib/cancel-intent.ts in the app;
      // change both together. Empty rides only: with bookings the departure
      // is locked anyway.
      const TIME_CHANGE_RE = /(time|timing|date|day|earlier|later|sooner|reschedulw*|postponw*|delayw*|push(ed|ing)?s+(its+)?(back|forward|up|to)|mov(e|ed|ing)s+(its+)?(to|up|back)|leav(e|ing)s+(at|earlier|later|sooner)|departw*|tomorrow|tonight|morning|afternoon|evening|noon|(mon|tues?|wed(nes)?|thu(rs)?|fri|sat(ur)?|sun)(day)?|d{1,2}(:d{2})?s*(am|pm))/i;
      const canEditInstead = () => active.length === 0 && !!editBtn;
      function editInsteadBtn(label) {
        const b = el('button', 'primary', label || 'Edit date & time instead');
        b.type = 'button';
        b.style.marginRight = '8px';
        b.addEventListener('click', () => { actionBusy = false; editBtn.click(); });
        return b;
      }

      const cancelBtn = el('button', 'linkbtn', 'Cancel this ride');
      cancelBtn.type = 'button';
      cancelBtn.addEventListener('click', () => {
        actionBusy = true;
        clear(panel); msg.classList.add('hidden');
        // Empty ride → offer the edit BEFORE asking for a reason, like the app
        // (2026-09-01): editing keeps the listing, its link, its place in
        // search and every rider alert pointed at it.
        if (canEditInstead()) {
          panel.appendChild(el('div', 'rowhint',
            'No one has booked yet. Just changing the time? Edit the departure instead — the ride keeps its link, its place in search, and any rider alerts pointed at it.'));
          panel.appendChild(editInsteadBtn('Edit date & time instead'));
          const cont = el('button', 'linkbtn', 'No, cancel the ride');
          cont.type = 'button';
          cont.addEventListener('click', () => { clear(panel); renderCancelForm(); });
          panel.appendChild(cont);
          panel.appendChild(neverMind());
          panel.classList.remove('hidden');
          return;
        }
        renderCancelForm();
      });

      function renderCancelForm() {
        if (active.length > 0) {
          panel.appendChild(el('div', 'rowhint',
            active.length + ' active booking' + (active.length === 1 ? '' : 's') + ' on this ride — cancelling refunds every confirmed rider in full and declines pending requests.'));
        }
        const ta = document.createElement('textarea');
        ta.placeholder = 'Reason (riders see this) — at least 10 characters';
        ta.rows = 3; ta.style.width = '100%'; ta.style.marginBottom = '8px';
        panel.appendChild(ta);
        const go2 = el('button', 'primary', 'Cancel ride for everyone');
        go2.type = 'button';
        go2.style.background = '#ff5d5d'; go2.style.color = '#2a0505';
        let timeChangeAcked = false;
        go2.addEventListener('click', async () => {
          msg.classList.add('hidden');
          // Reason reads like a departure change on an empty ride → one more
          // chance to edit instead. Second click on the same button proceeds.
          if (!timeChangeAcked && canEditInstead() && TIME_CHANGE_RE.test(ta.value)) {
            timeChangeAcked = true;
            const hint = el('div', 'rowhint',
              'Sounds like a time change. You can edit the departure instead of cancelling — or cancel anyway.');
            panel.insertBefore(hint, go2);
            panel.insertBefore(editInsteadBtn('Edit date & time instead'), go2);
            go2.textContent = 'Cancel anyway';
            return;
          }
          go2.disabled = true; go2.textContent = 'Cancelling…';
          try {
            const out = await doCancelRide(ride, ta.value);
            if (out.failed > 0) {
              // Do NOT auto-refresh: the repaint would wipe this warning and
              // show the "riders were refunded in full" banner — false for
              // the rider whose refund call failed (Fable audit #2). Keep the
              // freeze until the driver acknowledges.
              clear(panel);
              panel.appendChild(el('div', 'banner warn',
                out.failed + ' booking' + (out.failed === 1 ? '' : 's') + " couldn't be cancelled automatically — that rider has NOT been refunded yet. Email support@seatsherpa.app and we'll finish it."));
              const ok = el('button', 'primary', 'OK, got it');
              ok.type = 'button';
              ok.addEventListener('click', async () => { actionBusy = false; await refreshRide(ride.id); });
              panel.appendChild(ok);
              return;
            }
            actionBusy = false;
            await refreshRide(ride.id);
          } catch (e) {
            go2.disabled = false; go2.textContent = 'Cancel ride for everyone';
            msg.textContent = (e && e.message) || 'Cancellation failed.';
            msg.classList.remove('hidden');
          }
        });
        panel.appendChild(go2);
        panel.appendChild(neverMind());
        panel.classList.remove('hidden');
      }
      row.appendChild(cancelBtn);

      wrap.appendChild(row);
      wrap.appendChild(panel);
      wrap.appendChild(msg);
      return wrap;
    }

    function renderList(entries) {
      const body = $('listBody');
      clear(body);

      // Stripe-first drop-off (2026-09-02): the deposits banner used to sit
      // ABOVE "No rides yet", so brand-new web drivers (and passengers who
      // wandered in) clicked Set up deposits before posting anything, hit
      // Stripe's SSN/bank form, and left. Deposits are the LAST step: the
      // banner only shows once a ride exists. Wallet still has the button.
      if (entries.length > 0) {
        const pb = payoutBanner();
        if (pb) body.appendChild(pb);
      }

      if (entries.length === 0) {
        const c = el('div', 'card center');
        c.appendChild(el('div', 'icon', '\ud83d\ude97'));
        c.appendChild(el('h1', null, 'No rides yet'));
        c.appendChild(el('p', 'sub', 'When you post a ride, it shows up here with its requests, riders and check-in.'));
        const steps = el('ol', 'sub');
        steps.style.cssText = 'text-align:left;display:inline-block;margin:4px auto 14px;padding-left:20px;line-height:1.7';
        ['Post a ride — date, route, price per seat (2 min)',
         'Snap your license so it can go live',
         'Connect deposits in Wallet once riders start booking'].forEach((t) => steps.appendChild(el('li', null, t)));
        c.appendChild(steps);
        const a = document.createElement('a');
        a.href = '/post?new=1';
        a.textContent = 'Post a ride \u2192';
        a.style.fontWeight = '700';
        c.appendChild(a);
        body.appendChild(c);
        body.appendChild(signedInFooter());
        show('stList');
        return;
      }

      const now = Date.now();
      const upcoming = [];
      const past = [];
      for (const e of entries) {
        const dep = departureMs(e.ride);
        // "Upcoming" = not departed yet, OR departed within the last 12h WITH
        // riders still on it (the completion cron's horizon), so a mid-trip
        // ride keeps its check-in on top. A departed ride nobody booked has
        // nothing left to do and goes straight to past (Justin, 2026-09-03:
        // "the ride at 8am is in the past, that should not be here").
        const live = e.bookings.some((b) => {
          const st = effectiveStatus(b, e.ride);
          return st === 'Confirmed' || st === 'Pending';
        });
        if (dep > now || (live && dep + 12 * 60 * 60 * 1000 > now)) upcoming.push(e);
        else past.push(e);
      }
      upcoming.sort((a, z) => {
        // Requests first - they are the most important thing on this page.
        if ((a.pendingCount > 0) !== (z.pendingCount > 0)) return a.pendingCount > 0 ? -1 : 1;
        return departureMs(a.ride) - departureMs(z.ride);
      });
      past.sort((a, z) => departureMs(z.ride) - departureMs(a.ride));

      const totalPending = entries.reduce((s, e) => s + e.pendingCount, 0);
      const totalUnread = entries.reduce((s, e) => s + e.unreadCount, 0);
      const seatsSold = upcoming.reduce((s, e) => s + e.bookedSeats, 0);
      const seatsTotal = upcoming.reduce((s, e) => s + e.totalSeats, 0);

      // Dashboard header: who you are and what's true right now, before the
      // list. The subtitle states the single most useful fact rather than
      // greeting for the sake of it.
      const head = el('div', 'dashhead');
      head.appendChild(el('h1', null, 'Driver dashboard'));
      head.appendChild(el('div', 'said',
        totalPending > 0
          ? 'You have ' + totalPending + ' seat request' + (totalPending === 1 ? '' : 's') + ' to answer.'
          : upcoming.length
            ? 'Next up: ' + routeLabel(upcoming[0].ride) + ' \u00b7 ' + whenLabel(upcoming[0].ride) + '.'
            : 'No upcoming rides \u2014 post one and it shows up here.'));
      body.appendChild(head);

      // Stat strip. Every number is derived from rides already loaded; money
      // deliberately lives in Wallet, so nothing here can be a guess.
      const stats = el('div', 'stats');
      const statTile = (n, k, cls, onClick) => {
        const t = el(onClick ? 'button' : 'div', 'stat' + (cls ? ' ' + cls : '') + (onClick ? ' link' : ''));
        if (onClick) { t.type = 'button'; t.addEventListener('click', onClick); }
        t.appendChild(el('div', 'n', String(n)));
        t.appendChild(el('div', 'k', k));
        return t;
      };
      stats.appendChild(statTile(upcoming.length, upcoming.length === 1 ? 'Upcoming ride' : 'Upcoming rides'));
      stats.appendChild(statTile(
        seatsTotal ? seatsSold + '/' + seatsTotal : '\u2014',
        'Seats booked'));
      stats.appendChild(statTile(totalPending, totalPending === 1 ? 'Request waiting' : 'Requests waiting',
        totalPending > 0 ? 'act' : ''));
      // location.href, not go(): go() is pushState within /driving, so it
      // would rewrite the URL and re-render this page instead of leaving.
      stats.appendChild(statTile(totalUnread, totalUnread === 1 ? 'Unread message' : 'Unread messages',
        '', () => { location.href = '/messages'; }));
      body.appendChild(stats);

      if (totalPending > 0) {
        body.appendChild(el('div', 'banner amber',
          totalPending + ' seat request' + (totalPending === 1 ? '' : 's') + ' waiting for your answer. '
          + "Riders' card holds expire after about 7 days \u2014 answer soon so nobody is left hanging."));
      }

      // Demand signals (2026-08-28, app dashboard parity): waitlist counts on
      // your rides + the hottest searched corridors this week. Both fail-soft
      // (services/driver-insights.ts pattern) and fill in after paint.
      const demandSlot = el('div');
      body.appendChild(demandSlot);
      (async () => {
        try {
          const [{ data: wl }, { data: rd }] = await Promise.all([
            supabase.rpc('driver_waitlist_counts'),
            supabase.rpc('route_search_demand'),
          ]);
          const bits = [];
          const wlTotal = (wl || []).reduce((s, r) => s + (Number(r.waitlisted) || 0), 0);
          if (wlTotal > 0) {
            bits.push(wlTotal + ' rider' + (wlTotal === 1 ? '' : 's') + ' waitlisted on your rides — they book the moment a seat opens.');
          }
          const top = (rd || [])[0];
          if (top && Number(top.searches) >= 3) {
            // NEVER show raw metro ids ("la", "sfba") publicly — full area
            // names via the shared catalog (Justin, 2026-08-28).
            const destName = (id) =>
              (window.SS_STOPS && SS_STOPS.STOP_BY_ID[id] && SS_STOPS.STOP_BY_ID[id].name) || String(id);
            bits.push('Hot this week: ' + destName(top.from_dest) + ' → ' + destName(top.to_dest) + ' searched '
              + top.searches + '× by ' + top.searchers + ' rider' + (Number(top.searchers) === 1 ? '' : 's')
              + '. Driving it? Post the ride.');
          }
          if (bits.length) demandSlot.appendChild(el('div', 'banner info', bits.join(' ')));
        } catch (_) { /* tiles are optional */ }
      })();

      if (upcoming.length) {
        body.appendChild(el('h2', null, 'Upcoming'));
        const upGrid = el('div', 'ridegrid');
        upcoming.forEach((e) => upGrid.appendChild(rideCard(e)));
        body.appendChild(upGrid);
      }
      if (past.length) {
        // Collapsed by default (Justin, 2026-08-28): finished rides are
        // reference, not work. The console should open on what still needs
        // the driver's attention. Choice is remembered for the session.
        const openPast = sessionStorage.getItem('ss_past_open') === '1';
        const head = el('button', 'pasthead');
        head.type = 'button';
        head.setAttribute('aria-expanded', String(openPast));
        const caret = el('span', 'caret', openPast ? '▾' : '▸');
        head.appendChild(caret);
        head.appendChild(el('span', null, 'Past rides'));
        head.appendChild(el('span', 'pastcount', String(past.length)));
        const pastWrap = el('div', 'ridegrid');
        if (!openPast) pastWrap.classList.add('hidden');
        past.slice(0, 10).forEach((e) => pastWrap.appendChild(rideCard(e, true)));
        head.addEventListener('click', () => {
          const nowOpen = pastWrap.classList.contains('hidden');
          pastWrap.classList.toggle('hidden', !nowOpen);
          caret.textContent = nowOpen ? '▾' : '▸';
          head.setAttribute('aria-expanded', String(nowOpen));
          try { sessionStorage.setItem('ss_past_open', nowOpen ? '1' : '0'); } catch (_) {}
        });
        body.appendChild(head);
        body.appendChild(pastWrap);
      }
      body.appendChild(signedInFooter());
      show('stList');
      document.title = 'Your rides \u2014 Seat Sherpa';
    }

    // -- RIDE CONSOLE -------------------------------------------------------
    // A half-typed decline reason or PIN must never be repainted away by the
    // background refresh - same freeze pattern as trips.html's cancel panel.
    let actionBusy = false;

    function rideIsLive() {
      return !$('stRide').classList.contains('hidden') && !actionBusy;
    }

    async function refreshRide(rideId) {
      if (!rideIsLive()) return;
      try {
        const fresh = await loadRideEntry(rideId);
        if (!rideIsLive()) return;
        if (fresh) renderRide(fresh);
      } catch (_) { /* transient - keep the current paint */ }
    }

    async function loadRideEntry(rideId) {
      const ride = await loadRide(rideId);
      if (!ride) return null;
      const bookings = await loadBookingsForRides([ride.id]);
      const unread = await loadUnreadCounts(bookings.map((b) => b.id));
      bookings.forEach((b) => { b._unread = unread.get(b.id) || 0; });
      return buildEntry(ride, bookings, unread);
    }

    function requestBox(b, ride) {
      const box = el('div', 'bookingbox request');
      const top = el('div', 'bookingtop');
      const seats = seatLabels(b, ride);
      top.appendChild(paxRow(b, riderRepLabel(b) + ' \u00b7 ' + seats.length + ' seat' + (seats.length === 1 ? '' : 's')
        + (seats.length ? ' \u00b7 ' + seats.join(', ') : '') + ' \u00b7 ' + fmt$(b.total_price)));
      top.appendChild(pill('Pending', 'Requested'));
      box.appendChild(top);

      const boarding = stopName(b.boarding_stop);
      const alighting = stopName(b.alighting_stop);
      if (boarding) box.appendChild(el('div', 'rowhint', 'On-route pickup: ' + boarding));
      if (alighting) box.appendChild(el('div', 'rowhint', 'On-route drop-off: ' + alighting));

      if (b.driver_message && String(b.driver_message).trim()) {
        box.appendChild(el('div', 'ridernote', 'Note from ' + paxFirst(b) + ': ' + String(b.driver_message).trim()));
      }

      const msg = el('div', 'rowmsg err hidden');

      // Accept: two-step inline confirm - this is the moment the rider's card
      // is actually charged, so it gets a deliberate second tap.
      const actions = el('div', 'actrow');
      const acceptBtn = el('button', 'primary', 'Accept');
      acceptBtn.type = 'button';
      const declineBtn = el('button', 'outline', 'Decline');
      declineBtn.type = 'button';
      actions.appendChild(acceptBtn);
      actions.appendChild(declineBtn);
      box.appendChild(actions);
      box.appendChild(el('div', 'rowhint',
        "Accepting charges " + paxFirst(b) + "'s card and confirms their seat. "
        + 'They get a push and an email the moment you do.'));
      // The app lets a driver chat with a requester BEFORE deciding
      // (app/chat/[bookingId].tsx has accept controls in the thread) - give
      // the web driver the same option.
      const askBtn = el('button', 'linkbtn', 'Message ' + paxFirst(b) + ' first'
        + (b._unread > 0 ? ' (' + b._unread + ' unread)' : ''));
      askBtn.type = 'button';
      askBtn.style.display = 'block';
      askBtn.style.margin = '10px auto 0';
      askBtn.addEventListener('click', () =>
        go('/driving?ride=' + encodeURIComponent(ride.id) + '&chat=' + encodeURIComponent(b.id)));
      box.appendChild(askBtn);
      box.appendChild(msg);

      // Confirm row (hidden until Accept is tapped once).
      const confirmRow = el('div', 'actrow hidden');
      const confirmBtn = el('button', 'primary', 'Yes, charge and confirm');
      confirmBtn.type = 'button';
      const backBtn = el('button', 'outline', 'Back');
      backBtn.type = 'button';
      confirmRow.appendChild(confirmBtn);
      confirmRow.appendChild(backBtn);
      box.appendChild(confirmRow);

      // Decline panel (optional reason).
      const declinePanel = el('div', 'hidden');
      const lbl = el('label', null, 'Reason (optional \u2014 shared with the rider in chat)');
      const ta = document.createElement('textarea');
      ta.maxLength = 500;
      ta.placeholder = 'e.g. Sorry \u2014 my plans changed and this seat is no longer open';
      declinePanel.appendChild(lbl);
      declinePanel.appendChild(ta);
      const dActions = el('div', 'actrow');
      const dConfirm = el('button', 'primary', 'Decline request');
      dConfirm.type = 'button';
      const dKeep = el('button', 'outline', 'Keep it');
      dKeep.type = 'button';
      dActions.appendChild(dConfirm);
      dActions.appendChild(dKeep);
      declinePanel.appendChild(dActions);
      declinePanel.appendChild(el('div', 'rowhint',
        "Declining releases the hold on the rider's card right away. They get a push and an email; the reason is never shown on their lock screen."));
      box.appendChild(declinePanel);

      function setBusy(v) {
        actionBusy = v;
        [acceptBtn, declineBtn, confirmBtn, backBtn, dConfirm, dKeep].forEach((x) => { x.disabled = v; });
        ta.disabled = v;
      }

      acceptBtn.addEventListener('click', () => {
        actionBusy = true; // freeze background refresh while deciding
        msg.classList.add('hidden');
        actions.classList.add('hidden');
        declinePanel.classList.add('hidden');
        confirmRow.classList.remove('hidden');
      });
      backBtn.addEventListener('click', () => {
        actionBusy = false;
        confirmRow.classList.add('hidden');
        actions.classList.remove('hidden');
      });
      confirmBtn.addEventListener('click', async () => {
        setBusy(true);
        confirmBtn.textContent = 'Confirming\u2026';
        try {
          await doAccept(b, ride);
          actionBusy = false;
          await refreshRide(ride.id);
        } catch (e) {
          setBusy(false);
          actionBusy = false;
          confirmBtn.textContent = 'Yes, charge and confirm';
          confirmRow.classList.add('hidden');
          actions.classList.remove('hidden');
          msg.textContent = acceptErrorCopy(e);
          msg.classList.remove('hidden');
          const deadCode = (e && ((e.body && e.body.code) || e.error)) || '';
          if (deadCode === 'BOOKING_CANCELLED_RACE' || deadCode === 'BOOKING_NOT_PENDING'
              || deadCode === 'AUTH_NOT_CAPTURABLE' || deadCode === 'RIDE_CANCELLED') {
            // The request is gone - refresh after a beat so the copy is read.
            setTimeout(() => { void refreshRide(ride.id); }, 3500);
          }
        }
      });

      declineBtn.addEventListener('click', () => {
        actionBusy = true;
        msg.classList.add('hidden');
        actions.classList.add('hidden');
        confirmRow.classList.add('hidden');
        declinePanel.classList.remove('hidden');
        ta.focus();
      });
      dKeep.addEventListener('click', () => {
        actionBusy = false;
        declinePanel.classList.add('hidden');
        actions.classList.remove('hidden');
      });
      dConfirm.addEventListener('click', async () => {
        setBusy(true);
        dConfirm.textContent = 'Declining\u2026';
        try {
          const outcome = await doDecline(b, ride, ta.value);
          actionBusy = false;
          if (outcome === 'already-confirmed') {
            setBusy(false);
            dConfirm.textContent = 'Decline request';
            msg.textContent = 'Already accepted (maybe in another tab) — to cancel it, use the Manage card below.';
            msg.classList.remove('hidden');
            setTimeout(() => { void refreshRide(ride.id); }, 3500);
            return;
          }
          if (outcome === 'already-cancelled') {
            setBusy(false);
            dConfirm.textContent = 'Decline request';
            msg.textContent = 'This request was already withdrawn or cancelled \u2014 nothing more to do.';
            msg.className = 'rowmsg ok';
            setTimeout(() => { void refreshRide(ride.id); }, 2500);
            return;
          }
          await refreshRide(ride.id);
        } catch (e) {
          setBusy(false);
          actionBusy = false;
          dConfirm.textContent = 'Decline request';
          msg.textContent = (e && e.status === 401)
            ? 'Your sign-in expired. Refresh the page and sign in again.'
            : ((e && e.message) || 'Could not decline just now. Try again.');
          msg.classList.remove('hidden');
        }
      });

      return box;
    }

    function confirmedBox(b, ride, st, unreadCount) {
      const box = el('div', 'bookingbox');
      const top = el('div', 'bookingtop');
      const seats = seatLabels(b, ride);
      const subBits = [seats.length + ' seat' + (seats.length === 1 ? '' : 's')];
      if (seats.length) subBits.push(seats.join(', '));
      subBits.push(fmt$(b.total_price));
      top.appendChild(paxRow(b, subBits.join(' \u00b7 ')));
      if (st === 'Completed') top.appendChild(pill('Completed'));
      else if (b.pickup_code_entered_at) top.appendChild(pill('Confirmed', 'On board'));
      else top.appendChild(pill('Confirmed'));
      box.appendChild(top);

      const boarding = stopName(b.boarding_stop);
      const alighting = stopName(b.alighting_stop);
      if (boarding) box.appendChild(el('div', 'rowhint', 'On-route pickup: ' + boarding));
      if (alighting) box.appendChild(el('div', 'rowhint', 'On-route drop-off: ' + alighting));

      const msg = el('div', 'rowmsg err hidden');
      const actions = el('div', 'actrow');

      const chatBtn = el('button', 'outline',
        'Message' + (unreadCount > 0 ? ' (' + unreadCount + ')' : ''));
      chatBtn.type = 'button';
      chatBtn.addEventListener('click', () =>
        go('/driving?ride=' + encodeURIComponent(ride.id) + '&chat=' + encodeURIComponent(b.id)));
      actions.appendChild(chatBtn);

      // Complete: only for checked-in Confirmed bookings. Time gate mirrors
      // the app; the message is completeBooking's, shown BEFORE the DB gets a
      // chance to reject (0206 would also block anything else).
      if (st === 'Confirmed' && b.pickup_code_entered_at) {
        const earliest = departureMs(ride) + COMPLETE_AFTER_DEPARTURE_MS;
        const completeBtn = el('button', 'primary', 'Mark completed');
        completeBtn.type = 'button';
        actions.appendChild(completeBtn);
        if (Date.now() < earliest) {
          completeBtn.disabled = true;
          const eta = new Date(earliest).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: DEFAULT_TZ }) + ' PT';
          box.appendChild(actions);
          box.appendChild(el('div', 'rowhint', 'Too early to mark complete. Try again after ' + eta + '.'));
        } else {
          box.appendChild(actions);
        }
        completeBtn.addEventListener('click', async () => {
          actionBusy = true;
          completeBtn.disabled = true; chatBtn.disabled = true;
          completeBtn.textContent = 'Completing\u2026';
          msg.classList.add('hidden');
          try {
            await doComplete(b, ride);
            actionBusy = false;
            await refreshRide(ride.id);
          } catch (e) {
            actionBusy = false;
            completeBtn.disabled = false; chatBtn.disabled = false;
            completeBtn.textContent = 'Mark completed';
            msg.textContent = (e && e.status === 401)
              ? 'Your sign-in expired. Refresh the page and sign in again.'
              : ((e && e.message) || 'Could not complete just now. Try again.');
            msg.classList.remove('hidden');
          }
        });
      } else {
        box.appendChild(actions);
      }

      // Departure passed, Confirmed, no PIN: the honest driver-side warning +
      // the no-show report (2026-08-28, app parity \u2014 booking-detail.tsx:783).
      // 1h grace after departure; the conditional update mirrors
      // services/bookings.ts reportNoShow exactly, and 0206 backs it server-side.
      const dep = departureMs(ride);
      if (st === 'Confirmed' && !b.pickup_code_entered_at && dep && Date.now() >= dep) {
        box.appendChild(el('div', 'rowhint',
          paxFirst(b) + " hasn't been checked in. You must enter their 4-digit code (below) to be paid for this seat. "
          + "Never enter a code for a rider who wasn't there."));
        if (!b.no_show_reported_at && Date.now() >= dep + 60 * 60 * 1000) {
          const nsBtn = el('button', 'outline', 'Report no-show');
          nsBtn.type = 'button';
          nsBtn.style.marginTop = '8px';
          nsBtn.addEventListener('click', async () => {
            if (nsBtn.dataset.armed !== '1') {
              nsBtn.dataset.armed = '1';
              nsBtn.textContent = 'Tap again to confirm \u2014 ' + paxFirst(b) + ' never showed';
              return;
            }
            nsBtn.disabled = true; nsBtn.textContent = 'Reporting\u2026';
            msg.classList.add('hidden');
            try {
              const { data, error } = await supabase
                .from('bookings')
                .update({ no_show_reported_at: new Date().toISOString() })
                .eq('id', b.id)
                .eq('status', 'Confirmed')
                .is('pickup_code_entered_at', null)
                .is('no_show_reported_at', null)
                .select('id');
              if (error) throw error;
              if (!data || data.length === 0) throw new Error('This booking can no longer be reported as a no-show.');
              firePush(b.passenger_id, 'Seat Sherpa',
                'Your driver reported you as a no-show. If this is wrong, open the booking to dispute within 48 hours.',
                { type: 'no_show_reported', bookingId: b.id });
              fireSystemChat(b.id,
                '\u26a0\ufe0f The driver reported this booking as a no-show. If that\u2019s not right, open the booking and tap "Dispute" within 48 hours.');
              await refreshRide(ride.id);
            } catch (e) {
              nsBtn.disabled = false; nsBtn.dataset.armed = ''; nsBtn.textContent = 'Report no-show';
              msg.textContent = (e && e.message) || 'Could not report just now.';
              msg.classList.remove('hidden');
            }
          });
          box.appendChild(nsBtn);
        } else if (b.no_show_reported_at) {
          box.appendChild(el('div', 'rowhint',
            'No-show reported. ' + paxFirst(b) + ' has 48 hours to dispute; if they don\u2019t, your payment for the seat is released automatically.'));
        }
      }

      // Rate your rider (2026-08-28, app parity \u2014 trips.tsx ratingQueue):
      // completed + PIN-entered bookings only, one rating per rater (the
      // ratings constraints enforce both server-side, migration 0093).
      if (st === 'Completed' && b.pickup_code_entered_at && !b._myRating) {
        const rateWrap = el('div');
        rateWrap.style.marginTop = '8px';
        const rateLbl = el('div', 'rowhint', 'How was ' + paxFirst(b) + ' as a rider?');
        rateWrap.appendChild(rateLbl);
        const starRow = el('div');
        starRow.style.cssText = 'display:flex;gap:6px;margin:6px 0;';
        let picked = 0;
        const starBtns = [];
        for (let i = 1; i <= 5; i++) {
          const sb = el('button', null, '\u2606');
          sb.type = 'button';
          sb.style.cssText = 'background:none;border:0;font-size:26px;color:#a3a3ae;cursor:pointer;padding:2px;';
          sb.addEventListener('click', () => {
            picked = i;
            starBtns.forEach((x, j) => {
              x.textContent = j < i ? '\u2605' : '\u2606';
              x.style.color = j < i ? '#FFD75A' : '#a3a3ae';
            });
            sendRate.classList.remove('hidden');
          });
          starBtns.push(sb);
          starRow.appendChild(sb);
        }
        rateWrap.appendChild(starRow);
        const sendRate = el('button', 'outline hidden', 'Submit rating');
        sendRate.type = 'button';
        sendRate.addEventListener('click', async () => {
          if (!picked) return;
          sendRate.disabled = true; sendRate.textContent = 'Submitting\u2026';
          msg.classList.add('hidden');
          try {
            const { error } = await supabase.from('ratings').insert({
              booking_id: b.id, rater_id: me, ratee_id: b.passenger_id,
              rater_role: 'driver', stars: picked, comment: null,
            });
            if (error && !/one_per_rater/.test(error.message || '')) throw error;
            b._myRating = picked;
            await refreshRide(ride.id);
          } catch (e) {
            sendRate.disabled = false; sendRate.textContent = 'Submit rating';
            msg.textContent = /can_rate/.test(String(e && e.message))
              ? 'The rating window has closed for this booking.'
              : ((e && e.message) || 'Could not submit just now.');
            msg.classList.remove('hidden');
          }
        });
        rateWrap.appendChild(sendRate);
        box.appendChild(rateWrap);
      } else if (st === 'Completed' && b._myRating) {
        box.appendChild(el('div', 'rowhint', 'You rated ' + paxFirst(b) + ' ' + b._myRating + '\u2605 \u2014 thanks!'));
      }

      box.appendChild(msg);
      return box;
    }

    function checkinCard(entry) {
      const ride = entry.ride;
      const confirmed = entry.bookings.filter((b) => effectiveStatus(b, ride) === 'Confirmed');
      if (confirmed.length === 0) return null;
      const dep = departureMs(ride);
      const horizon = dep + 12 * 60 * 60 * 1000;
      if (Date.now() > horizon) return null;

      const card = el('div', 'card checkin');
      card.appendChild(el('div', 'eyebrow', 'Start trip \u00b7 Check riders in'));

      const windowOpen = Date.now() >= dep - PICKUP_CODE_OPENS_BEFORE_MS;
      const waiting = confirmed.filter((b) => !b.pickup_code_entered_at);
      const boarded = confirmed.filter((b) => !!b.pickup_code_entered_at);

      for (const b of boarded) {
        const row = el('div', 'checkedrow');
        row.appendChild(el('span', null, paxDisplay(b)));
        row.appendChild(el('span', 'ok', '\u2713 Checked in'));
        card.appendChild(row);
      }

      if (waiting.length === 0) {
        card.appendChild(el('p', 'sub', 'Everyone is checked in. Safe drive!'));
        return card;
      }

      if (!windowOpen) {
        // Mirrors the app: the affordance stays hidden until 2h before -
        // entering a code starts the trip and releases the payout.
        card.appendChild(el('p', 'sub',
          'Check-in opens 2 hours before departure (' + dateLabel(ride.dep_date) + ' \u00b7 '
          + timeLabel(ride.dep_time) + '). Each rider has a 4-digit code in their booking \u2014 '
          + "you'll type it here when they're in the car."));
        return card;
      }

      card.appendChild(el('p', 'sub',
        'Ask each rider for the 4-digit code in their booking and type it here once '
        + "they're in the car. That's what marks the trip started \u2014 and it's how you get paid."));

      const wrap = el('div', 'pinwrap');
      const input = document.createElement('input');
      input.id = 'pinInput';
      input.type = 'text';
      input.inputMode = 'numeric';
      input.maxLength = 4;
      input.placeholder = '\u2022\u2022\u2022\u2022';
      input.autocomplete = 'off';
      const goBtn = el('button', 'primary', 'Check in');
      goBtn.type = 'button';
      wrap.appendChild(input);
      wrap.appendChild(goBtn);
      card.appendChild(wrap);

      const msg = el('div', 'rowmsg hidden');
      card.appendChild(msg);
      card.appendChild(el('div', 'rowhint',
        waiting.length + ' rider' + (waiting.length === 1 ? '' : 's') + ' still to check in: '
        + waiting.map((b) => paxDisplay(b)).join(', ')));

      // Freeze background refresh while a PIN is being typed — renderRide()
      // rebuilds the card, which would wipe a half-typed code. But the old
      // rule (stay frozen while ANY digits remain) meant an abandoned
      // half-PIN froze refresh until navigation (audit L3). Compromise: a
      // blurred, non-empty input keeps its freeze for 3 minutes, then the
      // page assumes abandonment and resumes refreshing.
      let pinFreezeTimer = null;
      input.addEventListener('focus', () => {
        actionBusy = true;
        if (pinFreezeTimer) { clearTimeout(pinFreezeTimer); pinFreezeTimer = null; }
      });
      input.addEventListener('blur', () => {
        if (!input.value.trim()) { actionBusy = false; return; }
        if (pinFreezeTimer) clearTimeout(pinFreezeTimer);
        pinFreezeTimer = setTimeout(() => { actionBusy = false; }, 180000);
      });
      input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); goBtn.click(); } });

      goBtn.addEventListener('click', async () => {
        msg.classList.add('hidden');
        const code = input.value.replace(/\D/g, '');
        if (code.length !== 4) {
          msg.textContent = 'Code must be 4 digits.';
          msg.className = 'rowmsg err';
          return;
        }
        actionBusy = true;
        goBtn.disabled = true; input.disabled = true;
        goBtn.textContent = 'Checking\u2026';
        const out = await doCheckin(ride, code);
        goBtn.disabled = false; input.disabled = false;
        goBtn.textContent = 'Check in';
        if (!out.ok) {
          // RPC failure strings are already written for drivers - verbatim.
          msg.textContent = out.error || 'That code did not match. Try again.';
          msg.className = 'rowmsg err';
          input.select();
          return;
        }
        input.value = '';
        actionBusy = false;
        if (out.alreadyEntered) {
          msg.textContent = (out.passengerName ? abbreviateName(out.passengerName) : 'That rider')
            + ' was already checked in.';
        } else if (out.remaining === 0) {
          msg.textContent = (out.passengerName ? abbreviateName(out.passengerName) : 'Rider')
            + ' checked in \u2014 everyone is on board. Safe drive!';
        } else {
          msg.textContent = (out.passengerName ? abbreviateName(out.passengerName) : 'Rider')
            + ' checked in.'
            + (typeof out.remaining === 'number'
              ? ' ' + out.remaining + ' more to go.' : '');
        }
        msg.className = 'rowmsg ok';
        await refreshRide(ride.id);
      });

      return card;
    }

    async function renderRide(entry) {
      clearTimers();
      actionBusy = false;
      const body = $('rideBody');
      clear(body);
      const ride = entry.ride;

      body.appendChild(backRow('All rides', () => go('/driving')));

      // Summary card
      const card = el('div', 'card');
      card.appendChild(el('div', 'eyebrow', 'Your ride'));
      card.appendChild(el('div', 'route', routeLabel(ride)));
      // The list shows cities; the opened ride is where you actually drive
      // from and to, so it shows the exact addresses (Justin, 2026-08-28).
      const fullAddr = fullRouteLabel(ride);
      if (fullAddr && fullAddr !== routeLabel(ride)) {
        card.appendChild(el('div', 'addr', fullAddr));
      }
      card.appendChild(el('div', 'meta', whenLabel(ride)));
      card.appendChild(el('div', 'meta',
        entry.bookedSeats + ' of ' + entry.totalSeats + ' seat' + (entry.totalSeats === 1 ? '' : 's') + ' booked'
        + (ride.instant ? ' \u00b7 Instant book' : ' \u00b7 Review each request')));
      body.appendChild(card);

      if (ride.cancelled_at) {
        // Raw status on purpose: a Confirmed booking surviving on a cancelled
        // ride means a refund call failed — saying "refunded in full" there
        // would be false (Fable audit #2).
        const unRefunded = entry.bookings.filter((b) => b.status === 'Confirmed').length;
        body.appendChild(el('div', 'banner warn',
          unRefunded > 0
            ? 'This ride is cancelled, but ' + unRefunded + ' booking' + (unRefunded === 1 ? '' : 's') + " couldn't be refunded automatically — email support@seatsherpa.app and we'll finish it."
            : 'This ride is cancelled. Riders were refunded in full; nothing more to do here.'));
      }

      const pb = payoutBanner();
      if (pb) body.appendChild(pb);

      const pending = entry.bookings.filter((b) => effectiveStatus(b, ride) === 'Pending');
      const confirmed = entry.bookings.filter((b) => {
        const st = effectiveStatus(b, ride);
        return st === 'Confirmed' || st === 'Completed';
      });
      const cancelled = entry.bookings.filter((b) => effectiveStatus(b, ride) === 'Cancelled');

      // Requests first - the most important thing on the page.
      if (pending.length > 0 && !ride.cancelled_at) {
        body.appendChild(el('h2', null, 'Requests waiting'));
        pending.forEach((b) => body.appendChild(requestBox(b, ride)));
      }

      // Check-in card (Confirmed riders, day-of).
      if (!ride.cancelled_at) {
        const ci = checkinCard(entry);
        if (ci) body.appendChild(ci);
      }

      if (confirmed.length > 0) {
        body.appendChild(el('h2', null, 'Your riders'));
        // Mark bookings I already rated so the star row doesn't re-offer
        // (fail-soft: an error just re-shows the row; the one-per-rater
        // constraint catches the duplicate).
        try {
          const doneIds = confirmed.filter((b) => effectiveStatus(b, ride) === 'Completed').map((b) => b.id);
          if (doneIds.length && !confirmed.some((b) => b._ratingsChecked)) {
            const { data: myRs } = await supabase
              .from('ratings')
              .select('booking_id, stars')
              .eq('rater_id', me)
              .in('booking_id', doneIds);
            for (const b of confirmed) {
              b._ratingsChecked = true;
              const r = (myRs || []).find((x) => x.booking_id === b.id);
              if (r) b._myRating = r.stars;
            }
          }
        } catch (_) {}
        confirmed.forEach((b) =>
          body.appendChild(confirmedBox(b, ride, effectiveStatus(b, ride), b._unread || 0)));
      }

      if (pending.length === 0 && confirmed.length === 0 && !ride.cancelled_at) {
        body.appendChild(el('div', 'banner neutral',
          'No riders yet. Requests and bookings show up here the moment they land \u2014 you also get an email.'));
      }

      if (cancelled.length > 0) {
        body.appendChild(el('h2', null, 'Cancelled'));
        cancelled.forEach((b) => {
          const box = el('div', 'bookingbox');
          const top = el('div', 'bookingtop');
          top.appendChild(paxRow(b, (b.seat_ids || []).length + ' seat' + ((b.seat_ids || []).length === 1 ? '' : 's')));
          top.appendChild(pill('Cancelled'));
          box.appendChild(top);
          if (b.cancel_reason && String(b.cancel_reason).trim()) {
            box.appendChild(el('div', 'rowhint', 'Reason: ' + String(b.cancel_reason).trim()));
          }
          body.appendChild(box);
        });
      }

      // Manage (edit / cancel) \u2014 the full flows, in the browser. The old
      // banner here said "do it in the Seat Sherpa app": exactly the funnel
      // the standing rule bans.
      if (!ride.cancelled_at) { const seatsCard = seatsSection(entry); if (seatsCard) body.appendChild(seatsCard); }
      if (!ride.cancelled_at) body.appendChild(manageSection(entry));

      // Post again (2026-08-28, app refill parity): same route/seats/price on
      // a fresh date \u2014 the cheapest supply we have.
      {
        const again = document.createElement('a');
        again.href = '/post?refill=' + encodeURIComponent(ride.id);
        again.textContent = 'Post this route again \u2192';
        again.style.cssText = 'display:block;text-align:center;margin:4px 0 10px;font-weight:700;';
        body.appendChild(again);
      }

      body.appendChild(signedInFooter());
      show('stRide');
      document.title = routeLabel(ride) + ' \u2014 Seat Sherpa';

      // Refresh cadence: fast while something can change under the driver
      // (pending requests, day-of check-in), slow otherwise. Frozen whenever
      // an action panel is open (actionBusy) via rideIsLive().
      const dep = departureMs(ride);
      const dayOf = dep && Math.abs(Date.now() - dep) < 12 * 60 * 60 * 1000;
      const cadence = (pending.length > 0 || dayOf) ? 30000 : 60000;
      every(cadence, () => { void refreshRide(ride.id); });
    }

    // -- CHAT ---------------------------------------------------------------
    // trips.html's polling chat, sides swapped: here *I* am the driver and the
    // other party is the rider. Same honest trade-offs (up to ~6s latency,
    // pauses while hidden).
    const MSG_SELECT = 'id, booking_id, sender_id, body, created_at, read_at, is_system';
    let chatMsgs = new Map();
    let chatSince = null;
    let composerFocused = false;

    function uuid() {
      try { return crypto.randomUUID(); } catch (_) {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
          const r = (Math.random() * 16) | 0;
          return (c === 'x' ? r : ((r & 0x3) | 0x8)).toString(16);
        });
      }
    }

    function orderedMsgs() {
      return Array.from(chatMsgs.values()).sort((a, z) => {
        const d = String(a.created_at).localeCompare(String(z.created_at));
        return d !== 0 ? d : String(a.id).localeCompare(String(z.id));
      });
    }

    function absorb(rows) {
      let changed = false;
      for (const r of rows || []) {
        const prev = chatMsgs.get(r.id);
        chatMsgs.set(r.id, Object.assign({}, prev || {}, r, { _state: null }));
        if (!prev) changed = true;
        if (!chatSince || String(r.created_at) > chatSince) chatSince = String(r.created_at);
      }
      return changed;
    }

    function paintThread() {
      const box = $('chatThread');
      if (!box) return;
      const atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 60;
      clear(box);
      const rows = orderedMsgs();
      if (rows.length === 0) {
        box.appendChild(el('div', 'emptythread',
          'No messages yet. Say hi \u2014 riders usually reply quickly.'));
      }
      for (const m of rows) {
        const mine = m.sender_id === me;
        const sys = m.is_system === true;
        const row = el('div', 'brow ' + (sys ? 'sys' : mine ? 'me' : 'them'));
        const bub = el('div', 'bubble' + (m._state === 'sending' ? ' sending' : m._state === 'failed' ? ' failed' : ''));
        bub.textContent = m.body || '';
        row.appendChild(bub);
        box.appendChild(row);
        if (!sys) {
          const t = el('div', 'btime', m._state === 'sending' ? 'Sending\u2026'
            : m._state === 'failed' ? 'Not sent \u2014 tap send to retry'
            : new Date(m.created_at).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }));
          if (!mine) t.style.textAlign = 'left';
          box.appendChild(t);
        }
      }
      if (atBottom) box.scrollTop = box.scrollHeight;
    }

    async function pollMessages(bookingId, initial) {
      let q = supabase.from('messages').select(MSG_SELECT).eq('booking_id', bookingId).order('created_at', { ascending: true });
      if (!initial && chatSince) q = q.gte('created_at', chatSince);
      const { data, error } = await q;
      if (error) throw error;
      const changed = absorb(data);
      if (changed || initial) paintThread();
      if (changed) void markRead(bookingId);
      return data || [];
    }

    async function markRead(bookingId) {
      try {
        await supabase.from('messages')
          .update({ read_at: new Date().toISOString() })
          .eq('booking_id', bookingId)
          .neq('sender_id', me)
          .is('read_at', null);
      } catch (_) { /* read receipts are cosmetic */ }
    }

    function threadIsHot() {
      if (composerFocused) return true;
      const rows = orderedMsgs();
      if (rows.length === 0) return false;
      const last = rows[rows.length - 1];
      return Date.now() - new Date(last.created_at).getTime() < 5 * 60 * 1000;
    }

    function renderChat(entry, b) {
      const ride = entry.ride;
      const body = $('chatBody');
      clear(body);
      chatMsgs = new Map();
      chatSince = null;
      composerFocused = false;

      body.appendChild(backRow('Back to ride', () => go('/driving?ride=' + encodeURIComponent(ride.id))));

      const card = el('div', 'card');
      card.appendChild(el('div', 'eyebrow', routeLabel(ride) + ' \u00b7 ' + dateLabel(ride.dep_date)));
      card.appendChild(el('h1', null, paxDisplay(b)));
      card.appendChild(el('p', 'sub',
        'Messages here reach ' + paxFirst(b) + ' in the Seat Sherpa app (or on their trips page). '
        + 'This page checks for replies every few seconds while it\u2019s open.'));

      const thread = el('div', 'thread');
      thread.id = 'chatThread';
      card.appendChild(thread);

      // CALL (2026-09-03, app parity): the number comes from counterparty_phone()
      // — Confirmed/Completed only, 24h either side of departure, parties only —
      // and is fetched only when tapped. The pre-checks just give a friendlier
      // message than the RPC's empty result.
      const callRow = el('div', 'callrow');
      callRow.style.cssText = 'display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:6px 0 10px;';
      const callBtn = el('button', 'linkbtn', 'Call ' + String(paxDisplay(b) || 'your rider').split(' ')[0]);
      callBtn.type = 'button';
      callBtn.style.cssText = 'border:1px solid #00a8a0;color:#00a8a0;background:transparent;border-radius:999px;padding:8px 14px;font-weight:700;font-size:14px;cursor:pointer;';
      const callMsg = el('div', 'msg hidden');
      callMsg.style.cssText = 'font-size:13px;color:#6b7280;margin:0;';
      callRow.appendChild(callBtn);
      callRow.appendChild(callMsg);
      card.appendChild(callRow);
      callBtn.addEventListener('click', async () => {
        callMsg.classList.add('hidden');
        const say = (t) => { callMsg.textContent = t; callMsg.classList.remove('hidden'); };
        const st = (b.pickup_code_entered_at ? 'Completed' : b.status);
        if (st !== 'Confirmed' && st !== 'Completed') { say('Calling opens once the booking is confirmed — message here for now.'); return; }
        const dep = departureMs(ride);
        const H = 3600 * 1000;
        if (Number.isFinite(dep)) {
          const now = Date.now();
          if (now < dep - 24 * H) {
            const h = Math.ceil((dep - 24 * H - now) / H);
            say('Calling opens 24 hours before pickup (' + (h <= 24 ? 'in ' + h + (h === 1 ? ' hour' : ' hours') : 'in ' + Math.round(h / 24) + ' days') + '). Until then, message here.');
            return;
          }
          if (now > dep + 24 * H) { say('Calling closed 24 hours after the ride. Message here instead.'); return; }
        }
        callBtn.disabled = true;
        try {
          const { data, error } = await supabase.rpc('counterparty_phone', { p_booking_id: b.id });
          const row = Array.isArray(data) ? data[0] : data;
          const cc = String((row && row.phone_country_code) || '').replace(/\D/g, '');
          const num = String((row && row.phone) || '').replace(/\D/g, '');
          if (error || !cc || !num) { say("They haven't added a phone number yet — message here instead."); return; }
          location.href = 'tel:+' + cc + num;
        } catch (_) {
          say("Couldn't get the number just now — try again in a moment.");
        } finally {
          callBtn.disabled = false;
        }
      });

      const composer = el('div', 'composer');
      const ta = document.createElement('textarea');
      ta.placeholder = 'Message ' + paxFirst(b) + '\u2026';
      ta.maxLength = 2000; // same cap as sendMessage()
      ta.rows = 1;
      const sendBtn = el('button', 'primary', 'Send');
      sendBtn.type = 'button';
      composer.appendChild(ta);
      composer.appendChild(sendBtn);
      card.appendChild(composer);

      const cmsg = el('div', 'msg err hidden');
      card.appendChild(cmsg);
      body.appendChild(card);
      body.appendChild(signedInFooter());

      ta.addEventListener('focus', () => { composerFocused = true; });
      ta.addEventListener('blur', () => { composerFocused = false; });
      ta.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey && !/Mobi|Android/i.test(navigator.userAgent)) {
          e.preventDefault(); sendBtn.click();
        }
      });

      async function doSend() {
        cmsg.classList.add('hidden');
        const failed = orderedMsgs().filter((m) => m._state === 'failed');
        let text = ta.value.trim();
        let retryRow = null;
        if (!text && failed.length) { retryRow = failed[failed.length - 1]; text = retryRow.body; }
        if (!text) return;
        if (text.length > 2000) { cmsg.textContent = 'That message is too long (2000 characters max).'; cmsg.classList.remove('hidden'); return; }
        // Off-platform contact WARNING — never a block (app parity,
        // lib/off-platform-guard.ts: one matched adult telling another how to
        // reach them is their call; we just remind them what they give up).
        // Covers plain numbers AND the letter-interleaved evasion (0216).
        if (!retryRow && sendBtn.dataset.warned !== text) {
          let hit = /(^|\D)(\+?1[\s.\-·]?)?\(?\d{3}\)?[\s.\-·]?\d{3}[\s.\-·]?\d{4}(?!\d)/.test(text);
          if (!hit) {
            const digs = [];
            for (let i2 = 0; i2 < text.length; i2++) if (text[i2] >= '0' && text[i2] <= '9') digs.push(i2);
            for (let i2 = 0; i2 + 9 < digs.length; i2++) {
              const win = text.slice(digs[i2], digs[i2 + 9] + 1);
              if (win.length <= 20 && !/^((19|20)\d\d\D{0,3})+$/.test(win)) { hit = true; break; }
            }
          }
          if (hit) {
            sendBtn.dataset.warned = text;
            cmsg.textContent = 'Heads up: sharing phone numbers moves things off Seat Sherpa — payments and no-show protection only work in here, and you can call each other from the app once the trip is near. Tap Send again to share it anyway.';
            cmsg.classList.remove('hidden');
            return;
          }
        }
        sendBtn.dataset.warned = '';
        cmsg.classList.add('hidden');

        const id = retryRow ? retryRow.id : uuid();
        const now = new Date().toISOString();
        chatMsgs.set(id, { id, booking_id: b.id, sender_id: me, body: text, created_at: retryRow ? retryRow.created_at : now, read_at: null, is_system: false, _state: 'sending' });
        ta.value = '';
        sendBtn.disabled = true;
        paintThread();

        try {
          const { data, error } = await supabase
            .from('messages')
            .insert({ id, booking_id: b.id, sender_id: me, body: text })
            .select(MSG_SELECT)
            .single();
          if (error) throw error;
          absorb([data]);
          paintThread();
          // Push the rider - mirrors sendMessage (services/messages.ts:672):
          // branded title, "driver <name>" body, never the message content.
          // myName is name_public ("First L.") and send-push re-abbreviates
          // idempotently for type:'new_message'. Fire-and-forget.
          if (b.passenger_id && b.passenger_id !== me) {
            callFn('send-push', {
              recipientIds: [b.passenger_id],
              title: 'Seat Sherpa',
              body: myName
                ? 'You have a new message from driver ' + myName
                : 'You have a new message',
              data: { type: 'new_message', bookingId: b.id, messageId: id },
            }).catch(() => {});
          }
        } catch (e) {
          const row = chatMsgs.get(id);
          if (row) { row._state = 'failed'; chatMsgs.set(id, row); }
          paintThread();
          cmsg.textContent = (e && e.message)
            ? 'Message not sent: ' + e.message
            : 'Message not sent. Check your connection and tap Send to retry.';
          cmsg.classList.remove('hidden');
        } finally {
          sendBtn.disabled = false;
        }
      }
      sendBtn.addEventListener('click', doSend);

      show('stChat');
      document.title = 'Chat with ' + paxDisplay(b) + ' \u2014 Seat Sherpa';

      pollMessages(b.id, true)
        .then(() => markRead(b.id))
        .catch(() => {
          cmsg.textContent = "We couldn't load this conversation. Refresh, or email support@seatsherpa.app.";
          cmsg.classList.remove('hidden');
        });

      let sinceLastTick = 0;
      every(2000, () => {
        if (document.hidden) return;
        sinceLastTick += 2000;
        const interval = threadIsHot() ? 6000 : 20000;
        if (sinceLastTick < interval) return;
        sinceLastTick = 0;
        pollMessages(b.id, false).catch(() => {});
      });

      const catchUp = () => {
        if (document.hidden) return;
        sinceLastTick = 0;
        pollMessages(b.id, false).catch(() => {});
      };
      document.addEventListener('visibilitychange', catchUp);
      window.addEventListener('focus', catchUp);
      chatListenerCleanup = () => {
        document.removeEventListener('visibilitychange', catchUp);
        window.removeEventListener('focus', catchUp);
      };
    }

    let chatListenerCleanup = null;

    // -- Render -------------------------------------------------------------
    async function render() {
      clearTimers();
      if (chatListenerCleanup) { chatListenerCleanup(); chatListenerCleanup = null; }
      actionBusy = false;

      const qp = new URLSearchParams(location.search);
      let rideParam = qp.get('ride');
      const chatParam = qp.get('chat');
      // The booking emails deep-link /driving?bookingId=N (Fable audit #3):
      // resolve it to the booking's ride so "Review & respond" actually lands
      // on the request instead of the list. Runs after auth below.
      const bookingParam = qp.get('bookingId');

      let session = null;
      try {
        const { data } = await supabase.auth.getSession();
        session = data ? data.session : null;
      } catch (_) { session = null; }

      if (!session) {
        setMsg('emailMsg', '');
        show('stEmail');
        document.title = 'Your rides \u2014 Seat Sherpa';
        return;
      }

      show('stLoading');
      try {
        // getUser() = fresh /auth/v1/user round trip - a revoked session
        // surfaces as a sign-in prompt, not an empty list.
        const { data: ud, error: uerr } = await supabase.auth.getUser();
        if (uerr || !ud || !ud.user) { show('stEmail'); return; }
        me = ud.user.id; try { localStorage.setItem('ss_last_role', 'driver'); } catch (_) {} // /signin routes by last role
        myEmail = ud.user.email || '';
        $('nfEmail').textContent = myEmail;

        if (!payout.loaded) await loadPayoutState();

        // bookingId → ride resolution (RLS: the driver can read bookings on
        // their own rides; a bogus/foreign id just falls through to the list).
        if (!rideParam && bookingParam) {
          const bid = parseInt(bookingParam, 10);
          if (Number.isFinite(bid) && bid > 0) {
            try {
              const { data: bk } = await supabase
                .from('bookings').select('ride_id').eq('id', bid).maybeSingle();
              if (bk && bk.ride_id) rideParam = String(bk.ride_id);
            } catch (_) { /* fall through to the list */ }
          }
        }

        if (!rideParam) {
          const rides = await loadMyRides();
          const bookings = await loadBookingsForRides(rides.map((r) => r.id));
          const unread = await loadUnreadCounts(bookings.map((b) => b.id));
          const entries = rides.map((r) => buildEntry(r, bookings, unread));
          renderList(entries);
          // AUTO-REFRESH (sweep 2026-09-03): the list sat stale until a manual
          // reload, so a new request only ever arrived by email. Poll a cheap
          // signature every 60s while the tab is visible and re-render only
          // when it changed — an open "Past rides" section is not collapsed
          // for nothing. Bookings (count + pending count) are the signal.
          const sigOf = (list) => list.map((e) => {
            const r = e.ride || e;
            const bs = Array.isArray(e.bookings) ? e.bookings : [];
            return r.id + ':' + bs.length + ':' + bs.filter((b) => b.status === 'Pending').length;
          }).join('|');
          let listSig = sigOf(entries);
          every(60000, async () => {
            if (document.hidden || actionBusy) return;
            try {
              const rides2 = await loadMyRides();
              const bookings2 = await loadBookingsForRides(rides2.map((r) => r.id));
              const unread2 = await loadUnreadCounts(bookings2.map((b) => b.id));
              const sig = sigOf(rides2.map((r) => buildEntry(r, bookings2, unread2)));
              if (sig !== listSig) { listSig = sig; render(); }
            } catch (_) { /* next tick */ }
          });
          return;
        }

        const rideId = parseInt(rideParam, 10);
        if (!Number.isFinite(rideId) || rideId <= 0) {
          show('stNotFound');
          document.title = 'Ride not found \u2014 Seat Sherpa';
          return;
        }
        const entry = await loadRideEntry(rideId);
        if (!entry) {
          show('stNotFound');
          document.title = 'Ride not found \u2014 Seat Sherpa';
          return;
        }
        if (chatParam) {
          const bId = parseInt(chatParam, 10);
          const b = entry.bookings.find((x) => x.id === bId);
          if (b) { renderChat(entry, b); return; }
          // Unknown booking id on my ride -> fall through to the ride view.
        }
        renderRide(entry);
      } catch (e) {
        $('errSub').textContent = (e && e.message)
          ? "We couldn't load that: " + e.message
          : 'Something went wrong on our end. Check your connection and try again.';
        show('stError');
      }
    }

    // Stripe return (?stripe=return|refresh): web-stripe-onboarding-link's
    // contract sends the driver back to /post, not here - but if that fn ever
    // grows a /driving return, or the driver pastes the URL with the param,
    // reconcile Connect status before first paint (the Rohan lesson).
    (async () => {
      const qp = new URLSearchParams(location.search);
      const stripeReturn = qp.get('stripe');
      if (stripeReturn === 'return' || stripeReturn === 'refresh') {
        try {
          const { data } = await supabase.auth.getSession();
          if (data && data.session) await callFn('stripe-refresh-account-status', {});
        } catch (_) {}
        const clean = new URLSearchParams(location.search);
        clean.delete('stripe');
        const rest = clean.toString();
        history.replaceState(null, '', '/driving' + (rest ? '?' + rest : ''));
      }
      render();
    })();
  </script>
</body>
</html>
