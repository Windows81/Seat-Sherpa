    /** Per-ride aggregates, mirroring getMyRidesWithBookings (bookings.ts:309):
     *  pendingCount, bookedSeats, totalSeats (open + held; CLOSED seats with no
     *  booking don't count), unreadCount. */
    function buildEntry(ride, bookings, unread) {
      const rideBookings = bookings.filter((b) => b.ride_id === ride.id);
      const active = rideBookings.filter((b) => b.status !== 'Cancelled');
      const pendingCount = rideBookings.filter((b) => effectiveStatus(b, ride) === 'Pending').length;
      const bookedSeats = active.reduce((sum, b) => sum + ((b.seat_ids || []).length), 0);
      const held = new Set();
      active.forEach((b) => (b.seat_ids || []).forEach((id) => held.add(id)));
      const seats = Array.isArray(ride.seats) ? ride.seats : [];
      const totalSeats = seats.filter((s) => s && !s.isDriver && (s.avail || held.has(s.id))).length;
      const unreadCount = rideBookings.reduce((sum, b) => sum + (unread.get(b.id) || 0), 0);
      return { ride, bookings: rideBookings, pendingCount, bookedSeats, totalSeats, unreadCount };
    }

