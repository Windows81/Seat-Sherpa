    // DORMANT DRIVER (0323, Justin 2026-09-29): a driver whose booking
    // requests went a week unanswered has every open seat closed until they
    // reactivate. The email carries a one-click link; this is the same button
    // for someone who lands here instead. my_dormant_state() reads only the
    // caller's own row; reactivate_my_rides() reopens the seats the pause
    // closed (never one a confirmed rider holds) and clears the flag.
    async function loadDormantState() {
      dormant = { loaded: true, at: null };
      try {
        const { data, error } = await supabase.rpc('my_dormant_state');
        if (!error && data && data.dormant_at) dormant.at = data.dormant_at;
      } catch (_) { /* pre-0323 database or a blip: no banner */ }
    }

    function dormantBanner() {
      if (!dormant.loaded || !dormant.at) return null;
      const bn = el('div', 'banner warn');
      bn.appendChild(el('strong', null, 'Your rides are paused. '));
      bn.appendChild(document.createTextNode(
        'Booking requests went a week without an answer, so riders can only join your waitlists. '
        + 'Reactivate to open your seats again; anyone waiting hears that seats opened.'));
      const btn = el('button', 'primary', 'Reactivate my rides');
      btn.type = 'button';
      const msg = el('div', 'msg err hidden');
      btn.addEventListener('click', async () => {
        btn.disabled = true; btn.textContent = 'Reactivating…';
        msg.classList.add('hidden');
        try {
          const { data, error } = await supabase.rpc('reactivate_my_rides');
          if (error) throw error;
          if (!data || (data.ok !== true && data.reason !== 'not_dormant')) {
            throw new Error((data && data.reason) || 'Could not reactivate.');
          }
          dormant = { loaded: true, at: null };
          await render();
        } catch (e) {
          btn.disabled = false; btn.textContent = 'Reactivate my rides';
          msg.textContent = (e && e.message) || 'Could not reactivate. Try again, or use the link in the email we sent.';
          msg.classList.remove('hidden');
        }
      });
      bn.appendChild(btn);
      bn.appendChild(msg);
      return bn;
    }

    function payoutBanner() {
      if (!payout.loaded || payout.credit) return null;
      if (payout.started && payout.enabled) return null;
      const bn = el('div', 'banner amber');
      bn.appendChild(el('strong', null, 'Deposits not set up. '));
