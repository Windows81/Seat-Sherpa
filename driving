        panel.appendChild(sectionLabel('Departure time', true));
        panel.appendChild(helper('Can you leave a bit earlier or later if it helps a rider?'));
        // Same pill toggles as the stops editor above, single-select.
        const flexRow = el('div');
        flexRow.style.display = 'flex'; flexRow.style.flexWrap = 'wrap'; flexRow.style.gap = '8px'; flexRow.style.margin = '10px 0 0';
        flexRow.setAttribute('role', 'radiogroup'); flexRow.setAttribute('aria-label', 'Departure time');
        const paintFlex = () => {
          clear(flexRow);
          for (const c of FLEX_CHOICES) {
            const on = c.v === flexSel;
            const chip = el('button', 'linkbtn', c.label);
            chip.type = 'button';
