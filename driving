          }
        });
        panel.appendChild(saveStops);
        panel.appendChild(neverMind());
        panel.classList.remove('hidden');
      });
      if (!ridePast) row.appendChild(editStopsBtn);

      // Edit note + flexible departure (0326). Allowed with bookings: the
      // note is advisory and a wider departure window changes no price. The
      // DB trigger refuses contact details and over-long notes; noteProblem
      // words the same refusal before the row is touched.
      const noteSet = !!String(ride.driver_note || '').trim() || (Number(ride.depart_flex_minutes) || 0) > 0;
      const editNoteBtn = el('button', 'linkbtn', noteSet ? 'Edit note' : 'Add a note or flexible time');
      editNoteBtn.type = 'button';
      editNoteBtn.addEventListener('click', () => {
        actionBusy = true;
        clear(panel); msg.classList.add('hidden');
        let flexSel = FLEX_CHOICES.some((c) => c.v === Number(ride.depart_flex_minutes)) ? Number(ride.depart_flex_minutes) : 0;
        const sectionLabel = (text, first) => {
          const l = el('div', null, text);
          l.style.fontWeight = '600'; l.style.fontSize = '14px'; l.style.color = 'var(--text2)';
