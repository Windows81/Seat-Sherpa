    }

    /** "Ask for ID verification" (0331). On the OPENED booking (the chat
     *  panel), never in the rider list rows (Justin, 2026-10-02). A driver can
     *  ask a rider without the badge once per booking: request-id-verification
     *  posts a system line in this chat, pushes and emails the rider, and
     *  stamps bookings.id_verify_requested_at. Pending/Confirmed, ride not
     *  departed. Quiet paxsub-styled text; on success it simply becomes
     *  "Asked". Server text lands via textContent only. */
    function askIdVerificationLine(b, ride) {
      if (!b || !ride) return null;
      if (b.passenger && b.passenger.id_verified === true) return null;
      if (b.status !== 'Pending' && b.status !== 'Confirmed') return null;
      if (b.id_verify_requested_at) return el('div', 'paxsub', 'Asked');
      const dep = departureMs(ride);
      if (!dep || dep <= Date.now()) return null;
      const wrap = el('div');
      const btn = el('button', 'asklink', 'Ask for ID verification');
      btn.type = 'button';
      const msg = el('div', 'msg err hidden');
      msg.style.cssText = 'font-size:12px;margin:4px 0 0;';
      // Ask first (Justin, 2026-10-22): one stray tap used to message, push
      // and email the rider. The link now opens a confirm line; nothing is
      // sent until "Send request".
      const first = paxFirst(b);
      const First = first.charAt(0).toUpperCase() + first.slice(1);
      const confirmBox = el('div', 'hidden');
      confirmBox.appendChild(el('div', 'paxsub', 'Ask ' + first + ' to get ID verified? ' + First + ' gets a message in this chat, a notification and an email. You can only ask once per booking.'));
      const row = el('div');
      row.style.cssText = 'display:flex;gap:18px;align-items:center;';
      const sendBtn = el('button', 'asklink', 'Send request');
      sendBtn.type = 'button';
      sendBtn.style.fontWeight = '600';
      const never = el('button', 'asklink', 'Never mind');
      never.type = 'button';
      row.appendChild(sendBtn);
      row.appendChild(never);
      confirmBox.appendChild(row);
      btn.addEventListener('click', () => {
        msg.classList.add('hidden');
        btn.classList.add('hidden');
        confirmBox.classList.remove('hidden');
      });
      never.addEventListener('click', () => {
        confirmBox.classList.add('hidden');
        btn.classList.remove('hidden');
      });
      sendBtn.addEventListener('click', async () => {
        sendBtn.disabled = true;
        never.disabled = true;
        msg.classList.add('hidden');
        let out;
        try {
          out = await callFn('request-id-verification', { bookingId: b.id });
        } catch (e) {
          const code = e && e.body && e.body.code;
          msg.textContent = (e && e.status === 401)
            ? 'Your sign-in expired. Refresh the page and sign in again.'
            : (code === 'MIGRATION_PENDING')
              ? 'Not available yet. Try again later.'
              : ((e && e.message) || 'Could not send the request just now. Try again.');
          msg.classList.remove('hidden');
          sendBtn.disabled = false;
          never.disabled = false;
          return;
        }
        if (out && out.ok) {
          // Both a fresh ask and "already asked" end in the same quiet state.
          b.id_verify_requested_at = b.id_verify_requested_at || new Date().toISOString();
          wrap.replaceChild(el('div', 'paxsub', 'Asked'), confirmBox);
          if (btn.parentNode) btn.parentNode.removeChild(btn);
          return;
        }
        // ok:false reasons (not live, cancelled, departed, already verified)
        // are all terminal for this booking, so the link goes away.
        msg.textContent = (out && out.reason) || 'Not available right now.';
        msg.classList.remove('hidden');
        if (confirmBox.parentNode) confirmBox.parentNode.removeChild(confirmBox);
        if (btn.parentNode) btn.parentNode.removeChild(btn);
      });
      wrap.appendChild(btn);
      wrap.appendChild(confirmBox);
      wrap.appendChild(msg);
      return wrap;
    }

    /** "ID verified" tag (0314). Only an admin can set profiles.id_verified,
     *  so this is shown to every driver, not gated like the Get verified
     *  entry point. Built with DOM calls, not innerHTML. */
    function idVerifiedTag() {
      const tag = el('span', 'chip idv');
      const NS = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('stroke-width', '3');
      svg.setAttribute('stroke-linecap', 'round');
      svg.setAttribute('stroke-linejoin', 'round');
      svg.setAttribute('aria-hidden', 'true');
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', 'M20 6 9 17l-5-5');
      svg.appendChild(path);
      tag.appendChild(svg);
      tag.appendChild(document.createTextNode('ID verified'));
      return tag;
    }

    /** Rider ♀: the pink circle the app draws, inline in the name line, for
     *  anyone whose gender is female (Justin, 2026-10-08). */
    function riderFemaleTag() {
      const tag = el('span', 'femaletag', '♀');
