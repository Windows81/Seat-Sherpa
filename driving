        const rideId = Number(a.rideId);
        row.ride_id = Number.isFinite(rideId) && rideId > 0 ? rideId : null;
        const snip = String(a.snippet || '').slice(0, NOTE_SNIPPET_MAX);
        if (snip) row.snippet = snip;
        supabase.auth.getSession().then(({ data }) => {
          if (!data || !data.session) return;
          supabase.from('offplatform_warnings').insert(row).then(() => {}, () => {});
        }, () => {});
      } catch (_) {}
    }
    const FLEX_CHOICES = [
      { v: 0, label: 'Exact time' },
      { v: 60, label: 'About 1 hour' },
      { v: 120, label: 'About 2 hours' },
      { v: 720, label: 'Half a day' },
      // About a day (0352, Justin 2026-10-05: "add the flexible by a day option").
      { v: 1440, label: 'About a day' },
    ];
    /** Rider-facing chip text; empty for an exact-time ride. */
    function flexChipLabel(n) {
      const m = Number(n) || 0;
      if (m === 60) return 'Flexible, about 1 h';
      if (m === 120) return 'Flexible, about 2 h';
      if (m === 720) return 'Flexible, half a day';
      if (m === 1440) return 'Flexible, about a day';
