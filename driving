    async function loadBookingsForRides(rideIds) {
      if (!rideIds.length) return [];
      // RLS bookings_select_driver_rides (0002) scopes rows to rides I drive.
      const fetchRows = () => supabase
        .from('bookings')
        .select(bookingSelect())
        .in('ride_id', rideIds)
        .order('created_at', { ascending: true });
      let { data, error } = await fetchRows();
      if (error && paxIdVerifiedCol && /id_verified/i.test(String(error.message || ''))) {
