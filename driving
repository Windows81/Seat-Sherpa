    }

    function paxRawName(b) {
      return (b.passenger && b.passenger.name) || b.passenger_name || '';
    }
    function paxDisplay(b) { return abbreviateName(paxRawName(b)) || 'Rider'; }
    function paxFirst(b) { return firstName(paxRawName(b)); }

    /** Strip the street line, ZIP and state so a card reads "Los Altos \u2192
     *  San Francisco" instead of a full postal address (Justin, 2026-08-28).
     *  Same helper as trips.html. Exact addresses still show once a ride is
     *  opened \u2014 the list is for scanning, the detail is for driving to. */
    // Mapbox sometimes puts a REGION where the city belongs ("Westwood, The
    // Westside, California": Vladimir's rides 518 and 519, 2026-10-02), and the
    // last non-state part is then a district, not a city. Known Los Angeles
    // districts resolve to Los Angeles; other regional labels (South Bay, East
    // Bay, ...) step back to the part before them, or to nothing so the caller
    // falls back to the metro name. We go by city name (Justin).
    function ssPickCity(cleaned) {
      if (!cleaned || !cleaned.length) return '';
      var last = String(cleaned[cleaned.length - 1]);
      var key = last.toLowerCase().replace(/^the\s+/, '');
      var CITY = { 'westside': 'Los Angeles', 'san fernando valley': 'Los Angeles', 'valley': 'Los Angeles', 'south los angeles': 'Los Angeles', 'east los angeles': 'Los Angeles' };
      var SKIP = ['south bay', 'east bay', 'peninsula', 'silicon valley', 'north bay', 'inland empire', 'central valley', 'orange county', 'bay area', 'san francisco bay area', 'los angeles county', 'san diego county', 'wine country'];
      if (CITY[key]) return CITY[key];
      if (SKIP.indexOf(key) >= 0) return cleaned.length >= 2 ? String(cleaned[cleaned.length - 2]) : '';
      return last;
    }
    function cityOf(area) {
      if (!area) return '';
      const parts = String(area).split(',').map((s) => s.trim()).filter(Boolean);
      if (!parts.length) return String(area);
      const STATE = /^(california|ca|nevada|nv|arizona|az|oregon|or|usa|united states|us)( +\d{5}(-\d{4})?)?$/i;
      const ZIP = /^\d{5}(-\d{4})?$/;
      const cleaned = parts.filter((p) => !/^\d/.test(p) && !STATE.test(p) && !ZIP.test(p));
      if (!cleaned.length) return parts[0];
      return ssPickCity(cleaned);
    }
    function routeLabel(ride) {
      const from = cityOf(ride.departure_area) || ((window.SS_STOPS && SS_STOPS.STOP_BY_ID[ride.from_dest] && SS_STOPS.STOP_BY_ID[ride.from_dest].name) || 'Origin');
      const to = cityOf(ride.arrival_area) || ((window.SS_STOPS && SS_STOPS.STOP_BY_ID[ride.to_dest] && SS_STOPS.STOP_BY_ID[ride.to_dest].name) || 'Destination');
