    // Rider reputation (audit 8/28): deciding whether to charge a stranger's
    // card with nothing but a name is worse than the app, which shows a
    // rating. Ratings are readable (same table this page writes to).
    const riderRep = new Map(); // passenger_id -> {avg, n}
    async function loadRiderRep(ids) {
      const want = [...new Set((ids || []).filter((x) => x && !riderRep.has(x)))];
      if (!want.length) return;
      // The profile's star rating, the same number the app shows: Seat Sherpa
      // ratings minus any a moderator hid, or a matched rating (0348) until
      // the first real one (review 2026-10-05; this used to average the raw
      // ratings rows, hidden ones included).
      const { data, error } = await supabase.from('profiles').select('id, overall_rating').in('id', want);
      if (error) return;
      const byId = new Map((data || []).map((p) => [p.id, Number(p.overall_rating)]));
      for (const id of want) {
        const v = byId.get(id);
        riderRep.set(id, Number.isFinite(v) && v >= 1 ? { avg: v } : null);
      }
    }
    function riderRepLabel(b) {
      const r = b && b.passenger_id ? riderRep.get(b.passenger_id) : null;
