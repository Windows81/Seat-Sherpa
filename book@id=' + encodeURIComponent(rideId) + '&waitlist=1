    // ── Profile (name + bio) ──────────────────────────────────────────────
    function updateBioCount() { $('bioCount').textContent = String(bioWords($('pfBio').value)); }
    $('pfBio').addEventListener('input', updateBioCount);

    function nameLooksLikeHandle(n) {
      const t = String(n || '').trim();
      if (!t || /\s/.test(t)) return false;
      return (/\d/.test(t) && /^[a-z0-9._-]+$/i.test(t)) || /^[a-z0-9]{10}$/.test(t);
    }
    $('profileBtn').addEventListener('click', async () => {
      setMsg('profileMsg', ''); setMsg('photoMsg', '');
      const name = $('pfName').value.trim();
      const bio = $('pfBio').value.trim();
      if (!name) { setMsg('profileMsg', 'Please enter your name.'); return; }
      if (name.includes('@')) { setMsg('profileMsg', "Names can't contain @. Your driver just needs your real name."); return; }
      if (nameLooksLikeHandle(name)) { setMsg('profileMsg', 'That looks like a username. Riders and drivers need your real first and last name.'); return; }
      if (!bioOk(bio)) { setMsg('profileMsg', 'Tell the driver a little more, at least ' + BIO_MIN_WORDS + ' words.'); return; }
      const bioHit = bioContact(bio);
      if (bioHit) { setMsg('profileMsg', BIO_CONTACT_MSG[bioHit]); return; }
      if (!currentPhotoUrl && !photoBlob) { setMsg('photoMsg', 'Add a photo of your face, a selfie or one you already have. Your driver uses it to recognize you at pickup.'); return; }
      const btn = $('profileBtn');
      btn.disabled = true; btn.textContent = 'Saving…';
      try {
        // Photo first (if a new one is pending): same bucket/path as the app's
        // uploadAvatar — avatars/{uid}/avatar.jpg, upsert, ?t= cache-bust.
        const patch = { name, bio };
        if (photoBlob) {
          const path = myUid + '/avatar.jpg';
          const { error: upErr } = await supabase.storage.from('avatars')
            .upload(path, photoBlob, { contentType: 'image/jpeg', upsert: true });
          if (upErr) throw upErr;
          const { data: urlData } = supabase.storage.from('avatars').getPublicUrl(path);
          patch.photo_url = urlData.publicUrl + '?t=' + Date.now();
        }
        // The signup DB trigger creates the profiles row; update (not insert)
        // is the same write the app makes under the user's own RLS. One retry
        // covers the rare just-signed-up trigger race.
        let { data, error } = await supabase.from('profiles')
          .update(patch).eq('id', myUid).select('id');
        if (!error && (!data || data.length === 0)) {
