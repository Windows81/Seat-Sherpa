      }
      // Best-effort role stamp for accounts that predate metadata-at-signup.
      try { await supabase.auth.updateUser({ data: { role: data?.user?.user_metadata?.role || 'passenger' } }); } catch (_) {}
      // Waitlist join was the whole reason they signed in (scan #1) — finish
