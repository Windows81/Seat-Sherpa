    // ── Photo ─────────────────────────────────────────────────────────────
    let photoBlob = null;

    // Browser-side clone of the app's preparePhotoForUpload: downscale to
    // ≤1024px + re-encode JPEG. Avatars render at ≤128px so nothing visible is
    // lost, and a 10 MB camera original becomes ~100–200 KB. Canvas re-encode
    // also strips EXIF/GPS.
    async function downscale(file) {
      const url = URL.createObjectURL(file);
      try {
        const img = await new Promise((res, rej) => {
          const i = new Image();
          i.onload = () => res(i);
          i.onerror = () => rej(new Error('decode'));
          i.src = url;
        });
        const MAX = 1024;
        const scale = Math.min(1, MAX / Math.max(img.naturalWidth, img.naturalHeight));
        const w = Math.max(1, Math.round(img.naturalWidth * scale));
        const h = Math.max(1, Math.round(img.naturalHeight * scale));
        const c = document.createElement('canvas');
        c.width = w; c.height = h;
        c.getContext('2d').drawImage(img, 0, 0, w, h);
        const blob = await new Promise((res) => c.toBlob(res, 'image/jpeg', 0.85));
        if (!blob) throw new Error('encode');
        return blob;
      } finally { URL.revokeObjectURL(url); }
    }

    // One path for every source (selfie camera, file picker, Google avatar):
    // downscale → face gate → preview. The upload happens on Continue.
    async function acceptPhotoCandidate(fileOrBlob, sourceLabel) {
      setMsg('photoMsg', '');
      let candidate;
      try {
        candidate = await downscale(fileOrBlob);
      } catch (_) {
        setMsg('photoMsg', "That image format isn't supported. Try a different photo.");
        return false;
      }
      // Face gate (2026-08-28) — a car photo went through as an avatar.
      // Blocks ONLY on an affirmative "zero faces found"; if the detector
      // can't load, fail open rather than brick the booking.
      try {
        const { checkFace } = await import('/js/ss-face.js');
        const fr = await checkFace(candidate);
        if (fr.ok && fr.faces === 0) {
          setMsg('photoMsg', sourceLabel === 'google'
            ? "We couldn't spot a face in your Google photo. Take a selfie or choose a clear photo of yourself instead."
            : "We couldn't spot a face in that photo. Your driver uses it to recognize you at pickup, so please use a clear photo of yourself.");
          return false;
        }
      } catch (_) { /* detector unavailable — proceed */ }
      // REAL-PHOTO gate (2026-09-07): illustrations / AI portraits are a hard
      // no; any failure falls open. Shared helper: /js/ss-photo-check.js.
      try {
        const { checkRealPhoto, NOT_REAL_PHOTO_MESSAGE } = await import('/js/ss-photo-check.js');
        const { data: sess } = await supabase.auth.getSession();
        const rp = await checkRealPhoto(candidate, sess && sess.session && sess.session.access_token);
        if (rp.realPhoto === false) { setMsg('photoMsg', NOT_REAL_PHOTO_MESSAGE); return false; }
      } catch (_) { /* fail open */ }
      photoBlob = candidate;
      const prev = $('photoPrev');
      prev.src = URL.createObjectURL(photoBlob);
      prev.classList.remove('hidden');
      $('googlePhotoOffer').classList.add('hidden');
      $('photoFileLabel').textContent = 'Choose a different photo';
      return true;
    }
    for (const inputId of ['photoFile', 'photoSelfie']) {
      $(inputId).addEventListener('change', async (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        await acceptPhotoCandidate(file, inputId === 'photoSelfie' ? 'selfie' : 'file');
        try { e.target.value = ''; } catch (_) {}
      });
    }
    // Add-email (parity with the app's on-open prompt, 2026-09-02): only
