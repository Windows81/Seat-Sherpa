    // ── Create booking → Stripe Checkout ──────────────────────────────────
    $('bookBtn').addEventListener('click', async () => {
      setMsg('bookMsg', '');
      if (selectedSeats.length === 0) return;
      const btn = $('bookBtn');
      // Off-platform contact in the note: warn once per note text; a second
      // tap with the same text sends it (web chat uses the same pattern).
      {
        const note = $('drvMsg').value.trim();
        const hit = noteContact(note);
        // 0305: log the warning and the send-anyway. A rider who is not signed
        // in yet cannot write the row (RLS needs auth.uid()), and the 'shown'
        // row used to be fired anyway and silently lost, so every brand-new
        // rider's warning vanished from the record (found 2026-09-20 while
        // checking whether a rider had been warned). Now it is QUEUED and
        // written the moment they are signed in, further down.
        const logNoteWarn = (action) => {
          const row = { surface: 'web_booking_note', hit: ['phone', 'handle', 'email'].includes(hit) ? hit : 'phone', action, ride_id: Number(rideId) || null };
          try {
            supabase.auth.getSession().then(({ data }) => {
              if (data && data.session) {
                supabase.from('offplatform_warnings').insert(row).then(() => {}, () => {});
              } else {
                const q = (window.__ssNoteWarnQueue = window.__ssNoteWarnQueue || []);
                if (q.length < 10) q.push(row);
              }
            }, () => {});
          } catch (_) {}
        };
        // Only promise a removal the server really does (0306/0307): numbers,
        // emails and @handles. An app name alone ("venmo") is warned, not removed.
        const willMask = hit === 'phone' || /@[A-Za-z0-9_.]{3,}/.test(note);
        if (hit && btn.dataset.noteWarned !== note) {
          btn.dataset.noteWarned = note;
          logNoteWarn('shown');
          setMsg('bookMsg', willMask ? NOTE_WARN_MSG[hit] : 'Your message moves things off Seat Sherpa. Payment and no-show protection only cover rides kept here.');
          return;
        }
        window.__ssNoteSentAnyway = (hit && btn.dataset.noteWarned === note && btn.dataset.noteLogged !== note)
          ? () => { btn.dataset.noteLogged = note; logNoteWarn('sent_anyway'); }
          : null;
      }
      btn.disabled = true;
      const prevLabel = btn.textContent;
      btn.textContent = 'Requesting…';
      try {
        const { data: sessionData } = await supabase.auth.getSession();
        const token = sessionData.session?.access_token;
        if (!token) { show('stEmail'); return; }
        // Logged only once signed in: before that RLS refuses the row and it
        // was never retried (review 2026-09-18).
        // Flush any 'warning shown' rows queued while they were signed out.
        // Before the send-anyway row, so the record reads in the order it
        // happened.
        if (Array.isArray(window.__ssNoteWarnQueue) && window.__ssNoteWarnQueue.length) {
          const queued = window.__ssNoteWarnQueue.splice(0, window.__ssNoteWarnQueue.length);
          for (const row of queued) { try { supabase.from('offplatform_warnings').insert(row).then(() => {}, () => {}); } catch (_) {} }
        }
        if (typeof window.__ssNoteSentAnyway === 'function') { window.__ssNoteSentAnyway(); window.__ssNoteSentAnyway = null; }
        // Re-read the booking-fee waiver RIGHT BEFORE creating the booking.
        // It is read once at sign-in, but a checkout-lapse waiver can end one
        // hour before departure, and these riders are by definition slow to
        // finish: OTP, name, bio, phone, photo. The app has a pre-pay amount
        // check for this; web has none, so a stale "Waived" would have become
        // an unexplained higher number on the Stripe page (bug sweep,
        // 2026-09-11). If it changed, redraw and make them look again.
        if (myUid) {
          try {
            const { data: wNow } = await supabase.rpc('passenger_fee_waived', { p_user: myUid });
            if ((wNow === true) !== myFeeWaived) {
              myFeeWaived = wNow === true;
              try { renderSeats(); } catch (_) {}
              try { updateSummary(); } catch (_) {}
              setMsg('bookMsg', myFeeWaived
                ? 'Good news, your booking fee came off. Check the total and tap again.'
                : 'Your booking fee waiver just ran out, so the total changed. Check it and tap again.');
              return;
            }
          } catch (_) { /* the server is authoritative either way */ }
        }
        const res = await fetch(SUPA + '/functions/v1/web-create-booking', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: ANON,
            Authorization: 'Bearer ' + token,
          },
          body: JSON.stringify({
            rideId,
            seatIds: selectedSeats,
            boardingStopId: segBoardingId,
            alightingStopId: segAlightingId,
            driverMessage: $('drvMsg').value.trim() || null,
          }),
        });
        const body = await res.json().catch(() => ({}));
        // Resume or fresh — any response carrying a checkoutUrl goes to Stripe.
        if (body && body.checkoutUrl) {
          if (body.resumed) {
            // Resuming an EARLIER request: the charge is that request, not
            // what's on screen now. Name the real total on the way out
            // (audit P1 - the one case where charge could exceed display).
            try {
              var rp = document.querySelector('#stRedirect .sub, #stRedirect p');
              if (rp) rp.textContent = 'Resuming the request you already started: ' + fmt$((body.amountCents || 0) / 100) + ' total. It replaces what you just selected. Taking you to secure checkout…';
            } catch (_) {}
          }
          show('stRedirect');
          location.href = body.checkoutUrl;
          return;
        }
        if (!res.ok) { await handleBookingError(body); return; }
        throw new Error('Unexpected response.');
      } catch (e) {
        setMsg('bookMsg', (e && e.message) || 'Something went wrong. Try again.');
      } finally {
        if (!$('stRedirect').classList.contains('hidden')) return;
        btn.disabled = false;
        btn.textContent = prevLabel;
      }
    });

    function ssLogTos(uid) {
      // Consent evidence for the sign-in-wrap notice. Flag only on SUCCESS
      // — a swallowed failure must retry next session (audit P2).
      try {
        if (localStorage.getItem('ss-tos-web-v1')) return;
        supabase.from('terms_acceptances')
          .insert({ user_id: uid, terms_version: '2026-05-26', privacy_version: '2026-07-08', platform: 'web' })
          .then(function (r) { if (!r || !r.error) { try { localStorage.setItem('ss-tos-web-v1', '1'); } catch (_) {} } }, function () {});
      } catch (_) {}
    }
    // Server gate bounces → route the visitor to the right step; ride-level
    // failures → honest terminal states. Machine codes per web-create-booking.
    async function handleBookingError(body) {
      const code = body && body.error;
      switch (code) {
        case 'GATE_NAME':
        case 'GATE_BIO':
          await route();
          setMsg('profileMsg', 'Please finish your profile first.');
          return;
        case 'GATE_PHONE':
          await route();
          setMsg('phoneMsg', 'Please verify your phone first.');
          return;
        case 'GATE_PHOTO':
          await route();
          setMsg('photoMsg', 'Please add a face photo first.');
          return;
        case 'RIDE_GONE': showGone(); return;
        case 'DEPARTS_TOO_SOON': showGone('too_soon'); return;
        case 'OWN_RIDE':
          // Reached when the driver signed in MID-funnel, so the boot-time
          // isOwnRide check couldn't know yet (review, 2026-09-08). Show the
          // same terminal screen the boot check shows rather than a small
          // inline note under a Request button that will never work.
          showGone('own_ride');
          return;
        case 'SEATS_TAKEN': {
          // Someone beat them to it — refresh availability and let them re-pick.
          try {
            const d = await loadRide(true);
            if (d && d.found) {
              rideData = d;
              // Last seat gone: "pick another" over an all-Taken grid is a
              // dead end (audit M5) — route to the full-ride state, which
              // offers the browse list instead.
              if (!(d.seats || []).some((s) => s.avail !== false)) { showGone('full'); return; }
              renderSeats();
              try { initSegment(); recomputeSegment(); } catch (_) {}
            }
          } catch (_) {}
          setMsg('bookMsg', 'Someone grabbed that seat first. Pick another.');
          return;
        }
        case 'INVALID_STOP':
          segBoardingId = null; segAlightingId = null;
          try { $('segBoard').value = ''; $('segAlight').value = ''; recomputeSegment(); } catch (_) {}
          setMsg('bookMsg', "Those pickup and drop-off stops don't match this route, so it was reset to the full trip. Try again.");
          return;
        case 'ALREADY_BOOKED':
          setMsg('bookMsg', 'You already have a request on this ride' +
            (body.refCode ? ' (ref ' + body.refCode + ')' : '') +
            '. Manage it at seatsherpa.app/trips' +
            (body.refCode ? '?ref=' + encodeURIComponent(body.refCode) : '') + '.');
          return;
        case 'INVALID_SEATS':
          setMsg('bookMsg', 'One of those seats is no longer offered. Refresh and pick again.');
          return;
        case 'INVALID_AMOUNT':
          setMsg('bookMsg', "This ride's pricing looks off. Try again in a minute.");
          return;
        case 'CHECKOUT_CREATE_FAILED':
          setMsg('bookMsg', "Couldn't start the payment page. Nothing was charged. Try again.");
          return;
        default:
          setMsg('bookMsg', (body && (body.message || body.error)) || 'Something went wrong. Try again.');
      }
    }

    // ── Return from Stripe: success ───────────────────────────────────────
    // Polls the booking row via PostgREST under the rider's own RLS
    // (bookings_select_own) — explicit column list, never select('*').
    // payment_verified_at is stamped by the checkout.session.completed webhook,
    // which can lag the redirect by a few seconds.
    async function runSuccessFlow() {
      show('stFinalizing');
      const { data: sessionData } = await supabase.auth.getSession();
      if (!sessionData.session) {
        // Session didn't survive (cleared storage / different browser). The
        // webhook still stamps + notifies regardless — reassure and stop.
        $('successTitle').textContent = 'Payment received';
        $('successSub').textContent = "Your request is being finalized. You'll get an email as soon as the driver responds, and your card is only charged if they accept.";
        show('stSuccess');
        return;
      }
      for (let attempt = 0; attempt < 20; attempt++) {
        try {
          const { data: b } = await supabase.from('bookings')
            .select('id, status, payment_verified_at, ref_code')
            .eq('id', bookingParam)
            .maybeSingle();
          if (b) {
            // Point the success screen's message button at THIS booking's
            // thread rather than the generic inbox (audit 8/28).
            if (b.ref_code) {
              var _mb = $('successMsgBtn');
              if (_mb) _mb.href = '/trips?ref=' + encodeURIComponent(b.ref_code) + '&chat=1';
            }
            if (b.status === 'Confirmed') {
              $('successTitle').textContent = "You're booked!";
              if (b.ref_code) { $('successRef').textContent = b.ref_code; $('successRef').classList.remove('hidden'); }
              $('successSub').textContent = 'The driver accepted. Check your email for the details, and chat about pickup any time at seatsherpa.app/trips.';
              show('stSuccess');
              return;
            }
            if (b.status === 'Cancelled') {
              $('successTitle').textContent = 'This request was cancelled';
              $('successSub').textContent = "Your card won't be charged. Head back to the ride to try again, or find another ride in the app.";
              show('stSuccess');
              return;
            }
            if (b.payment_verified_at) {
              $('successTitle').textContent = 'Your request is in';
              if (b.ref_code) { $('successRef').textContent = b.ref_code; $('successRef').classList.remove('hidden'); }
              const drv = rideData && rideData.driverFirst ? rideData.driverFirst : 'The driver';
              $('successSub').textContent = drv + " has been notified. Your card is only charged when they accept, and we'll email you as soon as they respond.";
              show('stSuccess');
              return;
            }
          }
        } catch (_) { /* transient — keep polling */ }
        await new Promise((r) => setTimeout(r, 3000));
      }
      // Webhook slower than our patience — the sweeps/webhook still converge;
      // never leave the rider thinking their money vanished.
      $('successTitle').textContent = 'Payment is processing';
      // No email promise here — nothing mails the rider at this moment (the
      // next email is the driver's response). My trips is the live truth.
      $('successSub').textContent = "Your payment went through and your request is being finalized. It'll show in My trips within a few minutes. Your card is only charged if the driver accepts, and we'll email you the moment they respond.";
      show('stSuccess');
    }

    // ── Return from Stripe: cancelled ─────────────────────────────────────
    function runCancelledFlow() {
      // "Finish booking" resumes the still-open Checkout session DIRECTLY
      // (resume:true probe — no seats sent; the server returns the session
      // URL for the rider's own Pending booking). It must NOT reload the
      // funnel: the rider's own held seats render as taken there, so a
      // last-seat ride showed them "This ride is full", and re-picking a
      // different seat silently redirected to the old session for the old
      // seats anyway. RESUME_NONE (session expired) falls back to the funnel.
      $('retryLink').addEventListener('click', async (ev) => {
        ev.preventDefault();
        const link = $('retryLink');
        const prev = link.textContent;
        link.textContent = 'Resuming…';
        try {
          const { data: sessionData } = await supabase.auth.getSession();
          const token = sessionData.session?.access_token;
          if (!token) { location.href = '/book?id=' + encodeURIComponent(rideId); return; }
          const res = await fetch(SUPA + '/functions/v1/web-create-booking', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              apikey: ANON,
              Authorization: 'Bearer ' + token,
            },
            body: JSON.stringify({ rideId, resume: true }),
          });
          const body = await res.json().catch(() => ({}));
          if (body && body.checkoutUrl) { location.href = body.checkoutUrl; return; }
        } catch (e) { /* fall through to the funnel */ }
        location.href = '/book?id=' + encodeURIComponent(rideId);
      });
      show('stCancelled');
      // Name a card decline (2026-09-04): Stripe shows it on its own page,
      // but a rider who backs out landed on a bare "Checkout cancelled" with
      // no hint why. Read-only peek at the open session's PaymentIntent.
      (async () => {
        try {
          const { data: sessionData } = await supabase.auth.getSession();
          const token = sessionData.session?.access_token;
          if (!token) return;
          const res = await fetch(SUPA + '/functions/v1/web-create-booking', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: ANON, Authorization: 'Bearer ' + token },
            body: JSON.stringify({ rideId, peek: true }),
          });
          const body = await res.json().catch(() => ({}));
          if (body && body.declined) {
            const bank = String(body.declineMessage || 'Your card was declined.').trim().replace(/([^.!?])$/, '$1.');
            $('stCancelled').querySelector('h1').textContent = 'Your card was declined';
            $('stCancelled').querySelector('.sub').textContent = bank + ' Nothing was charged and your seat request is still held open. Tap Finish booking to try a different card.';
            $('retryLink').textContent = 'Try a different card';
          }
        } catch (_) { /* leave the generic card */ }
      })();
    }

    $('withdrawBtn').addEventListener('click', async () => {
      const btn = $('withdrawBtn');
      btn.disabled = true;
      setMsg('cancelMsg', '');
      try {
        const { data: sessionData } = await supabase.auth.getSession();
        if (!sessionData.session) throw new Error('Please use the device you booked on, or just leave it. An unpaid request expires on its own.');
        // Withdraw through web-cancel-booking (same path as /trips) so the
        // Stripe side is actually cleaned up — the old raw status flip left a
        // completed authorization dangling on the rider's card and never
        // stamped cancelled_by. Falls back to the raw flip (still legal under
        // 0059's column grant) only if the function itself is unreachable.
        const wcRes = await fetch(SUPA + '/functions/v1/web-cancel-booking', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: ANON,
            Authorization: 'Bearer ' + sessionData.session.access_token,
          },
          body: JSON.stringify({
            bookingId: bookingParam,
            reason: 'Rider closed web checkout without paying',
          }),
        });
        if (!wcRes.ok) {
          const out = await wcRes.json().catch(() => ({}));
          // No direct row write as a fallback (sweep 2026-09-03): that path
          // skipped the authorization release and every notification. A
          // server hiccup just asks the rider to try again; an unpaid request
          // is cleared by the sweeps anyway.
          if (wcRes.status >= 500 || wcRes.status === 0) {
            throw new Error("Couldn't withdraw just now. Please try again in a moment.");
          } else {
            throw new Error((out && out.error) || "This request can't be withdrawn here. It may already be accepted; manage it in the app.");
          }
        }
        $('retryLink').classList.add('hidden');
        btn.classList.add('hidden');
        setMsg('cancelMsg', 'Request withdrawn. The seats are open again and your card was never charged.', 'ok');
      } catch (e) {
        setMsg('cancelMsg', (e && e.message) || 'Could not withdraw. Try again.');
        btn.disabled = false;
      }
    });

    $('signOutBtn').addEventListener('click', async () => {
      await supabase.auth.signOut({ scope: 'local' }); // global scope would revoke the phone app's session too (ss-session.js rule)
      selectedSeats = [];
      $('signedIn').classList.add('hidden');
      show('stEmail');
    });

    // Enter-key submits on the single-field steps.
    const enterMap = [['email','emailBtn'], ['emailCode','codeBtn'], ['phoneNum','phoneSendBtn'], ['phoneCode','phoneVerifyBtn']];
    for (const [inp, btn] of enterMap) {
      $(inp).addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); $(btn).click(); } });
    }

    // ── Boot ──────────────────────────────────────────────────────────────
    (async function init() {
      const returning = (returnState === 'success' || returnState === 'cancelled') && Number.isFinite(bookingParam);
      if (!Number.isFinite(rideId) && !returning) { showGone(); return; }
      // FIRST PAINT NEVER WAITS ON AUTH (2026-09-08): the ride card is public
      // data, so fetch it with the anon key and start the session read at the
      // same time instead of chaining them. getSession can trigger a token
      // refresh — a network round-trip that retries on a weak connection —
      // and the card used to sit blank behind it for no reason.
      const sessionP = supabase.auth.getSession().catch(() => ({ data: { session: null } }));
      let d = null;
      let fetchFailed = false;
      try { d = await fetchRide(ANON); } catch (_) { d = null; fetchFailed = true; }
      if (d && d.found) { rideData = d; renderRideCard(d); try { $('instantNote').classList.toggle('hidden', !d.instant); } catch (_) {} }

      // Return states short-circuit the funnel BEFORE the ride-found check:
      // a rider coming back from Stripe must always see their booking status,
      // even if the ride has since departed/cancelled (public-ride reports
      // those as found:false).
      if (returnState === 'success' && returning) { runSuccessFlow(); return; }
      if (returnState === 'cancelled' && returning) { runCancelledFlow(); return; }

      if (fetchFailed) { showGone('offline'); return; }
      if (!d || !d.found) { showGone(); return; }

      // A driver can't book their own seat. web-create-booking has always
      // refused this with OWN_RIDE 403, but only AFTER seat pick and payment
      // details — say it up front, the way the app does (app/ride.tsx).
      // Only an identified caller gets `isOwnRide` back, so this is a second
      // fetch — one the anonymous majority never pays for, and one that no
      // longer blocks the ride card above it.
      // BOTH of these are raced against a timeout. They sit between the ride
      // card and the seat grid, so anything that hangs here leaves a signed-in
      // rider looking at a ride they cannot book. fetch() never times out on
      // its own, and this path went from one network call to two on 2026-09-08,
      // which doubled the exposure. Losing the race is safe: the worst case is
      // a driver briefly seeing their own ride's seat grid, and
      // web-create-booking still refuses with OWN_RIDE 403.
      const withTimeout = (p, ms, fallback) =>
        Promise.race([p, new Promise((res) => setTimeout(() => res(fallback), ms))]);
      const bootSession = (await withTimeout(sessionP, 4000, { data: { session: null } })).data;
      const token = bootSession && bootSession.session ? bootSession.session.access_token : null;
      if (token) {
        const own = await withTimeout(fetchRide(token).catch(() => null), 4000, null);
        if (own && own.isOwnRide) { showGone('own_ride'); return; }
      }

      // Pre-extension public-ride payload (no seats array) can't drive the
      // picker — fall back to the app rather than a broken grid.
      if (!Array.isArray(d.seats)) { show('stAppOnly'); return; }
      if (d.seatsLeft === 0 || !d.seats.some((s) => s.avail !== false)) { showGone('full'); return; }
      if (d.bookable === false) { showGone('soon'); return; }

      renderSeats();
      initSegment();
      // SEATS BEFORE SIGN-UP (BlaBlaCar benchmark, 2026-08-26): an anonymous
      // visitor sees the seat grid, per-seat prices, and the exact total
      // BEFORE committing any identity — the old boot bounced them straight
      // to email OTP with the price still invisible, four gates before the
      // one question that decides everything ("does this price work?").
      // Tapping Request starts the sign-in walk; selection survives in memory
      // because every gate is a card on this same page; and the server
      // re-enforces every gate regardless (GATE_* bounces route back).
      if (!token) {
        show('stSeats');
      } else {
        await route();
      }
    })();
  </script>
