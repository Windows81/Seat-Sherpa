    }

    // Send the SIGNED-IN user's token when we have one, not the anon key:
    // public-ride answers `isOwnRide` only for an identified caller, which is
    // how this page learns the viewer is the driver BEFORE the seat picker
    // (Justin, 2026-09-08 — web let him walk to payment on his own ride).
    // Anonymous visitors keep the anon key and the old behaviour exactly.
    async function loadRide(fresh) {
      let bearer = ANON;
      try {
        const { data: sd } = await supabase.auth.getSession();
        if (sd && sd.session && sd.session.access_token) bearer = sd.session.access_token;
      } catch (_) { /* not signed in — anon key */ }
      return fetchRide(bearer, fresh);
    }

    // Waitlist (2026-08-28, app parity): ?waitlist=1 turns the full-ride dead
    // end into demand capture. Mirrors services/waitlist.ts joinWaitlist —
    // dupe insert = already on the list = success. notify-waitlist already
    // emails web users when a seat frees; only this join was missing.
    let waitlistMode = false;
    async function waitlistFlow() {
      $('rideCard').classList.add('hidden');
      const { data: sd } = await supabase.auth.getSession();
      const uid = sd && sd.session && sd.session.user ? sd.session.user.id : null;
      if (!uid) {
        $('goneTitle').textContent = 'This ride is full';
        $('goneSub').innerHTML = 'We’ll email you the moment a seat opens. ' +
          '<a href="#" id="wlSignIn" style="font-weight:700;">Sign in with your email to join the waitlist →</a>';
        show('stGone');
        const a = document.getElementById('wlSignIn');
        // waitlistMode: after sign-in the continuations must come BACK here
        // (scan #1 — route() knows nothing about waitlists and dumped the
        // signed-in visitor on an empty seat grid; the join never happened).
        if (a) a.addEventListener('click', (e) => { e.preventDefault(); waitlistMode = true; show('stEmail'); });
        return;
      }
      const { error } = await supabase.from('ride_waitlist').insert({ ride_id: rideId, user_id: uid });
      if (error && !/duplicate|unique/i.test(error.message || '')) {
        $('goneTitle').textContent = 'This ride is full';
        $('goneSub').textContent = 'Every seat has been taken, and the waitlist did not respond. Refresh to try again.';
        show('stGone');
        return;
      }
      $('goneTitle').textContent = "You're on the list 🔔";
      $('goneSub').textContent = "We'll email you the moment a seat opens on this ride. No need to keep checking.";
      show('stGone');
      void offerAlternative();
    }

    // Full is not a dead end (Justin, 2026-09-17): a live ride within a day
    // whose route passes within 50 miles of this ride's start and then its end
    // (RPC alt_rides_for_full_ride, migration 0302) is offered under the
    // waitlist confirmation so the person can lock a seat in instead of
    // waiting. The join above stands either way; any error means no offer.
    const ALT_METRO = {
      sfba: 'San Francisco Bay Area', sanjose: 'San Jose', napasonoma: 'Napa / Sonoma', sacramento: 'Sacramento',
      tahoereno: 'Tahoe / Reno', la: 'Los Angeles', oc: 'Orange County', sd: 'San Diego', palm: 'Palm Springs',
      inlandempire: 'Riverside / Inland Empire', vegas: 'Las Vegas', manteca: 'Manteca', fresno: 'Fresno',
      santacruz: 'Santa Cruz', monterey: 'Monterey', bakersfield: 'Bakersfield', slo: 'San Luis Obispo',
      santabarbara: 'Santa Barbara', burningman: 'Burning Man', redding: 'Redding',
    };
    function altCity(area, fallback) {
      var parts = String(area || '').split(',').map(function (s) { return s.trim(); }).filter(function (s) {
        return s && !/^(california|nevada|ca|nv|usa|united states)(\s+\d{5})?$/i.test(s) && !/^\d{5}$/.test(s);
      });
      var city = parts[parts.length - 1];
      return city && city.length <= 28 && !/\d/.test(city) ? city : fallback;
    }
    function altEsc(s) {
      return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function altWhen(depDate, depTime) {
      var day = String(depDate || '');
      var p = day.split('-').map(Number);
      var dt = new Date(Date.UTC(p[0], (p[1] || 1) - 1, p[2] || 1));
      if (isFinite(dt.getTime()) && p[0] > 2000) {
        day = dt.toLocaleDateString('en-US', { timeZone: 'UTC', weekday: 'short', month: 'numeric', day: 'numeric' });
      }
      var t = String(depTime || '').split(':').map(Number);
      if (!isFinite(t[0])) return day;
      var h12 = t[0] % 12 === 0 ? 12 : t[0] % 12;
      var mm = isFinite(t[1]) ? t[1] : 0;
      return day + ' at ' + h12 + ':' + (mm < 10 ? '0' : '') + mm + ' ' + (t[0] >= 12 ? 'PM' : 'AM');
    }
    async function offerAlternative() {
      try {
        const { data, error } = await supabase.rpc('alt_rides_for_full_ride', { p_ride_id: rideId });
        if (error || !Array.isArray(data) || !data.length) return;
        const a = data[0];
        const from = altCity(a.departure_area, ALT_METRO[a.from_dest] || a.from_dest);
        const to = altCity(a.arrival_area, ALT_METRO[a.to_dest] || a.to_dest);
        const seats = a.open_seats + ' seat' + (a.open_seats === 1 ? '' : 's') + ' open';
        // All-in like the marketplace: seat + service fee (5%, $2 minimum), whole
        // dollars, never the bare seat price (Justin, 2026-09-17).
        const seatCents = Math.round(Number(a.price_from) * 100);
        const feeCents = Math.max(Math.floor(seatCents * 0.05), 200);
        const price = a.price_from != null ? ', from $' + Math.ceil((seatCents + feeCents) / 100) : '';
        const more = data.length > 1 ? ' ' + (data.length - 1) + ' more like it on the marketplace.' : '';
        $('goneSub').innerHTML =
          "We'll email you if a seat opens. " +
          '<strong>' + altEsc(a.driver_name) + '</strong> is driving ' + altEsc(from) + ' to ' + altEsc(to) + ' ' +
          altEsc(altWhen(a.dep_date, a.dep_time)) + altEsc(price) + ', ' + altEsc(seats) + '. ' +
          '<a href="/book?id=' + encodeURIComponent(a.ride_id) + '" style="font-weight:700;">Lock that one in instead</a>.' +
          altEsc(more);
      } catch (_) { /* no offer */ }
    }

    function showGone(kind) {
      $('rideCard').classList.add('hidden');
      if (kind === 'full') {
        if (qp.get('waitlist') === '1' && rideId) { void waitlistFlow(); return; }
        $('goneTitle').textContent = 'This ride is full';
        $('goneSub').innerHTML = 'Every seat has been taken. <a href="?id=' + encodeURIComponent(rideId) + '&waitlist=1" style="font-weight:700;">Join the waitlist</a> and we’ll email you if one opens.';
      } else if (kind === 'own_ride') {
        $('goneTitle').textContent = 'This is your ride';
        $('goneSub').innerHTML = 'You can’t book a seat on a ride you’re driving. <a href="/driving" style="font-weight:700;">Open your driving console</a> to manage seats and riders, or share the link to fill it.';
      } else if (kind === 'too_soon') {
        // Requests close 15 minutes before departure — the driver needs time
        // to answer. Distinct from an actual departure (sweep 2026-09-03).
        $('goneTitle').textContent = 'Too close to departure to request';
        $('goneSub').innerHTML = 'Requests close 15 minutes before a ride leaves so the driver has time to answer. <a href="/rides?web=1" style="font-weight:700;">See other rides on this route</a>.';
      } else if (kind === 'soon') {
        // Reachable only if the ride departs mid-session now that booking runs
        // right up to departure (2026-08-28) — so say what actually happened.
        $('goneTitle').textContent = 'This ride has just departed';
        $('goneSub').innerHTML = 'It left while you were booking. Drivers post new rides every day. <a href="/rides?web=1" style="font-weight:700;">See what’s live now</a>.';
      } else if (kind === 'offline') {
        // A failed fetch is NOT a cancelled ride (audit 8/28): telling a rider
        // on a flaky phone connection that the ride is gone kills a live sale.
        $('goneTitle').textContent = "Couldn't load this ride";
        $('goneSub').innerHTML = 'Check your connection and <a href="#" id="goneRetry" style="font-weight:700;">try again</a>.';
        show('stGone');
        var _gr = $('goneRetry');
        if (_gr) _gr.addEventListener('click', function (e) { e.preventDefault(); location.reload(); });
        return;
      } else {
        $('goneTitle').textContent = 'That ride is no longer available';
        $('goneSub').textContent = 'It was cancelled or has already left. Drivers post new rides every day.';
      }
      show('stGone');
    }

    // ── Seat picker ───────────────────────────────────────────────────────
    // ── Segment state (2026-08-28) — mirrors _shared/web-posting.ts
    //    segmentFactor/segmentSeatPriceUsd EXACTLY; the server recomputes the
    //    charge, this is display. ─────────────────────────────────────────
    let segBoardingId = null, segAlightingId = null, segLegUsd = null;
    function segHav(a, c) {
      if (!a || !c || !isFinite(a.lat)) return 0;
      const R = 3958.8, toRad = (d2) => (d2 * Math.PI) / 180;
      const dLat = toRad(c.lat - a.lat), dLng = toRad(c.lng - a.lng);
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a.lat)) * Math.cos(toRad(c.lat)) * Math.sin(dLng / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(h));
    }
    function segT(start, end, p) {
      const dx = end.lng - start.lng, dy = end.lat - start.lat;
      const len2 = dx * dx + dy * dy || 1;
      return ((p.lng - start.lng) * dx + (p.lat - start.lat) * dy) / len2;
    }
    function segStopById(id) { return (rideData.routeStops || []).find((s) => s.id === id) || null; }
    function segPrice(fullUsd) {
      if (segLegUsd == null || !(fullUsd > 0)) return fullUsd;
      return Math.min(fullUsd, segLegUsd);
    }
    function recomputeSegment() {
      const start = rideData.approxStart, end = rideData.approxEnd;
      const b = segStopById(segBoardingId), a = segStopById(segAlightingId);
      segLegUsd = null;
      const note = $('segNote');
      if ((b || a) && start && end) {
        // Coordless stops (name-only / catalog drift) must not join the
        // projection: null coerces to 0 in segT and projects to the point
        // (0,0), which made ANY coordless boarding trip the "drop-off before
        // pickup" error (review finding #5). Mirror the server: no coords →
        // endpoint defaults, price never discounts.
        const hasC = (p) => p && typeof p.lat === 'number' && isFinite(p.lat)
          && typeof p.lng === 'number' && isFinite(p.lng);
        const tb = b && hasC(b) ? segT(start, end, b) : 0;
        const ta = a && hasC(a) ? segT(start, end, a) : 1;
        if (ta <= tb) {
          // Impossible order — reset the alighting side and say why.
          segAlightingId = null;
          $('segAlight').value = '';
          // Re-price for the RESET pair (audit P1): the server will bill the
          // driver-set board->end leg; showing full price here over-quotes.
          var spR = rideData.segmentPrices || null;
          var vR = spR ? spR[(segBoardingId || 'origin') + '|end'] : undefined;
          segLegUsd = typeof vR === 'number' && isFinite(vR) && vR > 0 ? Math.round(vR) : null;
          note.textContent = 'That drop-off comes before your pickup on the route, so it was reset to the final stop.';
          note.classList.remove('hidden');
        } else {
          // Driver-set leg price (0226): the driver priced this exact pair
          // at posting, or the leg costs the full seat price. Same lookup
          // the server bills with - display cannot drift from the charge.
          const sp = rideData.segmentPrices || null;
          const v = sp ? sp[(segBoardingId || 'origin') + '|' + (segAlightingId || 'end')] : undefined;
          segLegUsd = typeof v === 'number' && isFinite(v) && v > 0 ? Math.round(v) : null;
          note.textContent = segLegUsd != null
            ? 'Partial trip \u2014 the driver set this leg at $' + segLegUsd + ' per seat.'
            : '';
          note.classList.toggle('hidden', segLegUsd == null);
        }
      } else {
        note.classList.add('hidden');
      }
      renderSeats();
    }
    function initSegment() {
      const stops = rideData.routeStops || [];
      if (!stops.length || !rideData.approxStart || !rideData.approxEnd) return;
      const wrap = $('segWrap');
      const bSel = $('segBoard'), aSel = $('segAlight');
      bSel.innerHTML = ''; aSel.innerHTML = '';
      const opt = (sel, value, label) => {
        const o = document.createElement('option');
        o.value = value; o.textContent = label;
        sel.appendChild(o);
      };
      // Times: departure on the origin, the server's per-stop estimate on each
      // stop (public-ride `eta`, same math as the app chips and the pickup
      // reminders; timing sweep 2026-09-10). Estimates, confirmed in chat.
      const to12h = (t) => { const m = /^(\d{1,2}):(\d{2})/.exec(t || ''); if (!m) return ''; const h = Number(m[1]); return (h % 12 || 12) + ':' + m[2] + ' ' + (h >= 12 ? 'PM' : 'AM'); };
      const depLabel = to12h(rideData.depTime);
      const withEta = (label, st) => label + (st.eta ? ' (' + st.eta + ')' : '');
      opt(bSel, '', 'Board: ' + (rideData.fromArea || 'Start') + (depLabel ? ' (' + depLabel + ')' : ''));
      stops.forEach((st) => { if (st.id) opt(bSel, st.id, withEta('Board: ' + st.name, st)); });
      stops.forEach((st) => { if (st.id) opt(aSel, st.id, withEta('Get off: ' + st.name, st)); });
      opt(aSel, '', 'Get off: ' + (rideData.toArea || 'End'));
      aSel.value = '';
      // Leg preselect from the search card (2026-09-08): ?board=<stopId>
      // &alight=<stopId>, forwarded by ride.html. Only ids that exist on THIS
      // ride are honoured; recomputeSegment re-validates order and prices the
      // pair exactly as the seat tiles and the server will.
      try {
        const pb = qp.get('board'), pa = qp.get('alight');
        if (pb && segStopById(pb)) { bSel.value = pb; segBoardingId = pb; }
        if (pa && segStopById(pa)) { aSel.value = pa; segAlightingId = pa; }
        if (segBoardingId || segAlightingId) recomputeSegment();
      } catch (_) {}
      bSel.addEventListener('change', () => { segBoardingId = bSel.value || null; recomputeSegment(); });
      aSel.addEventListener('change', () => { segAlightingId = aSel.value || null; recomputeSegment(); });
      wrap.classList.remove('hidden');
    }

    /** Rewrite every open tile's price from the current selection. Open tiles
     *  carry data-seat; closed ones are disabled and show a word, not a price. */
    function refreshTilePrices() {
      var tiles = document.querySelectorAll('[data-seat]');
      for (var i = 0; i < tiles.length; i++) {
        var el = tiles[i];
        if (el.disabled) continue;
        var seat = seatById(el.dataset.seat);
        var sp = el.querySelector('.sp');
        if (seat && sp) sp.textContent = fmt$(tilePriceDollars(seat));
      }
    }

    function seatBtn(s) {
      const btn = document.createElement('button');
      btn.type = 'button';
      const priced = typeof s.price === 'number' && s.price > 0;
      const open = s.avail !== false && priced;
      btn.className = 'seat' + (open ? '' : ' taken');
      btn.dataset.seat = s.id;
      // textContent, never innerHTML: seat label/id come from the DRIVER's
      // rides.seats JSON (any app user controls their own), so a markup
      // label here would be stored XSS running with the rider's session.
      // (2026-08-20)
      var labelSpan = document.createElement('span');
      labelSpan.textContent = s.label || s.id;
      var priceSpan = document.createElement('span');
      priceSpan.className = 'sp';
      // Booked-by-a-rider says "Taken"; a seat the driver closed (comfort
      // seat) says "Closed" — different facts (Justin, 2026-08-28). booked is
      // new in the payload: only an explicit false means closed, so a cached
      // pre-field payload still reads "Taken".
      priceSpan.textContent = open ? fmt$(tilePriceDollars(s)) : (s.booked === false ? 'Closed' : 'Taken');
      btn.appendChild(labelSpan);
      btn.appendChild(priceSpan);
      if (open) {
        btn.addEventListener('click', () => {
          const i = selectedSeats.indexOf(s.id);
          if (i >= 0) selectedSeats.splice(i, 1); else selectedSeats.push(s.id);
          btn.classList.toggle('sel', i < 0);
          // Marginal prices depend on what else is selected, so every OTHER
          // tile's number changes when this one is picked: the first seat
          // carries the per-booking minimum, the second does not. Repaint the
          // labels in place (never the whole grid, which would drop the DOM
          // nodes and the selection styling we just set).
          refreshTilePrices();
          updateSummary();
        });
      }
      return btn;
    }

    // A position this ride never offered (see the car layout in renderSeats):
    // drawn locked so the diagram still reads as a whole car, never clickable,
    // never in selectedSeats. Plain text only — the label is ours, not the
    // driver's, but keep the same no-innerHTML discipline as seatBtn.
    function closedTile(id, name) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'seat taken closed';
      btn.disabled = true;
      btn.setAttribute('aria-label', name + ' seat, closed');
      var labelSpan = document.createElement('span');
      labelSpan.textContent = name;
      var priceSpan = document.createElement('span');
      priceSpan.className = 'sp';
      priceSpan.textContent = 'Closed';
      btn.appendChild(labelSpan);
      btn.appendChild(priceSpan);
      return btn;
    }

    function renderSeats() {
      const grid = $('seatGrid');
      grid.innerHTML = '';
      // Keep the rider's picks across a segment-change re-render (review
      // finding #9 — changing Board/Get off silently wiped the selection).
      const priorSeats = selectedSeats.slice();
      selectedSeats = [];
      const seats = Array.isArray(rideData.seats) ? rideData.seats : [];

      // Overhead cabin when every seat uses the app's canonical position ids
      // (fp front passenger; ml/mr middle row; rl/rc/rr rear). Unknown ids
      // (future layouts) fall back to the plain grid so nothing breaks.
      const KNOWN = { fp: 1, ml: 1, mr: 1, rl: 1, rc: 1, rr: 1 };
      const byId = {};
      for (const s of seats) byId[s.id] = s;
      const carLayout = seats.length > 0 && seats.every((s) => KNOWN[s.id]);

      if (!carLayout) {
        for (const s of seats) grid.appendChild(seatBtn(s));
      } else {
        const shell = document.createElement('div');
        shell.className = 'carshell';

        // Front row: the driver's seat (left, US car) + front passenger.
        const front = document.createElement('div');
        front.className = 'carrow';
        const drv = document.createElement('div');
        drv.className = 'dseat';
        drv.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M3.5 12h6M14.5 12h6M12 14.5V21"/></svg>';
        drv.appendChild(document.createTextNode('Driver'));
        front.appendChild(drv);
        // Every standard position is DRAWN. A ride posted from a car profile
        // with fewer passenger seats (the app builds the layout from the
        // vehicle's seat count — a "2-seat" car lists fp + rl only) used to
        // show a car with the rear row simply missing. Positions the ride
        // never listed now render as CLOSED tiles (Justin, 2026-09-07: "they
        // should appear but be marked as closed"). Same treatment as the app's
        // booking sheet. The middle row is still only drawn when the ride has
        // one — sedans have no middle row to close.
        const CLOSED_NAME = { fp: 'Front', ml: 'Middle Left', mr: 'Middle Right', rl: 'Rear Left', rc: 'Rear Center', rr: 'Rear Right' };
        const tile = (id) => byId[id] ? seatBtn(byId[id]) : closedTile(id, CLOSED_NAME[id]);
        front.appendChild(tile('fp'));
        shell.appendChild(front);

        // Middle row (6-seaters / vans) only when the vehicle has one.
        if (byId.ml || byId.mr) {
          const mid = document.createElement('div');
          mid.className = 'carrow';
          mid.appendChild(tile('ml'));
          mid.appendChild(tile('mr'));
          const div1 = document.createElement('div');
          div1.className = 'windshield';
          shell.appendChild(div1);
          shell.appendChild(mid);
        }

        // Rear bench — always drawn.
        {
          const div2 = document.createElement('div');
          div2.className = 'windshield';
          shell.appendChild(div2);
          const rear = document.createElement('div');
          rear.className = 'carrow three';
          rear.appendChild(tile('rl'));
          rear.appendChild(tile('rc'));
          rear.appendChild(tile('rr'));
          shell.appendChild(rear);
        }

        // Car chrome (v2): wheels at the corners + side mirrors, centered.
        const wrap = document.createElement('div');
        wrap.className = 'carwrap';
        ['wfl', 'wfr', 'wrl', 'wrr'].forEach((w) => {
          const el = document.createElement('div');
          el.className = 'carwheel ' + w;
          wrap.appendChild(el);
        });
        ['mml', 'mmr'].forEach((m) => {
          const el = document.createElement('div');
          el.className = 'carmirror ' + m;
          wrap.appendChild(el);
        });
        wrap.appendChild(shell);
        grid.appendChild(wrap);
      }

      if (rideData.driverFirst) {
        $('drvMsgLabel').textContent = 'Message to ' + rideData.driverFirst + ' (optional)';
        var _smb = $('successMsgBtn'); if (_smb) _smb.textContent = '💬 Message ' + rideData.driverFirst;
      }
      for (const pid of priorSeats) {
        const btn = grid.querySelector('[data-seat="' + (window.CSS && CSS.escape ? CSS.escape(pid) : pid) + '"]');
        if (btn && !btn.classList.contains('taken')) btn.click();
      }
      updateSummary();
    }

    function seatById(id) { return (rideData.seats || []).find((s) => s.id === id); }

    // The ONE place the charge is computed (display only — the server recomputes
    // everything from the ride row). Used by the seat summary AND the
    // "Your pick" line on the gate steps, so both always show the same number.
    function computeTotals() {
      const n = selectedSeats.length;
      if (n === 0 || !rideData) return null;
      const totalDollars = selectedSeats.reduce((sum, id) => sum + segPrice(seatById(id)?.price || 0), 0);
      // Same integer math as the server: fee on the summed seat cents.
      const bps = typeof rideData.serviceFeeBps === 'number' ? rideData.serviceFeeBps : 500;
      const seatCents = Math.round(totalDollars * 100);
      const feeCents = serviceFeeCentsFor(seatCents);
      const minLifted = feeCents > Math.floor((seatCents * bps) / 10000);
      // Flat 99¢ booking fee, when it applies: waived-driver rides (server
      // says so) OR this rider holds credit (credit parity with the app,
      // 2026-08-25). The server adds it as its own Checkout line item.
      const bookingFeeCents =
        rideData.bookingFeeApplies === true || myCreditCents > 0 ||
        (rideData.bookingFeeApplies === undefined && rideData.bookingFeeCents > 0)
          ? 99 : 0;
      const grandTotal = seatCents + feeCents + bookingFeeCents;
      // Credit preview — mirrors the server exactly: redeem up to the total
      // minus Stripe's 50¢ card minimum. charge = what the card is charged.
      const creditPreview = myCreditCents > 0 && grandTotal > 50 ? Math.min(myCreditCents, grandTotal - 50) : 0;
      return { n, bps, minLifted, seatCents, feeCents, bookingFeeCents, grandTotal, creditPreview, charge: grandTotal - creditPreview };
    }

    // Booking-fee info toggle; aria-expanded mirrors the hint's visibility.
    (function wireFeeInfo() {
      function init() {
        var btn = $('feeInfoBtn'), box = $('feeInfo');
        if (!btn || !box) return;
        btn.addEventListener('click', function () {
          var open = box.classList.toggle('hidden') === false;
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();

function rideWhen(dateStr, timeStr) {
  var p = String(dateStr || '').split('-').map(Number);
  if (!p[0] || !p[1] || !p[2]) return '';
  var day = new Date(p[0], p[1] - 1, p[2]).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  var t = '';
  if (timeStr) {
    var h = parseInt(String(timeStr).slice(0, 2), 10), m = String(timeStr).slice(3, 5);
    if (!isNaN(h)) t = ((h % 12) || 12) + ':' + m + ' ' + (h >= 12 ? 'PM' : 'AM') + ' PT';
  }
  return day + (t ? ' · ' + t : '');
}

    function updateSummary() {
      const n = selectedSeats.length;
      const bookBtn = $('bookBtn');
      const t = computeTotals();
      if (n === 0 || !t) {
        $('priceSummary').classList.add('hidden');
        bookBtn.disabled = true;
        bookBtn.textContent = 'Pick a seat to continue';
        return;
      }
      const { bps, minLifted, seatCents, feeCents } = t;
      $('sumSeatsLabel').textContent = n + ' seat' + (n === 1 ? '' : 's');
      $('sumSeats').textContent = fmt$(seatCents / 100);
      // The label stays "Booking fee" + the info button (never a derived rate,
      // Justin 2026-09-10); the toggle text carries the live rate and floor.
      var minC = typeof rideData.serviceFeeMinCents === 'number' ? rideData.serviceFeeMinCents : 0;
      var minTxt = minC % 100 === 0 ? '$' + (minC / 100) : fmt$(minC / 100);
      $('feeInfo').textContent = myFeeWaived
        ? 'Your booking fee is waived. Nothing to do, it is already off this total.'
        : 'The booking fee is ' + (bps / 100) + '% of the seat price'
          + (minC > 0 ? ', with a minimum of ' + minTxt + ' for processing and server fees on rides under that amount.' : '.')
          + (minLifted ? ' The minimum applies to this booking.' : '');
      // A waived rider reads "Waived", not "$0.00". A zero dollar amount looks
      // like a bug; the word says a thing was done for them on purpose.
      $('sumFee').textContent = myFeeWaived ? 'Waived' : fmt$(feeCents / 100);
      // Flat 99¢ booking fee, when it applies: waived-driver rides (server
      // says so) OR this rider holds credit (credit parity with the app,
      // 2026-08-25 — their credit auto-applies at checkout as a "Ride credit"
      // discount, and credit-funded bookings carry the fee). The server adds
      // it as its own Checkout line item, so this summary must match exactly.
      var bookingFeeCents = t.bookingFeeCents;
      var bookingFeeRow = $('sumBookingFeeRow');
      if (bookingFeeRow) bookingFeeRow.classList.toggle('hidden', bookingFeeCents === 0);
      if (bookingFeeCents > 0) $('sumBookingFee').textContent = fmt$(bookingFeeCents / 100);
      var grandTotal = t.grandTotal;
      var creditPreview = t.creditPreview;
      var creditRow = $('sumCreditRow');
      if (creditRow) creditRow.classList.toggle('hidden', creditPreview === 0);
      if (creditPreview > 0) $('sumCredit').textContent = '−' + fmt$(creditPreview / 100);
      $('sumTotal').textContent = fmt$((grandTotal - creditPreview) / 100);
      $('priceSummary').classList.remove('hidden');
      bookBtn.disabled = false;
      bookBtn.textContent = 'Request ' + n + ' seat' + (n === 1 ? '' : 's') + ' · ' + fmt$((grandTotal - creditPreview) / 100);
    }

    // ── Email OTP ─────────────────────────────────────────────────────────
    let emailCooldown = 0, emailCooldownTimer = null;
    function startEmailCooldown() {
      emailCooldown = 60;
      const btn = $('codeResend');
      clearInterval(emailCooldownTimer);
      emailCooldownTimer = setInterval(() => {
        emailCooldown -= 1;
        if (emailCooldown <= 0) { clearInterval(emailCooldownTimer); btn.disabled = false; btn.textContent = 'Resend code'; }
        else { btn.disabled = true; btn.textContent = 'Resend in ' + emailCooldown + 's'; }
      }, 1000);
      btn.disabled = true; btn.textContent = 'Resend in 60s';
    }

    async function sendEmailOtp(email) {
      // shouldCreateUser — the whole point is a first-time visitor. role:
      // 'passenger' in user_metadata so the app routes correctly if they
      // install it later. 6-digit typed code, no redirect link — immune to
      // mail-scanner link burning.
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { shouldCreateUser: true, data: { role: 'passenger', surface: 'web' } },
      });
      if (error) {
        const m = (error.message || '').toLowerCase();
        if (m.includes('rate limit')) return 'Too many codes requested. Try again in an hour.';
        return error.message || "Couldn't send the code. Try again.";
      }
      return null;
    }

    $('emailBtn').addEventListener('click', async () => {
      setMsg('emailMsg', '');
      const email = $('email').value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setMsg('emailMsg', 'Enter a valid email address.'); return; }
      const btn = $('emailBtn');
      btn.disabled = true; btn.textContent = 'Sending…';
      const err = await sendEmailOtp(email);
      btn.disabled = false; btn.textContent = 'Email me a code';
      if (err) { setMsg('emailMsg', err); return; }
      pendingEmail = email;
      $('codeEmailEcho').textContent = email;
      $('emailCode').value = '';
      startEmailCooldown();
      show('stCode');
      $('emailCode').focus();
    });

    $('codeResend').addEventListener('click', async () => {
      setMsg('codeMsg', '');
