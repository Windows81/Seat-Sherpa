      setMsg('codeMsg', 'New code sent.', 'ok');
    });

    $('codeChangeEmail').addEventListener('click', () => { setMsg('codeMsg', ''); show('stEmail'); });

    // ── Social sign-in (Google / Apple popup — js/ss-oauth.js) ────────────
    // The popup writes the shared session; the page never navigates, so the
    // seat/segment selection survives. Continuation mirrors the OTP verify
    // path: role stamp (keep existing, default passenger), fresh-account
    // signup event, then route() picks up exactly where the funnel was.
    if (window.SS_OAUTH) {
      window.SS_OAUTH.mount($('oauthMount'), {
        onSignedIn: async () => {
          try {
            const { data: u } = await supabase.auth.getUser();
            if (u && u.user) {
              // surface:'web' so 0261's trigger stamps profiles.web_seen_at for
              // OAuth sign-ups too (only the OTP path set it at signUp).
              try { await supabase.auth.updateUser({ data: { role: u.user.user_metadata?.role || 'passenger', surface: 'web' } }); } catch (_) {}
              try {
                const created = u.user.created_at ? new Date(u.user.created_at).getTime() : 0;
                // ONCE per page. A new Google/Apple rider signs in here and is
                // sent straight to the phone wall, whose success handler fires
                // the same event, so both landed inside the 10-minute window:
                // two Google Ads conversions, two Meta, two Reddit, for one
                // rider (bug sweep, 2026-09-11).
                if (created && Date.now() - created < 10 * 60 * 1000 && window.ssTrack && !window.__ssSignupFired) {
                  window.__ssSignupFired = true;
                  window.ssTrack('CompleteRegistration', { em: u.user.email });
                }
              } catch (_) {}
            }
          } catch (_) {}
          if (waitlistMode) { waitlistMode = false; await waitlistFlow(); return; }
          await route();
        },
      });
    }

    $('codeBtn').addEventListener('click', async () => {
      setMsg('codeMsg', '');
      const code = $('emailCode').value.replace(/\D/g, '');
      // 6–8: Supabase's OTP length is a dashboard setting — never stricter here.
      if (code.length < 6) { setMsg('codeMsg', 'Enter the code from the email.'); return; }
      const btn = $('codeBtn');
      btn.disabled = true; btn.textContent = 'Verifying…';
      const { data, error } = await supabase.auth.verifyOtp({ email: pendingEmail, token: code, type: 'email' });
      btn.disabled = false; btn.textContent = 'Verify';
      if (error) {
        const m = (error.message || '').toLowerCase();
