<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Seat Sherpa for Colleges — cheaper student travel, less parking demand</title>
  <meta name="description" content="Students already drive home for breaks with empty seats. Seat Sherpa lets your campus share those rides at cost — no setup, no integration, and nothing for the college to pay." />
  <meta property="og:title" content="Seat Sherpa for Colleges" />
  <meta property="og:description" content="Cheaper student travel and less parking demand, with a carpool platform that costs your college nothing to run." />
  <meta property="og:image" content="https://seatsherpa.app/icon.png" />
  <meta property="og:url" content="https://seatsherpa.app/colleges" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" href="/icon-96.png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    /* Theme tokens (2026-10-12). Dark is the default and every dark value is
       the literal this page used before tokens. Light follows the system
       setting with the shared light palette; in light, teal is kept for
       things you can tap (links, buttons, the active nav item), and the
       eyebrow pill and step numbers go neutral. */
    :root {
      color-scheme: dark;
      --bg: #0E0E10; --text: #fff; --link: #00D4C8;
      --line: rgba(255,255,255,0.06); --nav-link: #ccc; --nav-active: #00D4C8;
      --wm-eat: #00D4C8; --wm-sherpa: #ffffff;
      --glow: rgba(0,212,200,0.10);
      --eyebrow: #00D4C8; --eyebrow-bg: rgba(0,212,200,.10); --eyebrow-line: rgba(0,212,200,.28);
      --lede: #ccc; --sub: #999; --body: #b9b9c6;
      --btn-top: #00D4C8; --btn-bottom: #00B5AA; --on-teal: #04201e; --btn-glow: rgba(0,212,200,.22);
      --ghost-line: rgba(0,212,200,.5);
      --card: #131316; --card-line: rgba(255,255,255,0.08);
      --num-bg: #0E0E10; --num-line: rgba(0,212,200,.45); --num: #00D4C8;
      --note-bg: rgba(0,212,200,.06); --note-line: rgba(0,212,200,.22); --note-text: #cfeeeb;
      --foot: #888;
    }
    @media (prefers-color-scheme: light) {
      :root {
        color-scheme: light;
        --bg: #F5F6F5; --text: #121416; --link: #007C76;
        --line: rgba(18,22,22,0.10); --nav-link: #4B5357; --nav-active: #007C76;
        --wm-eat: #00A89F; --wm-sherpa: #121416;
        --glow: rgba(0,168,159,0.08);
        --eyebrow: #4B5357; --eyebrow-bg: #EFF1F0; --eyebrow-line: #D8DCDB;
        --lede: #4B5357; --sub: #4B5357; --body: #4B5357;
        --btn-glow: rgba(0,168,159,.25);
        --ghost-line: rgba(0,124,118,.45);
        --card: #FFFFFF; --card-line: rgba(18,22,22,0.10);
        --num-bg: #EFF1F0; --num-line: #D8DCDB; --num: #23272A;
        --note-bg: #FFFFFF; --note-line: rgba(18,22,22,0.10); --note-text: #23272A;
        --foot: #687176;
      }
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: var(--bg); color: var(--text); line-height: 1.55; -webkit-font-smoothing: antialiased;
    }
    a { color: var(--link); text-decoration: none; transition: opacity .15s; }
    a:hover { opacity: .85; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
    nav { padding: 20px 0; border-bottom: 1px solid var(--line); }
    nav .container { display: flex; align-items: center; justify-content: space-between; }
    nav .links { display: flex; gap: 24px; font-size: 14px; }
    nav .links a { color: var(--nav-link); }
    nav .links a.active { color: var(--nav-active); font-weight: 600; }
    @media (max-width: 700px) { nav .links { display: none; } }
    .hero {
      padding: 76px 0 56px; text-align: center;
      background: radial-gradient(ellipse at top, var(--glow) 0%, transparent 60%);
    }
    .eyebrow {
      display: inline-block; font-size: 11px; letter-spacing: 1.6px; text-transform: uppercase;
      color: var(--eyebrow); background: var(--eyebrow-bg); border: 1px solid var(--eyebrow-line);
      border-radius: 999px; padding: 5px 14px; margin-bottom: 20px; font-weight: 700;
    }
    h1 {
      font-family: Outfit, sans-serif; font-weight: 700; font-size: 48px; line-height: 1.12;
      letter-spacing: -0.6px; margin-bottom: 18px;
    }
    @media (max-width: 700px) { h1 { font-size: 34px; } .hero { padding: 52px 0 40px; } }
    .lede { font-size: 18px; color: var(--lede); max-width: 660px; margin: 0 auto 30px; }
    .btn {
      display: inline-block; background: linear-gradient(180deg, var(--btn-top) 0%, var(--btn-bottom) 100%);
      color: var(--on-teal); font-weight: 700; padding: 14px 26px; border-radius: 100px; font-size: 15px;
      box-shadow: 0 8px 24px var(--btn-glow);
    }
    .btn.ghost { background: none; color: var(--link); border: 1px solid var(--ghost-line); box-shadow: none; }
    section { padding: 68px 0; border-top: 1px solid var(--line); }
    h2 { font-family: Outfit, sans-serif; font-weight: 700; font-size: 30px; letter-spacing: -0.3px; margin-bottom: 10px; }
    .sub { color: var(--sub); font-size: 15.5px; margin-bottom: 30px; max-width: 680px; }
    .steps { display: grid; gap: 12px; }
    .step {
      display: flex; gap: 16px; align-items: flex-start; background: var(--card);
      border: 1px solid var(--card-line); border-radius: 14px; padding: 18px 20px;
    }
    .step .n {
      flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--num-bg);
      border: 1px solid var(--num-line); color: var(--num); font-weight: 700; font-size: 14px;
      display: flex; align-items: center; justify-content: center;
    }
    .step h3 { font-size: 16px; font-weight: 700; margin-bottom: 3px; }
    .step p { font-size: 14.5px; color: var(--body); line-height: 1.55; }
    .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    @media (max-width: 820px) { .grid3 { grid-template-columns: 1fr; } }
    .card { background: var(--card); border: 1px solid var(--card-line); border-radius: 16px; padding: 22px; }
    .card h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; }
    .card p { font-size: 14.5px; color: var(--body); }
    .note {
      background: var(--note-bg); border: 1px solid var(--note-line);
      border-radius: 14px; padding: 18px 20px; font-size: 15px; color: var(--note-text); line-height: 1.6;
    }
    .cta { text-align: center; }
    footer { padding: 44px 0 60px; border-top: 1px solid var(--line); color: var(--foot); font-size: 14px; }
    footer .container { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 20px; }
    footer .links { display: flex; gap: 20px; flex-wrap: wrap; }
    footer .links a { color: var(--foot); }

    /* Laptop (2026-10-12): a split hero (headline left, pitch and button
       right), the four steps as a 2 x 2 grid, and "What it costs" with its
       heading beside a reading-width note instead of one full-width line of
       text. Phones are untouched (all of this starts at 960px). */
    @media (min-width: 960px) {
      .container { max-width: 1180px; }
      .hero { padding: 96px 0 80px; text-align: left; }
      .hero .container {
        display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
        column-gap: 72px; align-items: end;
      }
      .hero .eyebrow { grid-column: 1; grid-row: 1; justify-self: start; }
      .hero h1 { grid-column: 1; grid-row: 2 / span 2; margin-bottom: 0; font-size: 52px; }
      .hero .lede { grid-column: 2; grid-row: 2; max-width: none; margin: 0 0 28px; }
      .hero .btn { grid-column: 2; grid-row: 3; justify-self: start; }
      section { padding: 84px 0; }
      h2 { font-size: 34px; }
      .sub { font-size: 16.5px; }
      .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
      .step { padding: 22px 24px; }
      .step p, .card p { font-size: 15px; }
      .grid3 { gap: 20px; }
      .card { padding: 26px; }
      .container:has(> .note) {
        display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 600px);
        column-gap: 72px; align-items: start;
      }
      .container:has(> .note) > h2 { grid-column: 1; grid-row: 1 / span 4; }
      .container:has(> .note) > .note { grid-column: 2; font-size: 16px; padding: 22px 26px; }
    }
  </style>
</head>
<body>
  <nav>
    <div class="container">
      <a href="/" aria-label="Seat Sherpa home" style="display:block">
