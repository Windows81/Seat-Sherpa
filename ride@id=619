  <script>
    (function () {
      // The headline normally sits UNDER the button (reassurance, web mode);
      // when the ride is gone, full or departed the headline is the news and
      // has to come first. Lives in THIS block: it used to be declared in the
      // share block below, out of reach of the three calls here, so each one
      // threw and silently skipped everything after it, including the swap
      // from "Book this seat" to "See current rides" (found 2026-10-03).
      function headAboveButton(sub) {
        var ch = document.querySelector('.cta-head');
        var wb2 = document.getElementById('webBook');
        if (ch && wb2 && wb2.parentNode) { wb2.parentNode.insertBefore(ch, wb2); ch.style.marginTop = ''; }
        var cs = document.getElementById('ctaSub');
        if (cs && typeof sub === 'string') cs.textContent = sub;
      }
      var p = new URLSearchParams(window.location.search);
      // Leading digits only (bug check 2026-10-05): a Facebook post that ran
      // the link into the next word opened /ride/227My, and public-ride 400s
      // on anything but a number. Ride ids are numeric.
      // No digits at all ("abc") = no ride: the browse state, not "That ride
      // is no longer available" (bug check 2026-10-05).
      var rawId = p.get('id');
      var idDigits = /^\d+/.exec(rawId || '');
      var id = idDigits ? idDigits[0] : '';
      var ref = (p.get('ref') || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
      var SUPA = 'https://vmfmbntacifqoqxqxgsk.supabase.co';
      var ANON = 'sb_publishable_TGebz9q_z0kkH0Tuivlr4w_3MPLMxF3';

      // Referral nudge — shows the sharer's code so a new rider gets $5 off.
      if (ref) {
        document.getElementById('refCode').textContent = ref;
        document.getElementById('refNudge').style.display = 'block';
      }

      // Browser booking is FIRST-CLASS (2026-08-28, standing rule): every
      // visitor gets the in-browser booking CTA. This was gated on ?web=1
      // from the hidden-funnel era; the /book flow is live and battle-tested,
      // and a share link that funnels to the app stores loses the sale.
      var web = true;
      if (web && id) {
        var wb = document.getElementById('webBook');
        // Forward a leg preselect from /rides (2026-09-08): the search card
        // showed the driver's price for THIS leg, so the booking page has to
        // open on the same pair or the price changes on click-through. Only
        // plain stop ids pass through; the booking page validates them
        // against the ride.
        var legQ = '';
        try {
          var lp = new URLSearchParams(location.search);
          ['board', 'alight'].forEach(function (k) {
            var v = lp.get(k);
            if (v && /^[a-z0-9-]{1,40}$/.test(v)) legQ += '&' + k + '=' + encodeURIComponent(v);
          });
        } catch (_) {}
        wb.href = '/book?id=' + encodeURIComponent(id) + legQ;
        wb.style.display = 'flex';
        // The button says what to do; a headline repeating it above was
        // noise. The line under it carries the one fact that matters.
        document.getElementById('ctaTitle').style.display = 'none';
        document.getElementById('ctaSub').textContent = 'The seat is only charged if the driver accepts. Payment is handled by Stripe.';
        // The reassurance reads under the button, not above it.
        var ctaHead = document.querySelector('.cta-head');
        if (ctaHead && wb.parentNode) { wb.parentNode.insertBefore(ctaHead, wb.nextSibling); ctaHead.style.marginTop = '12px'; }
      } else if (web) {
        // No/invalid id (truncated or ancient links): with the store badges
        // gone this page had NO button at all (scan #3) — point the main CTA
        // at the live browse list.
        var wbNoId = document.getElementById('webBook');
        wbNoId.href = '/rides?web=1';
        wbNoId.textContent = 'See current rides';
        wbNoId.style.display = 'flex';
        document.getElementById('ctaSub').textContent = 'Browse live carpools across California & Nevada and book right from your browser.';
      }

      // Fetch the ride details by id (short links carry only the id now).
      // v=ride tells public-ride this is a person on the ride page, so it
      // logs a ride view (0295); c= and dr= carry the campaign code and the
      // page's own referrer for the funnel. Link previews send none of these.
      if (id) {
        var viewQ = '&v=ride';
        try {
          var cq = new URLSearchParams(location.search).get('c');
          if (cq) viewQ += '&c=' + encodeURIComponent(cq.slice(0, 32));
          if (document.referrer) viewQ += '&dr=' + encodeURIComponent(document.referrer.slice(0, 200));
        } catch (e) { /* attribution is optional */ }
        fetch(SUPA + '/functions/v1/public-ride?id=' + encodeURIComponent(id) + viewQ,
              { headers: { apikey: ANON, Authorization: 'Bearer ' + ANON } })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            // Renders a "tell drivers you need this" link under the CTA,
            // prefilled with this ride's corridor + date so the rider posts a
            // request in one tap instead of re-entering the trip. Silent when
            // the payload predates fromDest/toDest — never a broken link.
            function offerRequestBoard(rd) {
              try {
                if (!rd || !rd.fromDest || !rd.toDest) return;
                var host = document.getElementById('moreRides');
                if (!host) return;
                var href = '/requests?from=' + encodeURIComponent(rd.fromDest)
                  + '&to=' + encodeURIComponent(rd.toDest)
                  + (rd.depDate ? '&date=' + encodeURIComponent(rd.depDate) : '');
                var a = document.createElement('a');
                a.href = href;
                a.style.cssText = 'color:var(--link);text-decoration:none;';
                a.textContent = 'Tell drivers you still need this trip';
                var wrap = document.createElement('div');
                wrap.style.cssText = 'margin-top:8px;';
                wrap.appendChild(a);
                host.appendChild(wrap);
                host.style.display = 'block';
              } catch (_) { /* best-effort */ }
            }
            if (!d || !d.found) {
              // Ride gone — cancelled, removed, or already departed (a link in an
              // old Craigslist / FB post). Don't leave the visitor on a generic
              // page as if their ride were fine: reframe the CTA so they still
              // funnel into the app to find a current ride.
              document.getElementById('ctaTitle').textContent = 'That ride is no longer available';
              document.getElementById('ctaTitle').style.display = '';
              headAboveButton('It was cancelled or has already left. Drivers post new rides every day.');
              // The optimistic web-mode "Book this seat online" button was
              // shown before this fetch — a teal book CTA under "no longer
              // available" is an embarrassing first click (audit M2). Point
              // it at the live browse list instead of hiding it: the visitor
              // still wants a ride.
              var wbGone = document.getElementById('webBook');
              if (wbGone && wbGone.style.display !== 'none') {
                wbGone.href = '/rides?web=1';
                wbGone.textContent = 'See current rides';
              }
              // Cancelled/departed: nothing competes for this moment, and the
              // visitor's trip intent is still unmet — offer the board.
              offerRequestBoard(d);
              return;
            }
            // Full or not-yet/no-longer bookable (departs too soon): the book
            // funnel would only bounce them — swap the CTA for browse.
            // Leg-aware seats (0356, 2026-10-05): full from the start but open
            // from a later stop, e.g. every seat taken to Los Angeles and free
            // from there to San Diego. The button books that stretch; the
            // full ride keeps its waitlist as a link (Justin: "in addition to
            // the original having a waitlist").
            var openStop = (d.legAware && d.openFrom && d.seatsLeft === 0 && d.bookable !== false)
              ? ((d.routeStops || []).find(function (s) { return s && s.id === d.openFrom.stopId; }) || null)
              : null;
            // THE RIDER'S STRETCH (bug check 2026-10-06). A link with
            // ?board=<stop> (stretch posts, search cards) or a ride open only
            // from a later stop (openStop) is about the trip FROM that stop
            // on: header, time, stops, seats, price, title and share text
            // start there, never the origin, its time or earlier stops
            // (standing copy rule). A stop the car has already passed gives
            // way to the first one still ahead, as the book page does.
            // ?alight=<stop> (a search card's leg) ends it early.
            var legQp = new URLSearchParams(location.search);
            var plainStopId = function (v) { return v && /^[a-z0-9-]{1,40}$/.test(v) ? v : ''; };
            var stopById = function (sid) {
              return sid ? ((d.routeStops || []).find(function (s) { return s && s.id === sid && typeof s.pos === 'number'; }) || null) : null;
            };
            var legStop = stopById(plainStopId(legQp.get('board')));
            if (openStop && typeof openStop.pos === 'number' && (!legStop || legStop.pos < openStop.pos)) legStop = openStop;
            if (legStop && legStop.boardable === false) {
              var nextUp = typeof d.boardableFromIndex === 'number'
                ? ((d.routeStops || []).find(function (s) { return s && s.id && s.pos === d.boardableFromIndex - 1; }) || null)
                : null;
              legStop = nextUp && nextUp.pos > legStop.pos ? nextUp : null;
            }
            // The car has left its origin but a later stop is still ahead
            // (originBoardable false): the page describes the trip from that
            // stop, like a stretch link. The header, timeline, seats and price
            // used to start at the origin while the button said "Book from
            // Los Angeles" and the booking page charged the stretch (bug check
            // 2026-10-12).
            if (!legStop && !openStop && d.originBoardable === false && d.bookable !== false && typeof d.boardableFromIndex === 'number') {
              legStop = (d.routeStops || []).find(function (s) { return s && s.id && typeof s.pos === 'number' && s.pos === d.boardableFromIndex - 1; }) || null;
            }
            // ?alight= with no ?board= is a leg from the ORIGIN to a stop
            // (/rides cards link those): it ends there. It was ignored, so the
            // page quoted the whole ride ($46.20) for a $14 leg (bug check
            // 2026-10-12).
            var legEnd = stopById(plainStopId(legQp.get('alight')));
            if (legEnd && legStop && legEnd.pos <= legStop.pos) legEnd = null;
            var onLeg = !!(legStop || legEnd);
            // "San Diego, CA" reads "San Diego" beside a stop name, which
            // carries no state; sentences keep the full destination.
            var legToShort = legEnd ? legEnd.name : String(d.toArea || 'destination').replace(/,\s*[A-Z]{2}$/, '');
            var legToLong = legEnd ? legEnd.name : (d.toArea || 'the destination');
            // public-ride's eta: "~11:00 PM" or "~12:05 AM (next day)".
            var legEta = function (st) {
              var m = /^~?\s*(\d{1,2}:\d{2}\s*[AP]M)(\s*\(next day\))?/i.exec(String((st && st.eta) || ''));
              return m ? { time: m[1].toUpperCase(), nextDay: !!m[2] } : null;
            };
            // The stop's own calendar day (a stop reached after midnight is
            // the next day), as YYYY-MM-DD for rideWhen.
            var legDate = function (st) {
              var e = legEta(st);
              var p = String(d.depDate || '').split('-').map(Number);
              if (!p[0] || !p[1] || !p[2]) return d.depDate || '';
              var dt = new Date(p[0], p[1] - 1, p[2] + (e && e.nextDay ? 1 : 0));
              return dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0') + '-' + String(dt.getDate()).padStart(2, '0');
            };
            var leavesLine = function (st) {
              var e = legEta(st);
              return e
                ? 'Leaves ' + st.name + ' around ' + e.time + ' (estimated) for ' + legToLong + '.'
                : 'Seats open from ' + st.name + ' to ' + legToLong + '.';
            };
            // Seats and price for the stretch, the book page's rules: a
            // leg-aware seat is open for [board, alight) when it is not
            // closed and no hold overlaps it, otherwise the live whole-ride
            // seats; each costs min(its price, the driver's leg price).
            var legSeats = null, legPrice = null, legVaries = false;
            if (onLeg) {
              // Boarding index: 0 = the origin, a stop's pos + 1 otherwise.
              var lb = legStop ? legStop.pos + 1 : 0;
              var lN = typeof d.routeStopCount === 'number' ? d.routeStopCount : (d.routeStops || []).length;
              var la = legEnd ? legEnd.pos + 1 : lN + 1;
              var lHolds = Array.isArray(d.seatHolds) ? d.seatHolds : [];
              var lOpen = (d.seats || []).filter(function (s) {
                if (!s || !s.id) return false;
                if (d.legAware) {
                  return s.closed !== true && !lHolds.some(function (h) { return h && h.seat === s.id && Number(h.from) < la && lb < Number(h.to); });
                }
                return s.avail !== false && !s.booked;
              });
              var lSeg = d.segmentPrices ? d.segmentPrices[(legStop ? legStop.id : 'origin') + '|' + (legEnd ? legEnd.id : 'end')] : undefined;
              var lLeg = typeof lSeg === 'number' && isFinite(lSeg) && lSeg > 0 ? Math.round(lSeg) : null;
              var lPrices = lOpen
                .map(function (s) { return typeof s.price === 'number' ? (lLeg != null ? Math.min(s.price, lLeg) : s.price) : NaN; })
                .filter(function (v) { return isFinite(v) && v > 0; });
              legSeats = lOpen.length;
              if (lPrices.length) {
                legPrice = Math.min.apply(null, lPrices);
                var lDistinct = {};
                lPrices.forEach(function (v) { lDistinct[v] = 1; });
                legVaries = Object.keys(lDistinct).length > 1;
              }
            }
            var legAlightQ = legEnd ? '&alight=' + encodeURIComponent(legEnd.id) : '';
            // The car has left the origin but a later stop is still ahead
            // (2026-10-06, reversing 10/5): book from that stop. Sold-out-from-
            // start rides take the openStop branch below instead.
            if (web && !openStop && d.originBoardable === false && d.bookable !== false && typeof d.boardableFromIndex === 'number') {
              var aheadStop = legStop || (d.routeStops || []).find(function (s) { return s && s.pos === d.boardableFromIndex - 1 && s.id; }) || null;
              var wbAhead = document.getElementById('webBook');
              if (aheadStop && wbAhead && wbAhead.style.display !== 'none') {
                wbAhead.href = '/book?id=' + encodeURIComponent(id) + '&board=' + encodeURIComponent(aheadStop.id) + (legStop ? legAlightQ : '');
                wbAhead.textContent = 'Book from ' + aheadStop.name;
                // A stretch link never mentions where the ride started.
                headAboveButton(legStop ? leavesLine(legStop) : 'This ride has left ' + (d.fromArea || 'its start') + '. '
                  + (aheadStop.eta ? 'It reaches ' + aheadStop.name + ' around ' + String(aheadStop.eta).replace(/^~\s*/, '') + ' (estimated).' : ''));
              }
            }
            if (web && openStop) {
              var wbLeg = document.getElementById('webBook');
              if (wbLeg && wbLeg.style.display !== 'none') {
                var bookFrom = legStop || openStop;
                wbLeg.href = '/book?id=' + encodeURIComponent(id) + '&board=' + encodeURIComponent(bookFrom.id) + (legStop ? legAlightQ : '');
                wbLeg.textContent = 'Book from ' + bookFrom.name;
                var wl = document.createElement('a');
                wl.href = '/book?id=' + encodeURIComponent(id) + '&waitlist=1';
                wl.textContent = 'Need the whole ride? Join the waitlist';
                wl.style.cssText = 'display:block;text-align:center;margin-top:12px;color:var(--link);font-size:14px;text-decoration:none;';
                if (wbLeg.parentNode) wbLeg.parentNode.insertBefore(wl, wbLeg.nextSibling);
              }
            } else if (web && (d.seatsLeft === 0 || d.bookable === false)) {
              var wbDead = document.getElementById('webBook');
              if (wbDead && wbDead.style.display !== 'none') {
                if (d.seatsLeft === 0) {
                  // Full ≠ dead end (parity with the app's waitlist,
                  // 2026-08-28): capture the demand — notify-waitlist already
                  // emails when a seat frees.
                  wbDead.href = '/book?id=' + encodeURIComponent(id) + '&waitlist=1';
                  wbDead.textContent = 'Full. Email me if a seat opens';
                } else {
                  wbDead.href = '/rides?web=1';
                  wbDead.textContent = 'This ride has departed. See other rides';
                }
              }
              // No board offer here (Justin, 2026-08-28): rides are bookable
              // until they depart now, so "closed" is a vanishing state — and
              // a full ride's waitlist is strictly better than a request
              // (same ride, same driver, same date). The board is offered on
              // the gone/departed path only.
            }
            document.getElementById('rideCard').style.display = 'block';
            // Two columns on a laptop once there is a trip to show.
