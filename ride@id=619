              var bookableSeats = (d.seats || []).filter(function (s) {
                return s && s.avail !== false && !s.booked && typeof s.price === 'number';
              });
              var distinct = {};
              bookableSeats.forEach(function (s) { distinct[s.price] = 1; });
              var varies = onLeg ? legVaries : Object.keys(distinct).length > 1;
              document.getElementById('price').textContent = (varies ? 'from $' : '$') + total;
              document.querySelector('.footer-row').style.display = '';
              shareTotal = total;
            } else {
              document.querySelector('.footer-row').style.display = 'none';
            }
            // TRIP TIMELINE (2026-10-12, Justin approved the before/after):
            // pickup and its time, each stop with its estimated time, the
            // estimated drop-off (public-ride arriveEta). A stretch link
            // starts at its boarding stop and ends at its drop-off stop, the
            // same rule as the header. Stop names can be driver-typed, so
            // every string goes in as textContent. Any failure leaves the
            // one-line "Also stops in" list as it was.
            try {
              var tlHost = document.getElementById('timeline');
              var clock = function (hhmm) {
                var h = parseInt(String(hhmm || '').slice(0, 2), 10), mm = String(hhmm || '').slice(3, 5);
                return isNaN(h) || !/^\d\d$/.test(mm) ? '' : ((h % 12) || 12) + ':' + mm + ' ' + (h >= 12 ? 'PM' : 'AM');
              };
              var etaTime = function (eta) { var e = legEta({ eta: eta }); return e ? e.time : ''; };
              var startDate = legStop ? legDate(legStop) : (d.depDate || '');
              var tRows = [{
                cls: 'end', est: !!legStop,
                time: legStop ? etaTime(legStop.eta) : clock(d.depTime),
                name: legStop ? legStop.name : (noState(d.fromArea) || 'Start'),
                cap: legStop && legStop.eta ? 'Pickup, estimated' : 'Pickup',
              }];
              (d.routeStops || []).filter(function (s) {
                return s && s.name && typeof s.pos === 'number' && (!legStop || s.pos > legStop.pos) && (!legEnd || s.pos < legEnd.pos);
              }).forEach(function (s) { tRows.push({ cls: 'stop', time: etaTime(s.eta), name: s.name }); });
              var endEta = legEnd ? legEnd.eta : d.arriveEta;
              var endDay = '';
              if (endEta) {
                var endDate = legDate({ eta: endEta });
                if (endDate && startDate && endDate !== startDate) {
                  var edp = endDate.split('-').map(Number);
                  endDay = new Date(edp[0], edp[1] - 1, edp[2]).toLocaleDateString('en-US', { weekday: 'short' });
                }
              }
              tRows.push({
                cls: 'end', est: true,
                time: etaTime(endEta),
                name: legEnd ? legEnd.name : (noState(d.toArea) || 'Destination'),
                cap: 'Drop-off' + (endDay ? ' · ' + endDay : '') + (endEta ? ', estimated' : ''),
              });
              // Long routes fold the middle: the first 3 stops, then "Show N
              // more stops" (only past 5 stops; ride 559 has 8).
              var nStops = tRows.length - 2, folded = [];
              tRows.forEach(function (row, i) {
                var li = document.createElement('li');
                li.className = row.cls + (row.est ? ' est' : '');
                var t = document.createElement('span'); t.className = 't'; t.textContent = row.time || '';
                var rail = document.createElement('span'); rail.className = 'rail';
                var node = document.createElement('span'); node.className = 'node'; rail.appendChild(node);
                var pl2 = document.createElement('span'); pl2.className = 'pl';
                var nm = document.createElement('b'); nm.textContent = row.name; pl2.appendChild(nm);
                if (row.cap) { var cp = document.createElement('span'); cp.textContent = row.cap; pl2.appendChild(cp); }
                li.appendChild(t); li.appendChild(rail); li.appendChild(pl2);
                if (nStops > 5 && i > 3 && i < tRows.length - 1) { li.hidden = true; folded.push(li); }
                tlHost.appendChild(li);
              });
              if (folded.length) {
                var moreLi = document.createElement('li');
                moreLi.className = 'stop more-row';
                moreLi.innerHTML = '<span class="t"></span><span class="rail"><span class="node"></span></span><span class="pl"></span>';
                var moreB = document.createElement('button');
                moreB.type = 'button'; moreB.className = 'more';
                moreB.textContent = 'Show ' + folded.length + ' more stops';
                moreB.addEventListener('click', function () {
                  folded.forEach(function (li) { li.hidden = false; });
                  moreLi.remove();
                });
                moreLi.querySelector('.pl').appendChild(moreB);
                tlHost.insertBefore(moreLi, folded[0]);
              }
              var anyEst = tRows.some(function (r) { return r.time && (r.est || r.cls === 'stop'); });
              document.getElementById('timelineNote').textContent = anyEst
                ? 'Times are Pacific. Stop and drop-off times are estimates.'
                : 'Times are Pacific.';
              document.getElementById('tripCard').style.display = 'block';
              document.getElementById('stops').style.display = 'none';
              // The time now leads the timeline, so the line under the title
              // is the day and the seats: "Wed, Oct 14 · 3 seats left".
              var metaEl = document.getElementById('meta');
              var flexTag = metaEl.querySelector('.tag');
              var seatsTxt = (seatsEl && seatsEl.textContent) || '';
              var metaParts = [rideWhen(startDate, null)];
              // No seat count on a ride that can't be booked any more ("3 seats
              // left" beside "This ride has already departed", bug check 10/12).
              if (seatsTxt && seatsTxt !== 'Seats available' && d.bookable !== false) metaParts.push(seatsTxt);
              metaEl.textContent = metaParts.filter(Boolean).join(' · ');
              if (flexTag) metaEl.appendChild(flexTag);
            } catch (_) { /* the one-line stop list stays */ }
            // No driver details at all: no empty card.
            (function () {
              var dc = document.getElementById('driverCard');
              var rowOn = document.getElementById('driverRow').style.display === 'flex';
              var noteOn = document.getElementById('driverNote').style.display === 'block';
              if (!rowOn && !noteOn) dc.style.display = 'none';
              else if (!rowOn) document.getElementById('driverNote').style.cssText = 'display:block;';
              // Who the driver is (photo, name, badges, preference chips) in
              // one block, so a wide laptop can put it beside the bio/car/
              // reviews block (.pack). A phone sees no difference.
              if (rowOn) {
                var drvRow = document.getElementById('driverRow');
                var idBlock = document.createElement('div');
                idBlock.className = 'drv-id';
                dc.insertBefore(idBlock, drvRow);
                idBlock.appendChild(drvRow);
                var prefsEl = dc.querySelector(':scope > .prefs');
                if (prefsEl) idBlock.appendChild(prefsEl);
              }
            })();
            // Headline follows the CTA's actual state (scan #2 — the old
            // unconditional overwrite reverted 'Book this carpool ride' and
            // sat "Grab this seat" above a Full/closed button).
            if (openStop) {
              // Once the car passes the open stop, the stop still ahead
              // (legStop), not "Leaves Los Angeles around 11:00 PM" for good.
              var ctaStop = legStop || openStop;
              document.getElementById('ctaTitle').textContent = 'Seats open from ' + ctaStop.name;
              document.getElementById('ctaTitle').style.display = '';
              // Only the stretch they can book (Justin, 2026-10-06: "they dont
              // need to know what happens before LA, just estimated time of
              // departure").
              headAboveButton(leavesLine(ctaStop));
            } else if (d.seatsLeft === 0) {
              document.getElementById('ctaTitle').textContent = 'This ride is full';
              document.getElementById('ctaTitle').style.display = '';
              headAboveButton("Join the waitlist and we'll email you if a seat opens.");
            } else if (d.bookable === false) {
              document.getElementById('ctaTitle').textContent = 'This ride has already departed';
              document.getElementById('ctaTitle').style.display = '';
              headAboveButton('Drivers post new rides every day.');
            }
            document.title = legStop
              ? legStop.name + ' → ' + legToShort + ' · Seat Sherpa'
              : (d.fromArea || 'Ride') + ' → ' + (legEnd ? legEnd.name : (d.toArea || '')) + ' · Seat Sherpa';
            // Friendly share message (Justin, 2026-08-28): a shared link should
            // read like a pitch, not a bare URL. Consumed by the share buttons.
            try {
              // A stretch is shared as the stretch: its stop, its day, its
              // price, and a link that opens on it (?board=, read below).
              var sWhen = legStop ? rideWhen(legDate(legStop), null) : (d.depDate ? rideWhen(d.depDate, null) : '');
              if (legStop) document.body.dataset.shareBoard = legStop.id;
              if (legEnd) document.body.dataset.shareAlight = legEnd.id;
              document.body.dataset.shareMsg =
                'Check out this carpool ride from '
                + (legStop ? legStop.name + ' to ' + legToShort : (d.fromArea || 'a city') + ' to ' + (legEnd ? legEnd.name : (d.toArea || 'its destination')))
                + (sWhen ? ' on ' + sWhen : '')
                // All-in total, same figure the page advertises (scan #6) —
                // never a lower bare seat price than the recipient will see.
                // No trailing emoji. 🚗 is a non-BMP surrogate pair and it
                // came out of at least one share path as a replacement
                // glyph (Justin's WhatsApp, 2026-08-29). Plain text survives
                // every clipboard, sms: and share-sheet round trip.
                + (shareTotal ? ' for $' + shareTotal : '')
                + '.';
            } catch (_) {}
          }).catch(function () {});
      }

      // ── Android smart open ─────────────────────────────────────────────
      // On Android, surface the teal "Open in the app" CTA wired to an
      // intent: URL — Chrome opens the installed app via its seatsherpa://
      // scheme, or falls back to the Play Store listing when it isn't
      // installed. One tap covers both cases. (iOS gets the same treatment
      // via the App Store badge once Apple review clears.)
      var isAndroid = /android/i.test(navigator.userAgent);
      var isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
      if (isAndroid || isIOS) {
        var playUrl = 'https://seatsherpa.onelink.me/cGHs?pid=web&c=ride';
        var appStoreUrl = 'https://seatsherpa.onelink.me/cGHs?pid=web&c=ride';
        // Carry the ride id (and ref) INTO the app so it opens this exact
        // ride's booking sheet (app/ride.tsx) — an empty intent path landed
        // users on the marketplace. Data URI becomes seatsherpa://ride?id=N.
        var intentPath = id
          ? 'ride?id=' + encodeURIComponent(id) + (ref ? '&ref=' + encodeURIComponent(ref) : '')
          : '';
        var intentUrl =
          'intent://' + intentPath + '#Intent;scheme=seatsherpa;package=com.seatsherpa.app' +
          ';S.browser_fallback_url=' + encodeURIComponent(playUrl) + ';end';
        var openBtn = document.getElementById('openApp');
        // Android: intent opens the installed app or falls back to Play.
        // iOS: the App Store page (shows "Open" when installed).
        openBtn.href = isAndroid ? intentUrl : appStoreUrl;
        // Web-booking mode keeps the browser flow front and center — don't
        // surface the app-open button on top of it.
        if (!web) openBtn.style.display = 'flex';
      }
    })();

    // ── Share this ride ─────────────────────────────────────────────────
    (function () {
      // SHORT share link (Justin, 2026-08-29): the address bar carries
      // from/to/date/time/price/web purely so the page can paint before the
      // fetch lands — none of it is needed by a recipient, and pasting all
      // of it wrapped to three ugly lines in WhatsApp. /ride/:id already
      // redirects to /ride?id=: (vercel.json), so the canonical share form is
      //   seatsherpa.app/ride/330
      // `ref` is the one param worth carrying — it's the referral credit.
      const shareRef = new URLSearchParams(location.search).get('ref');
      // Leading digits only, so a mangled link ("227My") is never re-shared.
      const shortIdRaw = new URLSearchParams(location.search).get('id') || '';
      const shortId = (/^\d+/.exec(shortIdRaw) || [''])[0];
      // Lazy, like the message: a stretch view (2026-10-06) shares a link
      // that opens on the same stretch, /ride/442?board=la, which is also
      // what the link preview (api/og-ride.js) renders as the stretch.
      const shareUrl = () => {
        if (!shortId) return location.origin + location.pathname + location.search;
        const q = [];
        const sb = document.body.dataset.shareBoard, sa = document.body.dataset.shareAlight;
        if (sb && /^[a-z0-9-]{1,40}$/.test(sb)) q.push('board=' + encodeURIComponent(sb));
        // An origin-to-stop leg shares as one too (alight without board).
        if (sa && /^[a-z0-9-]{1,40}$/.test(sa)) q.push('alight=' + encodeURIComponent(sa));
        if (shareRef) q.push('ref=' + encodeURIComponent(shareRef));
        return location.origin + '/ride/' + encodeURIComponent(shortId) + (q.length ? '?' + q.join('&') : '');
      };
      // Sharer's referral code (Justin, 2026-08-28): the pitch should carry
      // "$5 off with my code". Best-effort REST read under the shared session.
      try {
        const tok = JSON.parse(localStorage.getItem('sb-vmfmbntacifqoqxqxgsk-auth-token') || 'null');
        if (tok && tok.access_token && tok.user && tok.user.id) {
          fetch('https://vmfmbntacifqoqxqxgsk.supabase.co/rest/v1/profiles?id=eq.' + encodeURIComponent(tok.user.id) + '&select=referral_code', {
            headers: { apikey: 'sb_publishable_TGebz9q_z0kkH0Tuivlr4w_3MPLMxF3', Authorization: 'Bearer ' + tok.access_token },
          }).then((r) => r.json()).then((rows) => {
            const code = rows && rows[0] && rows[0].referral_code;
            if (code) document.body.dataset.refCode = String(code);
          }).catch(() => {});
        }
      } catch (_) {}
      // Lazy: dataset.shareMsg lands after the ride fetch renders.
      const text = () => {
        let m = document.body.dataset.shareMsg
          || ((document.title.replace(' · Seat Sherpa', '') || 'A ride on Seat Sherpa') + ', grab a seat:');
        if (document.body.dataset.refCode) {
          m += ' New to Seat Sherpa? Use my code ' + document.body.dataset.refCode + ' for $5 off your first ride.';
        }
        return m;
      };
      // ONE button (2026-09-16). On a phone it opens the system share sheet,
      // which already offers Messages, WhatsApp, Mail and the rest, so the
      // six hand-built targets that used to sit here were duplicates. On a
      // desktop, where the share sheet drops the pitch text, it copies the
      // message plus the link.
      const shareBtn = document.getElementById('shareBtn');
      const touchShare = !!navigator.share && window.matchMedia('(pointer: coarse)').matches;
      const copyShare = () => {
        const full = text() + ' ' + shareUrl();
        (navigator.clipboard ? navigator.clipboard.writeText(full) : Promise.reject())
          .then(() => {
            shareBtn.textContent = 'Copied';
            setTimeout(() => { shareBtn.textContent = 'Share this ride'; }, 2500);
          })
          .catch(() => { prompt('Copy this message:', full); });
      };
      shareBtn.addEventListener('click', () => {
        if (touchShare) {
          // An in-app browser can expose navigator.share and still refuse it;
          // fall back to copying unless the person simply closed the sheet.
          navigator.share({ title: text(), text: text(), url: shareUrl() })
            .catch((e) => { if (!e || e.name !== 'AbortError') copyShare(); });
          return;
        }
        copyShare();
      });
    })();

    // ── Phone booking bar (2026-10-12) ─────────────────────────────────
    // Price + Book pinned to the bottom of a phone screen while the booking
    // card's own button (#webBook) is off screen; it slides away when that
    // button scrolls into view, so the two never show at once. It copies
    // #webBook's link and label whenever the ride fetch changes them, and
    // only appears for a real booking link (Book this seat / Book from X),
    // never for See current rides, a waitlist or a departed ride. Hidden on
    // laptops by CSS, where the booking card itself stays in view.
    (function () {
      var wb = document.getElementById('webBook');
      var bar = document.getElementById('bookBar');
      if (!wb || !bar || !('IntersectionObserver' in window) || !('MutationObserver' in window)) return;
      var btn = document.getElementById('bbBtn');
      var bp = document.getElementById('bbPrice');
      var bn = document.getElementById('bbNote');
      var priceEl = document.getElementById('price');
      var main = document.getElementById('rideCard');
      var wbOnScreen = false;
      function sync() {
        var href = wb.getAttribute('href') || '';
        var pt = priceEl ? priceEl.textContent.trim() : '';
        // No price = nothing bookable on this stretch (every seat held): no
        // bar, the card says why (bug check 2026-10-12).
        var ok = wb.style.display !== 'none' && main.style.display !== 'none'
          && /^\/book\?id=\d+/.test(href) && !/[?&]waitlist=1/.test(href) && !!pt;
        if (ok) {
          btn.setAttribute('href', href);
          // "Book from Santa Nella / Los Banos" squeezed the price to nothing
          // on a 360px phone; the header above already names the stop.
          var label = wb.textContent.trim();
          btn.textContent = /^Book from /.test(label) ? 'Book this seat' : label;
          bp.textContent = pt;
          bn.style.display = '';
        }
        bar.hidden = !ok;
        bar.classList.toggle('off', wbOnScreen);
        bar.setAttribute('aria-hidden', String(!ok || wbOnScreen));
        if (wbOnScreen) btn.setAttribute('tabindex', '-1'); else btn.removeAttribute('tabindex');
        document.body.classList.toggle('has-bar', ok);
      }
      new IntersectionObserver(function (entries) {
        wbOnScreen = entries[entries.length - 1].isIntersecting;
        sync();
      }).observe(wb);
      var mo = new MutationObserver(sync);
      mo.observe(wb, { attributes: true, childList: true, characterData: true, subtree: true });
      if (priceEl) mo.observe(priceEl, { childList: true, characterData: true, subtree: true });
      mo.observe(main, { attributes: true, attributeFilter: ['style'] });
      sync();
    })();
  </script>
